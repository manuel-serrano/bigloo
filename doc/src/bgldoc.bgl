;*---------------------------------------------------------------------*/
;*    doc                                                              */
;*---------------------------------------------------------------------*/
(module bgldoc
   (library web)
   (import "./fontifier.bgl" . fontifier)
   (main))

;*---------------------------------------------------------------------*/
;*    definitions-table ...                                            */
;*---------------------------------------------------------------------*/
(define definitions-table (create-hashtable :size 128 :weak 'open-string))
(define tests-table (create-hashtable :size 128 :weak 'open-string))

(define max-tests 5)

(define navbutton-attrs
   '((class . "navbutton")
     (onclick . "this.setAttribute('open', this.getAttribute('open') === 'true' ? 'false' : 'true')")))

;*---------------------------------------------------------------------*/
;*    all-chapters ...                                                 */
;*---------------------------------------------------------------------*/
(define all-chapters
   '(("numbers" . "number.html")
     ("characters" . "character.html")
     ("i/o" . "io.html")
     ("pairs" . "pair.html")
     ("strings" . "string.html")
     ("vectors" . "vector.html")))

;*---------------------------------------------------------------------*/
;*    let+ :: ...                                                      */
;*---------------------------------------------------------------------*/
(define-expander let+
   (lambda (x e)
       (match-case x
	 ((let+ (?vars ?expr) . ?body)
	  `(multiple-value-bind ,vars ,expr ,@body))
	 (else
	  (error "let+" "bad syntax" x)))))

;*---------------------------------------------------------------------*/
;*    main ...                                                         */
;*---------------------------------------------------------------------*/
(define (main x)
   (let+ ((chapter toc index) (chapter (cadr x)))
      (call-with-output-file "index.sexp"
	 (lambda (op)
	    (write index op)))
      (display "<!-- GENERATED by doc.bgl -->\n")
      (let ((doc (xml-element 'html '((class . "bgldoc"))
		    (list
		       (call-with-input-file "head.html" html-parse)
		       (xml-element 'nav '((class . "menu"))
			  (list (xml-element 'div '((class . "menu"))
				   (list
				      (xml-element 'img '((class . "logo") (src . "bgl.svg")) '())
				      (xml-element 'ul '((class . "menu"))
					 (list
					    (xml-element 'li '() (list (xml-element 'a '() (list "Home"))))
					    (xml-element 'li navbutton-attrs
					       (list
						  (xml-element 'a '() (list "Stdlib"))
						  (xml-main-toc all-chapters)))
					    (xml-element 'li '() (list (xml-element 'a '() (list "Modules"))))
					    (xml-element 'li '() (list (xml-element 'a '() (list "Objects"))))))
				      (xml-element 'span '((class . "version"))
					 (list (xml-element 'text '() (list (bigloo-config 'release-number)))))))))
		       (xml-element 'div '((class . "chapter"))
			  (list
			     (xml-element 'div '((class . "body"))
				(xml-element-children chapter))
			     (xml-toc toc)))))))
	 (write-html doc))))

;*---------------------------------------------------------------------*/
;*    xml-main-toc ...                                                 */
;*---------------------------------------------------------------------*/
(define (xml-main-toc chapters)
   (xml-element 'div '((class . "nav-menu") (id . "stdlib"))
      (list
	 (xml-element 'nav '()
	    (list
	       (xml-element 'ul '((class . "defs"))
		  (map (lambda (chapter::pair)
			  (xml-element 'li '((class . "def"))
			     (list (xml-element 'a
				      `((href . ,(cdr chapter)))
				      (list (xml-element 'text '() (list (car chapter))))))))
		     chapters)))))))

;*---------------------------------------------------------------------*/
;*    xml-toc ...                                                      */
;*---------------------------------------------------------------------*/
(define (xml-toc toc::pair-nil)
   
   (define (xml-toc-defs defs::pair-nil)
      (xml-element 'ul '((class . "defs"))
	 (map (lambda (def::XmlElement)
		 (xml-element 'li '((class . "def"))
		    (list (xml-element 'a
			     `((href . ,(string-append "#" (xml-element-attribute def 'id))))
			     (map xml-element-dup (xml-element-children def))))))
	    defs)))
   
   (define (xml-toc-sections toc::pair-nil)
      (xml-element 'ul '((class . "sections"))
	 (map (lambda (section::pair)
		 (let ((title::XmlElement (car section))
		       (defs (cdr section)))
		    (xml-element 'li '((class . "section"))
		       (list
			  (xml-element 'a
			     `((href . ,(string-append "#" (xml-element-attribute title 'id))))
			     (map xml-element-dup (xml-element-children title)))
			  (xml-toc-defs defs)))))
	    toc)))
   
   (xml-element 'div '((class . "toc"))
      (list
	 (xml-element 'nav '()
	    (list
	       (xml-toc-sections toc))))))

;*---------------------------------------------------------------------*/
;*    chapter ...                                                      */
;*---------------------------------------------------------------------*/
(define (chapter file::bstring)
   
   (define (chapter-toc::pair-nil doc::XmlElement)
      (map (lambda (e::XmlElement)
	      (let loop ((n (xml-element-next-sibling e))
			 (defs '()))
		 (if (isa? n XmlElement)
		     (let ((n::XmlElement n))
			(if (eq? (-> n tag) 'h2)
			    (cons e (reverse! defs))
			    (if (eq? (-> n tag) 'h3)
				(loop (xml-element-next-sibling n)
				   (cons (xml-element-dup n) defs))
				(loop (xml-element-next-sibling n)
				   defs))))
		     (cons e (reverse! defs)))))
	 (xml-get-elements-by-tag doc 'h2)))
   
   (call-with-input-file file
      (lambda (ip)
	 (let* ((doc (markdown-parse ip
			:eval (make-doc-eval (dirname file))
			:fontifier (lambda (lang id lines)
				      (call-with-input-string (apply string-append lines)
					 fontifier.lisp))))
		(index '())
		(toc (chapter-toc doc)))
	    (for-each (lambda (e)
			 (let* ((name (string-trim-both
					 (apply string-append
					    (xml-text-element-value
					       (car (xml-element-children e))))))
				(def (hashtable-get definitions-table name))
				(tests (hashtable-get tests-table name)))
			    (let ((md (definition->markdown def)))
			       (xml-element-children-set! e md)
			       (xml-element-attribute-set! e 'class (definition-class def))
			       (if (pair? tests)
				   (let loop ((next (xml-element-next-sibling e))
					      (prev e))
				      (cond
					 ((or (not next)
					      (let ((next::XmlElement next))
						 (memq (-> next tag) '(h1 h2 h3 h4))))
					  (for-each (lambda (el)
						       (xml-element-append-child! prev el))
					     (test->markdown (reverse tests))))
					 (else
					  (loop (xml-element-next-sibling next) next))))
				   (error "doc" "Cannot find test" name))
			       (set! index
				  (cons (list name def (xml-element-attribute e 'id))
				     index)))))
	       (xml-get-elements-by-tag doc 'h3))
	    (values doc toc index)))))
   
;*---------------------------------------------------------------------*/
;*    definition-class ...                                             */
;*---------------------------------------------------------------------*/
(define (definition-class def)
   (match-case def
      ((generic . ?-) "generic")
      ((?- .  ?-) "function")
      (else "variable")))

;*---------------------------------------------------------------------*/
;*    definition->markdown ...                                         */
;*---------------------------------------------------------------------*/
(define (definition->markdown::pair def)

   (define (markdown-ident::pair sym class)
      (multiple-value-bind (id ty)
	 (parse-ident2 sym)
	 (if ty
	     (list (xml-element 'span `((class . ,class)) (list id))
		(xml-element 'span '((class . "type")) (list "::" ty)))
	     (list (xml-element 'span `((class . ,class)) (list id))))))

   (define (markdown-argument::pair arg)
      (cond
	 ((symbol? arg)
	  (markdown-ident arg "argument"))
	 ((eq? arg #!optional)
	  (list (xml-element 'span '((class . "dsssl")) (list "#!optional"))))
	 ((eq? arg #!key)
	  (list (xml-element 'span '((class . "dsssl")) (list "#!key"))))
	 ((eq? arg #!rest)
	  (list (xml-element 'span '((class . "dsssl")) (list "#!rest"))))
	 ((pair? arg)
	  `("(" ,@(markdown-ident (car arg) "argument")
	      " "
	      ,(xml-element 'span '((class . "expression")) (list (format "~s" (cadr arg))))
	      ")"))
	 (else
	  (error "definition->markdown" "Illegal argument" arg))))

   (define (markdown-arguments::pair-nil args)
      (cond
	 ((null? args)
	  '())
	 ((not (pair? args))
	  (cons " . " (markdown-argument args)))
	 (else
	  (cons " " (append (markdown-argument (car args)) (markdown-arguments (cdr args)))))))
	      
   (define (function->markdown fun args)
      `("(" ,@(markdown-ident fun "definition") ,@(markdown-arguments args) ")"))
   
   (define (variable->markdown var)
      (list (xml-element 'span '((class . "definition")) (list (symbol->string var)))))

   (match-case def
      ((?fun . ?args)
       (function->markdown fun args))
      (else
       (variable->markdown def))))

;*---------------------------------------------------------------------*/
;*    fontify ...                                                      */
;*---------------------------------------------------------------------*/
(define (fontify text::bstring #!key (lang::bstring "bgl"))
   (cond
      ((string=? lang "bgl")
       (call-with-input-string text fontifier.lisp))
      (else
       (format "~s" text))))

;*---------------------------------------------------------------------*/
;*    test->markdown ...                                               */
;*---------------------------------------------------------------------*/
(define (test->markdown tests)
   (let ((ts (take tests max-tests)))
      (list
	 (xml-element 'h4 '((class . "example"))
	    (list (if (pair? (cdr ts)) "Examples" "Example")))
	 (xml-element 'pre '((class . "test"))
	    (append-map (lambda (t)
			   (list
			      (fontify (format "~s" (car t)))
			      (xml-element 'span '((class . "result")) (list "&rarr;"))
			      (fontify (format "~s" (cdr t)))
			      "\n"))
	       ts)))))

;*---------------------------------------------------------------------*/
;*    make-doc-eval ...                                                */
;*---------------------------------------------------------------------*/
(define (make-doc-eval dir)
   (lambda (x)
      (match-case x
	 ((include (and ?file (? string?)))
	  ;;(call-with-input-file (make-file-name dir file) read-string)
	  (call-with-input-file file read-string))
	 ((implementation-path (and ?file (? string?)))
	  (let* ((src (call-with-input-file (make-file-name dir file) port->sexp-list)))
	     (collect-definitions src)
	     ""))
	 ((example-path (and ?file (? string?)))
	  (let* ((src (call-with-input-file (make-file-name dir file) port->sexp-list)))
	     (collect-tests src)
	     ""))
	 (else
	  (eval x)))))

;*---------------------------------------------------------------------*/
;*    collect-definitions ...                                          */
;*---------------------------------------------------------------------*/
(define (collect-definitions src)
   (for-each (lambda (e)
		(match-case e
		   ((define (and ?def (?id . ?-)) . ?-)
		    (hashtable-put! definitions-table (parse-ident id) def))
		   ((define-inline (and ?def (?id . ?-)) . ?-)
		    (hashtable-put! definitions-table (parse-ident id) def))
		   ((define-generic (and ?def (?id . ?-)) . ?-)
		    (hashtable-put! definitions-table (parse-ident id) (cons 'generic def)))
		   ((define (and ?def (? symbol?)) ?-)
		    (hashtable-put! definitions-table (parse-ident def) def))
		   (else #f)))
      src))
	     
;*---------------------------------------------------------------------*/
;*    collect-tests ...                                                */
;*---------------------------------------------------------------------*/
(define (collect-tests src)
   
   (define (hashtable-add! table key val)
      (let ((old (hashtable-get table key)))
	 (if (pair? old)
	     (hashtable-put! table key (cons val old))
	     (hashtable-put! table key (list val)))))
		
   (for-each (lambda (e)
		(match-case e
		   ((define-test ?id ?expr :expected ?val)
		    (hashtable-add! tests-table (symbol->string id) (cons expr val)))
		   ((define-test ?id ?expr)
		    (hashtable-add! tests-table (symbol->string id) (cons expr #t)))
		   (else #f)))
      src))
	     
;*---------------------------------------------------------------------*/
;*    parse-ident ...                                                  */
;*---------------------------------------------------------------------*/
(define (parse-ident id::symbol)
   (let* ((s (symbol->string! id))
	  (l (string-length s)))
      (let loop ((i 0))
	 (cond
	    ((>=fx i (-fx l 2))
	     s)
	    ((char=? (string-ref s i) #\:)
	     (if (char=? (string-ref s (+fx i 1)) #\:)
		 (substring s 0 i)
		 (loop (+fx i 1))))
	    (else
	     (loop (+fx i 1)))))))

;*---------------------------------------------------------------------*/
;*    parse-ident2 ...                                                 */
;*---------------------------------------------------------------------*/
(define (parse-ident2 id::symbol)
   (let* ((s (symbol->string! id))
	  (l (string-length s)))
      (let loop ((i 0))
	 (cond
	    ((>=fx i (-fx l 2))
	     (values s #f))
	    ((char=? (string-ref s i) #\:)
	     (if (char=? (string-ref s (+fx i 1)) #\:)
		 (values (substring s 0 i) (substring s (+fx i 2) (string-length s)))
		 (loop (+fx i 1))))
	    (else
	     (loop (+fx i 1)))))))
