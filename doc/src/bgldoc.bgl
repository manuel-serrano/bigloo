;*---------------------------------------------------------------------*/
;*    bgldoc                                                           */
;*---------------------------------------------------------------------*/
(module bgldoc
   (library web)
   (import "./fontifier.bgl" . fontifier)
   (main))

;*---------------------------------------------------------------------*/
;*    definitions-table ...                                            */
;*---------------------------------------------------------------------*/
(define definitions-table (create-hashtable :size 128 :weak 'open-string))
(define tests-table (create-hashtable :size 128 :weak 'open-string))

(define max-tests 5)

;*---------------------------------------------------------------------*/
;*    navbutton-attrs ...                                              */
;*---------------------------------------------------------------------*/
(define (navbutton-attrs clazz::bstring)
   `((class . ,(string-append "navbutton " clazz))
     (onclick . "this.setAttribute('open', this.getAttribute('open') === 'true' ? 'false' : 'true')")))

;*---------------------------------------------------------------------*/
;*    all-menus ...                                                    */
;*---------------------------------------------------------------------*/
(define all-menus
   '(("home" . "index.html")
     ("stdlib" . "bool.html")
     ("module" . "module5.html")))

;*---------------------------------------------------------------------*/
;*    stdlib-chapters ...                                              */
;*---------------------------------------------------------------------*/
(define stdlib-chapters
   '(("booleans" . "bool.html")
     ("characters" . "character.html")
     ("hash" . "hash.html")
     ("i/o" . "io.html")
     ("numbers" . "number.html")
     ("pairs and lists" . "pair.html")
     ("ports" . "port.html")
     ("strings" . "string.html")
     ("vectors" . "vector.html")))

;*---------------------------------------------------------------------*/
;*    module-chapters ...                                              */
;*---------------------------------------------------------------------*/
(define module-chapters
   '(("module 5" . "module5.html")
     ("module 4" . "module4.html")))

;*---------------------------------------------------------------------*/
;*    find-chapter-title ...                                           */
;*---------------------------------------------------------------------*/
(define (find-chapter-title source)
   (let* ((p (prefix (basename source)))
          (c (find (lambda (x) (string=? (prefix (cdr x)) p))
                (append module-chapters stdlib-chapters))))
      (if (pair? c)
          (prefix (cdr c))
          (error "find-chapter-title" "Cannot find title for source" source))))

;*---------------------------------------------------------------------*/
;*    find-menu-href ...                                               */
;*---------------------------------------------------------------------*/
(define (find-menu-href label)
   (let ((c (assoc label all-menus)))
      (if (pair? c)
          (cdr c)
          (error "find-menu-href" "Cannot find href for label" label))))

;*---------------------------------------------------------------------*/
;*    let+ :: ...                                                      */
;*---------------------------------------------------------------------*/
(define-expander let+
   (lambda (x e)
       (match-case x
	 ((let+ (?vars ?expr) . ?body)
	  `(multiple-value-bind ,vars ,expr ,@body))
	 (else
	  (error "let+" "bad syntax" x)))))

;*---------------------------------------------------------------------*/
;*    main ...                                                         */
;*---------------------------------------------------------------------*/
(define (main argv)
   
   (define reset-index #f)
   (define target #f)
   (define index-name "index.sexp")
   (define active-navbutton "main")
   (define chapters '())
   (define main-title (xml-element 'span '((class . "main")) '("bigloo")))

   (define (menubar title::pair-nil
              #!key (home "") (stdlib "") (modules "") objects)
      (xml-element 'nav '((class . "menu"))
         (list (xml-element 'div '((class . "menu"))
                  (list
                     (xml-element 'div '((class . "title"))
                        (cons main-title title))
                     (xml-element 'ul `((class . "menu")
                                        (data-active . ,active-navbutton))
                        (list
                           (xml-element 'li (navbutton-attrs "home")
                              (list
                                 (xml-element 'a
                                    `((class . "home")
                                      (href . ,(find-menu-href "home")))
                                    (list "Home"))
                                 home))
                           (xml-element 'li (navbutton-attrs "stdlib")
                              (list
                                 (xml-element 'a
                                    '((class . "stdlib submenu"))
                                    (list "Stdlib"))
                                 stdlib))
                           (xml-element 'li (navbutton-attrs "Modules")
                              (list
                                 (xml-element 'a
                                    '((class . "modules submenu"))
                                    (list "Modules"))
                                 modules))
                           (xml-element 'li (navbutton-attrs "Objects")
                              (list (xml-element 'a '() (list "Objects"))))))
                     (xml-element 'span '((class . "version"))
                        (list
                           (xml-element 'text '()
                              (list (bigloo-config 'release-number))))))))))
      
   (define (compile-chapter source)
      (let+ ((chapter toc new-index) (chapter source (or target (string-append (prefix source) ".html"))))

	 (let ((index (if (or reset-index (not (file-exists? index-name)))
			  new-index
			  (delete-duplicates!
			     (append new-index
				(call-with-input-file index-name read))
			     (lambda (x y) (string=? (car x) (car y)))))))
	    (call-with-output-file index-name
	       (lambda (op)
		  (write index op))))
	 
	 (display "<!-- GENERATED by main.bgl -->\n")
	 (let ((doc (xml-element 'html '((class . "bgldoc"))
		       (list
			  (call-with-input-file "head.html" html-parse)
                          (menubar (list
                                      (xml-element 'span '((class . "sep"))
                                         '("/"))
                                      (find-chapter-title source))
                             :stdlib (xml-chapter-toc 'stdlib stdlib-chapters)
                             :modules (xml-chapter-toc 'modules module-chapters))
			  (xml-element 'div '((class . "chapter"))
			     (list
				(xml-element 'div '((class . "body"))
				   (xml-element-children chapter))
				(xml-toc toc)))))))
	    (write-html doc))))

   (define (compile-home sources)
      (display "<!-- GENERATED by main.bgl -->\n")
      (let ((doc (xml-element 'html '((class . "bgldoc home"))
                    (list
                       (call-with-input-file "head.html" html-parse)
                       (menubar '()
                          :stdlib (xml-chapter-toc 'stdlib stdlib-chapters)
                          :modules (xml-chapter-toc 'modules module-chapters))
                       (xml-element 'div '((class . "home"))
                          (list
                             (xml-element 'img '((class . "logo") (src . "bgl.svg")) '())
                             main-title))
                       (xml-element 'div '((class . "body"))
                          (map (lambda (source)
                                  (call-with-input-file source
                                     (lambda (ip)
                                        (markdown-parse ip
                                           :eval (make-doc-eval (dirname source))
                                           :fontifier (lambda (lang id lines)
                                                         (call-with-input-string
                                                               (apply string-append lines)
                                                            (cond
                                                               ((string=? lang "bnf")
                                                                fontifier.ebnf)
                                                               (else
                                                                fontifier.bigloo))))))))
                             sources))))))
         (write-html doc)))
      
   
   (args-parse (cdr argv)
      ((("-h" "--help") (help "This help message"))
       (args-parse-usage #f))
      ((("-r" "--reset-index") (help "Reset the index"))
       (set! reset-index #t))
      ((("-t" "--tab") ?tab (help "Set the active navbutton"))
       (set! active-navbutton tab))
      (("-o" ?filename (help "target"))
       (set! target filename))
      (else
       (set! chapters (cons else chapters))))

   (if (string=? active-navbutton "home")
       (compile-home chapters)
       (for-each compile-chapter chapters)))

;*---------------------------------------------------------------------*/
;*    xml-chapter-toc ...                                              */
;*---------------------------------------------------------------------*/
(define (xml-chapter-toc id chapters)
   (xml-element 'div `((class . "nav-menu") (id . ,id))
      (list
	 (xml-element 'nav '()
	    (list
	       (xml-element 'ul '((class . "defs"))
		  (map (lambda (chapter::pair)
			  (xml-element 'li '((class . "def"))
			     (list (xml-element 'a
				      `((href . ,(cdr chapter)))
				      (list
					 (xml-element 'text '()
					    (list (car chapter))))))))
		     chapters)))))))

;*---------------------------------------------------------------------*/
;*    xml-toc ...                                                      */
;*---------------------------------------------------------------------*/
(define (xml-toc toc::pair-nil)
   
   (define (xml-toc-defs defs::pair-nil)
      (xml-element 'ul '((class . "defs"))
	 (map (lambda (def::XmlElement)
		 (xml-element 'li '((class . "def"))
		    (list (xml-element 'a
			     `((href . ,(string-append "#" (xml-element-attribute def 'id))))
			     (map xml-element-dup
				(xml-element-children def))))))
	    defs)))
   
   (define (xml-toc-sections toc::pair-nil)
      (xml-element 'ul '((class . "sections"))
	 (map (lambda (section::pair)
		 (let ((title::XmlElement (car section))
		       (defs (cdr section)))
		    (xml-element 'li '((class . "section"))
		       (list
			  (xml-element 'a
			     `((href . ,(string-append "#" (xml-element-attribute title 'id))))
			     (map xml-element-dup
				(xml-element-children title)))
			  (xml-toc-defs defs)))))
	    toc)))
   
   (xml-element 'div '((class . "toc"))
      (list
	 (xml-element 'nav '()
	    (list
	       (xml-toc-sections toc))))))

;*---------------------------------------------------------------------*/
;*    chapter ...                                                      */
;*---------------------------------------------------------------------*/
(define (chapter source::bstring target::bstring)
   
   (define (chapter-toc::pair-nil doc::XmlElement)
      (map (lambda (e::XmlElement)
	      (let loop ((n (xml-element-next-sibling e))
			 (defs '()))
		 (if (isa? n XmlElement)
		     (let ((n::XmlElement n))
			(if (eq? (-> n tag) 'h2)
			    (cons e (reverse! defs))
			    (if (eq? (-> n tag) 'h3)
				(loop (xml-element-next-sibling n)
				   (cons (xml-element-dup n) defs))
				(loop (xml-element-next-sibling n)
				   defs))))
		     (cons e (reverse! defs)))))
	 (xml-get-elements-by-tag doc 'h2)))
   
   (call-with-input-file source
      (lambda (ip)
	 (let* ((doc (markdown-parse ip
			:eval (make-doc-eval (dirname source))
			:fontifier (lambda (lang id lines)
				      (call-with-input-string (apply string-append lines)
                                         (cond
                                            ((string=? lang "bnf")
                                             fontifier.ebnf)
                                            (else
                                             fontifier.bigloo))))))
		(index '())
		(toc (chapter-toc doc)))
            ;; test examples 
	    (for-each (lambda (e)
			 (let* ((name (string-trim-both
					 (apply string-append
					    (xml-text-element-value
					       (car (xml-element-children e))))))
				(def (hashtable-get definitions-table name))
				(tests (hashtable-get tests-table name)))
                            (if (not def)
                                (error "doc" "Cannot find definition" name)
                                (let ((md (definition->markdown def)))
                                   (xml-element-children-set! e md)
                                   (xml-element-attribute-set! e 'class (definition-class def))
                                   (if (pair? tests)
                                       (let loop ((next (xml-element-next-sibling e))
                                                  (prev e))
                                          (cond
                                             ((or (not next)
                                                  (let ((next::XmlElement next))
                                                     (memq (-> next tag) '(h1 h2 h3 h4))))
                                              (for-each (lambda (el)
                                                           (xml-element-append-child! prev el))
                                                 (test->markdown (reverse tests))))
                                             (else
                                              (loop (xml-element-next-sibling next) next))))
                                       (error "doc" "Cannot find test" name))
                                   (set! index
                                      (cons (list name def (xml-element-attribute e 'id) target)
                                         index))))))
	       (xml-get-elements-by-tag doc 'h3))
            ;; inline examples
            (for-each (lambda (e::XmlElement)
                         (let* ((path (xml-element-attribute e 'href))
                                (qpath (make-file-name (dirname target) path)))
                            (when (and (file-exists? qpath) (member (suffix path) '("bgl" "bgh")))
                               (xml-element-replace-child! e
                                  (xml-element 'pre '((class . "example"))
                                     (fontify (call-with-input-file qpath read-string)))))))
               (xml-get-elements-by-tag doc 'a))
	    (values doc toc index)))))
   
;*---------------------------------------------------------------------*/
;*    definition-class ...                                             */
;*---------------------------------------------------------------------*/
(define (definition-class def)
   (match-case def
      ((generic . ?-) "generic")
      ((?- .  ?-) "function")
      (else "variable")))

;*---------------------------------------------------------------------*/
;*    definition->markdown ...                                         */
;*---------------------------------------------------------------------*/
(define (definition->markdown::pair def)

   (define (markdown-ident::pair sym class)
      (multiple-value-bind (id ty)
	 (parse-ident2 sym)
	 (if ty
	     (list (xml-element 'span `((class . ,class)) (list id))
		(xml-element 'span '((class . "type")) (list "::" ty)))
	     (list (xml-element 'span `((class . ,class)) (list id))))))

   (define (markdown-argument::pair arg)
      (cond
	 ((symbol? arg)
	  (markdown-ident arg "argument"))
	 ((eq? arg #!optional)
	  (list (xml-element 'span '((class . "dsssl")) (list "#!optional"))))
	 ((eq? arg #!key)
	  (list (xml-element 'span '((class . "dsssl")) (list "#!key"))))
	 ((eq? arg #!rest)
	  (list (xml-element 'span '((class . "dsssl")) (list "#!rest"))))
	 ((pair? arg)
	  `("(" ,@(markdown-ident (car arg) "argument")
	      " "
	      ,(xml-element 'span '((class . "expression")) (list (format "~s" (cadr arg))))
	      ")"))
	 (else
	  (error "definition->markdown" "Illegal argument" arg))))

   (define (markdown-arguments::pair-nil args)
      (cond
	 ((null? args)
	  '())
	 ((not (pair? args))
	  (cons " . " (markdown-argument args)))
	 (else
	  (cons " " (append (markdown-argument (car args)) (markdown-arguments (cdr args)))))))
	      
   (define (function->markdown fun args)
      `("(" ,@(markdown-ident fun "definition") ,@(markdown-arguments args) ")"))
   
   (define (variable->markdown var)
      (list (xml-element 'span '((class . "definition")) (list (symbol->string var)))))

   (match-case def
      ((?fun . ?args)
       (function->markdown fun args))
      (else
       (variable->markdown def))))

;*---------------------------------------------------------------------*/
;*    fontify ...                                                      */
;*---------------------------------------------------------------------*/
(define (fontify text::bstring #!key (lang::bstring "bigloo"))
   (cond
      ((string=? lang "bigloo")
       (call-with-input-string text fontifier.bigloo))
      ((string=? lang "bnf")
       (call-with-input-string text fontifier.ebnf))
      (else
       (format "~s" text))))

;*---------------------------------------------------------------------*/
;*    test->markdown ...                                               */
;*---------------------------------------------------------------------*/
(define (test->markdown tests)
   (let ((ts (take tests max-tests)))
      (list
	 (xml-element 'h4 '((class . "example"))
	    (list (if (pair? (cdr ts)) "Examples" "Example")))
	 (xml-element 'pre '((class . "test"))
	    (append-map (lambda (t)
                           (let ((s (format "~s" (car t))))
                              (if (>fx (string-length s) 80)
                                  (list
                                     (fontify (call-with-output-string
                                                 (lambda (op)
                                                   (pp (car t) op :width 100))))
                                     (xml-element 'span '((class . "result")) (list "   &rarr;"))
                                     (fontify (format "~s" (cdr t)))
                                     "\n")
                                  (list
                                     (fontify s)
                                     (xml-element 'span '((class . "result")) (list "&rarr;"))
                                     (fontify (format "~s" (cdr t)))
                                     "\n"))))
	       ts)))))

;*---------------------------------------------------------------------*/
;*    make-doc-eval ...                                                */
;*---------------------------------------------------------------------*/
(define (make-doc-eval dir)
   (lambda (x)
      (match-case x
	 ((include (and ?file (? string?)))
	  ;;(call-with-input-file (make-file-name dir file) read-string)
	  (call-with-input-file file read-string))
	 ((implementation-path (and ?file (? string?)))
	  (let* ((src (call-with-input-file (make-file-name dir file) port->sexp-list)))
	     (collect-definitions src)
	     ""))
	 ((example-path (and ?file (? string?)))
	  (let* ((src (call-with-input-file (make-file-name dir file) port->sexp-list)))
	     (collect-tests src)
	     ""))
	 (else
	  (eval x)))))

;*---------------------------------------------------------------------*/
;*    collect-definitions ...                                          */
;*---------------------------------------------------------------------*/
(define (collect-definitions src)
   (for-each (lambda (e)
		(match-case e
		   ((define (and ?def (?id . ?-)) . ?-)
		    (hashtable-put! definitions-table (parse-ident id) def))
		   ((define-inline (and ?def (?id . ?-)) . ?-)
		    (hashtable-put! definitions-table (parse-ident id) def))
		   ((define-generic (and ?def (?id . ?-)) . ?-)
		    (hashtable-put! definitions-table (parse-ident id) (cons 'generic def)))
		   ((define (and ?def (? symbol?)) ?-)
		    (hashtable-put! definitions-table (parse-ident def) def))
		   (else #f)))
      src))
	     
;*---------------------------------------------------------------------*/
;*    collect-tests ...                                                */
;*---------------------------------------------------------------------*/
(define (collect-tests src)
   
   (define (hashtable-add! table key val)
      (let ((old (hashtable-get table key)))
	 (if (pair? old)
	     (hashtable-put! table key (cons val old))
	     (hashtable-put! table key (list val)))))
		
   (for-each (lambda (e)
		(match-case e
		   ((define-test ?id ?expr :expected ?val)
		    (hashtable-add! tests-table (symbol->string id) (cons expr val)))
		   ((define-test ?id ?expr)
		    (hashtable-add! tests-table (symbol->string id) (cons expr #t)))
		   (else
		    #f)))
      src))
	     
;*---------------------------------------------------------------------*/
;*    parse-ident ...                                                  */
;*---------------------------------------------------------------------*/
(define (parse-ident id::symbol)
   (let* ((s (symbol->string! id))
	  (l (string-length s)))
      (let loop ((i 0))
	 (cond
	    ((>=fx i (-fx l 2))
	     s)
	    ((char=? (string-ref s i) #\:)
	     (if (char=? (string-ref s (+fx i 1)) #\:)
		 (substring s 0 i)
		 (loop (+fx i 1))))
	    (else
	     (loop (+fx i 1)))))))

;*---------------------------------------------------------------------*/
;*    parse-ident2 ...                                                 */
;*---------------------------------------------------------------------*/
(define (parse-ident2 id::symbol)
   (let* ((s (symbol->string! id))
	  (l (string-length s)))
      (let loop ((i 0))
	 (cond
	    ((>=fx i (-fx l 2))
	     (values s #f))
	    ((char=? (string-ref s i) #\:)
	     (if (char=? (string-ref s (+fx i 1)) #\:)
		 (values (substring s 0 i) (substring s (+fx i 2) (string-length s)))
		 (loop (+fx i 1))))
	    (else
	     (loop (+fx i 1)))))))
