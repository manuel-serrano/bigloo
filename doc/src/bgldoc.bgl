;*---------------------------------------------------------------------*/
;*    bgldoc                                                           */
;*---------------------------------------------------------------------*/
(module bgldoc
   (library web XmlElement xml-element xml-element-ctor xml-element-dup
      xml-element-attribute xml-element-attribute-set!
      xml-text-element-value xml-element-next-sibling
      xml-get-elements-by-tag
      xml-element-children  xml-element-children-set!
      xml-element-append-child! xml-element-replace-child!
      write-html html-parse markdown-parse)
   (import "./fontifier.bgl" . fontifier)
   (main))

;*---------------------------------------------------------------------*/
;*    definitions-table ...                                            */
;*---------------------------------------------------------------------*/
(define definitions-table (make-hashtable :size 128 :keys 'string))
(define tests-table (make-hashtable :size 128 :keys 'string))

(define max-tests 5)

;*---------------------------------------------------------------------*/
;*    navbutton-attrs ...                                              */
;*---------------------------------------------------------------------*/
(define (navbutton-attrs clazz::bstring)
   `((class . ,(string-append "navbutton " clazz))
     (onclick . ,(format "body.setAttribute('open', body.getAttribute('open') === '~a' ? 'none' : '~a')" clazz clazz))))

;*---------------------------------------------------------------------*/
;*    all-menus ...                                                    */
;*---------------------------------------------------------------------*/
(define all-menus
   '(("home" . "index.html")
     ("lang" . "condexpand.html")
     ("libs" . "bool.html")
     ("backends" . "backend.html")
     ("dev" . "dev.html")
     ("index" . "idx.html")))

;*---------------------------------------------------------------------*/
;*    libs-chapters ...                                                */
;*---------------------------------------------------------------------*/
(define libs-chapters
   '(("command line parsing" . "argsparse.html")
     ("bigloo" . "bigloo.html")
     ("booleans" . "bool.html")
     ("csv" . "csv.html")
     ("dates" . "date.html")
     ("digest & crc" . "digest.html")
     ("hash" . "hash.html")
     ("errors" . "error.html")
     ("graphs" . "graph.html")
     ("integers" . "int.html")
     ("internet" . "internet.html")
     ("i/o" . "io.html")
     ("mmap" . "mmap.html")
     ("net" . "net.html")
     ("numbers" . "number.html")
     ("os" . "os.html")
     ("pairs and lists" . "pair.html")
     ("ports" . "port.html")
     ("processes" . "process.html")
     ("reals" . "real.html")
     ("regexp" . "regexp.html")
     ("serialization" . "serial.html")
     ("sqlite" . "sqlite.html")
     ("ssl" . "ssl.html")
     ("strings" . "string.html")
     ("symbols & keywords" . "symbol.html")
     ("tar" . "tar.html")
     ("threads" . "thread.html")
     ("vectors" . "vector.html")
     ("weak pointers" . "weakptr.html")
     ("zip" . "zip.html")))

;*---------------------------------------------------------------------*/
;*    backend-chapters ...                                             */
;*---------------------------------------------------------------------*/
(define backend-chapters
   '(("C" . "c.html")
     ("jvm" . "jvm.html")
     ("wasm" . "wasm.html")))

;*---------------------------------------------------------------------*/
;*    lang-chapters ...                                                */
;*---------------------------------------------------------------------*/
(define lang-chapters
   '(("conditional execution" . "condexpand.html")
     ("lexers & parsers" . "parser.html")
     ("module 5" . "module5.html")
     ("module 4" . "module4.html")
     ("objects" . "object.html")
     ("pattern matching" . "match.html")))

;*---------------------------------------------------------------------*/
;*    find-chapter-title ...                                           */
;*---------------------------------------------------------------------*/
(define (find-chapter-title source)
   (let* ((p (prefix (basename source)))
          (c (find (lambda (x) (string=? (prefix (cdr x)) p))
                (append lang-chapters libs-chapters backend-chapters))))
      (if (pair? c)
          (prefix (cdr c))
          (error "find-chapter-title" "Cannot find title for source" source))))

;*---------------------------------------------------------------------*/
;*    find-menu-href ...                                               */
;*---------------------------------------------------------------------*/
(define (find-menu-href label)
   (let ((c (assoc label all-menus)))
      (if (pair? c)
          (cdr c)
          (error "find-menu-href" "Cannot find href for label" label))))

;*---------------------------------------------------------------------*/
;*    let+ :: ...                                                      */
;*---------------------------------------------------------------------*/
(define-expander let+
   (lambda (x e)
       (match-case x
	 ((let+ (?vars ?expr) . ?body)
	  `(multiple-value-bind ,vars ,expr ,@body))
	 (else
	  (error "let+" "bad syntax" x)))))

;*---------------------------------------------------------------------*/
;*    main ...                                                         */
;*---------------------------------------------------------------------*/
(define (main argv)
   
   (define reset-index #f)
   (define target #f)
   (define index-name "index.sexp")
   (define active-navbutton "main")
   (define chapters '())
   (define main-title (xml-element 'span '((class . "main")) '("bigloo")))

   (define (menubar title::pair-nil
              #!key (download "") (lang "") (libs "") (backends "") dev)
      (xml-element 'nav '((class . "menu"))
         (list (xml-element 'div '((class . "menu"))
                  (list
                     (xml-element 'div '((class . "title"))
                        (cons main-title title))
                     (xml-element 'ul `((class . ,(format "menu ~a" active-navbutton))
                                        (data-active . ,active-navbutton))
                        (list
                           (xml-element 'li (navbutton-attrs "home")
                              (list
                                 (xml-element 'a `((class . "home")
                                                   (href . ,(find-menu-href "home")))
                                    (list (xml-element 'span '() '("Home"))))))
                           (xml-element 'li (navbutton-attrs "download")
                              (list
                                 (xml-element 'a `((class . "download"))
                                    (list (xml-element 'span '() '("Download"))))
                                 download))
                           (xml-element 'li (navbutton-attrs "lang")
                              (list
                                 (xml-element 'a '((class . "lang submenu"))
                                    (list (xml-element 'span '() '("Lang"))))
                                 lang))
                           (xml-element 'li (navbutton-attrs "libs")
                              (list
                                 (xml-element 'a '((class . "libs submenu"))
                                    (list (xml-element 'span '() '("Libs"))))
                                 libs))
                           (xml-element 'li (navbutton-attrs "backends")
                              (list (xml-element 'a '((class . "backends submenu"))
                                       (list (xml-element 'span '() '("Backends"))))
                                 backends))
                           (xml-element 'li (navbutton-attrs "dev")
                              (list (xml-element 'a '((class . "dev submenu"))
                                       (list (xml-element 'span '() '("Dev"))))))
                           (xml-element 'li (navbutton-attrs "index")
                              (list
                                 (xml-element 'a `((class . "index")
                                                   (href . ,(find-menu-href "index")))
                                    (list (xml-element 'span '() '("Index"))))))))
                     (xml-element 'span '((class . "version"))
                        (list
                           (xml-element 'text '()
                              (list (bigloo-config 'release-number))))))))))
      
   (define (compile-chapter source)
      (let+ ((chapter toc new-index) (chapter source (or target (string-append (prefix source) ".html"))))

	 (let ((index (if (or reset-index (not (file-exists? index-name)))
			  new-index
			  (delete-duplicates!
			     (append new-index
				(call-with-input-file index-name read))
			     (lambda (x y) (string=? (car x) (car y)))))))
	    (call-with-output-file index-name
	       (lambda (op)
		  (write index op))))

	 (display "<!-- GENERATED by bgldoc.bgl -->\n")
	 (let ((doc (xml-element 'html `((class . "bgldoc") (id . ,(prefix source)))
		       (list
			  (call-with-input-file "head.html" html-parse)
                          (menubar (list
                                      (xml-element 'span '((class . "sep"))
                                         '("/"))
                                      (find-chapter-title source))
                             :libs (xml-chapter-toc 'libs libs-chapters)
                             :backends (xml-chapter-toc 'backends backend-chapters)
                             :lang (xml-chapter-toc 'lang lang-chapters))
			  (xml-element 'div '((class . "chapter"))
			     (list
				(xml-element 'div '((class . "body")
                                                    (onclick . "hideSearch()"))
				   (xml-element-children chapter))
                                (xml-search-input)
                                (xml-search-results)
				(xml-toc toc)))))))
	    (write-html doc))))

   (define (compile-home sources)
      (display "<!-- GENERATED by bgldoc.bgl -->\n")
      (let ((doc (xml-element 'html '((class . "bgldoc home"))
                    (list
                       (call-with-input-file "head.html" html-parse)
                       (menubar (list
                                   (xml-element 'span '((class . "sep"))
                                      '("/"))
                                   "home")
                          :libs (xml-chapter-toc 'libs libs-chapters)
                          :backends (xml-chapter-toc 'backends backend-chapters)
                          :lang (xml-chapter-toc 'lang lang-chapters))
                       (xml-element 'div '((class . "home"))
                          (list
                             (xml-element 'img '((class . "logo") (src . "bgl.svg")) '())
                             main-title))
                       (xml-element 'div '((class . "body"))
                          (map (lambda (source)
                                  (call-with-input-file source
                                     (lambda (ip)
                                        (markdown-parse ip
                                           :eval (make-doc-eval (dirname source))
                                           :fontifier (lambda (lang id lines)
                                                         (call-with-input-string
                                                               (apply string-append lines)
                                                            (cond
                                                               ((string=? lang "bnf")
                                                                fontifier.ebnf)
                                                               ((string=? lang "C")
                                                                fontifier.c)
                                                               ((string=? lang "java")
                                                                fontifier.java)
                                                               ((string=? lang "wat")
                                                                fontifier.wat)
                                                               (else
                                                                fontifier.bigloo))))))))
                             sources))))))
         (write-html doc)))

   (define (compile-index indexes)
      (display "<!-- GENERATED by bgldoc.bgl -->\n")
      (let ((doc (xml-element 'html '((class . "bgldoc index"))
                    (list
                       (call-with-input-file "head.html" html-parse)
                       (menubar (list
                                   (xml-element 'span '((class . "sep"))
                                      '("/"))
                                   "index")
                          :libs (xml-chapter-toc 'libs libs-chapters)
                          :backends (xml-chapter-toc 'backends backend-chapters)
                          :lang (xml-chapter-toc 'lang lang-chapters))
                       (xml-element 'div '((class . "chapter"))
                          (let+ ((elements sections) (index-entries indexes))
                             (list
                                (xml-element 'div '((class . "body")
                                                    (onclick . "hideSearch()"))
                                   (list
                                      (xml-element 'div '((class . "index"))
                                         (reverse! elements))))
                                (xml-search-input)
                                (xml-search-results)
                                (xml-toc sections))))))))
         (write-html doc)))
      
   
   (args-parse (cdr argv)
      ((("-h" "--help") (help "This help message"))
       (args-parse-usage #f))
      ((("-r" "--reset-index") (help "Reset the index"))
       (set! reset-index #t))
      ((("-t" "--tab") ?tab (help "Set the active navbutton"))
       (set! active-navbutton tab))
      (("-o" ?filename (help "target"))
       (set! target filename))
      (else
       (set! chapters (cons else chapters))))

   (cond
      ((string=? active-navbutton "home")
       (compile-home chapters))
      ((string=? active-navbutton "index")
       (compile-index chapters))
      (else
       (for-each compile-chapter chapters))))

;*---------------------------------------------------------------------*/
;*    index-entries ...                                                */
;*---------------------------------------------------------------------*/
(define (index-entries indexes::pair-nil)
   
   (define (index-entry en)
      (xml-element 'div '((class . "index-entry"))
         (list
            (xml-element 'a `((title . ,(format "~s" (cadr en)))
                              (id . ,(car en))
                              (href . ,(format "~a#~a" (cadddr en) (caddr en))))
               (list (car en))))))
   
   (define (toc-entry letter)
      (let ((name (string (char-upcase letter))))
         (xml-element 'div `((class . "index-section")
                             (id . ,name))
            (list name))))

   (define (first-letter str)
      (let ((c (string-ref str 0)))
         (if (char=? c #\()
             (string-ref str 1)
             c)))

   (define (index-letter c)
      (if (char-alphabetic? c)
          c
          #\~))

   (define (real-name str)
      (if (char=? (string-ref str 0) #\()
          (substring str 1)
          str))
         
   (let ((entries (append-map (lambda (f) (call-with-input-file f read))
                     indexes)))
      (let loop ((entries (sort (lambda (x y)
                                   (string<=? (real-name (car x))
                                      (real-name (car y))))
                             entries))
                 (section #\space)
                 (elements '())
                 (sections '()))
         (if (null? entries)
             (values elements
                (list
                   (cons (xml-element 'h2 '((id . "index")) (list "index"))
                      (reverse! sections))))
             (let* ((en (car entries))
                    (name (car en)))
                (if (char-ci=? (index-letter (first-letter name)) section)
                    (let ((el (index-entry en)))
                       (loop (cdr entries) section (cons el elements) sections))
                    (let* ((letter (index-letter (first-letter name)))
                           (el (toc-entry letter)))
                       (loop entries letter
                          (cons el elements) (cons el sections)))))))))

;*---------------------------------------------------------------------*/
;*    xml-chapter-toc ...                                              */
;*---------------------------------------------------------------------*/
(define (xml-chapter-toc id chapters)
   (xml-element 'div `((class . "nav-menu") (id . ,id))
      (list
	 (xml-element 'nav '()
	    (list
	       (xml-element 'ul '((class . "defs"))
		  (map (lambda (chapter::pair)
			  (xml-element 'li '((class . "def"))
			     (list (xml-element 'a
				      `((href . ,(cdr chapter)))
				      (list
					 (xml-element 'text '()
					    (list (car chapter))))))))
		     chapters)))))))

;*---------------------------------------------------------------------*/
;*    xml-search-input ...                                             */
;*---------------------------------------------------------------------*/
(define (xml-search-input)
   (xml-element 'div '((class . "search"))
      (list
         (xml-element 'label '()
            (list "&#x1f50d;"))
         (xml-element 'input '((oninput . "search(this.value)"))
            '()))))

;*---------------------------------------------------------------------*/
;*    xml-search-results ...                                           */
;*---------------------------------------------------------------------*/
(define (xml-search-results)
   (xml-element 'div '((class . "search-results") (id . "search-results"))
      '()))

;*---------------------------------------------------------------------*/
;*    xml-toc ...                                                      */
;*---------------------------------------------------------------------*/
(define (xml-toc toc::pair-nil)
   
   (define (xml-toc-defs defs::pair-nil)
      (xml-element 'ul '((class . "defs"))
	 (map (lambda (def::XmlElement)
		 (xml-element 'li '((class . "def"))
		    (list (xml-element 'a
			     `((href . ,(string-append "#" (xml-element-attribute def 'id))))
			     (map xml-element-dup
				(xml-element-children def))))))
	    defs)))
   
   (define (xml-toc-sections toc::pair-nil)
      (xml-element 'ul '((class . "sections"))
	 (map (lambda (section::pair)
		 (let ((title::XmlElement (car section))
		       (defs (cdr section)))
		    (xml-element 'li '((class . "section"))
		       (list
			  (xml-element 'a
			     `((href . ,(string-append "#" (xml-element-attribute title 'id))))
			     (map xml-element-dup
				(xml-element-children title)))
			  (xml-toc-defs defs)))))
	    toc)))
   
   (xml-element 'div '((class . "toc"))
      (list
	 (xml-element 'nav '()
	    (list
	       (xml-toc-sections toc))))))

;*---------------------------------------------------------------------*/
;*    chapter ...                                                      */
;*---------------------------------------------------------------------*/
(define (chapter source::bstring target::bstring)

   (define (class-nodef? e)
      (let ((klass (xml-element-attribute e 'class)))
         (or (equal? klass "NoDef")
             (equal? klass "NoDef-C")
             (equal? klass "NoDef-jvm")
             (equal? klass "NoDef-wasm")
             (equal? klass "NoDef-C-jvm")
             (equal? klass "NoDef-C-wasm")
             (equal? klass "NoDef-jvm-wasm"))))
   
   (define (chapter-toc::pair-nil doc::XmlElement)
      (map (lambda (e::XmlElement)
	      (let loop ((n (xml-element-next-sibling e))
			 (defs '()))
		 (if (isa? n XmlElement)
		     (let ((n::XmlElement n))
			(if (eq? (-> n tag) 'h2)
			    (cons e (reverse! defs))
			    (if (eq? (-> n tag) 'h3)
                                (let ((d (if (class-nodef? n)
                                             (xml-element 'span `((class . ,(xml-element-attribute n 'class))
                                                                  (id . ,(xml-element-attribute n 'id)))
                                                (list (xml-element-attribute n 'id)))
                                             (xml-element-dup n)))) 
                                    (loop (xml-element-next-sibling n)
                                       (cons d defs)))
				(loop (xml-element-next-sibling n)
				   defs))))
		     (cons e (reverse! defs)))))
	 (xml-get-elements-by-tag doc 'h2)))

   (define (backends bs)
      (xml-element 'span '((class . "backends"))
         (map (lambda (b)
                 (xml-element 'span
                    `((class . ,(format "backend ~a" (car b)))
                      (title . ,(car b)))
                    (list
                       (xml-element 'a `((href . ,(format "./~a.html" (string-downcase (car b)))))
                          (cdr b)))))
            bs)))

   (define (class-backend klass)
      (if (string? klass)
          (let ((s (string-split klass #\-)))
             (backends
                (map (lambda (c) (list c (if (member c s) "&#x25cf;" "&#x25cb;")))
                   '("C" "jvm" "wasm"))))
          (backends '(("C" "&#x25cf;") ("jvm" "&#x25cf;") ("wasm" "&#x25cf;")))))

   (call-with-input-file source
      (lambda (ip)
	 (let* ((doc (markdown-parse ip
			:eval (make-doc-eval (dirname source))
			:fontifier (lambda (lang id lines)
				      (call-with-input-string (apply string-append lines)
                                         (cond
                                            ((string=? lang "bnf")
                                             fontifier.ebnf)
                                            ((string=? lang "C")
                                             fontifier.c)
                                            ((string=? lang "java")
                                             fontifier.java)
                                            ((string=? lang "wat")
                                             fontifier.wat)
                                            (else
                                             fontifier.bigloo))))))
		(index '())
		(toc (chapter-toc doc)))
            ;; test examples 
	    (for-each (lambda (e)
			 (let* ((name (string-trim-both
					 (apply string-append
					    (xml-text-element-value
					       (car (xml-element-children e))))))
                                (klass (xml-element-attribute e 'class))
                                (id (xml-element-attribute e 'id))
				(def (hashtable-get definitions-table name))
				(tests (or (hashtable-get tests-table name)
                                           (hashtable-get tests-table id))))
                            (cond
                               ((=fx (hashtable-size definitions-table) 0)
                                e)
                               ((not def)
                                (if (class-nodef? e)
                                    (let* ((pseudodef (call-with-input-string name read))
                                           (md (definition->markdown pseudodef)))
                                       (xml-element-children-set! e
                                          (cons (class-backend
                                                   (when (>fx (string-length klass) 6)
                                                      (substring klass 6)))
                                             md))
                                       (xml-element-attribute-set! e 'class (definition-class def))
                                       (if (pair? tests)
                                           (let loop ((next (xml-element-next-sibling e))
                                                      (prev e))
                                              (cond
                                                 ((or (not next)
                                                      (let ((next::XmlElement next))
                                                         (memq (-> next tag) '(h1 h2 h3 h4))))
                                                  (for-each (lambda (el)
                                                               (xml-element-append-child! prev el))
                                                     (test->markdown (reverse tests))))
                                                 (else
                                                  (loop (xml-element-next-sibling next) next))))
                                           (error "doc" "Cannot find test" name))
                                       (set! index
                                          (cons (list id pseudodef (xml-element-attribute e 'id) target)
                                             index)))
                                    (error "doc" "Cannot find definition" name)))
                               (else
                                (let ((md (definition->markdown def)))
                                   (xml-element-children-set! e (cons (class-backend klass) md))
                                   (xml-element-attribute-set! e 'class (definition-class def))
                                   (cond
                                      ((pair? tests)
                                       (let loop ((next (xml-element-next-sibling e))
                                                  (prev e))
                                          (cond
                                             ((or (not next)
                                                  (let ((next::XmlElement next))
                                                     (memq (-> next tag) '(h1 h2 h3 h4))))
                                              (for-each (lambda (el)
                                                           (xml-element-append-child! prev el))
                                                 (test->markdown (reverse tests))))
                                             (else
                                              (loop (xml-element-next-sibling next) next)))))
                                      ((or (equal? klass "NoTest")
                                           (equal? klass "NoTest-C")
                                           (equal? klass "NoTest-jvm")
                                           (equal? klass "NoTest-wasm")
                                           (equal? klass "NoTest-C-jvm")
                                           (equal? klass "NoTest-C-wasm")
                                           (equal? klass "NoTest-jvm-wasm")
                                           (equal? klass "NoTest-C-jvm-wasm"))
                                       e)
                                      (else
                                       (error "doc" "Cannot find test" name)))
                                   (set! index
                                      (cons (list name def (xml-element-attribute e 'id) target)
                                         index)))))))
	       (xml-get-elements-by-tag doc 'h3))
            ;; inline examples
            (for-each (lambda (e::XmlElement)
                         (let* ((path (xml-element-attribute e 'href))
                                (qpath (make-file-name (dirname target) path)))
                            (when (and (file-exists? qpath) (member (suffix path) '("bgl" "bgh")))
                               (xml-element-replace-child! e
                                  (xml-element 'pre '((class . "example"))
                                     (fontify (call-with-input-file qpath read-string)))))))
               (xml-get-elements-by-tag doc 'a))
	    (values doc toc index)))))
   
;*---------------------------------------------------------------------*/
;*    definition-class ...                                             */
;*---------------------------------------------------------------------*/
(define (definition-class def)
   (match-case def
      ((generic . ?-) "function generic")
      ((?- .  ?-) "function")
      (((or class absract-class final-class wide-class) . ?-) "class")
      (else "variable")))

;*---------------------------------------------------------------------*/
;*    definition->markdown ...                                         */
;*---------------------------------------------------------------------*/
(define (definition->markdown::pair def)

   (define (markdown-ident::pair sym class)
      (multiple-value-bind (id ty)
	 (parse-ident2 sym)
	 (if ty
	     (list (xml-element 'span `((class . ,class)) (list id))
		(xml-element 'span '((class . "type")) (list "::" ty)))
	     (list (xml-element 'span `((class . ,class)) (list id))))))

   (define (markdown-argument::pair arg)
      (cond
	 ((symbol? arg)
	  (markdown-ident arg "argument"))
	 ((eq? arg #!optional)
	  (list (xml-element 'span '((class . "dsssl")) (list "#!optional"))))
	 ((eq? arg #!key)
	  (list (xml-element 'span '((class . "dsssl")) (list "#!key"))))
	 ((eq? arg #!rest)
	  (list (xml-element 'span '((class . "dsssl")) (list "#!rest"))))
	 ((pair? arg)
	  `("(" ,@(markdown-ident (car arg) "argument")
	      " "
	      ,(xml-element 'span '((class . "expression")) (list (format "~s" (cadr arg))))
	      ")"))
	 (else
	  (error "definition->markdown" "Illegal argument" arg))))

   (define (markdown-arguments::pair-nil args)
      (cond
	 ((null? args)
	  '())
	 ((not (pair? args))
	  (cons " . " (markdown-argument args)))
	 (else
	  (cons " " (append (markdown-argument (car args)) (markdown-arguments (cdr args)))))))
	      
   (define (function->markdown fun args)
      `("(" ,@(markdown-ident fun "definition") ,@(markdown-arguments args) ")"))
   
   (define (generic->markdown fun args)
      `("("
          ,(xml-element 'span '((class . "generic")) (list "generic "))
          ,@(markdown-ident fun "definition") ,@(markdown-arguments args) ")"))

   (define (markdown-field field)
      (list (xml-element 'span '((class . "field"))
               (cons "\n       "
                  (match-case field
                     ((? symbol?)
                      (markdown-ident field "field"))
                     (((? symbol?))
                      (cons "(" (append (markdown-ident (car field) "field") (list ")"))))
                     (else
                      (let* ((ronly #t)
                             (f (filter (lambda (a)
                                           (match-case a
                                              ((get . ?-) #f)
                                              ((set . ?-) (set! ronly #f) #f)))
                                   (cdr field))))
                         (if (null? f)
                             (if ronly
                                 (cons "(" (append (markdown-ident (car field) "field") (list " read-only)")))
                                 (markdown-ident (car field) "field"))
                             (cons "("
                                (append (markdown-ident (car field) "field")
                                   (map (lambda (e) (format " ~s" e)) f)
                                   (list ")")))))))))))
   
   (define (class->markdown keyword clazz fields)
      (list (xml-element 'span '((class . "pre"))
               `("("
                   ,(xml-element 'span '((class . "class")) (list keyword " "))
                   ,@(markdown-ident clazz "definition")
                   ,@(map markdown-field fields)
                   ")"))))
      
   (define (variable->markdown var)
      (list (xml-element 'span '((class . "definition")) (list (symbol->string var)))))

   (match-case def
      ((generic ?fun . ?args)
       (generic->markdown fun args))
      (((or class abstract-class wide-class final-class) ?clazz . ?fields)
       (class->markdown (symbol->string (car def)) clazz fields))
      ((?fun . ?args)
       (function->markdown fun args))
      (else
       (variable->markdown def))))

;*---------------------------------------------------------------------*/
;*    fontify ...                                                      */
;*---------------------------------------------------------------------*/
(define (fontify text::bstring #!key (lang::bstring "bigloo"))
   (cond
      ((string=? lang "bigloo")
       (call-with-input-string text fontifier.bigloo))
      ((string=? lang "bnf")
       (call-with-input-string text fontifier.ebnf))
      ((string=? lang "C")
       (call-with-input-string text fontifier.c))
      ((string=? lang "java")
       (call-with-input-string text fontifier.java))
      ((string=? lang "wat")
       (call-with-input-string text fontifier.wat))
      (else
       (format "~s" text))))

;*---------------------------------------------------------------------*/
;*    test->markdown ...                                               */
;*---------------------------------------------------------------------*/
(define (test->markdown tests)
   (let ((ts (take tests max-tests)))
      (list
	 (xml-element 'h4 '((class . "example"))
	    (list (if (pair? (cdr ts)) "Examples" "Example")))
	 (xml-element 'pre '((class . "test"))
	    (append-map (lambda (t)
                           (let* ((s (format "~s" (car t)))
                                  (r (format "~s" (cdr t)))
                                  (m (if (string-suffix? "?" r) "&vdash;" "&rarr;")))
                              (if (>fx (string-length s) 100)
                                  (list
                                     (fontify (call-with-output-string
                                                 (lambda (op)
                                                   (pp (car t) op :width 100))))
                                     (xml-element 'span '((class . "result")) (list "   " m))
                                     (xml-element 'span '((class . "result-value")) (fontify r))
                                     "\n")
                                  (list
                                     (fontify s)
                                     (xml-element 'span '((class . "result")) (list m))
                                     (xml-element 'span '((class . "result-value")) (fontify r))
                                     "\n"))))
	       ts)))))

;*---------------------------------------------------------------------*/
;*    make-doc-eval ...                                                */
;*---------------------------------------------------------------------*/
(define (make-doc-eval dir)
   (lambda (x)
      (match-case x
	 ((include (and ?file (? string?)))
	  (call-with-input-file file read-string))
	 ((include (and ?file (? string?)) :line-start (and (? integer?) ?lnum))
          (apply string-append
             (list-tail (call-with-input-file file read-lines-newline) lnum)))
	 ((include (and ?file (? string?)) :tag ?tag)
          (let* ((lines (call-with-input-file file read-lines-newline))
                 (startl (format ";; tag-start ~a\n" tag))
                 (endl (format ";; tag-end ~a\n" tag))
                 (start (member startl lines)))
             (if (pair? start)
                 (let loop ((lines (cdr start))
                            (res '()))
                    (cond
                       ((null? lines)
                        (apply string-append (reverse! res)))
                       ((string=? (car lines) endl)
                        (apply string-append (reverse! res)))
                       (else
                        (loop (cdr lines) (cons (car lines) res)))))
                 (format "file or tag not found ~a" x))))
	 ((implementation-path (and ?file (? string?)))
	  (let* ((src (call-with-input-file (make-file-name dir file) port->sexp-list)))
	     (collect-definitions src)
	     ""))
	 ((example-path (and ?file (? string?)))
	  (let* ((src (call-with-input-file (make-file-name dir file) port->sexp-list)))
	     (collect-tests src)
	     ""))
         ((test ?id)
          (let ((tests (hashtable-get tests-table (symbol->string id))))
             (if (pair? tests)
                 (string-append "\n```bigloo\n"
                    (call-with-output-string
                       (lambda (op)
                          (pp (caar tests) op :width 100)))
                    (format "  &rarr; ~s" (cdar tests))
                    "\n```\n")
                 (error "doc" "Cannot find test" id))))
	 (else
	  (eval x)))))

;*---------------------------------------------------------------------*/
;*    collect-definitions ...                                          */
;*---------------------------------------------------------------------*/
(define (collect-definitions src)
   
   (define (field x)
      (match-case x
         ((? symbol?)
          (and (not (char=? (string-ref (symbol->string! x) 0) #\$))
               (not (char=? (string-ref (symbol->string! x) 0) #\%))))
         (((and ?ident (? symbol?)) . ?-)
          (and (not (char=? (string-ref (symbol->string! ident) 0) #\$))
               (not (char=? (string-ref (symbol->string! ident) 0) #\%))))
         (else
          #t)))
   
   (for-each (lambda (e)
		(match-case e
		   ((define (and ?def (?id . ?-)) . ?-)
		    (hashtable-put! definitions-table (parse-ident id) def))
		   ((define-inline (and ?def (?id . ?-)) . ?-)
		    (hashtable-put! definitions-table (parse-ident id) def))
		   ((define-generic (and ?def (?id . ?-)) . ?-)
		    (hashtable-put! definitions-table (parse-ident id) (cons 'generic def)))
		   ((define (and ?def (? symbol?)) ?-)
		    (hashtable-put! definitions-table (parse-ident def) def))
                   (((or define-class define-abstract-class define-wide-class define-final-class)
                     (and ?def (? symbol?)) . ?fields)
                    (hashtable-put! definitions-table (parse-ident def)
                       `(,(string->symbol (substring (symbol->string (car e)) 8))
                         ,def ,@(filter field fields))))
                   ((module ?- . ?clauses)
                    (for-each (lambda (clause)
                                 (match-case clause
                                    ((or (export . ?subclauses)
                                         (cond-expand (bigloo-c (export . ?subclauses)) . ?-)
                                         (cond-expand (((kwote and) ((kwote or) bigloo-c . ?-) . ?-) (export . ?subclauses)) . ?-))
                                     (for-each (lambda (subclause)
                                                  (match-case subclause
                                                     (((or class abstract-class wide-class final-class) ?def . ?fields)
                                                      (hashtable-put! definitions-table
                                                         (parse-ident def)
                                                         `(,(car subclause) ,def ,@(filter field fields))))))
                                        subclauses))))
                       clauses))
		   (else #f)))
      src))

;*---------------------------------------------------------------------*/
;*    collect-tests ...                                                */
;*---------------------------------------------------------------------*/
(define (collect-tests src)
   
   (define (hashtable-add! table key val)
      (let ((old (hashtable-get table key)))
	 (if (pair? old)
	     (hashtable-put! table key (cons val old))
	     (hashtable-put! table key (list val)))))
		
   (for-each (lambda (e)
		(match-case e
		   ((define-test ?id ?expr :cond-expand ?- :expected ?val)
		    (hashtable-add! tests-table (symbol->string id) (cons expr val)))
		   ((define-test ?id ?expr :eq ?- :expected ?val)
		    (hashtable-add! tests-table (symbol->string id) (cons expr val)))
		   ((define-test ?id ?expr :expected ?val)
		    (hashtable-add! tests-table (symbol->string id) (cons expr val)))
		   ((define-test ?id ?expr)
		    (hashtable-add! tests-table (symbol->string id) (cons expr #t)))
		   ((define-test ?id ?expr :cond-expand ?-)
		    (hashtable-add! tests-table (symbol->string id) (cons expr #t)))
		   (else
		    #f)))
      src))
	     
;*---------------------------------------------------------------------*/
;*    parse-ident ...                                                  */
;*---------------------------------------------------------------------*/
(define (parse-ident id::symbol)
   (let* ((s (symbol->string! id))
	  (l (string-length s)))
      (let loop ((i 0))
	 (cond
	    ((>=fx i (-fx l 2))
	     s)
	    ((char=? (string-ref s i) #\:)
	     (if (char=? (string-ref s (+fx i 1)) #\:)
		 (substring s 0 i)
		 (loop (+fx i 1))))
	    (else
	     (loop (+fx i 1)))))))

;*---------------------------------------------------------------------*/
;*    parse-ident2 ...                                                 */
;*---------------------------------------------------------------------*/
(define (parse-ident2 id::symbol)
   (let* ((s (symbol->string! id))
	  (l (string-length s)))
      (let loop ((i 0))
	 (cond
	    ((>=fx i (-fx l 2))
	     (values s #f))
	    ((char=? (string-ref s i) #\:)
	     (if (char=? (string-ref s (+fx i 1)) #\:)
		 (values (substring s 0 i) (substring s (+fx i 2) (string-length s)))
		 (loop (+fx i 1))))
	    (else
	     (loop (+fx i 1)))))))
