;*---------------------------------------------------------------------*/
;*    doc                                                              */
;*---------------------------------------------------------------------*/
(module doc
   (library web)
   (import "./fontifier.bgl" . fontifier)
   (main))

;*---------------------------------------------------------------------*/
;*    definitions-table ...                                            */
;*---------------------------------------------------------------------*/
(define definitions-table (create-hashtable :size 128 :weak 'open-string))
(define tests-table (create-hashtable :size 128 :weak 'open-string))

(define index '())

(define max-tests 5)

;*---------------------------------------------------------------------*/
;*    main ...                                                         */
;*---------------------------------------------------------------------*/
(define (main x)
   (call-with-input-file (cadr x)
      (lambda (ip)
	 (let ((doc (markdown-parse ip
		       :eval (make-doc-eval (dirname (cadr x)))
		       :fontifier (lambda (lang id lines)
				     (call-with-input-string (apply string-append lines)
					fontifier.lisp)))))
	    (for-each (lambda (e)
			 (let* ((name (string-trim-both (markdown-text-element-value (car (markdown-element-children e)))))
				(def (hashtable-get definitions-table name))
				(tests (hashtable-get tests-table name)))
			    (let ((md (definition->markdown def)))
			       (markdown-element-children-set! e md)
			       (markdown-element-attribute-set! e 'class (definition-class def))
			       (if (pair? tests)
				   (let loop ((next (markdown-element-next-sibling e))
					      (prev e))
				      (cond
					 ((or (not next)
					      (memq (markdown-element-tag next) '(h1 h2 h3 h4)))
					  (for-each (lambda (el)
						       (markdown-element-append-child! prev el))
					     (test->markdown (reverse tests))))
					 (else
					  (loop (markdown-element-next-sibling next) next))))
				   (error "doc" "Cannot find test" name))
			       (set! index (cons (list name def (markdown-element-attribute e 'id)) index)))))
	       (markdown-get-elements-by-tag doc 'h3))
	    (call-with-output-file "index.sexp"
	       (lambda (op)
		  (write index op)))
	    (display "<!-- GENERATED by doc.bgl -->")
	    (markdown->html doc)))))

;*---------------------------------------------------------------------*/
;*    definition-class ...                                             */
;*---------------------------------------------------------------------*/
(define (definition-class def)
   (match-case def
      ((generic . ?-) "generic")
      ((?- .  ?-) "function")
      (else "variable")))

;*---------------------------------------------------------------------*/
;*    definition->markdown ...                                         */
;*---------------------------------------------------------------------*/
(define (definition->markdown::pair def)

   (define (markdown-ident::pair sym class)
      (multiple-value-bind (id ty)
	 (parse-ident2 sym)
	 (if ty
	     (list (markdown-element 'span `((class . ,class)) (list id))
		(markdown-element 'span '((class . "type")) (list "::" ty)))
	     (list (markdown-element 'span `((class . ,class)) (list id))))))

   (define (markdown-argument::pair arg)
      (cond
	 ((symbol? arg)
	  (markdown-ident arg "argument"))
	 ((eq? arg #!optional)
	  (list (markdown-element 'span '((class . "dsssl")) (list "#!optional"))))
	 ((eq? arg #!key)
	  (list (markdown-element 'span '((class . "dsssl")) (list "#!key"))))
	 ((eq? arg #!rest)
	  (list (markdown-element 'span '((class . "dsssl")) (list "#!rest"))))
	 ((pair? arg)
	  `("(" ,@(markdown-ident (car arg) "argument")
	      " "
	      ,(markdown-element 'span '((class . "expression")) (list (format "~s" (cadr arg))))
	      ")"))
	 (else
	  (error "definition->markdown" "Illegal argument" arg))))

   (define (markdown-arguments::pair-nil args)
      (cond
	 ((null? args)
	  '())
	 ((not (pair? args))
	  (cons " . " (markdown-argument args)))
	 (else
	  (cons " " (append (markdown-argument (car args)) (markdown-arguments (cdr args)))))))
	      
   (define (function->markdown fun args)
      `("(" ,@(markdown-ident fun "definition") ,@(markdown-arguments args) ")"))
   
   (define (variable->markdown var)
      (list (markdown-element 'span '((class . "definition")) (list (symbol->string var)))))

   (match-case def
      ((?fun . ?args)
       (function->markdown fun args))
      (else
       (variable->markdown def))))

;*---------------------------------------------------------------------*/
;*    fontify ...                                                      */
;*---------------------------------------------------------------------*/
(define (fontify text::bstring #!key (lang::bstring "bgl"))
   (cond
      ((string=? lang "bgl")
       (call-with-input-string text fontifier.lisp))
      (else
       (format "~s" text))))

;*---------------------------------------------------------------------*/
;*    test->markdown ...                                               */
;*---------------------------------------------------------------------*/
(define (test->markdown tests)
   (let ((ts (take tests max-tests)))
      (list
	 (markdown-element 'h4 '((class . "example"))
	    (list (if (pair? (cdr ts)) "Examples" "Example")))
	 (markdown-element 'pre '((class . "test"))
	    (append-map (lambda (t)
			   (list
			      (fontify (format "~s" (car t)))
			      (markdown-element 'span '((class . "result")) (list "&rarr;"))
			      (fontify (format "~s" (cdr t)))
			      "\n"))
	       ts)))))

;*---------------------------------------------------------------------*/
;*    make-doc-eval ...                                                */
;*---------------------------------------------------------------------*/
(define (make-doc-eval dir)
   (lambda (x)
      (match-case x
	 ((include (and ?file (? string?)))
	  ;;(call-with-input-file (make-file-name dir file) read-string)
	  (call-with-input-file file read-string))
	 ((implementation-path (and ?file (? string?)))
	  (let* ((src (call-with-input-file (make-file-name dir file) port->sexp-list)))
	     (collect-definitions src)
	     ""))
	 ((example-path (and ?file (? string?)))
	  (let* ((src (call-with-input-file (make-file-name dir file) port->sexp-list)))
	     (collect-tests src)
	     ""))
	 (else
	  (eval x)))))

;*---------------------------------------------------------------------*/
;*    collect-definitions ...                                          */
;*---------------------------------------------------------------------*/
(define (collect-definitions src)
   (for-each (lambda (e)
		(match-case e
		   ((define (and ?def (?id . ?-)) . ?-)
		    (hashtable-put! definitions-table (parse-ident id) def))
		   ((define-inline (and ?def (?id . ?-)) . ?-)
		    (hashtable-put! definitions-table (parse-ident id) def))
		   ((define-generic (and ?def (?id . ?-)) . ?-)
		    (hashtable-put! definitions-table (parse-ident id) (cons 'generic def)))
		   ((define (and ?def (? symbol?)) ?-)
		    (hashtable-put! definitions-table (parse-ident def) def))
		   (else #f)))
      src))
	     
;*---------------------------------------------------------------------*/
;*    collect-tests ...                                                */
;*---------------------------------------------------------------------*/
(define (collect-tests src)
   
   (define (hashtable-add! table key val)
      (let ((old (hashtable-get table key)))
	 (if (pair? old)
	     (hashtable-put! table key (cons val old))
	     (hashtable-put! table key (list val)))))
		
   (for-each (lambda (e)
		(match-case e
		   ((define-test ?id ?expr :expected ?val)
		    (hashtable-add! tests-table (symbol->string id) (cons expr val)))
		   ((define-test ?id ?expr)
		    (hashtable-add! tests-table (symbol->string id) (cons expr #t)))
		   (else #f)))
      src))
	     
;*---------------------------------------------------------------------*/
;*    parse-ident ...                                                  */
;*---------------------------------------------------------------------*/
(define (parse-ident id::symbol)
   (let* ((s (symbol->string! id))
	  (l (string-length s)))
      (let loop ((i 0))
	 (cond
	    ((>=fx i (-fx l 2))
	     s)
	    ((char=? (string-ref s i) #\:)
	     (if (char=? (string-ref s (+fx i 1)) #\:)
		 (substring s 0 i)
		 (loop (+fx i 1))))
	    (else
	     (loop (+fx i 1)))))))

;*---------------------------------------------------------------------*/
;*    parse-ident2 ...                                                 */
;*---------------------------------------------------------------------*/
(define (parse-ident2 id::symbol)
   (let* ((s (symbol->string! id))
	  (l (string-length s)))
      (let loop ((i 0))
	 (cond
	    ((>=fx i (-fx l 2))
	     (values s #f))
	    ((char=? (string-ref s i) #\:)
	     (if (char=? (string-ref s (+fx i 1)) #\:)
		 (values (substring s 0 i) (substring s (+fx i 2) (string-length s)))
		 (loop (+fx i 1))))
	    (else
	     (loop (+fx i 1)))))))
