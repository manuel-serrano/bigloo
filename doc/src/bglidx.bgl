;*    Build the JSON doc index                                         */
;*=====================================================================*/

;*---------------------------------------------------------------------*/
;*    buildidx                                                         */
;*---------------------------------------------------------------------*/
(module buildidx
   (main main))

;*---------------------------------------------------------------------*/
;*    main ...                                                         */
;*---------------------------------------------------------------------*/
(define (main argv)
   (printf "[~(,)]"
      (map (lambda (a)
              (format "[~s,\"~a#~a\"]" (car a) (cadddr a) (caddr a)))
         (call-with-input-file (cadr argv) read))))
