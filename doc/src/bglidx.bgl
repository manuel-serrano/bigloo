;*    -------------------------------------------------------------    */
;*    Build the JSON doc index                                         */
;*=====================================================================*/

;*---------------------------------------------------------------------*/
;*    buildidx                                                         */
;*---------------------------------------------------------------------*/
(module buildidx
   (main main))

;*---------------------------------------------------------------------*/
;*    main ...                                                         */
;*---------------------------------------------------------------------*/
(define (main argv)
   (let ((idx (format "[~(,)]"
                 (map (lambda (a)
                         (format "[~s,'~a#~a']" (car a) (caddr a) (cadddr a)))
                    (call-with-input-file (caddr argv) read))))
         (head (call-with-input-file (cadr argv) read-string)))
      (display (pregexp-replace "@INDEXJSON@" head idx))))
