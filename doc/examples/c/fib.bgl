(module fib
   (extern "C"
      (macro printf::int (::string ::string ::long) "printf"))
   (main))

(define (main argv::pair-nil)
   (let ((arg (if (pair? (cdr argv)) (cadr argv) "30")))
      (printf "fib(%s)=%ld\n" arg (fib (string->integer arg)))))

(define (fib::long x::long)
   (if (<fx x 2)
       1
       (+fx (fib (-fx x 1)) (fib (-fx x 2)))))
