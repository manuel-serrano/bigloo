;*---------------------------------------------------------------------*/
;*    bignums                                                          */
;*---------------------------------------------------------------------*/
(module bignums
   (export test))

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "./test.bgh")

;*---------------------------------------------------------------------*/
;*    test ...                                                         */
;*---------------------------------------------------------------------*/
(define (test verbose tests::pair-nil)
   (when (or (null? tests) (member "bignum" tests))
      (test-all verbose "bignum")))

;*---------------------------------------------------------------------*/
;*    bigfactorial ...                                                 */
;*---------------------------------------------------------------------*/
(define (factorial n::bignum)
   (let loop ((n n) (f #z1))
      (if (positivebx? n)
	  (loop (-bx n #z1) (*bx f n))
	  f)))

;*---------------------------------------------------------------------*/
;*    fixbig? ...                                                      */
;*---------------------------------------------------------------------*/
(define (fixbig? n)
   (cond-expand
      (enable-gmp (fixnum? n))
      (else (or (fixnum? n) (bignum? n)))))

;*---------------------------------------------------------------------*/
;*    tests                                                            */
;*---------------------------------------------------------------------*/
(define-test bignum? (bignum? 1)
   :result #f)
(define-test bignum? (bignum? #e1)
   :result #f)
(define-test bignum? (bignum? #l1)
   :result #f)
(define-test bignum? (bignum? #z1)
   :result #t)
(define-test bignum? (bignum? "#z1")
   :result #f)

(define-test number? (number? #z1)
   :result #t)

(define-test integer? (integer? #z1)
   :result #t)

(define-test write (with-output-to-string (lambda () (write #z123457)))
   :result "#z123457")

(define-test read (with-input-from-string "#z123457" read)
   :result (+ #z123456 1))
(define-test read
   (number?
      (cadr (with-input-from-string "(i64.const 9223372036854775807)" read)))
   :result #t)

(define-test string->bignum
   (string->bignum "1000111010110000111110101111101010101" 2)
   :result #z76606824277)
(define-test string->bignum
   (string->bignum "160756243201251221" 8)
   :result #z3974619006849681)
(define-test string->bignum
   (string->bignum "7F02BC" 16)
   :result #z8323772)
(define-test string->bignum
      (string->bignum "74982374918237438749182374013432141" 10)
      :result #z74982374918237438749182374013432141)

(define-test factorial (factorial #z10)
   :result #z3628800)
(define-test factorial (factorial #z20)
   :result #z2432902008176640000)

(define-test evenbx? (even? #z5327)
   :result #f)
(define-test evenbx? (even? #z5328)
   :result #t)
(define-test evenbx? (evenbx? #z5327)
   :result #f)
(define-test evenbx? (evenbx? #z5328)
   :result #t)
(define-test evenbx? (evenbx? (string->bignum "10"))
   :result #t)
(define-test evenbx? (evenbx? (string->bignum "-10"))
   :result #t)
(define-test evenbx? (not (evenbx? (string->bignum "9")))
   :result #t)

(define-test oddbx? (odd? #z5327)
   :result #t)
(define-test oddbx? (odd? #z5328)
   :result #f)
(define-test oddbx? (oddbx? #z5327)
   :result #t)
(define-test oddbx? (oddbx? #z5328)
   :result #f)
(define-test oddbx? (oddbx? (string->bignum "17"))
   :result #t)
(define-test oddbx? (oddbx? (string->bignum "-17"))
   :result #t)
(define-test oddbx? (not (oddbx? (string->bignum "10")))
   :result #t)

(define-test bignum->string
   (let ((x 444432895893458734875837457834)) (+ 1 x))
   :result (string->bignum "444432895893458734875837457835"))
(define-test bignum->string (bignum->string (string->bignum "123"))
   :result "123")
(define-test bignum->string (bignum->string (string->bignum "-123"))
   :result "-123")

(define-test string->bignum
   (=bx (string->bignum "987654321") (string->bignum "987654321"))
   :result #t)
(define-test string->bignum
   (<bx (string->bignum "987654321") (string->bignum "987654322"))
   :result #t)
(define-test string->bignum
   (<=bx (string->bignum "987654321") (string->bignum "987654322"))
   :result #t)
(define-test string->bignum
   (>bx (string->bignum "987654321") (string->bignum "987654320"))
   :result #t)
(define-test string->bignum
   (>=bx (string->bignum "987654321") (string->bignum "987654320"))
   :result #t)

(define-test zerobx? (zerobx? (string->bignum "0"))
   :result #t)
(define-test zerobx? (not (zerobx? (string->bignum "123")))
   :result #t)

(define-test negativebx? (negativebx? (string->bignum "-123"))
   :result #t)
(define-test negativebx? (not (negativebx? (string->bignum "0")))
   :result #t)

(define-test positivebx? (positivebx? (string->bignum "123"))
   :result #t)
(define-test positivebx? (not (positivebx? (string->bignum "0")))
   :result #t)

(define-test +bx
   (=bx (string->bignum "123")
      (+bx (string->bignum "115") (string->bignum "8")))
   :result #t)
(define-test +bx
   (=bx (string->bignum "5")
      (+bx (string->bignum "-4") (string->bignum "9")))
   :result #t)
(define-test -bx
   (=bx (string->bignum "100")
      (-bx (string->bignum "115") (string->bignum "15")))
   :result #t)
(define-test -bx
   (=bx (string->bignum "-9")
      (-bx (string->bignum "11") (string->bignum "20")))
   :result #t)
(define-test -bx
   (let ((n #z-123433501646591633158596049484350423312)
         (m #z294753032762170191753873821847264131470))
      (-bx n m))
   :result #z-418186534408761824912469871331614554782)
(define-test *bx
   (=bx (string->bignum "-731")
      (*bx (string->bignum "-43") (string->bignum "17")))
   :result #t)
(define-test *bz (*bx #z10000 #z0)
   :result #z0)
(define-test *bx
   (*bx #z10000000000000000000000000000000000 #z0)
   :result #z0)
(define-test /bx
   (/bx #z1234500000000000000000000000000000000 #z1000000000000000000000000000)
   :result #z1234500000)

(define-test quotientbx
   (=bx (string->bignum "-58823")
      (quotientbx (string->bignum "1000000")
         (string->bignum "-17")))
   :result #t)
(define-test remainderbx
   (=bx (string->bignum "9")
      (remainderbx (string->bignum "1000000")
         (string->bignum "-17")))
   :result #t)
(define-test modulobx
   (=bx (string->bignum "-8")
      (modulobx (string->bignum "1000000")
         (string->bignum "-17")))
   :result #t)

(define-test maxbx
   (=bx (string->bignum "654321")
      (maxbx (string->bignum "123456")
         (string->bignum "654321")))
   :result #t)
(define-test minbx
   (=bx (string->bignum "123456")
      (minbx (string->bignum "123456")
         (string->bignum "654321")))
   :result #t)

(define-test >bx
   (>bx (string->bignum "ABCDEF" 16)
      (string->bignum "ABCDEE" 16))
   :result #t)
(define-test fixbig? (fixbig? (+ 34 (car (list 35))))
   :result #t)
(define-test fixbig? (fixbig? (+ 34 (car (list #z35))))
   :result #t)
(define-test fixbig? (fixbig? (+ #z34 (car (list #z35))))
   :result #t)
(define-test + (fixnum? (+ #z34 (car (list 35))))
   :result #t)
(define-test / (number? (/ #z2 (if (> (current-seconds) 0) 1 2)))
   :result #t)
(define-test / (number? (/ #z3 (if (> (current-seconds) 0) 2 2)))
   :result #t)

(define-test eval
   (let ((n 9999999999999))
      (bignum? (eval `(* (string->number "9999999999999") ,n))))
   :result #t)
(define-test eval
      (let ((n 9999999999999))
	 (bignum? (eval `(2* (string->number "9999999999999") ,n))))
      :result #t)

(define-test bit-notbx (bit-notbx #z5)
   :result #z-6)
(define-test bit-orbx (bit-orbx #z5 #z3)
   :result #z7)
(define-test bit-xorbx (bit-orbx #z5 #z3)
   :result #z7)
(define-test bit-andbx (bit-andbx #z5 #z3)
   :result #z1)
(define-test bit-lshbx (bit-lshbx #z5 3)
   :result #z40)
(define-test bit-rshbx (bit-rshbx #z43 3)
   :result #z5)
(define-test bit-urshbx (bit-rshbx #z200 3)
   :result #z25)

(define-test =bx (=bx #z35 (+bx #z10 #z25)))
(define-test <bx (<bx #z43 (+bx #z1330 #z25)))
(define-test <=bx (<=bx #z43 (+bx #z9810 #z-25)))
(define-test >bx (>bx #z343 (+bx #z10 #z25)))
(define-test >=bx (>=bx #z143 (+bx #z10 #z25)))

(define-test fixnum->bignum (fixnum->bignum 124) :result #z124)
(define-test fixnum->bignum (fixnum->bignum -124) :result #z-124)

(define-test elong->bignum (elong->bignum #e124) :result #z124)
(define-test elong->bignum (elong->bignum #e-124) :result #z-124)

(define-test llong->bignum (llong->bignum #l124) :result #z124)
(define-test llong->bignum (llong->bignum #l-124) :result #z-124)

(define-test absbx (absbx #z123) :result #z123)
(define-test absbx (absbx #z-123) :result #z123)

(define-test exptbx (exptbx #z2 #z32) :result #z4294967296)

(define-test remainderbx (remainderbx #z5 #z2) :result #z1)
(define-test quotientbx (quotientbx #z5 #z2) :result #z2)
(define-test quotientbx (modulobx #z5 #z2) :result #z1)

(define-test gcdbx (gcdbx #z55 #z15) :result #z5)
(define-test lcmbx (lcmbx #z55 #z15) :result #z165)

(define-test randombx (let ((n (randombx #z10))) (and (>=bx n #z0) (<bx n #z10))))
