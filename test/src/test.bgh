;*    -------------------------------------------------------------    */
;*    Testing macros                                                   */
;*=====================================================================*/

;*---------------------------------------------------------------------*/
;*    all-tests ...                                                    */
;*---------------------------------------------------------------------*/
(define all-tests '())

(define isatty (output-port-isatty? (current-output-port)))

;*---------------------------------------------------------------------*/
;*    define-test ...                                                  */
;*---------------------------------------------------------------------*/
(define-expander define-test
   (lambda (x e)
      (match-case x
         ((define-test ?id ?expr :cond-expand ?clause . ?rest)
	  `(set! all-tests
	      (cons (cons ',id
		       (lambda ()
			  (check-test ',id
			     ,(cadr (cer x))
			     ,(caddr (cer x))
			     ,(e `(cond-expand
                                     (,clause ,expr)
                                     (else #t))
                                 e)
			     ,@(map (lambda (x)
                                       (if (keyword? x)
                                           x
                                           (e `(cond-expand
                                                  (,clause ,x)
                                                  (else #t))
                                              e)))
                                  rest))))
		 all-tests)))
	 ((define-test ?id ?expr . ?rest)
	  `(set! all-tests
	      (cons (cons ',id
		       (lambda ()
			  (check-test ',id
			     ,(cadr (cer x))
			     ,(caddr (cer x))
			     ,(e expr e)
			     ,@(map (lambda (x) (e x e)) rest))))
		 all-tests)))
	 (else
	  (error "define-test" "Illegal form" x)))))

;*---------------------------------------------------------------------*/
;*    check-test ...                                                   */
;*---------------------------------------------------------------------*/
(define (check-test id fname loc provided #!key (expected #t) (eq equal?))
   (if (not (eq provided expected))
       (error/location id "test failed"
	  (format "expected: ~s, provided: ~s" expected provided)
	  fname loc)))

;*---------------------------------------------------------------------*/
;*    ~equal? ...                                                      */
;*---------------------------------------------------------------------*/
(define (~equal? x y)
   (define epsilon 0.00001)
   (if (and (flonum? x) (flonum? y))
       (or (<fl (absfl (-fl x y)) epsilon)
           (and (nanfl? x) (nanfl? y)))
       (equal? x y)))

;*---------------------------------------------------------------------*/
;*    color ...                                                        */
;*---------------------------------------------------------------------*/
(define (color col::symbol . l)
   (if isatty
       (let ((col (case col
		     ((ok) 33)
		     ((fail) 32)
		     (else 31))))
	  (format "[0m[1;~am~()[0m" col l))
       (if (and (pair? l) (null? (cdr l)))
	   (car l)
	   (format "~()" l))))

;*---------------------------------------------------------------------*/
;*    test-all ...                                                     */
;*---------------------------------------------------------------------*/
(define (test-all verbose section::bstring)
   (if verbose
       (print (color 'test section) "...")
       (display* section "..."))
   (let ((success 0)
	 (failures 0))
      (for-each (lambda (t)
		   (with-handler
		      (lambda (e)
			 (exception-notify e)
			 (when verbose (print (color 'fail "failure")))
			 (set! failures (+fx failures 1)))
		      (begin
			 (when verbose (display* "  " (car t) "..."))
			 ((cdr t))
			 (when verbose (print (color 'ok "ok")))
			 (set! success (+fx success 1)))))
	 (reverse all-tests))
      (unless verbose
	 (if (=fx failures 0)
	     (print (color 'ok "ok"))
	     (print failures (color 'fail " failed"))))
      (cons success failures)))
      
