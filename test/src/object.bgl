;*    Testing Objects and Classes                                      */
;*=====================================================================*/

;*---------------------------------------------------------------------*/
;*    object                                                           */
;*---------------------------------------------------------------------*/
(module object
   (export test))

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "./test.bgh")

;*---------------------------------------------------------------------*/
;*    class definitions                                                */
;*---------------------------------------------------------------------*/
(define-final-class Point
   (point-ctor)
   (x (default 0))
   (y (default 0)))

(define-wide-class ColorPoint::Point
   (color read-only (default 'black)))

(define-wide-class Point3d::Point
   (z (default 0) (info "the 3rd dimension")))

(define point-cnt 0)

(define (point-ctor x::Point)
   (set! point-cnt (+fx point-cnt 1))
   x)

(define-generic (class-id o)
   'obj)

(define-method (class-id o::Point)
   'Point)

(define-method (class-id o::Point3d)
   (symbol-append '|Point3d::| (call-next-method)))

;*---------------------------------------------------------------------*/
;*    test ...                                                         */
;*---------------------------------------------------------------------*/
(define (test verbose tests::pair-nil)
   (when (or (null? tests) (member "object" tests))
      (test-all verbose "object")))

;*---------------------------------------------------------------------*/
;*    tests                                                            */
;*---------------------------------------------------------------------*/
(define-test isa? (isa? #t object)
   :expected #f)

(define-test isa? (isa? (instantiate::Point) Point)
   :expected #t)

(define-test isa? (isa? (instantiate::Point) Point3d)
   :expected #f)

(define-test isa? (isa? (instantiate::Point3d) Point)
   :expected #t)

(define-test instantiate (isa? (instantiate::Point) object)
   :expected #t)

(define-test instantiate (isa? (instantiate::Point (y 100)) Point)
   :expected #t)

(define-test instantiate (isa? (instantiate::ColorPoint (y 100)) Point3d)
   :expected #f)

(define-test class-nil (isa? (class-nil Point) Point)
   :expected #t)

(define-test with-access
   (with-access::Point (instantiate::Point3d) (x) x)
   :expected 0)

(define-test with-access
   (let ((o1 (instantiate::Point (x 1) (y 3)))
         (o2 (instantiate::Point (y 3))))
      (with-access::Point o1 (x (y1 y))
         (with-access::Point o2 (y)
            (set! x (- x))
            (set! y1 (- y1 y))
            (+ x y1))))
   :expected -1)

(define-test ->
   (let ((o::Point3d (instantiate::Point3d (z 30))))
      (set! (-> o z) 20)
      (+fx (-> o x) (-> o z)))
   :expected 20)

(define-test ->
   (let ((p1::Point (instantiate::Point (x 1) (y 5)))
         (p2::Point (instantiate::Point (x 2) (y 3))))
      (set! (-> p1 x) (- (-> p1 x)))
      (set! (-> p1 y) (- (-> p1 y) (-> p2 y)))
      (-> p1 y))
   :expected 2)

(define-test co-instantiate
   (co-instantiate ((p1 (instantiate::Point
                           (x p2)
                           (y 20)))
                    (p2 (instantiate::Point
                           (x 10)
                           (y p1))))
      (with-access::Point p1 (y)
         (with-access::Point p2 (x)
            (+ x y))))
   :expected 30)

(define-test duplicate
   (let* ((p (instantiate::Point3d (z 30)))
          (p2 (duplicate::Point3d p (x 10))))
      (with-access::Point3d p2 (x y z)
         (+ x y z)))
   :expected 40)

(define-test duplicate
   (let* ((p (instantiate::Point (x 1)))
          (p2 (duplicate::Point3d p (y 10) (z 30))))
      (with-access::Point3d p2 (x y z)
         (+ x y z)))
   :expected 41)

(define-test duplicate
   (let* ((p (instantiate::Point3d (x 1)))
          (p2 (duplicate::Point p (y 10))))
      (with-access::Point p2 (x y)
         (+ x y)))
   :expected 11)

(define-test ctor
   (>fx point-cnt 5)
   :expected #t)

(define-test generic (class-id 1)
   :expected 'obj)

(define-test method (class-id (instantiate::Point))
   :expected 'Point)

(define-test call-next-method (class-id (instantiate::Point3d))
   :expected 'Point3d::Point)

(define-test widen (isa? (widen!::Point3d (instantiate::Point)) Point3d)
   :expected #t)

(define-test widen!
   (let ((o::Point3d (widen!::Point3d (instantiate::Point (x 100)) (z 45))))
      (+ (-> o x) (-> o z)))
   :expected 145)

(define-test widen! (isa? (widen!::ColorPoint (instantiate::Point)) Point3d)
   :expected #f)

(define-test widen!
   (let ((o::ColorPoint (widen!::ColorPoint (instantiate::Point))))
      (-> o color))
   :expected 'black)

(define-test widen!
   (let* ((o (instantiate::Point))
          (p (widen!::Point3d o)))
      (eq? o p))
   :expected #t)

(define-test shrink! (isa? (shrink! (widen!::Point3d (instantiate::Point))) Point3d)
   :expected #f)

(define-test find-class (find-class 'Point3d)
   :expected Point3d)

(define-test class? (class? Point3d)
   :expected #t)

(define-test class? (class? 'Point3d)
   :expected #f)

(define-test class-super (class-super Point3d)
   :expected Point)

(define-test class-super (class-super (find-class 'object))
   :expected #f)

(define-test class-subclasses (every class? (class-subclasses (find-class 'object)))
   :expected #t)

(define-test class-name (class-name Point)
   :expected 'Point)

(define-test class-constructor (procedure? (class-constructor Point))
   :expected #t)

(define-test class-constructor (procedure? (class-constructor object))
   :expected #f)

(define-test object-class (object-class (instantiate::Point))
   :expected Point)

(define-test object-equal?
   (let ((o (instantiate::Point))
         (p (instantiate::Point)))
      (equal? o p))
   :expected #t)

(define-test object-equal?
   (let ((o (instantiate::Point))
         (p (instantiate::Point3d)))
      (equal? o p))
   :expected #f)

(define-test object-hashnumber
   (fixnum? (object-hashnumber (instantiate::Point)))
   :expected #t)

(define-test class-all-fields
   (>fx (vector-length (class-all-fields Point3d)) (vector-length (class-all-fields Point)))
   :expected #t)

(define-test find-class-field
   (class-field? (find-class-field Point 'x))
   :expected #t)

(define-test find-class-field
   (class-field? (find-class-field Point 'does-not-exist))
   :expected #f)

(define-test class-field? (class-field? 1)
   :expected #f)

(define-test class-field? (class-field? (vector-ref (class-fields Point) 0))
   :expected #t)

(define-test class-fields
   (every class-field? (vector->list (class-fields Point)))
   :expected #t)

(define-test class-field-name (class-field-name (find-class-field Point 'x))
   :expected 'x)

(define-test class-field-accessor
   (let* ((o (instantiate::Point (x 34)))
          (f (find-class-field Point 'x)))
      ((class-field-accessor f) o))
   :expected 34)

(define-test class-field-mutable?
   (class-field-mutable? (find-class-field Point 'x))
   :expected #t)

(define-test class-field-mutable?
   (class-field-mutable? (find-class-field ColorPoint 'color))
   :expected #f)

(define-test class-field-mutator
   (let* ((o (instantiate::Point (x 34)))
          (f (find-class-field Point 'x)))
      ((class-field-mutator f) o 55)
      (with-access::Point o (x) x))
   :expected 55)

(define-test class-field-info
   (class-field-info (find-class-field Point3d 'z))
   :expected "the 3rd dimension")

