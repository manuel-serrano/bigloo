;*---------------------------------------------------------------------*/
;*    bigloo                                                           */
;*---------------------------------------------------------------------*/
(module bigloo
   (export test))

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "./test.bgh")

;*---------------------------------------------------------------------*/
;*    test ...                                                         */
;*---------------------------------------------------------------------*/
(define (test verbose tests::pair-nil)
   (when (or (null? tests) (member "bigloo" tests))
      (test-all verbose "bigloo")))

;*---------------------------------------------------------------------*/
;*    configuration                                                    */
;*---------------------------------------------------------------------*/
(define-test bigloo-configuration
   (bigloo-configuration)
   :result list?)

(define-test bigloo-config
   (bigloo-config 'version)
   :result string?)

(define-test bigloo-config
   (string>=? (bigloo-config 'version) "5.0.0"))

(define-test bigloo-config
   (bigloo-config)
   :result list?)

;*---------------------------------------------------------------------*/
;*    mangling                                                         */
;*---------------------------------------------------------------------*/
(define-test bigloo-mangle
   (bigloo-mangle "fib")
   :result "BgL_fibz00")

(define-test bigloo-mangle
   (bigloo-mangle "string->number")
   :result "BgL_stringzd2ze3numberz31")

(define-test bigloo-module-mangle
   (bigloo-module-mangle "fib" "mod")
   :result "BGl_fibz00zzmodz00")

(define-test bigloo-module-mangle
   (bigloo-module-mangle "string->number" "lib")
   :result "BGl_stringzd2ze3numberz31zzlibz00")

(define-test bigloo-mangled?
   (bigloo-mangled? "BgL_fibz00"))

(define-test bigloo-mangled?
   (bigloo-mangled? "BGl_fibz00zzmodz00"))

(define-test bigloo-mangled?
   (bigloo-mangled? "BGl_fibz00zzmodz")
   :result #f)

(define-test bigloo-demangle
   (bigloo-demangle "BgL_fibz00")
   :result "fib")
   
(define-test bigloo-demangle
   (bind-values (id mod)
      (bigloo-demangle "BGl_stringzd2ze3numberz31zzlibz00")
      (cons id mod))
   :result '("string->number" . "lib"))

(define-test bigloo-need-mangling?
   (bigloo-need-mangling? "fib")
   :result #f)

(define-test bigloo-need-mangling?
   (bigloo-need-mangling? "integer?")
   :result #t)

(define-test bigloo-class-mangled?
   (bigloo-class-mangled? (bigloo-mangle "Point"))
   :result #f)

(define-test bigloo-class-mangled?
   (bigloo-class-mangled? (string-append (bigloo-mangle "Point") "_bglt")))

(define-test bigloo-class-demangle
   (bigloo-class-demangle (string-append (bigloo-mangle "Point") "_bglt"))
   :result "Point_bglt")

;*---------------------------------------------------------------------*/
;*    procedure                                                        */
;*---------------------------------------------------------------------*/
(define-test procedure-arity (procedure-arity +fx)
   :result 2)

(define-test procedure-arity (procedure-arity list)
   :result -1)

(define-test procedure-arity (procedure-arity (lambda (a . b) a))
   :result -2)

(define-test procedure-correct-arity? (procedure-correct-arity? +fx 2)
   :result #t)

(define-test procedure-correct-arity? (procedure-correct-arity? +fx 3)
   :result #f)
   
(define-test procedure-correct-arity? (procedure-correct-arity? list 0)
   :result #t)
   
(define-test procedure-correct-arity? (procedure-correct-arity? list 5)
   :result #t)
   
(define-test procedure-correct-arity? (procedure-correct-arity? (lambda (a . b) a) 0)
   :result #f)
