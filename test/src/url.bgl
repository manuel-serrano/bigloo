;*---------------------------------------------------------------------*/
;*    urls                                                             */
;*---------------------------------------------------------------------*/
(module urls
   (export test))

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "./test.bgh")

;*---------------------------------------------------------------------*/
;*    test ...                                                         */
;*---------------------------------------------------------------------*/
(define (test verbose tests::pair-nil)
   (when (or (null? tests) (member "url" tests))
      (test-all verbose "url")))

