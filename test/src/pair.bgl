;*---------------------------------------------------------------------*/
;*    pair                                                             */
;*---------------------------------------------------------------------*/
(module pair
   (export test))

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "./test.bgh")

;*---------------------------------------------------------------------*/
;*    test ...                                                         */
;*---------------------------------------------------------------------*/
(define (test verbose tests::pair-nil)
   (when (or (null? tests) (member "pair" tests))
      (test-all verbose "pair")))

;*---------------------------------------------------------------------*/
;*    tests ...                                                        */
;*---------------------------------------------------------------------*/
(define-test cons (cons 1 2)
   :result '(1 . 2))
(define-test cons (cons 1 (cons 2 '()))
   :result '(1 2))

(define-test econs (econs 1 2 3)
   :result '(1 . 2))
(define-test econs (cer (econs 1 2 3))
   :result '3)
(define-test econs (pair? (econs 1 2 3))
   :result #t)
(define-test econs (epair? (cons 1 2))
   :result #f)

(define-test null? (null? (cons 1 2))
   :result #f)
(define-test null? (null? (list))
   :result #t)
(define-test null? (null? '#())
   :result #f)

(define-test pair? (pair? '(1 2)))
(define-test pair? (pair? (econs 1 2 3)))
(define-test pair? (pair? '())
   :result #f)

(define-test pair-or-null? (pair-or-null? (cons 1 2))
   :result #t)
(define-test pair-or-null? (pair-or-null? '(1 2))
   :result #t)
(define-test pair-or-null? (pair-or-null? '())
   :result #t)
(define-test pair-or-null? (pair-or-null? '#())
   :result #f)

(define-test car (car (list 1 2 3))
   :result 1)
(define-test cdr (cdr (list 1 2 3))
   :result '(2 3))
(define-test set-car! (let ((x (cons 1 2))) (set-car! x 0) x)
   :result (cons 0 2))
(define-test set-cdr! (let ((x (cons 1 2))) (set-cdr! x 0) x)
   :result (cons 1 0))
(define-test epair? (epair? (econs 1 2 3))
   :result #t)
(define-test epair? (epair? (cons 2 3))
   :result #f)
(define-test epair? (pair? (econs 1 2 3))
   :result #t)
(define-test cer (cer (econs 1 2 3))
   :result 3)
(define-test set-cer! (let ((p (econs 1 2 3)))
			 (set-cer! p 4)
			 (cer p))
   :result 4)

(define-test caar (caar '((1) 2))
   :result 1)
(define-test cadr (cadr '((1) 2))
   :result 2)
(define-test cadar (cadr '((1) 2))
   :result 2)
(define-test caadr (caadr '(((1)) (2)))
   :result 2)
(define-test caaar (caaar '(((1)) (2)))
   :result 1)
(define-test caddr (caddr '(1 2 3))
   :result 3)
(define-test cdddar (cddar '((1 2 3 4)))
   :result '(3 4))
(define-test cddddr (cddddr '(1 2 3 4 5 6))
   :result '(5 6))

(define-test last-pair (last-pair '(1 2 3))
   :result '(3))

(define-test epair (car (econs 1 2 3))
   :result 1)
(define-test epair (cdr (econs 1 2 3))
   :result 2)
(define-test map (map (lambda (x) (+ 1 x)) '(1 2 3))
   :result '(2 3 4))
(define-test map (map cons '(1 2 3) '(4 5 6))
   :result '((1 . 4) (2 . 5) (3 . 6)))
(define-test map (map list '(1 2 3) '(4 5 6))
   :result '((1 4) (2 5) (3 6)))
(define-test map (map (lambda (a b) (list a b)) '(1 2 3) '(4 5 6))
   :result '((1 4) (2 5) (3 6)))
(define-test map (map (lambda (a b c) (list a b c)) '(1 2 3) '(4 5 6) '(7 8 9))
   :result '((1 4 7) (2 5 8) (3 6 9)))
(define-test map (map (lambda (x) x) '())
   :result '())
(define-test map (map car '())
   :result '())
(define-test map (map car '((1)))
   :result '(1))
(define-test append-map (append-map (lambda (x) (list x (- x))) '(1 3 8))
   :result '(1 -1 3 -3 8 -8))
(define-test append-map! (append-map! (lambda (x) (list x (- x))) '(1 3 8))
   :result '(1 -1 3 -3 8 -8))
(define-test for-each (begin (for-each (lambda (x) x) '()) #t)
   :result #t) 
(define-test for-each (let ((v 0))
		       (for-each (lambda (x) (set! v (+ x v)))
				 '(1 2 3))
		       v)
   :result 6)
(define-test for-each (let ((v 0))
		       (for-each (lambda (x y) (set! v (+ y x v)))
				 '(1 2 3) '(4 5 6))
		       v)
   :result 21)
(define-test for-each (let ((v 0))
		       (for-each (lambda (x y z) (set! v (+ y x v z)))
				 '(1 2 3) '(4 5 6) '(7 8 9))
		       v)
   :result 45)
(define-test filter (filter number? '(1 2 #\a "foo" foo 3))
   :result '(1 2 3))
(define-test filter! (let ((l (list 1 2 #\a "foo" 'foo 3)))
			(set! l (filter! number? l))
			l)
   :result '(1 2 3))
(define-test any (any number? '(1 2 3 4 5 6))
   :result #t)
(define-test any (any number? '(toto 1 2 3 4 5 6))
   :result #t)
(define-test any (any number? '(toto 1 2 3 4 5 6 tutu))
   :result #t)
(define-test any (any number? '(toto tutu))
   :result #f)
(define-test any (any > '(1 2 3 4) '(5 6 7 8))
   :result #f)
(define-test any (any > '(1 2 3 4) '(5 0 7 8))
   :result #t)
(define-test every (every number? '(1 2 3 4 5 6))
   :result #t)
(define-test every (every number? '(toto 1 2 3 4 5 6))
   :result #f)
(define-test every (every number? '(toto 1 2 3 4 5 6 tutu))
   :result #f)
(define-test every (every number? '(toto tutu))
   :result #f)
(define-test every (every > '(1 2 3 4) '(5 6 7 8))
   :result #f)
(define-test every (every > '(5 6 7 8) '(1 2 3 4))
   :result #t)
(define-test reverse (reverse '(1 2 3 4))
   :result '(4 3 2 1))
(define-test reverse! (reverse! (list 1 2 3 4))
   :result '(4 3 2 1))
(define-test list-tail (list-tail '(1 2 3 4) 2)
   :result '(3 4))
(define-test list-ref (list-ref '(1 2 (3 4) 5) 2)
   :result '(3 4))
(define-test assoc (assoc 1 '((2 3) (4 5)))
   :result #f)
(define-test equal (equal? '(1 2 (3 4 (5) (6 7)) (5 6) "titi"
			     #(1 2 (6 #(6 7)) titi) tutu)
			 '(1 2 (3 4 (5) (6 7)) (5 6) "titi"
			     #(1 2 (6 #(6 7)) titi) tutu))
   :result #t)
(define-test equal (equal? '(1 2 (3 4 (5) (6 7)) (5 6) "titi"
			     #(1 2 (6 #(6 7)) titi) tutu)
			 '(1 2 (3 4 (5) (6 7)) (5 6) "titi"
			     #(1 2 (6 #(6 7)) toto) tutu))
   :result #f)
(define-test member (member '(1 2 3) '((0 1 2) (1 2 3) (4 5 6)))
   :result '((1 2 3) (4 5 6)))
(define-test length (length '(1 2 3))
   :result 3)
(define-test append (append '(1 2 (3 4)) '((5 6) 7))
   :result '(1 2 (3 4) (5 6) 7))
(define-test append (append '(a b) '(c . d))
   :result '(a b c . d))
(define-test append (append '() 'a)
   :result  'a)
(define-test eappend (eappend (econs 1 '() 3) '((5 6) 7))
   :result '(1 (5 6) 7))
(define-test append! (let ((l (list 1 2 '(3 4)))) (append! l '((5 6) 7)) l)
   :result '(1 2 (3 4) (5 6) 7))
(define-test list (list 1 2 3)
   :result '(1 2 3))
(define-test list? (list? '(1 2 . 4))
   :result #f)
(define-test list? (list? '(1 2 3 4))
   :result #t)
(define-test list? (list? '())
   :result #t)
(define-test remv (let ((x '(1 2 3 4))) (remv 2 x))
   :result '(1 3 4))
(define-test remq! (let ((x (list 1 2 3 4))) (remv! 2 x) x)
   :result '(1 3 4))
(define-test delete (let ((x '(1 2 (3 4) 5))) (delete '(3 4) x))
   :result '(1 2 5))
(define-test delete! (let ((x (list 1 2 (list 3 4) 5))) (delete! '(3 4) x) x)
   :result '(1 2 5))
(define-test memv (memv 3 '(1 2 3 4 5))
   :result '(3 4 5))
(define-test memq (memq #\a '(1 2 3 4 5))
   :result #f)
(define-test member (member '(2 3) '((1 2) (2 3) (3 4) (4 5)))
   :result '((2 3) (3 4) (4 5)))
(define-test cons* (cons* 1 0)
   :result '(1 . 0))
(define-test cons* (cons* 'a)
   :result 'a)
(define-test cons* (cons* (cons* (quote x) 0 (quote ())) (quote ()))
   :result '((x 0)))
(define-test make-list (make-list 2)
   :result '(#unspecified #unspecified))
(define-test make-list (make-list 10 4)
   :result '(4 4 4 4 4 4 4 4 4 4))
(define-test list-tabulate (list-tabulate 4 values)
   :result '(0 1 2 3))
(define-test iota (iota 5)
   :result '(0 1 2 3 4))
(define-test iota (iota 5 0 -1.)
   :result '(0. -1. -2. -3. -4.))
(define-test delete-duplicates (delete-duplicates '(a b a c a b c z))
   :result '(a b c z))
(define-test delete-duplicates
   (delete-duplicates '((a . 3) (b . 7) (a . 9) (c . 1))
      (lambda (x y) (eq? (car x) (car y))))
   :result '((a . 3) (b . 7) (c . 1)))
(define-test delete-duplicates! 
   (delete-duplicates! (list '(a . 3) '(b . 7) '(a . 9) '(c . 1))
      (lambda (x y) (eq? (car x) (car y))))
   :result '((a . 3) (b . 7) (c . 1)))

(define-test find (find (lambda (x) (> x 3)) '(1 3 4 5))
   :result 4)
(define-test find (find (lambda (x) (> x 3)) '(-1 -2))
   :result #f)
(define-test find (find (lambda (x) (> x 3)) '())
   :result #f)

(define-test find-tail (find-tail (lambda (x) (> x 3)) '(1 3 4 5))
   :result '(4 5))
(define-test find-tail (find-tail (lambda (x) (> x 3)) '(-1 -2))
   :result #f)
(define-test find-tail (find-tail (lambda (x) (> x 3)) '())
   :result #f)

(define-test take (take '(1 2 3 4) 3)
   :result '(1 2 3))
(define-test drop (drop '(1 2 3 4) 2)
   :result '(3 4))
(define-test drop-last (drop-last '(1 2 3 4) 2)
   :result '(1 2))
(define-test drop-last (drop-last '(1 2 3 4) 0)
   :result '(1 2 3 4))
(define-test drop-last (drop-last '(1 2 3 4) 5)
   :result '())

(define-test assq (assq 'b '((a . 0) (b . 1) (c . 2)))
   :result '(b . 1))
(define-test assq (assq 'z '((a . 0) (b . 1) (c . 2)))
   :result #f)

(define-test assv (assv '1 '((0 . 0) (1 . 1) (2 . 2)))
   :result '(1 . 1))
(define-test assv (assv '9 '((0 . 0) (1 . 1) (2 . 2)))
   :result #f)

(define-test remq (remq 'b '(a b c))
   :result '(a c))
(define-test remq (remq 'd '(a b c))
   :result '(a b c))

(define-test remv (remv '1 '(0 1 2))
   :result '(0 2))
(define-test remq (remv '3 '(0 1 2))
   :result '(0 1 2))

(define-test remq! (let ((l (list 'a 'b 'c))) (remq! 'b l) l)
   :result '(a c))
(define-test remq! (let ((l (list 'a 'b 'c))) (remq! 'z l) l)
   :result '(a b c))

(define-test remv! (let ((l (list 0 1 2))) (remv! '1 l) l)
   :result '(0 2))
(define-test remv! (let ((l (list 0 1 2))) (remv! '0 l) l)
   :result '(0 1 2))

(define-test reduce (reduce + 0 '())
   :result 0)
(define-test reduce (reduce + 0 '(1))
   :result 1)
(define-test reduce (reduce + 0 '(1 2 3))
   :result (+ 1 2 3))

(define-test list-split (list-split '(1 2 3 4 5 6) 2)
   :result '((1 2) (3 4) (5 6)))
(define-test list-split (list-split '(1 2 3 4 5 6 7) 3 8)
   :result '((1 2 3) (4 5 6) (7 8 8)))

(define-test list-copy (list-copy '(1 2 3))
   :result (list 1 2 3))
(define-test list-copy (list-copy '())
   :result (list))

(define-test tree-copy (tree-copy '(1 (2) 3))
   :result '(1 (2) 3))
(define-test tree-copy (tree-copy '(((4))))
   :result '(((4))))
(define-test tree-copy (tree-copy '())
   :result '())

(define-test sort
   (let ((l '(("foo" 5) ("bar" 6) ("hux" 1) ("gee" 4))))
      (sort (lambda (x y) (string<? (car x) (car y))) l))
   :result '(("bar" 6) ("foo" 5) ("gee" 4) ("hux" 1)))

(define-test filter
   (filter (lambda (x) (> x 2)) '(1 2 0))
   :result '())
(define-test filter
   (filter (lambda (x) (> x 2)) '(1 2 0 3))
   :result '(3))
(define-test filter
   (filter (lambda (x) (> x 2)) '(10 1 2 0 3))
   :result '(10 3))
(define-test filter
   (filter (lambda (x) (> x 2)) '(10 11 1 2 0 3))
   :result '(10 11 3))
(define-test filter
   (filter (lambda (x) (> x 2)) '(10 11 1 2 0 3 22))
   :result '(10 11 3 22))
(define-test filter
   (filter (lambda (x) (> x 2)) '(1 2 0 3 22))
   :result '(3 22))
(define-test filter
   (filter (lambda (x) (> x 2)) '(1 2 0 3 22 23))
   :result '(3 22 23))
(define-test filter
   (filter (lambda (x) (> x 2)) '(22 23))
   :result '(22 23))
(define-test filter
   (filter (lambda (x) (> x 2)) '(22))
   :result '(22))

(define-test filter
   ((car (list filter)) (lambda (x) (> x 2)) '(1 2 0))
   :result '())
(define-test filter
   ((car (list filter)) (lambda (x) (> x 2)) '(1 2 0 3))
   :result '(3))
(define-test filter
   ((car (list filter)) (lambda (x) (> x 2)) '(10 1 2 0 3))
   :result '(10 3))
(define-test filter
   ((car (list filter)) (lambda (x) (> x 2)) '(10 11 1 2 0 3))
   :result '(10 11 3))
(define-test filter
   ((car (list filter)) (lambda (x) (> x 2)) '(10 11 1 2 0 3 22))
   :result '(10 11 3 22))
(define-test filter
   ((car (list filter)) (lambda (x) (> x 2)) '(1 2 0 3 22))
   :result '(3 22))
(define-test filter
   ((car (list filter)) (lambda (x) (> x 2)) '(1 2 0 3 22 23))
   :result '(3 22 23))
(define-test filter
   ((car (list filter)) (lambda (x) (> x 2)) '(22 23))
   :result '(22 23))
(define-test filter
   ((car (list filter)) (lambda (x) (> x 2)) '(22))
   :result '(22))

(define-test filter
   (filter number? '(1 2 #\a "foo" foo 3))
   :result '(1 2 3))

(define-test map
   (map (lambda (x) (+ 1 x)) '(1 2 3))
   :result '(2 3 4))
(define-test map (map cons '(1 2 3) '(4 5 6))
   :result '((1 . 4) (2 . 5) (3 . 6)))
(define-test map (map list '(1 2 3) '(4 5 6))
   :result '((1 4) (2 5) (3 6)))
(define-test map (map (lambda (a b) (list a b)) '(1 2 3) '(4 5 6))
   :result '((1 4) (2 5) (3 6)))
(define-test map (map (lambda (a b c) (list a b c)) '(1 2 3) '(4 5 6) '(7 8 9))
   :result '((1 4 7) (2 5 8) (3 6 9)))
(define-test map (map (lambda (x) x) '())
   :result '())
(define-test map (map car '())
   :result '())
(define-test map (map car '((1)))
   :result '(1))

(define-test map!
   (let ((l (list 1 2 3)))
      (and (eq? (map! (lambda (x) (+ 1 x)) l) l) l))
   :result '(2 3 4))

(define-test append-map
   (append-map (lambda (x) (list x (- x))) '(1 3 8))
   :result '(1 -1 3 -3 8 -8))

(define-test filter-map
   (filter-map (lambda (x) (when (> x 2) (- x))) '(1 3 0 8 -1))
   :result '(-3 -8))
(define-test filter-map
   (filter-map (lambda (x) (if (number? x) '- #f)) '(1 2 #\a "foo" foo 3))
   :result '(- - -))

(define-test append-map!
   (append-map! (lambda (x) (list x (- x))) '(1 3 8))
   :result '(1 -1 3 -3 8 -8))

(define-test for-each (begin (for-each (lambda (x) x) '()) #t)
   :result #t) 
(define-test for-each
   (let ((v 0))
      (for-each (lambda (x) (set! v (+ x v)))
         '(1 2 3))
      v)
   :result 6)
(define-test for-each
   (let ((v 0))
      (for-each (lambda (x y) (set! v (+ y x v)))
         '(1 2 3) '(4 5 6))
      v)
   :result 21)
(define-test for-each
   (let ((v 0))
      (for-each (lambda (x y z) (set! v (+ y x v z)))
         '(1 2 3) '(4 5 6) '(7 8 9))
      v)
   :result 45)

 
