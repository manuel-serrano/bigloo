;*    -------------------------------------------------------------    */
;*    Testing boolean and equivalence functions                        */
;*=====================================================================*/

;*---------------------------------------------------------------------*/
;*    booleans                                                         */
;*---------------------------------------------------------------------*/
(module booleans
   (export test))

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "./test.bgh")

;*---------------------------------------------------------------------*/
;*    test ...                                                         */
;*---------------------------------------------------------------------*/
(define (test verbose tests::pair-nil)
   (when (or (null? tests) (member "boolean" tests))
      (test-all verbose "boolean")))

(define-test boolean? (boolean? #f)
   :result #t)

(define-test boolean? (boolean? 0)
   :result #f)

(define-test boolean? (boolean? '())
   :result #f)

(define-test not (not #t)
   :result #f)

(define-test not (not 3)
   :result #f)

(define-test not (not #f)
   :result #t)

(define-test not (not (list 3))
   :result #f)

(define-test not (not '())
   :result #f)

(define-test not (not (list))
   :result #f)

(define-test eq? (eq? 'a 'a)
   :result #t)

(define-test eq? (eq? (list 'a) (list 'a))
   :result #f)

(define-test eq? (eq? '() '())
   :result #t)

(define-test eq? (eq? car car)
   :result #t)

(define-test eq? (let ((x '(a))) (eq? x x))
   :result #t)

(define-test eq? (let ((x '#())) (eq? x x))
   :result #t)

(define-test eq? (let ((p (lambda (x) x))) (eq? p p))
   :result #t)

(define-test eqv? (eqv? 'a 'a)
   :result #t)

(define-test eqv? (eqv? 2 2)
   :result #t)

(define-test eqv? (eqv? (cons 1 2) (cons 1 2))
   :result #f)

(define-test eqv? (eqv? '() '())
   :result #t)

(define-test eqv? (eqv? 100000000 100000000)
   :result #t)

(define-test eqv? (eqv? (lambda () 1) (lambda () 2))
   :result #f)

(define-test eqv? (eqv? #f '())
   :result #f)

(define-test eqv? (eqv? #l-519994705 -519994705))

(define-test eqv? (eqv? #e-519994705 -519994705))

(define-test eqv? (eqv? #l-519994705 #z-519994705))

(define-test eqv? (eqv? #e-519994705 #z-519994705))

(define-test equal? (equal? '(a) '(a))
   :result #t)

(define-test equal? (equal? '(a (b) c) '(a (b) c))
   :result #t)

(define-test equal? (equal? "abc" "abc")
   :result #t)

(define-test equal? (equal? 'a 'a)
   :result #t)

(define-test equal? (equal? '2 '2)
   :result #t)

(define-test equal? (equal? (make-vector 5 'a) (make-vector 5 'a))
   :result #t)

(define-test equal? (equal? #l-519994705 -519994705))

(define-test equal? (equal? #e-519994705 -519994705))

(define-test equal? (equal? #l-519994705 #z-519994705))

(define-test equal? (equal? #e-519994705 #z-519994705))

(define-test equal? (equal? #z3201054679788660373 #l3201054679788660373))

