;*---------------------------------------------------------------------*/
;*    sqlite0                                                          */
;*---------------------------------------------------------------------*/
(module sqlite0
   (library sqlite)
   (export test))

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "./test.bgh")

;*---------------------------------------------------------------------*/
;*    test ...                                                         */
;*---------------------------------------------------------------------*/
(define (test verbose tests::pair-nil)
   (when (or (null? tests) (member "sqlite" tests))
      (test-all verbose "sqlite")))

;*---------------------------------------------------------------------*/
;*    tests                                                            */
;*---------------------------------------------------------------------*/
(define-test cond-expand
   (cond-expand
      (sqlite #t)
      (sqltiny #t)
      (else #f))
   :expected #t)

;*---------------------------------------------------------------------*/
;*    tests                                                            */
;*---------------------------------------------------------------------*/
(define-test sqltiny
   (isa? (instantiate::sqltiny) sqltiny))

(define-test sqlite
   (isa? (instantiate::sqlite) sqlite)
   :cond-expand sqlite)

(define-test sqlite
   (let ((path (make-file-name (os-tmp) "test.db")))
      (when (file-exists? path) (delete-file path))
      (let ((db (instantiate::sqlite (path path))))
         (unwind-protect
            (isa? db sqlite)
            (delete-file path))))
   :cond-expand sqlite)

(define-test sqlite-close
   (let ((db (instantiate::sqlite)))
      (sqlite-exec db "CREATE TABLE table1 (x INTEGER, y INTEGER)")
      (sqlite-exec db "INSERT INTO table1 VALUES(~a, ~a)" 1 4)
      (sqlite-close db))
   :cond-expand sqlite
   :expected #unspecified)

(define-test close
   (let ((db (instantiate::sqltiny)))
      (sqlite-close db))
   :expected #unspecified)

(define-test sqlite-format
   (sqlite-format "~a" "foo'bar")
   :expected "foo'bar")

(define-test sqlite-format
   (sqlite-format "~q" "foo'bar")
   :expected "'foo''bar'")

(define-test sqlite-format
   (sqlite-format "~a" '("foo'bar" "foo"))
   :expected "(foo'bar foo)")

(define-test sqlite-format 
   (sqlite-format "~k" '("foo'bar" "foo"))
   :expected "'foo''bar','foo'")

(define-test sqlite-format
   (sqlite-format "~l" '("foo'bar" "foo"))
   :expected "foo'bar,foo")

(define-test sqltiny-exec
   (let ((db (instantiate::sqltiny)))
      (sqlite-exec db "CREATE TABLE foo (x INTEGER, y INTEGER)")
      (for-each (lambda (x)
                   (sqlite-exec db  "INSERT INTO foo VALUES(~A, ~A)" x (* x x)))
         (iota 5 2))
      (sqlite-exec db "SELECT * FROM foo"))
   :expected "2")

(define-test sqlite-exec
   (let ((db (instantiate::sqlite)))
      (sqlite-exec db "CREATE TABLE foo (x INTEGER, y INTEGER)")
      (for-each (lambda (x)
                   (sqlite-exec db  "INSERT INTO foo VALUES(~A, ~A)" x (* x x)))
         (iota 5 2))
      (sqlite-exec db "SELECT * FROM foo"))
   :cond-expand sqlite
   :expected "2")

'(define-test sqltiny-eval
   (let ((db (instantiate::sqltiny)))
      (sqlite-exec db "create table assoc1 (k1,v1); create table assoc2 (k2,v2);")
      (let loop ((i 10))
	 (when (>fx i 0)
	    (sqlite-exec db "insert into assoc1 values (~a, ~a); insert into assoc2 values (~a, ~a)"
			 i (+fx i 1) i (+fx i 1))
	    (loop (-fx i 1))))
      (sqlite-eval db
	 (lambda (x) x)
	 "select MAX(k1)
           from assoc1
           where k1 < (select MIN(v2) from assoc2 where k2 > k1)"))
   :expected "9")

(define-test sqlite-eval
   (let ((db (instantiate::sqlite)))
      (sqlite-exec db "create table assoc1 (k1,v1); create table assoc2 (k2,v2);")
      (let loop ((i 10))
	 (when (>fx i 0)
	    (sqlite-exec db "insert into assoc1 values (~a, ~a); insert into assoc2 values (~a, ~a)"
			 i (+fx i 1) i (+fx i 1))
	    (loop (-fx i 1))))
      (sqlite-eval db
            (lambda (x) x)
	 "select MAX(k1) from assoc1 where k1 < (select MIN(v2) from assoc2 where k2 > k1)"))
   :cond-expand sqlite
   :expected "9")

'(define-test sqltiny-get
   (let ((db (instantiate::sqltiny)))
      (sqlite-exec db "create table assoc1 (k1,v1); create table assoc2 (k2,v2);")
      (let loop ((i 10))
	 (when (>fx i 0)
	    (sqlite-exec db "insert into assoc1 values (~a, ~a); insert into assoc2 values (~a, ~a)"
			 i (+fx i 1) i (+fx i 1))
	    (loop (-fx i 1))))
      (sqlite-get db cons
	 "select MAX(k1) from assoc1 where k1 < (select MIN(v2) from assoc2 where k2 > k1)"))
   :expected "9")

(define-test sqlite-get
   (let ((db (instantiate::sqlite)))
      (sqlite-exec db "create table assoc1 (k1,v1); create table assoc2 (k2,v2);")
      (let loop ((i 10))
	 (when (>fx i 0)
	    (sqlite-exec db "insert into assoc1 values (~a, ~a); insert into assoc2 values (~a, ~a)"
			 i (+fx i 1) i (+fx i 1))
	    (loop (-fx i 1))))
      (sqlite-get db cons
	 "select MAX(k1) from assoc1 where k1 < (select MIN(v2) from assoc2 where k2 > k1)"))
   :cond-expand sqlite
   :expected '(#("MAX(k1)") . #("9")))

(define-test sqltiny-get
   (let ((db (instantiate::sqltiny)))
      (sqlite-exec db "create table foo (x, y)")
      (let loop ((i 10))
	 (when (>fx i 0)
	    (sqlite-exec db "insert into foo values (~a, ~a)" i (+fx i 1))
	    (loop (-fx i 1))))
      (sqlite-get db cons
	 "select y from foo where x > 4"))
   :expected '(#("y") . #("11")))

(define-test sqlite-get
   (let ((db (instantiate::sqlite)))
      (sqlite-exec db "create table foo (x, y)")
      (let loop ((i 10))
	 (when (>fx i 0)
	    (sqlite-exec db "insert into foo values (~a, ~a)" i (+fx i 1))
	    (loop (-fx i 1))))
      (sqlite-get db cons
	 "select y from foo where x > 4"))
   :cond-expand sqlite
   :expected '(#("y") . #("11")))

(define-test sqltiny-for-each
   (let ((db (instantiate::sqltiny))
         (res '()))
      (sqlite-exec db "create table foo (x INTEGER, y INTEGER)")
      (for-each (lambda (x)
                   (sqlite-exec db "insert into foo values(~a, ~a)" x (* x x)))
         (iota 10))
      (sqlite-for-each db
         (lambda (keys vals) (set! res (cons keys vals)))
         "SELECT * FROM foo")
      res)
   :expected '(#("x" "y") . #("9" "81")))

(define-test sqlite-for-each
   (let ((db (instantiate::sqlite))
         (res '()))
      (sqlite-exec db "create table foo (x INTEGER, y INTEGER)")
      (for-each (lambda (x)
                   (sqlite-exec db "insert into foo values(~a, ~a)" x (* x x)))
         (iota 10))
      (sqlite-for-each db
         (lambda (keys vals) (set! res (cons keys vals)))
         "SELECT * FROM foo")
      res)
   :cond-expand sqlite
   :expected '(#("x" "y") . #("9" "81")))

(define-test sqlite-map
   (let ((db (instantiate::sqltiny)))
      (sqlite-exec db "create table foo (x INTEGER, y INTEGER)")
      (for-each (lambda (x)
                   (sqlite-exec db "insert into foo values(~A, ~A)" x (* x x)))
         (iota 10))
      (sqlite-map db 
            (lambda (s1 s2) (+ (string->integer s1) (string->integer s2))) 
         "SELECT * FROM foo"))
   :expected '(0 2 6 12 20 30 42 56 72 90))

(define-test sqltiny-map
   (let ((db (instantiate::sqltiny)))
      (sqlite-exec db "create table foo (x INTEGER, y INTEGER)")
      (for-each (lambda (x)
                   (sqlite-exec db "insert into foo values(~A, ~A)" x (* x x)))
         (iota 10))
      (sqlite-map db 
            vector 
         "SELECT * FROM foo"))
   :expected '(#("0" "0")
               #("1" "1")
               #("2" "4")
               #("3" "9")
               #("4" "16")
               #("5" "25")
               #("6" "36")
               #("7" "49")
               #("8" "64")
               #("9" "81")))

(define-test sqlite-map
   (let ((db (instantiate::sqlite)))
      (sqlite-exec db "create table foo (x INTEGER, y INTEGER)")
      (for-each (lambda (x)
                   (sqlite-exec db "insert into foo values(~A, ~A)" x (* x x)))
         (iota 10))
      (sqlite-map db 
            vector 
         "SELECT * FROM foo"))
   :cond-expand sqlite
   :expected '(#("0" "0")
               #("1" "1")
               #("2" "4")
               #("3" "9")
               #("4" "16")
               #("5" "25")
               #("6" "36")
               #("7" "49")
               #("8" "64")
               #("9" "81")))

(define-test sqltiny-name-of-tables
   (let ((db (instantiate::sqltiny)))
      (sqlite-exec db "create table foo (x INTEGER, y INTEGER)")
      (sqlite-exec db "create table bar (x INTEGER, y INTEGER, z INTEGER)")
      (sqlite-name-of-tables db))
   :expected '("foo" "bar"))

(define-test sqlite-name-of-tables
   (let ((db (instantiate::sqlite)))
      (sqlite-exec db "create table foo (x INTEGER, y INTEGER)")
      (sqlite-exec db "create table bar (x INTEGER, y INTEGER, z INTEGER)")
      (sqlite-name-of-tables db))
   :cond-expand sqlite
   :expected '("foo" "bar"))

(define-test sqltiny-name-of-tables
   (let ((db (instantiate::sqltiny)))
      (sqlite-exec db "create table foo (x INTEGER, y INTEGER)")
      (sqlite-exec db "create table bar (x INTEGER, y INTEGER, z INTEGER)")
      (sqlite-map db (lambda (x) x)
         "SELECT name FROM sqlite_master WHERE type='table'"))
   :expected '("foo" "bar"))

(define-test sqlite-name-of-tables
   (let ((db (instantiate::sqlite)))
      (sqlite-exec db "create table foo (x INTEGER, y INTEGER)")
      (sqlite-exec db "create table bar (x INTEGER, y INTEGER, z INTEGER)")
      (sqlite-map db (lambda (x) x)
         "SELECT name FROM sqlite_master WHERE type='table'"))
   :cond-expand sqlite
   :expected '("foo" "bar"))

(define-test sqltiny-table-name-of-columns
   (let ((db (instantiate::sqltiny)))
      (sqlite-exec db "create table foo (x INTEGER, y INTEGER)")
      (sqlite-exec db "create table bar (x INTEGER, y INTEGER, z INTEGER)")
      (sqlite-table-name-of-columns db "bar"))
   :expected '("x" "y" "z"))

(define-test sqlite-table-name-of-columns
   (let ((db (instantiate::sqlite)))
      (sqlite-exec db "create table foo (x INTEGER, y INTEGER)")
      (sqlite-exec db "create table bar (x INTEGER, y INTEGER, z INTEGER)")
      (sqlite-table-name-of-columns db "bar"))
   :cond-expand sqlite
   :expected '("x" "y" "z"))

(define-test sqlite-last-insert-rowid
   (let ((db (instantiate::sqltiny)))
      (sqlite-exec db "create table foo (x INTEGER, y INTEGER)")
      (for-each (lambda (x)
                   (sqlite-exec db "insert into foo values(~A, ~A)" x (* x x)))
         (iota 8))
      (sqlite-last-insert-rowid db))
   :expected "8")

(define-test sqlite-last-insert-rowid
   (let ((db (instantiate::sqlite)))
      (sqlite-exec db "create table foo (x INTEGER, y INTEGER)")
      (sqlite-exec db "create table bar (x INTEGER, y INTEGER, z INTEGER)")
      (for-each (lambda (x)
                   (sqlite-exec db "insert into foo values(~A, ~A)" x (* x x)))
         (iota 8))
      (for-each (lambda (x)
                   (sqlite-exec db "insert into bar values(~A, ~A, ~a)" x (* x x) 0))
         (iota 4))
      (sqlite-last-insert-rowid db))
   :cond-expand sqlite
   :expected "4")

(define-test sqlite-last-insert-rowid
   (let ((db (instantiate::sqltiny)))
      (sqlite-exec db "create table foo (x INTEGER, y INTEGER)")
      (for-each (lambda (x)
                   (sqlite-exec db "insert into foo values(~A, ~A)" x (* x x)))
         (iota 8))
      (sqlite-exec db "SELECT last_insert_rowid()"))
   :expected "8")

(define-test sqlite-last-insert-rowid
   (let ((db (instantiate::sqlite)))
      (sqlite-exec db "create table foo (x INTEGER, y INTEGER)")
      (sqlite-exec db "create table bar (x INTEGER, y INTEGER, z INTEGER)")
      (for-each (lambda (x)
                   (sqlite-exec db "insert into foo values(~A, ~A)" x (* x x)))
         (iota 8))
      (for-each (lambda (x)
                   (sqlite-exec db "insert into bar values(~A, ~A, ~a)" x (* x x) 0))
         (iota 4))
      (sqlite-exec db "SELECT last_insert_rowid()"))
   :cond-expand sqlite
   :expected "4")

(define-test insert
   (let ((db (instantiate::sqltiny)))
      (sqlite-exec db "create table foo (f2, f1 PRIMARY KEY);
                       create table bar (b1,b2,b3);

                       insert into foo (f1,f2) values ('foo4','foo3');
                       insert into bar values ('bar1','bar2','bar3');")
      (sqlite-map db list "select * from bar"))
   :expected '(("bar1" "bar2" "bar3")))

(define-test insert
   (let ((db (instantiate::sqlite)))
      (sqlite-exec db "create table foo (f2, f1 PRIMARY KEY);
                       create table bar (b1,b2,b3);

                       insert into foo (f1,f2) values ('foo4','foo3');
                       insert into bar values ('bar1','bar2','bar3');")
      (sqlite-map db list "select * from bar"))
   :cond-expand sqlite
   :expected '(("bar1" "bar2" "bar3")))

(define-test insert
   (let ((db (instantiate::sqltiny)))
      (sqlite-exec db "create table foo (f2, f1 PRIMARY KEY);
                       create table bar (b1,b2,b3);

                       insert into foo (f1,f2) values ('foo4','foo3');
                       insert into bar values ('bar1','bar2','bar3');")
      (sqlite-map db list "select * from foo,bar"))
   :expected '(("foo3" "foo4" "bar1" "bar2" "bar3")))

(define-test insert
   (let ((db (instantiate::sqlite)))
      (sqlite-exec db "create table foo (f2, f1 PRIMARY KEY);
                       create table bar (b1,b2,b3);

                       insert into foo (f1,f2) values ('foo4','foo3');
                       insert into bar values ('bar1','bar2','bar3');")
      (sqlite-map db list "select * from foo,bar"))
   :cond-expand sqlite
   :expected '(("foo3" "foo4" "bar1" "bar2" "bar3")))

;*---------------------------------------------------------------------*/
;*    *db* ...                                                         */
;*---------------------------------------------------------------------*/
(define *db* #unspecified)

;*---------------------------------------------------------------------*/
;*    create-table ...                                                 */
;*---------------------------------------------------------------------*/
(define-test create-table
   (begin
      (set! *db* (instantiate::sqlite))
      (sqlite-exec *db* "CREATE TABLE gee (x INTEGER, y INTEGER)")
      #t)
   :cond-expand sqlite)

;*---------------------------------------------------------------------*/
;*    insert ...                                                       */
;*---------------------------------------------------------------------*/
(define-test insert
   (begin
      (for-each (lambda (x)
                   (sqlite-exec *db* "INSERT INTO gee VALUES(~A, ~A)" x (* x x)))
         (iota 10))
      #t)
   :cond-expand sqlite)

;*---------------------------------------------------------------------*/
;*    select ...                                                       */
;*---------------------------------------------------------------------*/
(define-test select
   (sqlite-map  *db* vector "SELECT * FROM gee")
   :cond-expand sqlite
   :expected '(#("0" "0")
               #("1" "1")
               #("2" "4")
               #("3" "9")
               #("4" "16")
               #("5" "25")
               #("6" "36")
               #("7" "49")
               #("8" "64")
               #("9" "81")))

;*---------------------------------------------------------------------*/
;*    select.2 ...                                                     */
;*---------------------------------------------------------------------*/
(define-test select
   (sqlite-map *db* vector "SELECT y,x FROM gee WHERE y > 50")
   :cond-expand sqlite
   :expected '(#("64" "8") #("81" "9")))

;*---------------------------------------------------------------------*/
;*    create.2                                                         */
;*---------------------------------------------------------------------*/
(define-test create
   (begin
      (sqlite-exec *db* "create table foo (f2, f1 PRIMARY KEY);
                      create table bar (b1,b2,b3);
                      create table hux (h1,h2);
                      create table lee (l1,l2,l3);
                      create table mee (m1,m2);")
      #t)
   :cond-expand sqlite)

;*---------------------------------------------------------------------*/
;*    insert                                                           */
;*---------------------------------------------------------------------*/
(define-test insert
   (begin
      (sqlite-exec *db* "insert into foo (f1,f2) values ('foo1','foo2');
                      insert into foo (f1,f2) values ('foo4','foo3');

                      insert into bar values ('bar1','bar2','bar3');
                      insert into bar values ('bar4','bar6','bar5');

                      insert into hux values ('hux10', 10);
                      insert into hux values ('hux11', 11);
                      insert into hux values ('hux12', 12);
                      insert into hux values ('hux13', 12);

                      insert into lee values (1,2,0);
                      insert into lee values (1,2,1);
                      insert into lee values (2,3,0);
                      insert into lee values (2,4,0);
                      insert into lee values (3,4,0);
                      insert into lee values (4,5,8);
                      insert into lee values (4,6,7);

                      insert into mee (m1) values (1);
                      insert into mee (m1,m2) values (2,2);")
      #t)
   :cond-expand sqlite)

(define-test insert
   (begin
      (sqlite-exec *db* "insert into hux (h1,h2) values ('hux14', 1);
                      insert into hux (h1,h2) values ('hux15', 2)")
      #t)
   :cond-expand sqlite)

;*---------------------------------------------------------------------*/
;*    selects ...                                                      */
;*---------------------------------------------------------------------*/
(define-test select
   (sqlite-map *db* list "select * from foo")
   :cond-expand sqlite
   :expected '(("foo2" "foo1") ("foo3" "foo4")))

(define-test select
   (sqlite-map *db* list "select * from foo where (f1=f2)")
   :cond-expand sqlite
   :expected '())

(define-test select
   (sqlite-map *db* list "select l1,l2 from lee where (l1=1) || (l1=2)")
   :cond-expand sqlite
   :expected '(("1" "2") ("1" "2") ("2" "3") ("2" "4")))

(define-test select
   (sqlite-map *db* list "select l1,l2 from lee where (l1=3) or (l2>=5)")
   :cond-expand sqlite
   :expected '(("3" "4") ("4" "5") ("4" "6")))

(define-test select
   (sqlite-map *db* list "select l1,l2 from lee where (l1=4) and (l2>=5)")
   :cond-expand sqlite
   :expected '(("4" "5") ("4" "6")))

(define-test select
   (sqlite-map *db* list "select l1,l2 from lee where (l1=4) and (l2<2)")
   :cond-expand sqlite
   :expected '())

(define-test select
   (sqlite-map *db* list "select * from foo where (f1<f2)")
   :cond-expand sqlite
   :expected '(("foo2" "foo1")))

(define-test select
   (sqlite-map *db* list "select * from foo where (foo.f1<foo.f2)")
   :cond-expand sqlite
   :expected '(("foo2" "foo1")))

(define-test select
   (sqlite-map *db* list "select f1 from foo")
   :cond-expand sqlite
   :expected '(("foo1") ("foo4")))

(define-test select
   (sqlite-map *db* list "select f2 from foo")
   :cond-expand sqlite
   :expected '(("foo2") ("foo3")))

(define-test select
   (sqlite-map *db* list "select f1,f2 from foo")
   :cond-expand sqlite
   :expected '(("foo1" "foo2") ("foo4" "foo3")))

(define-test select
   (sqlite-map *db* list "select * from foo,bar")
   :cond-expand sqlite
   :expected '(("foo2" "foo1" "bar1" "bar2" "bar3")
               ("foo2" "foo1" "bar4" "bar6" "bar5")
               ("foo3" "foo4" "bar1" "bar2" "bar3")
               ("foo3" "foo4" "bar4" "bar6" "bar5")))

(define-test select
   (sqlite-map *db* list "select f1 from foo,bar ORDER BY f1")
   :cond-expand sqlite
   :expected '(("foo1")
               ("foo1")
               ("foo4")
               ("foo4")))

(define-test select
   (sqlite-map *db* list "select b1 from foo,bar ORDER BY b1")
   :cond-expand sqlite
   :expected '(("bar1")
               ("bar1")
               ("bar4")
               ("bar4")))

(define-test select
   (sqlite-map *db* list "select h1 from hux where h2 in (10,11)")
   :cond-expand sqlite
   :expected '(("hux10")
               ("hux11")))

;*---------------------------------------------------------------------*/
;*    distinct                                                         */
;*---------------------------------------------------------------------*/
(define-test distinct
   (sqlite-map *db* list "select DISTINCT b1 from foo,bar")
   :cond-expand sqlite
   :expected '(("bar1") ("bar4")))

(define-test distinct
   (sqlite-map *db* list "select DISTINCT l1 from lee")
   :cond-expand sqlite
   :expected '(("1") ("2") ("3") ("4")))

;*---------------------------------------------------------------------*/
;*    join                                                             */
;*---------------------------------------------------------------------*/
(define-test join
   (sqlite-map *db* list "select l1.*
                            from lee l1, lee l2
                           where (l1.l1=l2.l2) and (l1.l2=3)")
   :cond-expand sqlite
   :expected '(("2" "3" "0") ("2" "3" "0")))

(define-test join
   (sqlite-map *db* list "select DISTINCT l1.*
                            from lee l1, lee l2
                           where (l1.l1=l2.l2) and (l1.l2=3)")
   :cond-expand sqlite
   :expected '(("2" "3" "0")))

(define-test join
   (sqlite-map *db* list "select h1, l2 from hux, lee where (h2=l1)")
   :cond-expand sqlite
   :expected '(("hux14" "2") ("hux14" "2") ("hux15" "3") ("hux15" "4")))

;*---------------------------------------------------------------------*/
;*    like                                                             */
;*---------------------------------------------------------------------*/
(define-test like
   (sqlite-map *db* list "select DISTINCT h2 from hux where h1 like 'hux%' ORDER BY h2")
   :cond-expand sqlite
   :expected '(("1") ("2") ("10") ("11") ("12")))

(define-test like
   (sqlite-map *db* list "select DISTINCT h2 from hux where h1 like 'hux1_' ORDER BY h2")
   :cond-expand sqlite
   :expected '(("1") ("2") ("10") ("11") ("12")))

;*---------------------------------------------------------------------*/
;*    subqueries                                                       */
;*---------------------------------------------------------------------*/
(define-test subquery
   (begin
      (sqlite-map *db* list "create table ta (ta1,ta2);
                          create table tb (tb1,tb2);
                          insert into ta values(1,2);
                          insert into ta values(3,5);
                          insert into tb values(4,2)")
      #t)
   :cond-expand sqlite)

(define-test subquery
   (sqlite-map *db* list "select *
                           from ta
                           where ta2=(select tb2
                                      from tb
                                      where tb1>=ta2);")
   :cond-expand sqlite
   :expected '(("1" "2")))

(define-test subquery
   (sqlite-map *db* list "select h1
                           from hux
                           where h2 = (select l2
                                        from lee l2
                                        where l2.l2=h2)")
   :cond-expand sqlite
   :expected '(("hux15")))

(define-test subquery
   (sqlite-map *db* list "select *
                           from ta
                           where ta2 in (select tb2
                                         from tb
                                         where tb1>3);")
   :cond-expand sqlite
   :expected '(("1" "2")))

(define-test subquery
   (sqlite-map *db* list "select *
                           from ta
                           where ta2 not in (select tb2
                                             from tb
                                             where ta2<tb1);")
   :cond-expand sqlite
   :expected '(("3" "5")))

(define-test subquery
   (sqlite-map *db* list "select *
                           from ta ta1
                           where 4 > (select ta2
                                       from ta
                                       where ta1.ta2 = ta2)")
   :cond-expand sqlite
   :expected '(("1" "2")))

(define-test subquery
   (let ((db (instantiate::sqlite)))
      (sqlite-exec db "create table assoc1 (k1,v1);
                       create table assoc2 (k2,v2);")
      (let loop ((i 10))
	 (when (>fx i 0)
	    (sqlite-exec db "insert into assoc1 values (~a, ~a);
                             insert into assoc2 values (~a, ~a)"
			 i (+fx i 1) i (+fx i 1))
	    (loop (-fx i 1))))
      (sqlite-eval db
	 (lambda (x) x)
	 "select MAX(k1)
           from assoc1
           where k1 < (select MIN(v2) from assoc2 where k2 > k1)"))
   :cond-expand sqlite
   :expected "9")

