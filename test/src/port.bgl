;*---------------------------------------------------------------------*/
;*    port                                                             */
;*---------------------------------------------------------------------*/
(module port
   (export test))

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "./test.bgh")

;*---------------------------------------------------------------------*/
;*    test ...                                                         */
;*---------------------------------------------------------------------*/
(define (test verbose tests::pair-nil)
   (when (or (null? tests) (member "port" tests))
      (test-all verbose "port")))

;*---------------------------------------------------------------------*/
;*    tests ...                                                        */
;*---------------------------------------------------------------------*/
(define-test current-input-port (input-port? (current-input-port))
   :expected #t)
   
(define-test current-error-port (output-port? (current-error-port))
   :expected #t)
   
(define-test current-output-port (output-port? (current-output-port))
   :expected #t)
   
(define-test open-input-file (let ((p (open-input-file "misc/input.txt")))
                                (unwind-protect
                                   (input-port? p)
                                   (close-input-port p)))
   :expected #t)
(define-test open-input-file (input-string-port? (open-input-file "string:foo"))
   :expected #t)
(define-test open-input-file (input-port? (open-input-file "wrong"))
   :expected #f)

(define-test input-port-reopen!
   (call-with-input-string "\"foo\" bar gee"
      (lambda (ip)
         (read ip)
         (input-port-reopen! ip)
         (read ip)))
   :expected "foo")

(define-test open-input-procedure
   (let ((p (open-input-procedure
               (let ((s #t))
                  (lambda ()
                     (if s
                         (begin
                            (set! s #f)
                            "foobar")
                         s))))))
      (unwind-protect
         (read p)
         (close-input-port p)))
   :expected 'foobar)
                              
(define-test open-input-descriptor
   (let ((p (open-input-descriptor 0)))
      (unwind-protect
         (input-port? p)
         (close-input-port p)))
   :expected #t)

(define-test open-input-string
   (read-char (open-input-string "A"))
   :expected #\A)

(define-test open-input-string
   (read-string (open-input-string "ABCDE" 1 3))
   :expected "BC")

(define-test open-input-string!
   (read (open-input-string! "1900"))
   :expected 1900)

(define-test open-input-c-string
   (read-char (open-input-c-string "A"))
   :expected #\A)

(define-test open-input-mmap
   (let* ((mmap (open-mmap "misc/input.txt" :read #t :write #f))
          (ip (open-input-mmap mmap)))
      (unwind-protect
         (read ip)
         (begin
            (close-input-port ip)
            (close-mmap mmap))))
   :expected 'Toto)

(define-test open-input-gzip-file
   (let ((ip (open-input-gzip-file "misc/input.txt.gz")))
      (unwind-protect
         (read ip)
         (close-input-port ip)))
   :expected 'Toto)

(define-test open-input-gzip-port
   (let* ((zp (open-input-file "misc/input.txt.gz"))
          (ip (open-input-gzip-port zp)))
      (unwind-protect
         (read ip)
         (begin
            (close-input-port ip)
            (close-input-port zp))))
   :expected 'Toto)

(define-test open-input-zlib-file
   (let ((ip (open-input-zlib-file "misc/input.txt.zlib")))
      (unwind-protect
         (read ip)
         (close-input-port ip)))
   :expected 'Toto)

(define-test open-input-zlib-port
   (let* ((zp (open-input-file "misc/input.txt.zlib"))
          (ip (open-input-zlib-port zp)))
      (unwind-protect
         (read ip)
         (begin
            (close-input-port ip)
            (close-input-port zp))))
   :expected 'Toto)

(define-test close-input-port
   (closed-input-port? (close-input-port (open-input-file "/dev/null")))
   :expected #t)

(define-test closed-input-port?
   (closed-input-port? (close-input-port (open-input-file "/dev/null")))
   :expected #t)

(define-test close-output-port
   (begin (close-output-port (open-output-file "/dev/null")) #unspecified)
   :expected #unspecified)

(define-test close-output-port
   (let ((p (open-output-string)))
      (display "foo" p)
      (close-output-port p))
   :expected "foo")

(define-test closed-output-port?
   (closed-output-port? (close-output-port (open-output-file "/dev/null")))
   :expected #t)

(define-test closed-output-port?
   (closed-output-port? (open-output-string ""))
   :expected #f)

(define-test open-output-file
   (let ((p (open-output-file "/dev/null")))
      (unwind-protect
         (output-port? p)
         (close-output-port p))))

(define-test open-output-string
   (let ((p (open-output-string)))
      (display "foo" p)
      (display 100 p)
      (close-output-port p))
   :expected "foo100")

(define-test open-output-procedure
   (letrec* ((buf #f)
             (last #f)
             (flush #unspecified)
             (op (open-output-procedure
                    (lambda (x)
                       (set! last x)
                       (set! buf x))
                    (lambda ()
                       (set! flush last)))))
      (unwind-protect
         (begin
            (display "foo" op)
            (flush-output-port op)
            (display "bar" op)
            (cons flush buf))
         (close-output-port op)))
   :expected '("foo" . "bar"))

(define-test input-port? (input-port? (current-input-port))
   :expected #t)
(define-test input-port? (input-port? (current-output-port))
   :expected #f)
(define-test input-port? (input-port? (open-input-string "foo"))
   :expected #t)

(define-test input-string-port? (input-string-port? (current-input-port))
   :expected #f)
(define-test input-string-port? (input-string-port? (current-output-port))
   :expected #f)
(define-test input-string-port? (input-string-port? (open-input-string "foo"))
   :expected #t)

(define-test output-port? (output-port? (current-output-port))
   :expected #t)
(define-test output-port? (output-port? (current-output-port))
   :expected #t)
(define-test output-port? (output-port? (open-output-string))
   :expected #t)

(define-test output-string-port? (output-string-port? (current-output-port))
   :expected #f)
(define-test output-string-port? (output-string-port? (current-output-port))
   :expected #f)
(define-test output-string-port? (output-port? (open-output-string))
   :expected #t)

(define-test port? (port? (current-output-port))
   :expected #t)
(define-test port? (port? (current-output-port))
   :expected #t)
(define-test port? (port? (open-output-string))
   :expected #t)

(define-test call-with-input-file
   (call-with-input-file "misc/input.txt"
      (lambda (port)
         (read-chars 10 port)
         (read-char port)
         (read-chars 30 port)
         (peek-char port)
         (read-char port)))
   :expected #\e)

(define-test call-with-input-string
   (call-with-input-string "(foo 2.3)" read)
   :expected '(foo 2.3))

(define-test call-with-output-file
   (call-with-output-file "/dev/null" output-port?)
   :expected #t)

(define-test call-with-append-file
   (call-with-append-file "/dev/null" output-port?)
   :expected #t)

(define-test call-with-output-string
   (call-with-output-string (lambda (op) (display '(1 2) op)))
   :expected "(1 2)")

(define-test with-input-from-file
   (with-input-from-file "misc/input.txt"
      (lambda ()
         (read-chars 10)
         (read-char)
         (read-chars 30)
         (peek-char)
         (read-char)))
   :expected #\e)

(define-test with-input-from-string
   (with-input-from-string "foo bar"
      (lambda ()
         (read)))
   :expected 'foo)
         
(define-test with-input-from-procedure
   (with-input-from-procedure
         (let ((s "1"))
            (lambda ()
               (let ((r s))
                  (set! s #f)
                  r)))
      (lambda ()
         (read)))
   :expected 1)

(define-test with-input-from-port
   (call-with-input-string "(7 8)"
      (lambda (ip)
         (with-input-from-port ip
            (lambda ()
               (read)))))
   :expected '(7 8))
            
(define-test with-output-to-file
   (with-output-to-file "/dev/null"
      (lambda ()
         (display 1)
         #t))
   :expected #t)
         
(define-test with-append-to-file
   (with-append-to-file "/dev/null"
      (lambda ()
         (display 1)
         #t))
   :expected #t)
         
(define-test with-output-to-string
   (with-output-to-string
      (lambda ()
         (display 1)))
   :expected "1")

(define-test with-output-to-procedure
   (let ((buf #f)
         (last #f))
      (begin
         (with-output-to-procedure
            (lambda (x)
               (set! last x)
               (set! buf x))
            (lambda ()
               (display #t)
               (display #f)))
         buf))
   :expected "#f")

(define-test with-output-to-port
   (call-with-output-string
      (lambda (op)
         (with-output-to-port op
            (lambda ()
               (display '#(123))))))
   :expected "#(123)")
   
(define-test with-error-to-string
   (with-error-to-string
      (lambda ()
         (display 1 (current-error-port))))
   :expected "1")
         
(define-test with-error-to-file
   (with-error-to-file "/dev/null"
      (lambda ()
         (display 1 (current-error-port))
         #t))
   :expected #t)
         
(define-test with-error-to-procedure
   (let ((buf #f))
      (begin
         (with-error-to-procedure (lambda (x) (set! buf x))
            (lambda ()
               (display 123 (current-error-port))))
         buf))
   :expected "123")
         
(define-test with-error-to-port
   (call-with-output-string
      (lambda (op)
         (with-error-to-port op
            (lambda ()
               (display '#(123) (current-error-port))))))
   :expected "#(123)")

(define-test input-port-name
   (call-with-input-file "/etc/passwd" input-port-name)
   :expected "/etc/passwd")

(define-test input-port-name-set!
   (begin
      (input-port-name-set! (current-input-port) "foo")
      (input-port-name (current-input-port)))
   :expected "foo")

(define-test output-port-name
   (call-with-output-file "/dev/null" output-port-name)
   :expected "/dev/null")

(define-test output-port-name-set!
   (begin
      (output-port-name-set! (current-output-port) "foo")
      (output-port-name (current-output-port)))
   :expected "foo")

(define-test input-port-position
   (call-with-input-file "/etc/passwd"
      (lambda (ip)
         (read-chars 10 ip)
         (input-port-position ip)))
   :expected 10)

(define-test input-port-position-set!
   (call-with-input-file "/etc/passwd"
      (lambda (ip)
         (input-port-position-set! ip 10)
         (read-chars 10 ip)
         (input-port-position ip)))
   :expected 20)

(define-test output-port-position
   (let ((op (open-output-string)))
      (unwind-protect
         (begin
            (display "foo" op)
            (output-port-position-set! op 1)
            (display "bar" op)
            (output-port-position op))
         (close-output-port op)))
   :expected 4)

(define-test output-port-position-set!
   (let ((op (open-output-string)))
      (unwind-protect
         (begin
            (display "foo" op)
            (output-port-position-set! op 1)
            (display "bar" op)
            (output-port-position op))
         (close-output-port op)))
   :expected 4)

(define-test input-port-length
   (call-with-input-string "foo" input-port-length)
   :expected 3)

(define-test get-output-string
   (let ((p (open-output-string)))
      (display 1234 p)
      (let ((s (get-output-string p)))
         (display "foo" p)
         (close-output-port p)
         s))
   :expected "1234")

(define-test input-port-timeout
   (integer? (input-port-timeout (current-input-port)))
   :expected #t)

(define-test input-port-timeout-set!
   (call-with-input-file "/dev/null"
      (lambda (ip)
         (input-port-timeout-set! ip 10000)
         (integer? (input-port-timeout ip))))
   :expected #t)

(define-test input-port-timeout-set!
   (call-with-input-file "/dev/null"
      (lambda (ip)
         (input-port-timeout-set! ip 10000)
         (cond-expand
            (c (input-port-timeout ip))
            (else 10000))))
   :expected 10000)

(define-test output-port-timeout
   (integer? (output-port-timeout (current-output-port)))
   :expected #t)

(define-test output-port-timeout-set!
   (let ((op (open-output-string)))
      (unwind-protect
         (begin
            (output-port-timeout-set! op 10000)
            (integer? (output-port-timeout op)))
         (close-output-port op)))
   :expected #t)

(define-test output-port-timeout-set!
   (let ((op (open-output-string)))
      (unwind-protect
         (begin
            (output-port-timeout-set! op 10000)
            (cond-expand
               (c (output-port-timeout op))
               (else 10000)))
         (close-output-port op)))
   :expected 10000)

(define-test output-port-flush-hook
   (output-port-flush-hook (open-output-string ""))
   :expected #unspecified)

(define-test output-port-flush-hook-set!
   (let ((res #unspecified))
      (call-with-output-string
         (lambda (op)
            (output-port-flush-hook-set! op
               (lambda (p l)
                  (set! res (cons (eq? p op) (integer? l)))))
            (display "foo" op)
            (flush-output-port op)))
      res)
   :expected '(#t . #t))

(define-test output-port-flush-buffer
   (output-port-flush-buffer (current-output-port))
   :expected #unspecified)

(define-test output-port-flush-buffer-set!
   (let* ((buf (make-string 80))
          (p (open-output-string)))
      (output-port-flush-buffer-set! p buf)
      (eq? buf (output-port-flush-buffer p)))
   :expected #t)

(define-test input-port-close-hook
   (input-port-close-hook (open-input-string ""))
   :expected #unspecified)

(define-test input-port-close-hook-set!
   (let ((ip (open-input-string ""))
         (res #f))
      (input-port-close-hook-set! ip (lambda (p) (set! res (eq? ip p))))
      (close-input-port ip)
      res)
   :expected #t)
      
(define-test output-port-close-hook
   (output-port-close-hook (open-output-string ""))
   :expected #unspecified)

(define-test output-port-close-hook-set!
   (let ((ip (open-output-string ""))
         (res #f))
      (output-port-close-hook-set! ip (lambda (p) (set! res (eq? ip p))))
      (close-output-port ip)
      res)
   :expected #t)
      
(define-test open-input-ftp-file
   (let ((p (open-input-ftp-file "ftp-sop.inria.fr/ls-lR.gz")))
      (if (input-port? p)
          (unwind-protect
             (string? (read-string p))
             (close-input-port p))
          #t))
   :expected #t)

(define-test open-input-ftp-file
   (let ((p (open-input-ftp-file "anonymous:foo@ftp-sop.inria.fr/ls-lR.gz")))
      (if (input-port? p)
          (unwind-protect
             (string? (read-string p))
             (close-input-port p))
          #t))
   :expected #t)
   
