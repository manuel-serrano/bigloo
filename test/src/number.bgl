(define-test equal (equal? (car (list 1)) (car (list #l1))) :result #t)
(define-test equal (equal? (car (list #l1)) (car (list #l1))) :result #t)
(define-test equal (equal? (car (list #l1)) (car (list 1))) :result #t)
(define-test equal (equal? (car (list #l1)) (car (list 2))) :result #f)
