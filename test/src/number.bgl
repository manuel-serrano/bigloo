;*---------------------------------------------------------------------*/
;*    number                                                           */
;*---------------------------------------------------------------------*/
(module number
   (export test))

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "./test.bgh")

;*---------------------------------------------------------------------*/
;*    test ...                                                         */
;*---------------------------------------------------------------------*/
(define (test verbose tests::pair-nil)
   (when (or (null? tests) (member "number" tests))
      (test-all verbose "number")))

;*---------------------------------------------------------------------*/
;*    llong constant ...                                               */
;*---------------------------------------------------------------------*/
(define (foo-ok::llong x::llong)
  (let ((bar #l268435456))
    (quotientllong x bar)))

(define (foo-ko::llong x::llong)
  (quotientllong x #l268435456))

;*---------------------------------------------------------------------*/
;*    tests                                                            */
;*---------------------------------------------------------------------*/
(define-test number? (number? 3))
(define-test number? (number? 3.))
(define-test number? (number? #z3))
(define-test number? (number? #s32:3))
(define-test number? (number? #u64:3))

(define-test exact? (exact? 123))
(define-test exact? (exact? #s8:1))
(define-test exact? (exact? 3.0) :result #f)

(define-test inexact? (inexact? 123) :result #f)
(define-test inexact? (inexact? #s8:1) :result #f)
(define-test inexact? (inexact? 3.0) :result #t)

(define-test complex? (complex? 1) :result #t)
(define-test rational? (rational? 1) :result #t)

(define-test number->flonum (number->flonum 1.0) :eq ~equal? :result 1.0)
(define-test number->flonum (number->flonum 1) :eq ~equal? :result 1.)
(define-test number->flonum (number->flonum #z1) :eq ~equal? :result 1.)

(define-test fixnum->flonum (fixnum->flonum 1233) :eq ~equal? :result 1233.)
(define-test bignum->flonum (bignum->flonum #z133) :eq ~equal? :result 133.)

(define-test flonum->bignum (flonum->bignum 133.) :result #z133)

(define-test flonum->int32 (flonum->int32 -133.) :result #s32:-133)
(define-test int32->flonum (int32->flonum #s32:-133) :eq ~equal? :result -133.)

(define-test flonum->int64 (flonum->int64 -133.) :result #s64:-133)
(define-test int64->flonum (int64->flonum #s64:-133) :eq ~equal? :result -133.)

(define-test flonum->uint32 (flonum->uint32 133.) :result #u32:133)
(define-test uint32->flonum (uint32->flonum #u32:133) :eq ~equal? :result 133.)

(define-test flonum->uint64 (flonum->uint64 133.) :result #u64:133)
(define-test uint64->flonum (uint64->flonum #u64:133) :eq ~equal? :result 133.)

(define-test exact->inexact (exact->inexact 4) :eq ~equal? :result 4.)
(define-test inexact->exact (inexact->exact 4.) :result 4)

