(let ((un 1) (deux 2) (trois 3) (quatre 4))
   (define-test maxfxb (maxfx un) :result 1)
   (define-test maxfxb (maxfx un deux) :result deux)
   (define-test maxfxb (maxfx deux un) :result deux)
   (define-test maxfxb (maxfx deux un 0) :result deux)
   (define-test maxfxb (maxfx deux trois 0) :result 3)
   (define-test maxfxb (maxfx deux trois quatre) :result quatre)
   (define-test minbfx (minfx un) :result 1)
   (define-test minbfx (minfx un deux) :result 1)
   (define-test minbfx (minfx deux un) :result 1)
   (define-test minbfx (minfx deux un 0) :result 0)
   (define-test minbfx (minfx deux trois 0) :result 0)
   (define-test minbfx (minfx deux trois quatre) :result deux))

(let ((s (real->string 0.0)))
   (with-input-from-string s
      (lambda ()
         (let ((v (read)))
            (define-test read (real? v))
            (define-test read (and (>fl v -0.001) (<fl v 0.001)))))))

(define-test floor (floor -4.3) :result -5.0)
(define-test floor (floor 3.5) :result 3.0)
(define-test ceiling (ceiling -4.3) :result -4.0)
(define-test ceiling (ceiling 3.5) :result 4.0)
(define-test truncate (truncate -4.3) :result -4.0)
(define-test truncate (truncate 3.5) :result 3.0)
(define-test round (round -4.3) :result -4.0)
(define-test round (round 3.5) :result 4.0)
(define-test round (round 7) :result 7)
(define-test modulo (modulo 13 4) :result 1)
(define-test remainder (remainder 13 4) :result 1)
(define-test modulo (modulo -13 4) :result 3)
(define-test remainder (remainder -13 4) :result -1)
(define-test modulo (modulo 13 -4) :result -3)
(define-test remainder (remainder 13 -4) :result 1)
(define-test modulo (modulo -13 -4) :result -1)
(define-test remainder (remainder -13 -4) :result -1)
(define-test llong-constant (foo-ko #l1) :result (foo-ok #l1))
(define-test min/maxvalfx (<fx (minvalfx) (maxvalfx)) :result #t)
(define-test min/maxvalelong (<elong (minvalelong) (maxvalelong)) :result #t)
(define-test min/maxvalllong (<llong (minvalllong) (maxvalllong)) :result #t)
(define-test minval (<= (minvalllong) (minvalelong)) :result #t)
(define-test minval (<= (minvalllong) (minvalfx)) :result #t)
(define-test maxval (>= (maxvalllong) (maxvalelong)) :result #t)
(define-test maxval (>= (maxvalllong) (maxvalfx)) :result #t)
(define-test equal (equal? 1 1) :result #t)
(define-test equal (equal? 1 2) :result #f)
(define-test equal (equal? 2 1) :result #f)
(define-test equal (equal? 1 #e1) :result #t)
