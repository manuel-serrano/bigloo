(define-test min (min 3 4) :expected 3) 
(define-test min (min 3.9 4) :expected 3.9)

(let ((un 1) (deux 2.0) (trois 3) (quatre 4.0))
   (define-test maxb (max un) :expected 1)
   (define-test maxb (max un deux) :expected deux)
   (define-test maxb (max deux un) :expected deux)
   (define-test maxb (max deux un 0) :expected deux)
   (define-test maxb (max deux trois 0) :expected 3.)
   (define-test maxb (max deux trois quatre) :expected quatre)
   (define-test minb (min un) :expected 1)
   (define-test minb (min un deux) :expected 1.)
   (define-test minb (min deux un) :expected 1.)
   (define-test minb (min deux un 0) :expected 0.)
   (define-test minb (min deux trois 0) :expected 0.)
   (define-test minb (min deux trois quatre) :expected deux))

(define-test maxfx (maxfx 1) :expected 1)
(define-test maxfx (maxfx 1 2) :expected 2)
(define-test maxfx (maxfx 2 1) :expected 2)
(define-test maxfx (maxfx 2 1 0) :expected 2)
(define-test maxfx (maxfx 2 3 0) :expected 3)
(define-test maxfx (maxfx 2 3 4) :expected 4)
(define-test minfx (minfx 1) :expected 1)
(define-test minfx (minfx 1 2) :expected 1)
(define-test minfx (minfx 2 1) :expected 1)
(define-test minfx (minfx 2 1 0) :expected 0)
(define-test minfx (minfx 2 3 0) :expected 0)
(define-test minfx (minfx 2 3 4) :expected 2)
(define-test maxelong (maxelong #e1) :expected #e1)
(define-test maxelong (maxelong #e1 #e2) :expected #e2)
(define-test maxelong (maxelong #e2 #e1) :expected #e2)
(define-test maxelong (maxelong #e2 #e1 #e0) :expected #e2)
(define-test maxelong (maxelong #e2 #e3 #e0) :expected #e3)
(define-test maxelong (maxelong #e2 #e3 #e4) :expected #e4)
(define-test minelong (minelong #e1) :expected #e1)
(define-test minelong (minelong #e1 #e2) :expected #e1)
(define-test minelong (minelong #e2 #e1) :expected #e1)
(define-test minelong (minelong #e2 #e1 #e0) :expected #e0)
(define-test minelong (minelong #e2 #e3 #e0) :expected #e0)
(define-test minelong (minelong #e2 #e3 #e4) :expected #e2)
(define-test maxllong (maxllong #l1) :expected #l1)
(define-test maxllong (maxllong #l1 #l2) :expected #l2)
(define-test maxllong (maxllong #l2 #l1) :expected #l2)
(define-test maxllong (maxllong #l2 #l1 #l0) :expected #l2)
(define-test maxllong (maxllong #l2 #l3 #l0) :expected #l3)
(define-test maxllong (maxllong #l2 #l3 #l4) :expected #l4)
(define-test minllong (minllong #l1) :expected #l1)
(define-test minllong (minllong #l1 #l2) :expected #l1)
(define-test minllong (minllong #l2 #l1) :expected #l1)
(define-test minllong (minllong #l2 #l1 #l0) :expected #l0)
(define-test minllong (minllong #l2 #l3 #l0) :expected #l0)
(define-test minllong (minllong #l2 #l3 #l4) :expected #l2)

(let ((un 1) (deux 2) (trois 3) (quatre 4))
   (define-test maxfxb (maxfx un) :expected 1)
   (define-test maxfxb (maxfx un deux) :expected deux)
   (define-test maxfxb (maxfx deux un) :expected deux)
   (define-test maxfxb (maxfx deux un 0) :expected deux)
   (define-test maxfxb (maxfx deux trois 0) :expected 3)
   (define-test maxfxb (maxfx deux trois quatre) :expected quatre)
   (define-test minbfx (minfx un) :expected 1)
   (define-test minbfx (minfx un deux) :expected 1)
   (define-test minbfx (minfx deux un) :expected 1)
   (define-test minbfx (minfx deux un 0) :expected 0)
   (define-test minbfx (minfx deux trois 0) :expected 0)
   (define-test minbfx (minfx deux trois quatre) :expected deux))

(let ((s (real->string 0.0)))
   (with-input-from-string s
      (lambda ()
         (let ((v (read)))
            (define-test read (real? v))
            (define-test read (and (>fl v -0.001) (<fl v 0.001)))))))

(define-test floor (floor -4.3) :expected -5.0)
(define-test floor (floor 3.5) :expected 3.0)
(define-test ceiling (ceiling -4.3) :expected -4.0)
(define-test ceiling (ceiling 3.5) :expected 4.0)
(define-test truncate (truncate -4.3) :expected -4.0)
(define-test truncate (truncate 3.5) :expected 3.0)
(define-test round (round -4.3) :expected -4.0)
(define-test round (round 3.5) :expected 4.0)
(define-test round (round 7) :expected 7)
(define-test modulo (modulo 13 4) :expected 1)
(define-test remainder (remainder 13 4) :expected 1)
(define-test modulo (modulo -13 4) :expected 3)
(define-test remainder (remainder -13 4) :expected -1)
(define-test modulo (modulo 13 -4) :expected -3)
(define-test remainder (remainder 13 -4) :expected 1)
(define-test modulo (modulo -13 -4) :expected -1)
(define-test remainder (remainder -13 -4) :expected -1)
(define-test llong-constant (foo-ko #l1) :expected (foo-ok #l1))
(define-test min/maxvalfx (<fx (minvalfx) (maxvalfx)) :expected #t)
(define-test min/maxvalelong (<elong (minvalelong) (maxvalelong)) :expected #t)
(define-test min/maxvalllong (<llong (minvalllong) (maxvalllong)) :expected #t)
(define-test minval (<= (minvalllong) (minvalelong)) :expected #t)
(define-test minval (<= (minvalllong) (minvalfx)) :expected #t)
(define-test maxval (>= (maxvalllong) (maxvalelong)) :expected #t)
(define-test maxval (>= (maxvalllong) (maxvalfx)) :expected #t)
(define-test equal (equal? 1 1) :expected #t)
(define-test equal (equal? 1 2) :expected #f)
(define-test equal (equal? 2 1) :expected #f)
(define-test equal (equal? 1 #e1) :expected #t)
(define-test equal (equal? #e1 #e1) :expected #t)
(define-test equal (equal? #e1 1) :expected #t)
(define-test equal (equal? 1 #l1) :expected #t)
(define-test equal (equal? #l1 #l1) :expected #t)
(define-test equal (equal? #l1 1) :expected #t)
(define-test equal (equal? (car (list 1)) (car (list 1))) :expected #t)
(define-test equal (equal? (car (list 1)) 2) :expected #f)
(define-test equal (equal? 2 (car (list 1))) :expected #f)
(define-test equal (equal? (car (list 1)) (car (list #e1))) :expected #t)
(define-test equal (equal? (car (list #e1)) (car (list #e1))) :expected #t)
(define-test equal (equal? (car (list #e1)) (car (list 1))) :expected #t)
(define-test equal (equal? (car (list 1)) (car (list #l1))) :expected #t)
(define-test equal (equal? (car (list #l1)) (car (list #l1))) :expected #t)
(define-test equal (equal? (car (list #l1)) (car (list 1))) :expected #t)
(define-test equal (equal? (car (list #l1)) (car (list 2))) :expected #f)
(define-test eqv (eqv? 1 1) :expected #t)
(define-test eqv (eqv? 1 2) :expected #f)
(define-test eqv (eqv? 2 1) :expected #f)
(define-test eqv (eqv? 1 #e1) :expected #t)
(define-test eqv (eqv? #e1 #e1) :expected #t)
(define-test eqv (eqv? #e1 1) :expected #t)
(define-test eqv (eqv? 1 #l1) :expected #t)
(define-test eqv (eqv? #l1 #l1) :expected #t)
(define-test eqv (eqv? #l1 1) :expected #t)
(define-test eqv (eqv? (car (list 1)) (car (list 1))) :expected #t)
(define-test eqv (eqv? (car (list 1)) 2) :expected #f)
(define-test eqv (eqv? 2 (car (list 1))) :expected #f)
(define-test eqv (eqv? (car (list 1)) (car (list #e1))) :expected #t)
(define-test eqv (eqv? (car (list #e1)) (car (list #e1))) :expected #t)
(define-test eqv (eqv? (car (list #e1)) (car (list 1))) :expected #t)
(define-test eqv (eqv? (car (list 1)) (car (list #l1))) :expected #t)
(define-test eqv (eqv? (car (list #l1)) (car (list #l1))) :expected #t)
(define-test eqv (eqv? (car (list #l1)) (car (list 1))) :expected #t)
(define-test eqv (eqv? (car (list #l1)) (car (list 2))) :expected #f)
(define-test equal-eval (eval '(equal? 1 1)) :expected #t)
(define-test equal-eval (eval '(equal? 1 2)) :expected #f)
(define-test equal-eval (eval '(equal? 2 1)) :expected #f)
(define-test equal-eval (eval '(equal? 1 #e1)) :expected #t)
(define-test equal-eval (eval '(equal? #e1 #e1)) :expected #t)
(define-test equal-eval (eval '(equal? #e1 1)) :expected #t)
(define-test equal-eval (eval '(equal? 1 #l1)) :expected #t)
(define-test equal-eval (eval '(equal? #l1 #l1)) :expected #t)
(define-test equal-eval (eval '(equal? #l1 1)) :expected #t)
(define-test equal-eval (eval '(equal? (car (list 1)) (car (list 1)))) :expected #t)
(define-test equal-eval (eval '(equal? (car (list 1)) 2)) :expected #f)
(define-test equal-eval (eval '(equal? 2 (car (list 1)))) :expected #f)
(define-test equal-eval (eval '(equal? (car (list 1)) (car (list #e1)))) :expected #t)
(define-test equal-eval (eval '(equal? (car (list #e1)) (car (list #e1)))) :expected #t)
(define-test equal-eval (eval '(equal? (car (list #e1)) (car (list 1)))) :expected #t)
(define-test equal-eval (eval '(equal? (car (list 1)) (car (list #l1)))) :expected #t)
(define-test equal-eval (eval '(equal? (car (list #l1)) (car (list #l1)))) :expected #t)
(define-test equal-eval (eval '(equal? (car (list #l1)) (car (list 1)))) :expected #t)
(define-test equal-eval (eval '(equal? (car (list #l1)) (car (list 2)))) :expected #f)
(define-test eqv-eval (eval '(eqv? 1 1)) :expected #t)
(define-test eqv-eval (eval '(eqv? 1 2)) :expected #f)
(define-test eqv-eval (eval '(eqv? 2 1)) :expected #f)
(define-test eqv-eval (eval '(eqv? 1 #e1)) :expected #t)
(define-test eqv-eval (eval '(eqv? #e1 #e1)) :expected #t)
(define-test eqv-eval (eval '(eqv? #e1 1)) :expected #t)
(define-test eqv-eval (eval '(eqv? 1 #l1)) :expected #t)
(define-test eqv-eval (eval '(eqv? #l1 #l1)) :expected #t)
(define-test eqv-eval (eval '(eqv? #l1 1)) :expected #t)
(define-test eqv-eval (eval '(eqv? (car (list 1)) (car (list 1)))) :expected #t)
(define-test eqv-eval (eval '(eqv? (car (list 1)) 2)) :expected #f)
(define-test eqv-eval (eval '(eqv? 2 (car (list 1)))) :expected #f)
(define-test eqv-eval (eval '(eqv? (car (list 1)) (car (list #e1)))) :expected #t)
(define-test eqv-eval (eval '(eqv? (car (list #e1)) (car (list #e1)))) :expected #t)
(define-test eqv-eval (eval '(eqv? (car (list #e1)) (car (list 1)))) :expected #t)
(define-test eqv-eval (eval '(eqv? (car (list 1)) (car (list #l1)))) :expected #t)
(define-test eqv-eval (eval '(eqv? (car (list #l1)) (car (list #l1)))) :expected #t)
(define-test eqv-eval (eval '(eqv? (car (list #l1)) (car (list 1)))) :expected #t)
(define-test eqv-eval (eval '(eqv? (car (list #l1)) (car (list 2)))) :expected #f)

(seed-random! 10)

(let* ((v1 (random 10))
       (v2 (random 100)))
   (seed-random! 10)
   (let* ((v3 (random 10))
          (v4 (random 100)))
      (define-test random (and (>=fx v3 0) (<fx v3 10)))
      (define-test random (and (>=fx v4 0) (<fx v4 100)))
      (define-test random (cons v1 v2) :expected (cons v3 v4))))
	 
   

