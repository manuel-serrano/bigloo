(cond-expand
   (bint31
    (define-test eabs (= (abs (- #e1073741823)) #e1073741823)))
   (else
    (define-test eabs (= (abs (- #e2147483648)) #e2147483648))
    (define-test eabs (= (abs (- #e9223372036854775808)) #e9223372036854775808))))

(define-test labs (= (abs #l0) #l0) :result #t)
(define-test labs (= (abs #l1) #l1) :result #t)
(define-test labs (= (abs #l-1) #l1) :result #t)
(define-test labs (= (abs #l-2147483648) #l2147483648) :result #t)
