(define-test negllong (negllong #l214748364) :result #l-214748364)
(define-test negllong (negllong #l2147483648) :result #l-2147483648)
(define-test exp (exp 4.2) :eq ~equal? :result 66.68633104092515)
(define-test log (log 4.2) :eq ~equal? :result 1.4350845252893227)
(define-test log2 (log2 4.2) :eq ~equal? :result 2.070389327891398)
(define-test log10 (log10 4.2) :eq ~equal? :result 0.6232492903979004)
(define-test expt (expt 2 -1) :result 0.5)
(define-test expt (expt 2 -1.0) :result 0.5)
(define-test expt (expt -1 256) :result 1)
(define-test expt (expt -1 255) :result -1)
(define-test expt (eval '(expt -1 256)) :result 1)
(define-test expt (eval '(expt -1 255)) :result -1)
(define-test max (max 1) :result 1)
(define-test max (max 1 2) :result 2)
(define-test max (max 2 1) :result 2)
(define-test max (max 2 1 0) :result 2)
(define-test max (max 2 3 0) :result 3)
(define-test max (max 2 3 4) :result 4)
(define-test max (max 3 4) :result 4)
(define-test max (max 3.9 4) :result 4.)
(define-test max (max 3.9 4.) :result 4.)
(define-test min (min 1) :result 1)
(define-test min (min 1 2) :result 1)
(define-test min (min 2 1) :result 1)
(define-test min (min 2 1 0) :result 0)
(define-test min (min 2 3 0) :result 0)
(define-test min (min 2 3 4) :result 2)
(define-test min (min 3 4) :result 3) 
(define-test min (min 3.9 4) :result 3.9)

(let ((un 1) (deux 2.0) (trois 3) (quatre 4.0))
   (define-test maxb (max un) :result 1)
   (define-test maxb (max un deux) :result deux)
   (define-test maxb (max deux un) :result deux)
   (define-test maxb (max deux un 0) :result deux)
   (define-test maxb (max deux trois 0) :result 3.)
   (define-test maxb (max deux trois quatre) :result quatre)
   (define-test minb (min un) :result 1)
   (define-test minb (min un deux) :result 1.)
   (define-test minb (min deux un) :result 1.)
   (define-test minb (min deux un 0) :result 0.)
   (define-test minb (min deux trois 0) :result 0.)
   (define-test minb (min deux trois quatre) :result deux))

(define-test maxfx (maxfx 1) :result 1)
(define-test maxfx (maxfx 1 2) :result 2)
(define-test maxfx (maxfx 2 1) :result 2)
(define-test maxfx (maxfx 2 1 0) :result 2)
(define-test maxfx (maxfx 2 3 0) :result 3)
(define-test maxfx (maxfx 2 3 4) :result 4)
(define-test minfx (minfx 1) :result 1)
(define-test minfx (minfx 1 2) :result 1)
(define-test minfx (minfx 2 1) :result 1)
(define-test minfx (minfx 2 1 0) :result 0)
(define-test minfx (minfx 2 3 0) :result 0)
(define-test minfx (minfx 2 3 4) :result 2)
