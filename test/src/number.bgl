;*---------------------------------------------------------------------*/
;*    real                                                             */
;*---------------------------------------------------------------------*/
(module number
   (export test))

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "./test.bgh")

;*---------------------------------------------------------------------*/
;*    test ...                                                         */
;*---------------------------------------------------------------------*/
(define (test verbose tests::pair-nil)
   (when (or (null? tests) (member "number" tests))
      (test-all verbose "number")))

;*---------------------------------------------------------------------*/
;*    llong constant ...                                               */
;*---------------------------------------------------------------------*/
(define (foo-ok::llong x::llong)
  (let ((bar #l268435456))
    (quotientllong x bar)))

(define (foo-ko::llong x::llong)
  (quotientllong x #l268435456))

