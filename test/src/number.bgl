(define-test minelong (minelong #e2 #e1) :result #e1)
(define-test minelong (minelong #e2 #e1 #e0) :result #e0)
(define-test minelong (minelong #e2 #e3 #e0) :result #e0)
(define-test minelong (minelong #e2 #e3 #e4) :result #e2)
(define-test maxllong (maxllong #l1) :result #l1)
(define-test maxllong (maxllong #l1 #l2) :result #l2)
