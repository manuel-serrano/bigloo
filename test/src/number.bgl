(define-test flofix.< (let ((x 3.0) (y 3)) (< x y)) :expected #f)
(define-test flofix.< (let ((x 3.1) (y 3)) (< x y)) :expected #f)
(define-test flofix.< (let ((x 3.1) (y 4)) (< x y)) :expected #t)
(define-test flofix.> (let ((x 3) (y 3.0)) (> x y)) :expected #f)
(define-test flofix.> (let ((x 3) (y 3.1)) (> x y)) :expected #f)
(define-test flofix.> (let ((x 4) (y 3.1)) (> x y)) :expected #t)
(define-test flofix.<= (let ((x 3) (y 3.0)) (<= x y)) :expected #t)
(define-test flofix.<= (let ((x 3) (y 3.1)) (<= x y)) :expected #t)
(define-test flofix.<= (let ((x 3) (y 2.0)) (<= x y)) :expected #f)
(define-test flofix.>= (let ((x 3.0) (y 3)) (>= x y)) :expected #t)
(define-test flofix.>= (let ((x 3.1) (y 3)) (>= 3 3)) :expected #t)
(define-test flofix.>= (let ((x 3.1) (y 4)) (>= 3 4)) :expected #f)
(define-test flofix.< (let ((x -0.2) (y 0)) (< x y)) :expected #t)

(define-test string->number (string->number "0") :expected 0)
