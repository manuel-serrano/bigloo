(seed-random! 10)

(let* ((v1 (random 10))
       (v2 (random 100)))
   (seed-random! 10)
   (let* ((v3 (random 10))
          (v4 (random 100)))
      (define-test random (and (>=fx v3 0) (<fx v3 10)))
      (define-test random (and (>=fx v4 0) (<fx v4 100)))
      (define-test random (cons v1 v2) :result (cons v3 v4))))
	 
(define-test cos (cos 0.5) :eq ~equal? :result 0.8775825618903728)
(define-test cos (cos -0.3) :eq ~equal? :result 0.955336489125606)

(define-test sin (sin 0.5) :eq ~equal? :result 0.479425538604203)
(define-test sin (sin -0.3) :eq ~equal? :result -0.29552020666133955)

(define-test tan (tan 0.5) :eq ~equal? :result 0.5463024898437905)
(define-test tan (tan -0.3) :eq ~equal? :result -0.30933624960962325)

(define-test acos (acos 0.5) :eq ~equal? :result 1.0471975511965979)
(define-test acos (acos -0.3) :eq ~equal? :result 1.8754889808102941)

(define-test asin (asin 0.5) :eq ~equal? :result 0.5235987755982989)
(define-test asin (asin -0.3) :eq ~equal? :result -0.3046926540153975)

(define-test atan (atan 0.5) :eq ~equal? :result 0.4636476090008061)
(define-test atan (atan -0.3) :eq ~equal? :result -0.2914567944778671)

(define-test sqrt (sqrt 4.) :eq ~equal? :result 2.)
(define-test sqrt (sqrt 9) :eq ~equal? :result 3.)
