(define-test equal (equal? 1 #l1) :result #t)
(define-test equal (equal? #l1 #l1) :result #t)
(define-test equal (equal? #l1 1) :result #t)
(define-test equal (equal? (car (list 1)) (car (list 1))) :result #t)
(define-test equal (equal? (car (list 1)) 2) :result #f)
(define-test equal (equal? 2 (car (list 1))) :result #f)
(define-test equal (equal? (car (list 1)) (car (list #e1))) :result #t)
(define-test equal (equal? (car (list #e1)) (car (list #e1))) :result #t)
