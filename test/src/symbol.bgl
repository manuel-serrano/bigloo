;*    -------------------------------------------------------------    */
;*    Testing symbols and keywords                                     */
;*=====================================================================*/

;*---------------------------------------------------------------------*/
;*    symbols                                                          */
;*---------------------------------------------------------------------*/
(module symbols
   (export test))

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "./test.bgh")

;*---------------------------------------------------------------------*/
;*    test ...                                                         */
;*---------------------------------------------------------------------*/
(define (test verbose tests::pair-nil)
   (when (or (null? tests) (member "symbol" tests))
      (test-all verbose "symbol")))

;*---------------------------------------------------------------------*/
;*    tests                                                            */
;*---------------------------------------------------------------------*/
(define-test symbol? (symbol? 'foo))
(define-test symbol? (symbol? :foo) :result #f)
(define-test symbol? (symbol? (string->symbol "foo")))
(define-test symbol? (symbol? '|;|))

(define-test symbol-exists? (symbol-exists? (symbol->string 'foo)))
(define-test symbol-exists? (symbol-exists? "does not exist") :result #f)

(define-test eq? (eq? 'a 'a)
   :result #t)
(define-test eq? (eq? 'a 'A)
   :result #f)
(define-test eq? (eq? 'A 'A)
   :result #t)
(define-test eq? (eq? 'a 'b)
   :result #f)
(define-test eq? (eq? ':=   '|:=|)
   :result #f)
(define-test symbol '|foo\|bar|
   :result (string->symbol "foo\|bar"))
(define-test symbol
   (string=? (call-with-output-string (lambda (p) (write '|foo\|bar| p)))
      "|foo\\|bar|"))

(define-test eqv? (eqv? 'a 'a)
   :result #t)
(define-test eqv? (eqv? 'a 'A)
   :result #f)
(define-test eqv? (eqv? 'A 'A)
   :result #t)
(define-test eqv? (eqv? 'a 'b)
   :result #f)

(define-test string->symbol (symbol? (string->symbol ";")))

(define-test string 'étè
   :result (string->symbol "étè"))
(define-test string (symbol? (with-input-from-string "||" read))
   :result #t)
(define-test string (with-input-from-string "||" read)
   :result (string->symbol ""))
(define-test string (symbol? (with-input-from-string "|'|" read))
   :result #t)
(define-test string (with-input-from-string "|'|" read)
   :result (string->symbol "'"))
(define-test string (with-input-from-string "|{|" read)
   :result (string->symbol "{"))
(define-test string (with-input-from-string "|(|" read)
   :result (string->symbol "("))
(define-test string (with-input-from-string "|()|" read)
   :result (string->symbol "()"))
(define-test string (symbol? (with-input-from-string "|foo bar|" read))
   :result #t)
(define-test string (with-input-from-string "|foo bar|" read)
   :result 
   (string->symbol "foo bar"))

(define-test string->symbol
   (string->symbol "new Function( \"return hop_service( \\\"/hop/mailto\\\", arguments )\" )")
   :result (string->symbol (string-append "new Function( \"return hop_service( \\\"/hop/mailto\\\", arguments )\" )" "")))
(define-test string (symbol? (string->symbol "01234"))
   :result #t)

(let ((s1 (symbol->string '|:=|))
      (s2 (symbol->string '|:=|)))
   (define-test string->symbol (string=? s1 s2)
      :result #t))

(let ((s1 (with-output-to-string (lambda () (write ':=))))
      (s2 (with-output-to-string (lambda () (write '|:=|)))))
   (define-test string->symbol (string=? s1 s2)
      :result #f))

(let ((s1 (with-output-to-string (lambda () (write '|(|))))
      (s2 (with-output-to-string (lambda () (write (string->symbol "("))))))
   (define-test string.symbol (string=? s1 s2)
      :result #t))
   
(let ((s (with-output-to-string (lambda () (write '(|;| k))))))
   (with-input-from-string s
      (lambda ()
         (let ((v (read)))
            (define-test symbol
               (and (pair? v)
                    (pair? (cdr v))
                    (null? (cddr v))
                    (equal? v (list (string->symbol ";") 'k))))))))

(define-test symbol (symbol? '|(ab)|)
   :result #t)
(define-test symbol '|(a,b)|
   :result (string->symbol "(a,b)"))
(define-test symbol (symbol? '|:=|)
   :result #t)
(define-test symbol '|.|
   :result (string->symbol "."))

(let ((s1 (with-output-to-string (lambda () (write '|.|))))
      (s2 (with-output-to-string (lambda () (write (string->symbol "."))))))
   (define-test string (string=? s1 s2)
      :result #t))

(define-test symbol->string (symbol->string '.foo)
   :result ".foo")
(define-test string->symbol '.foo
   :result (string->symbol ".foo"))
(define-test string->symbol (string->symbol "`")
   :result '|`|)

(define-test gensym(symbol? (gensym))
   :result #t)
(define-test gensym (symbol? (gensym 'foo))
   :result #t)
(define-test gensym (symbol? (gensym "foo"))
   :result #t)
(define-test gensym (eq? (gensym) (gensym))
   :result #f)
(define-test gensym (eq? (gensym 'foo) (gensym 'foo))
   :result #f)
(let ((s (gensym)))
   (define-test gensym (eq? s (string->symbol (symbol->string s)))
      :result #t))

(define-test keyword (eq? :foo foo:)
   :result #t)
(define-test keyword (eq? :foo bar:)
   :result #f)
(define-test keyword (eq? :foo :Foo)
   :result #f)
(define-test keyword (eq? (string->keyword "foo") foo:)
   :result #t)
(define-test keyword (eq? (string->keyword "foo") :foo)
   :result #t)
(define-test keyword (eq? (string->keyword "foo:") foo:)
   :result #f)

(define-test keyword? (keyword? :foo:))
(define-test keyword? (keyword? :foo:))
(define-test keyword? (keyword? 'foo) :result #f)
(define-test keyword? (keyword? (string->keyword "foo")))

(define-test keyword
   (let* ((p (open-input-string "bar: :bar"))
          (s0 (keyword->string (read p)))
          (s1 (keyword->string (read p))))
      (string-append s0 " " s1))
   :result "bar bar")
(define-test keyword
   (let* ((s0 (keyword->string :bar))
          (s1 (keyword->string bar:)))
      (string-append s0 " " s1))
   :result "bar bar")
(define-test keyword
   (call-with-output-string
      (lambda (p)
         (display :bar p)
         (display " " p)
         (display bar: p)))
   :result "bar: bar:")

(define-test symbol->string (symbol->string '|foo bar|)
   :result "foo bar")

(define-test symbol->string
   (eq? (symbol->string 'foo) (symbol->string 'foo))
   :result #f)

(define-test symbol->string!
   (eq? (symbol->string! 'foo) (symbol->string! 'foo)))

(define-test string->symbol-ci
   (string->symbol-ci "foo")
   :result 'FOO)

(define-test keyword->string
   (eq? (keyword->string ':foo) (keyword->string ':foo))
   :result #f)

(define-test string->keyword
   (eq? (string->keyword "foo") :foo))

(define-test string->keyword
   (eq? (string->keyword "foo") foo:))

(define-test keyword->symbol
   (keyword->symbol :foo)
   :result 'foo)

(define-test keyword->symbol
   (keyword->symbol foo:)
   :result 'foo)

(define-test symbol->keyword
   (symbol->keyword 'foo)
   :result :foo)

(define-test symbol-append
   (symbol-append 'foo 'bar 'gee)
   :result 'foobargee)

(define-test symbol-append
   (symbol-append 'foo '|::| 'bar)
   :result 'foo::bar)

(define-test gensym
   (gensym)
   :result symbol?)

(define-test gensym
   (gensym "foo")
   :result symbol?)

(define-test gensym
   (gensym 'bar)
   :result symbol?)

(define-test genuuid
   (genuuid)
   :result string?)
