            (socket-close s))))
   :cond-expand (not wasm))

(define-test socket-accept
   (let ((serv (make-server-socket))
         (mu (make-mutex))
         (cv (make-condition-variable))
         (ready #f))
      (thread-start!
         (instantiate::pthread
            (body (lambda ()
                     (synchronize mu
                        (set! ready #t)
                        (condition-variable-broadcast! cv))
                     (socket-accept serv)))))
      (synchronize mu
         (unless ready
            (condition-variable-wait! cv mu)))
      ready)
   :cond-expand (library pthread))

(define-test socket-close
   (with-handler
      (lambda (e)
         (exception-notify e)
         #f)
      (let ((s (make-client-socket "localhost" 22)))
         (socket-close s)
         (socket-down? s)))
   :cond-expand (not wasm))

