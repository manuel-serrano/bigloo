;*---------------------------------------------------------------------*/
;*    net                                                              */
;*---------------------------------------------------------------------*/
(module net
   (export test))

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "./test.bgh")

;*---------------------------------------------------------------------*/
;*    test ...                                                         */
;*---------------------------------------------------------------------*/
(define (test verbose tests::pair-nil)
   (when (or (null? tests) (member "net" tests))
      (test-all verbose "net")))

;*---------------------------------------------------------------------*/
;*    tests                                                            */
;*---------------------------------------------------------------------*/
(define-test socket?
   (socket? (make-server-socket
               (cond-expand
                  (C 1966)
                  (jvm 1967)
                  (wasm 1968)
                  (else 1969)))))

(define-test socket?
   (socket? '#(1))
   :expected #f)

(define-test socket?
   (with-handler
      (lambda (e)
         #f)
      (socket? (make-client-socket "localhost" 22))))

(define-test socket-client?
   (with-handler
      (lambda (e)
         #f)
      (socket-client? (make-client-socket "localhost" 22))))

(define-test socket-client?
   (with-handler
      (lambda (e)
         #t)
      (socket-server? (make-client-socket "localhost" 22)))
   :cond-expand (not wasm)
   :expected #f)

(define-test socket-server?
   (with-handler
      (lambda (e)
         #f)
      (socket-server? (make-server-socket))))

(define-test datagram-socket?
   (with-handler
      (lambda (e)
         #t)
      (datagram-socket? (make-client-socket "localhost" 22)))
   :cond-expand (not wasm)
   :expected #f)

(define-test make-client-socket
   (with-handler
      (lambda (e)
         #f)
      (socket? (make-client-socket "localhost" 22))))

(define-test make-client-socket
   (with-handler
      (lambda (e)
         #f)
      (socket? (make-client-socket "localhost" 22 :inbuf #f :outbuf #f))))

(define-test socket-hostname
   (with-handler
      (lambda (e)
         #f)
      (socket-hostname (make-client-socket "localhost" 22)))
   :cond-expand (not wasm)
   :expected "localhost")

(define-test socket-host-address
   (with-handler
      (lambda (e)
         #f)
      (socket-host-address (make-client-socket "localhost" 22)))
   :cond-expand (not wasm)
   :expected "127.0.0.1")

(define-test socket-local-address
   (with-handler
      (lambda (e)
         (exception-notify e)
         #f)
      (socket-local-address (make-client-socket "localhost" 22)))
   :cond-expand (not wasm)
   :expected "127.0.0.1")

(define-test socket-port-number
   (with-handler
      (lambda (e)
         #f)
      (socket-port-number (make-client-socket "localhost" 22)))
   :expected 22)


