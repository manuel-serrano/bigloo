;*---------------------------------------------------------------------*/
;*    net                                                              */
;*---------------------------------------------------------------------*/
(module net
   (export test))

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "./test.bgh")

;*---------------------------------------------------------------------*/
;*    test ...                                                         */
;*---------------------------------------------------------------------*/
(define (test verbose tests::pair-nil)
   (when (or (null? tests) (member "net" tests))
      (test-all verbose "net")))


;*---------------------------------------------------------------------*/
;*    tests                                                            */
;*---------------------------------------------------------------------*/
(define-test socket?
   (socket? (make-server-socket 1966)))

(define-test socket?
   (socket? '#(1))
   :expected #f)

(define-test socket?
   (with-handler
      (lambda (e)
         #t)
      (socket? (make-client-socket "localhost" 22))))

(define-test socket-client?
   (with-handler
      (lambda (e)
         #t)
      (socket-client? (make-client-socket "localhost" 22))))

(define-test socket-client?
   (with-handler
      (lambda (e)
         #f)
      (socket-server? (make-client-socket "localhost" 22)))
   :expected #f)

(define-test socket-server?
   (with-handler
      (lambda (e)
         #t)
      (socket-server? (make-server-socket))))

(define-test datagram-socket?
   (with-handler
      (lambda (e)
         #f)
      (datagram-socket? (make-server-socket "localhost" 22)))
   :expected #f)
