;*---------------------------------------------------------------------*/
;*    net                                                              */
;*---------------------------------------------------------------------*/
(module net
   (cond-expand ((library pthread) (library pthread)))
   (export test))

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "./test.bgh")

;*---------------------------------------------------------------------*/
;*    test ...                                                         */
;*---------------------------------------------------------------------*/
(define (test verbose tests::pair-nil)
   (when (or (null? tests) (member "net" tests))
      (test-all verbose "net")))

;*---------------------------------------------------------------------*/
;*    tests                                                            */
;*---------------------------------------------------------------------*/
(define-test socket?
   (let ((s (make-server-socket
               (cond-expand
                  (C 1966)
                  (jvm 1967)
                  (wasm 1968)
                  (else 1969)))))
      (unwind-protect
         (socket? s)
         (socket-close s))))

(define-test socket?
   (socket? '#(1))
   :expected #f)

(define-test socket?
   (with-handler
      (lambda (e)
         #f)
      (let ((s (make-client-socket "localhost" 22)))
         (unwind-protect
            (socket? s)
            (socket-close s)))))

(define-test socket-client?
   (with-handler
      (lambda (e)
         #f)
      (let ((s (make-client-socket "localhost" 22)))
         (unwind-protect
            (socket-client? s)
            (socket-close s)))))

(define-test socket-client?
   (with-handler
      (lambda (e)
