;*---------------------------------------------------------------------*/
;*    thread                                                           */
;*---------------------------------------------------------------------*/
(module thread
   (cond-expand ((library pthread) (library pthread)))
   (export test))

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "./test.bgh")

;*---------------------------------------------------------------------*/
;*    test ...                                                         */
;*---------------------------------------------------------------------*/
(define (test verbose tests::pair-nil)
   (when (or (null? tests) (member "thread" tests))
      (test-all verbose "thread")))

;*---------------------------------------------------------------------*/
;*    tests ...                                                        */
;*---------------------------------------------------------------------*/
(define-test current-thread (thread? (current-thread))
   :expected #f)

(define-test thread? (thread? (make-thread list))
   :expected #t)

(define-test thread? (thread? 'a-symbol)
   :expected #f)

(define-test make-thread (thread? (make-thread (lambda () 'done)))
   :expected #t)

(define-test make-thread (thread-name (make-thread (lambda () 'done) "foo"))
   :expected "foo")

(define-test thread-name (thread-name (make-thread list "a thread"))
   :expected "a thread")
                            
(define-test thread-name-set!
   (let ((th (make-thread list)))
      (thread-name-set! th "another thread")
      (thread-name th))
   :expected "another thread")
                            
(define-test thread-specific (thread-specific (make-thread list))
   :expected #unspecified)
                            
(define-test thread-specific-set!
   (let ((th (make-thread list)))
      (thread-specific-set! th (cons 1 2))
      (thread-specific th))
   :expected '(1 . 2))
                            
(define-test thread-parameter (thread-parameter 'key)
   :expected #f)
                            
(define-test thread-parameter-set!
   (let* ((res #f)
          (th (thread-join!
                 (thread-start-joinable!
                    (make-thread
                       (lambda ()
                          (thread-parameter-set! 'key (cons 1 2))
                          (set! res (thread-parameter 'key))))))))
      res)
   :cond-expand (library pthread)
   :expected '(1 . 2))

(define-test thread-cleanup
   (thread-cleanup (make-thread list))
   :expected #unspecified)

(define-test thread-cleanup-set!
   (let* ((res #f)
          (t (make-thread list)))
      (thread-cleanup-set! t
         (lambda (v)
            (set! res
               (cons (thread? (current-thread))
                  (procedure? (thread-cleanup (current-thread)))))))
      (thread-join! (thread-start-joinable! t))
      res)
   :cond-expand (library pthread)
   :expected (cons #t #t))

(define-test thread-start!
   (begin (thread-start! (make-thread list)) #t)
   :cond-expand (library pthread)
   :expected #t)

(define-test thread-start-joinable!
   (begin (thread-start-joinable! (make-thread list)) #t)
   :cond-expand (library pthread)
   :expected #t)

(define-test thread-join!
   (begin (thread-join! (thread-start-joinable! (make-thread list))) #t)
   :cond-expand (library pthread)
   :expected #t)

(define-test thread-kill!
   (procedure? thread-kill!)
   :cond-expand (library pthread)
   :expected #t)

(define-test mutex? (mutex? (make-mutex))
   :expected #t)

(define-test mutex? (mutex? (make-thread list))
   :expected #f)

(define-test make-mutex (mutex? (make-mutex))
   :expected #t)

(define-test make-spinlock (mutex? (make-spinlock))
   :expected #t)

(define-test mutex-name (mutex-name (make-mutex "a-mutex"))
   :expected "a-mutex")

(define-test mutex-state (mutex-state (make-mutex))
   :cond-expand (library pthread)
   :expected 'unlocked)

(define-test mutex-lock! (begin (mutex-lock! (make-mutex)) #t)
   :expected #t)

(define-test mutex-unlock!
   (let ((m (make-mutex)))
      (mutex-lock! m)
      (unwind-protect
         #t
         (mutex-unlock! m)))
   :expected #t)

(define-test synchronize (synchronize (make-mutex) #t)
   :expected #t)

(define-test condition-variable? (condition-variable? (make-condition-variable))
   :expected #t)

(define-test condition-variable? (condition-variable? (make-mutex))
   :expected #f)

(define-test make-condition-variable (condition-variable? (make-condition-variable))
   :expected #t)

(define-test condition-variable-name (condition-variable-name (make-condition-variable "a condv"))
   :expected "a condv")

(define-test condition-variable-wait!
   (let* ((res 0)
          (mu (make-mutex))
          (cv (make-condition-variable))
          (th1 (make-thread (lambda ()
                               (synchronize mu
                                  (when (=fx res 0)
                                     (condition-variable-wait! cv mu))
                                  (set! res (+fx res 1))
                                  (condition-variable-signal! cv)))))
          (th2 (make-thread (lambda ()
                               (synchronize mu
                                  (condition-variable-signal! cv)
                                  (set! res (+fx res 1))
                                  (condition-variable-wait! cv mu))))))
      (thread-start! th1)
      (thread-join! (thread-start-joinable! th2))
      res)
   :cond-expand (library pthread)
   :expected 2)

(define-test condition-variable-signal!
   (let ((cv (make-condition-variable)))
      (condition-variable-signal! cv)
      #t)
   :cond-expand (library pthread)
   :expected #t)
   
(define-test condition-variable-broadcast!
   (let ((cv (make-condition-variable)))
      (condition-variable-broadcast! cv)
      #t)
   :cond-expand (library pthread)
   :expected #t)

(define-test pthread
    (thread? (instantiate::pthread (body list)))
    :cond-expand (library pthread)
    :expected #t)

(define-test open-semaphore
   (semaphore? (open-semaphore "semaphore1"))
   :cond-expand (and C (library pthread))
   :expected #t)

(define-test semaphore?
   (semaphore? (open-semaphore "semaphore1"))
   :cond-expand (and C (library pthread))
   :expected #t)

(define-test semaphore?
   (semaphore? (make-mutex))
   :cond-expand (and C (library pthread))
   :expected #f)

(define-test close-semaphore
   (close-semaphore (open-semaphore "semaphore2"))
   :cond-expand (and C (library pthread))
   :expected #t)

(define-test delete-semaphore
   (delete-semaphore (open-semaphore "semaphore2"))
   :cond-expand (and C (library pthread))
   :expected #t)

(define-test semaphore-post
   (let* ((res 0)
          (sem (open-semaphore "sync"))
          (th1 (make-thread (lambda ()
                               (semaphore-wait sem)
                               (set! res (+fx res 1)))))
          (th2 (make-thread (lambda ()
                               (set! res (+fx res 1))
                               (semaphore-post sem)))))
      (thread-start! th1)
      (thread-join! (thread-start-joinable! th2))
      res)
   :cond-expand (and C (library pthread))
   :expected 2)

(define-test semaphore-trywait
   (let* ((res 0)
          (sem (open-semaphore "sync"))
          (th1 (make-thread (lambda ()
                               (semaphore-trywait sem)
                               (set! res (+fx res 1)))))
          (th2 (make-thread (lambda ()
                               (set! res (+fx res 1))
                               (semaphore-post sem)))))
      (thread-start! th1)
      (thread-join! (thread-start-joinable! th2))
      (+ res (semaphore-value sem)))
   :cond-expand (and C (library pthread))
   :expected 3)

(define-test semaphore-value
   (semaphore-value (open-semaphore "semaphore4" :value 20))
   :cond-expand (and C (library pthread))
   :expected 20)


