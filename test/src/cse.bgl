;*---------------------------------------------------------------------*/
;*    cse                                                              */
;*---------------------------------------------------------------------*/
(module cse
   (export test))

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "./test.bgh")

;*---------------------------------------------------------------------*/
;*    foo ...                                                          */
;*---------------------------------------------------------------------*/
(define (foo x)
   (let ((y (car x)))
      (set-car! x 3)
      (let ((z (car x)))
	 z)))

;*---------------------------------------------------------------------*/
;*    bar ...                                                          */
;*---------------------------------------------------------------------*/
(define (bar x)
   (let ((y (car x)))
      (foo x)
      (let ((z (car x)))
	 z)))

;*---------------------------------------------------------------------*/
;*    gee ...                                                          */
;*---------------------------------------------------------------------*/
(define (gee l::pair)
   ;; this function was badly compiled due to a bug in the cse
   ;; that propagate the binding (a (c-car l)) into the loop.
   (let ((a ($car l)))
      (let loop ((a a))
	 (if ($pair? a)
	     (begin
		($set-car! l '(3))
		(loop ($cdr a)))
	     (let ((a ($car l)))
		($set-cdr! a 4)
		a))))) 

;*---------------------------------------------------------------------*/
;*    test9 ...                                                        */
;*---------------------------------------------------------------------*/
(define (test9)
   (let ((p (open-input-string "1 2 3 4 5 6 7")))
      (let* ((x (read p))
	     (y (eq? 'toto (read p)))
	     (z (read p)))
	 (= (+ x z) 4))))

;*---------------------------------------------------------------------*/
;*    test ...                                                         */
;*---------------------------------------------------------------------*/
(define (test verbose tests::pair-nil)
   (when (or (null? tests) (member "test" tests))
      (test-all verbose "test")))

;*---------------------------------------------------------------------*/
;*    tests                                                            */
;*---------------------------------------------------------------------*/
(define-test cse (foo '(1 2)) :result 3)
(define-test cse (bar '(1 2)) :result 3)
(define-test cse (gee '((1))) :result '(3 . 4))
(define-test cse (test9) :result #t)
