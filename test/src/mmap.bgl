;*---------------------------------------------------------------------*/
;*    mmap                                                             */
;*---------------------------------------------------------------------*/
(module mmap
   (export test))

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "./test.bgh")

;*---------------------------------------------------------------------*/
;*    test ...                                                         */
;*---------------------------------------------------------------------*/
(define (test verbose tests::pair-nil)
   (when (or (null? tests) (member "mmap" tests))
      (test-all verbose "mmap")))

;*---------------------------------------------------------------------*/
;*    tests                                                            */
;*---------------------------------------------------------------------*/
(define-test mmap?
   (let ((mm (open-mmap mmap.filename)))
      (unwind-protect
         (mmap? mm)
         (close-mmap mm)))
   :expected #t)
(define-test mmap? (mmap? list) :expected #f)
(define-test mmap? (mmap? 1) :expected #f)
(define-test mmap? (mmap? "foo") :expected #f)

(define-test open-mmap
   (let ((mm (open-mmap mmap.filename :write #f)))
      (unwind-protect
         (mmap? mm)
         (close-mmap mm))))

(define-test close-mmap
   (begin (close-mmap (open-mmap mmap.filename :write #f)) #t))

(define-test call-with-input-mmap
   (call-with-input-mmap mmap.filename mmap?))

(define-test call-with-output-mmap
   call-with-output-mmap
   :expected procedure?)

(define-test call-with-output-mmap
   (procedure-arity call-with-output-mmap)
   :expected 2)

(define-test mmap-length
   (let ((mm (open-mmap mmap.filename)))
      (unwind-protect
         (mmap-length mm)
         (close-mmap mm)))
   :expected (file-size mmap.filename))

(define-test string->mmap
   (mmap? (string->mmap "foo bar")))

(define-test mmap->string
   (string-length (mmap->string (string->mmap "foo bar")))
   :expected 7)

(define-test mmap->bstring
   (mmap->bstring (string->mmap "foo bar"))
   :expected string?)

(define-test mmap-name
   (let ((mm (open-mmap mmap.filename)))
      (unwind-protect
         (mmap-name mm)
         (close-mmap mm)))
   :expected mmap.filename)

(define-test mmap-ref
   (call-with-input-mmap mmap.filename
      (lambda (mm)
         (and (char=? (mmap-ref mm 0) #\;)
              (char=? (mmap-ref mm 1) #\;)))))

(define-test mmap-set!
   (let* ((s (make-string 10 #\a))
          (m (string->mmap s)))
      (mmap-set! m 0 #\b)
      (close-mmap m)
      (string-ref s 0))
   :expected #\b)

(define-test mmap-substring
   (call-with-input-mmap mmap.filename
      (lambda (mm)
         (mmap-substring mm 3 8)))
   :expected "DON'T")

(define-test mmap-substring-set!
   mmap-substring-set!
   :expected procedure?)

(define-test mmap-substring-set!
   (procedure-arity mmap-substring-set!)
   :expected 3)
      
(define-test mmap-ref
   (call-with-input-mmap "misc/img.jpg"
      (lambda (mm)
         (let ((l (mmap-length mm)))
            (let loop ((i #e0))
               (cond
                  ((=elong i l)
                   #t)
                  ((>=fx (char->integer (mmap-ref mm i)) 0)
                   (loop (+elong i #e1)))
                  (else
                   #f)))))))

(define-test mmap-ref
   (call-with-input-mmap "misc/img.jpg"
      (lambda (mm)
         (let ((l (mmap-length mm)))
            (let loop ((i #e0))
               (cond
                  ((=elong i l)
                   #f)
                  ((char=? (mmap-ref mm i) #a255)
                   #t)
                  (else
                   (loop (+elong i #e1)))))))))
