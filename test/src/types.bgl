;*---------------------------------------------------------------------*/
;*    trace                                                            */
;*---------------------------------------------------------------------*/
(module types
   (export test))

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "./test.bgh")

;*---------------------------------------------------------------------*/
;*    test ...                                                         */
;*---------------------------------------------------------------------*/
(define (test verbose tests::pair-nil)
   (when (or (null? tests) (member "types" tests))
      (test-all verbose "types")))

;*---------------------------------------------------------------------*/
;*    tests                                                            */
;*---------------------------------------------------------------------*/
(define-test typeof
   (typeof (cons 1 2))
   :expected "pair")

(define-test typeof
   (typeof 4.3)
   :expected "real")

(define-test typeof
   (typeof typeof)
   :expected "procedure")

(define-test typeof
   (typeof #l54)
   :expected "bllong")

(define-test typeof
   (typeof #z3435)
   :expected "bignum")



