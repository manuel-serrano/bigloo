;; module5_ex20.bgl
(module ex20
   (library csv)
   (library text . t)
   (library web date->w3c-datetime)
   (export read-csv hyphenize wdate))

(define (read-csv text::bstring)
   (call-with-input-string text read-csv-record))

(define (hyphenize::pair word::bstring)
   (t.hyphenate word
      (t.load-hyphens
         (make-file-path (dirname ex20.filename)
            ".." ".." ".." "api" "text" "data" "fr-hyphens.sch"))))

(define (wdate::bstring)
   (date->w3c-datetime (current-date)))
