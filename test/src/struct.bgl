;*---------------------------------------------------------------------*/
;*    struct                                                           */
;*---------------------------------------------------------------------*/
(module struct
   (export test))

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "./test.bgh")

;*---------------------------------------------------------------------*/
;*    test ...                                                         */
;*---------------------------------------------------------------------*/
(define (test verbose tests::pair-nil)
   (when (or (null? tests) (member "string" tests))
      (test-all verbose "string")))

;*---------------------------------------------------------------------*/
;*    tests                                                            */
;*---------------------------------------------------------------------*/
(define-struct structure x lambda y res)
(define-struct point x y z)

(define-test struct?
   (struct? (make-struct 'point 2 1)))

(define-test struct
   (let ((s (make-structure '())))
      (if (not (struct? s))
          #f)
      (structure-lambda-set! s (lambda (x y) (+ x y)))
      (structure-x-set! s 1)
      (structure-y-set! s 2)
      (structure-res-set! s ((structure-lambda s)
                             (structure-x s)
                             (structure-y s)))
      (structure-res s))
   :expected 3)

(define-test define-struct
   (begin
      (eval '(define-struct structure x lambda y res))
      (eval '(let ((s (make-structure '())))
              (if (not (struct? s))
                  #f)
              (structure-lambda-set! s (lambda (x y) (+ x y)))
              (structure-x-set! s 1)
              (structure-y-set! s 2)
              (structure-res-set! s ((structure-lambda s)
                                     (structure-x s)
                                     (structure-y s)))
              (structure-res s))))
   :expected 3)

(define-test make-struct
   (struct? (make-struct 'point 2 2)))

(define-test struct-key
   (struct-key (make-struct 'key 2 2))
   :expected 'key)

(define-test struct-key-set!
   (let ((o (make-struct 'key 2 2)))
      (struct-key-set! o 'key2)
      (struct-key o))
   :expected 'key2)

(define-test struct-ref
   (struct-ref (make-struct 'key 2 3) 1)
   :expected 3)

(define-test struct-set!
   (let ((o (make-struct 'key 2 2)))
      (struct-set! o 0 55)
      (struct-ref o 0))
   :expected 55)

(define-test struct-update!
   (let ((p1 (point 1 2 3))
         (p2 (point 4 5 6)))
      (struct-update! p1 p2)
      (equal? p1 p2)))

(define-test struct->list
   (struct->list (make-struct 'point 1 2))
   :expected '(point 2))

(define-test list->struct
   (list->struct '(point 1 2))
   :expected '#{point 1 2})
