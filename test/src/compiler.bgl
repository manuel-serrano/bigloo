   (case (+fx 1 (car (list 4)))
               ((1) 1)
         ((2) 1)
         ((7) 1000)
         ((5) 5)
         ((4) 4)
         ((4) 4)
         ((6) 10)
         (else 11))
   :result 5)

(define-test globalize-cast-bug-3b42a91c7
   ;; the globalizer was not correctly propagating cell-ref
   ;; inside cast nodes (see compiler/Globalize/node.scm)
   (let ((x 3))
      (letrec ((f1 (lambda ()
                      (set! x (+ x 1))
                      (cast::bint x)))
               (f2 (lambda ()
                      (set! x (* x 10))
                      (f1))))
         ((car (list f2 f1)))))
   :result 31)
                   
