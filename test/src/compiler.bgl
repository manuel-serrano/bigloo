(define (capture10::pair-nil locals::pair-nil node-or-nodes)
   
   (define (kill-used-in-node n)
      (set! locals (remq n locals)))

   (when (pair? locals)
      (cond
	 ((null? node-or-nodes)
	  #unspecified)
	 ((pair? node-or-nodes)
	  (for-each kill-used-in-node node-or-nodes))
	 (else
	  (kill-used-in-node node-or-nodes))))

   locals)

(define-test capture (capture10 (list 1 2 4) (list 4 6 67)) :result '(1 2))
   
