;*---------------------------------------------------------------------*/
;*    compiler                                                         */
;*---------------------------------------------------------------------*/
(module compiler
   (export test))

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "./test.bgh")

;*---------------------------------------------------------------------*/
;*    test ...                                                         */
;*---------------------------------------------------------------------*/
(define (test verbose tests::pair-nil)
   (when (or (null? tests) (member "compiler" tests))
      (test-all verbose "compiler")))

;*---------------------------------------------------------------------*/
;*    cse                                                              */
;*---------------------------------------------------------------------*/
(define (cse-foo x)
   (let ((y (car x)))
      (set-car! x 3)
      (let ((z (car x)))
	 z)))

(define-test cse
   (cse-foo (list 1 2))
   :expected 3)

(define-test cse
   (let ((x (list 1 2)))
      (let ((y (car x)))
         (cse-foo x)
         (let ((z (car x)))
            z)))
   :expected 3)

(define-test cse
   (let ((l '((1))))
      ;; this function was badly compiled due to a bug in the cse
      ;; that propagate the binding (a (c-car l)) into the loop.
      (let ((a ($car l)))
         (let loop ((a a))
            (if ($pair? a)
                (begin
                   ($set-car! l '(3))
                   (loop ($cdr a)))
                (let ((a ($car l)))
                   ($set-cdr! a 4)
                   a)))))
   :expected '(3 . 4))

(define-test cse
   (let ((p (open-input-string "1 2 3 4 5 6 7")))
      (let* ((x (read p))
	     (y (eq? 'toto (read p)))
	     (z (read p)))
	 (= (+ x z) 4))))

;*---------------------------------------------------------------------*/
;*    higher order                                                     */
;*---------------------------------------------------------------------*/
(define-test higher-order
   ((((((((((((((((((((((((((((((((((((((lambda (x) x) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) #t))

;*---------------------------------------------------------------------*/
;*    cfa                                                              */
;*---------------------------------------------------------------------*/
(define-test cfa
   (let ((random-strings '#(#"d909ef3e" 0)))
      (substring (vector-ref random-strings 0) 0 1))
   :expected "d")

;*---------------------------------------------------------------------*/
;*    expand                                                           */
;*---------------------------------------------------------------------*/
(define-test expand
   (let ((x 3))
      (define (f1 x)
         (+fx 1000 x))
      (define (f2 x)
         (f1 (+fx 100 x)))
      (define f
         (lambda (x)
            (f2 (+fx 10 x))))
      (f x))
   :expected 1113)

;*---------------------------------------------------------------------*/
;*    define                                                           */
;*---------------------------------------------------------------------*/
(define (foo1 x) (+fx x 1))
(define gee1 foo1)

(define (foo2 . x) (+fx (car x) 1))
(define gee2 foo2)

(define (foo3 x . y) (apply + (cons x y)))
(define gee3 foo3)

(define (foo4) 5)
(define gee4 foo4)

(define (foo5 x) (+fx x 1))
(define gee5 foo5)
(set! foo5 (lambda (y) 9))

(define-inline (foo6 x)
   (define (foo-inner x)
      x)
   (foo-inner x))

(define (typed-define y)
   (define (inner::int x) x)
   (inner y))

(define (n-ary-define y)
   (define (inner x . y)
      (cons x y))
   (inner y y))

(define (n-ary-typed-define y)
   (define (inner::pair x . y) (cons x y))
   (inner y y))

(define (set-derives)
  (define dset  (make-vector 10 -1))
  dset)

(define-macro (mk-hwdebug-available)
   `(begin
       (define hwdebug 7)))
   
(define (texpand)
   (mk-hwdebug-available)
   8)

(define (inner-print)
   (define (print) (begin 1 2 3 4 #t))
   (print))

(lambda (x)
   (define (bar x)
      x)
   (bar x))
 
(lambda (x)
   (define (bar x)
      (define (hux x)
	 x)
      (hux x))
   (bar x))

(define inner-test1
   (lambda (x)
      (define (bar x)
	 x)
      (bar x)))

(define (inner-test3 x)
   (define (bar x)
      x)
   (bar x))

(define (inner-test4 x)
   (define (bar x)
      (define (hux x)
	 x)
      (hux x))
   (bar x))

(define (inner-test5 f)
   (f 1))

(define-test internal (inner-test1 1) :expected 1)
(define-test internal (inner-test3 1) :expected 1)
(define-test internal (inner-test4 1) :expected 1)
(define-test internal
   (inner-test5 (lambda (x)
                   (define (bar x)
                      (define (hux x)
                         x)
                      (hux x))
                   (bar x)))
   :expected 1)
(define-test internal
   (inner-test5 (lambda (x)
                   (define (bar x)
                      x)
                   (bar x)))
   :expected 1)
(define-test alias (gee1 5) :expected 6)
(define-test alias (gee2 5) :expected 6)
(define-test alias (gee3 5 6) :expected 11)
(define-test alias (gee4) :expected 5)
(define-test alias (gee5 5) :expected 6)
(define-test alias (foo5 5) :expected 9)
(define-test inline (foo6 6) :expected 6)
(define-test inner (typed-define 5) :expected 5)
(define-test inner (n-ary-define 5) :expected '(5 5))
(define-test inner (n-ary-typed-define 5) :expected '(5 5))
(define-test inner (vector? (set-derives)) :expected #t)
(define-test inner (inner-print) :expected #t) 
(define-test expand (texpand) :expected 8)


