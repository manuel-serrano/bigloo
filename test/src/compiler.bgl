;*---------------------------------------------------------------------*/
;*    Local functions compilation                                      */
;*---------------------------------------------------------------------*/
(define (compilation-bug-1 indent-general)
   ;; compilation bug
   (letrec ((pp-comment (lambda () (labels ((tag-101 () (begin
							   0 1 2 3 4 5 6 7
							   0 1 2 3 4 5 6 7
							   0 1 2 3 4 5 6 7
							   0 1 2 3 4 5 6 7
							   0 1 2 3 4 5 6 7
							   0 1 2 3 4 5 6 7
							   0 1 2 3 4 5 6 7
							   0 1 2 3 4 5 6 7
							   0 1 2 3 4 5 6 7
							   0 1 2 3 4 5 6 7
							   0 1 2 3 4 5 6 7
							   0 1 2 3 4 5 6 7
							   (pp-general))))
				      (tag-101))))
	    (pp-general (lambda () (begin
				      0 1 2 3 4 5 6 7
				      0 1 2 3 4 5 6 7
				      0 1 2 3 4 5 6 7
				      0 1 2 3 4 5 6 7
