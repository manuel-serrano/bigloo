      ($dummy::obj ::obj ... "")))

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "./test.bgh")

;*---------------------------------------------------------------------*/
;*    test ...                                                         */
;*---------------------------------------------------------------------*/
(define (test verbose tests::pair-nil)
   (when (or (null? tests) (member "compiler" tests))
      (test-all verbose "compiler")))

;*---------------------------------------------------------------------*/
;*    declarations                                                     */
;*---------------------------------------------------------------------*/
(define var var)

(define (mut-bar . l) l)
(set! mut-bar 'toto)

(define (fooo x)
   (if (integer? x)
       (begin
	  (set! x #f)
	  (integer? x))
       #t))

(define hoist-ref (make-cell 0))
(define (hoist)
   (let ((x1 (let ((x2 (cell-ref hoist-ref)))
		(begin
		   (cell-set! hoist-ref (+fx x2 1))
		   x2)))
	 (x2 (let ((x2 (cell-ref hoist-ref)))
		(begin
		   (cell-set! hoist-ref (+fx x2 1))
		   x2))))
      (eq? x1 x2)))

(define (for-each-inline)
   (let ((v 0))
      (for-each (let ((j 0))
		   (lambda (x)
		      (set! v (+ j v))
		      (set! j (+ j 1))))
		'(a b c))
      v))

;*---------------------------------------------------------------------*/
;*    reserved symbols                                                 */
;*---------------------------------------------------------------------*/
(define (compiler-reserved-labels fun labels)
   (for-each (lambda (id) id) labels)
   (fun (lambda (id) id) labels))

(define (compiler-reserved-let x fun)
   (let ((let (if (> x 0) (fun (+ x 1)) (fun (- x)))))
      (if (> x 0) let (fun (- x)))))

(define (compiler-reserved-let*)
   (let* ((x 1) (x (+ 1 x))) x))

;*---------------------------------------------------------------------*/
;*    Top level definition orders                                      */
;*---------------------------------------------------------------------*/
(define order_foo 0)
(define order_foo1 (begin (set! order_foo (+fx order_foo 1)) order_foo))
(define order_foo2 (begin (set! order_foo (+fx order_foo 1)) order_foo))
(begin
   (define order_foo3 (begin (set! order_foo (+fx order_foo 1)) order_foo))
   (define order_foo4 (begin (set! order_foo (+fx order_foo 1)) order_foo)))
(define order_foo5 (begin (set! order_foo (+fx order_foo 1)) order_foo))

(define order_bar 0)
(define order_bar1 1)
(define order_bar2 1)
(define order_bar3 1)
(define order_bar4 1)
(define order_bar5 1)
(define order_bar6 1)
(define order_bar7 1)
(define order_bar8 1)

(begin
   (begin
      (begin
	 (set! order_bar (+fx order_bar 1))
	 (set! order_bar1 order_bar)
	 (set! order_bar (+fx order_bar 1))
	 (set! order_bar2 order_bar))
      (begin
	 (set! order_bar (+fx order_bar 1))
	 (set! order_bar3 order_bar)
	 (set! order_bar (+fx order_bar 1))
	 (set! order_bar4 order_bar))
      (set! order_bar (+fx order_bar 1))
      (set! order_bar5 order_bar)
      (set! order_bar (+fx order_bar 1))
      (set! order_bar6 order_bar))
   (set! order_bar (+fx order_bar 1))
   (set! order_bar7 order_bar)
   (set! order_bar (+fx order_bar 1))
   (set! order_bar8 order_bar))

;*---------------------------------------------------------------------*/
;*    compilation bugs                                                 */
;*---------------------------------------------------------------------*/
;; compilation failure
(let ((revtype2
         (labels ((revtype (parent t flag)
                     (let ((rev (lambda (q)
                                   (revtype t q #f))))
                        (if flag (rev 1)))))
            revtype)))
   (revtype2 1 2 #f))

(define (test-type-data-flow x::int)
   (if (pair? x)
       (car x)
       #t))

(define (test-type-data-flow2 l::pair-nil)
   (if (> (length l) 10)
       (print 1 2 3 4 5 6 7 8 ))
   (if (pair? l)
       (car l)
       l))

(define (test-type-data-flow3 l::pair-nil)
   (define (for-each-rest pred l)
      (cond ((pair? l)
	     (let loop ((x (car l))
			(l1 (cdr l)))
		(pred x l1)
		(cond ((pair? l1)
		       (loop (car l1) (cdr l1))))))))
   (set! l (filter! pair? l))
   (for-each-rest (lambda (l1 rest)
		     (cond ((pair? rest)
			    (append! l1 (car rest)))))
      l)
   (if (pair? l)
       (car l)
       l))

(define (test-type-data-flow4 l::pair-nil)
   (cond
      ((pair? l) 1)
      ((null? l) 2)
      (else (print "this" "branch" "cannot" "be" "selected"))))

(define (bug-jvm scm-files)
   ;; This function was badly compiled up to bigloo3.5b. The JAS code
   ;; is incorrect and the bytecode verifier breaks. This function
   ;; cannot be executed hence, it is used in this file only as a
   ;; procedural value
   (begin
      (labels ((try-120 (g-119) (try-120 8)))
	 (try-120 9))
      6))

(define (bug-dataflow-lub x)
   (when (string? x)
      (cond
	 ((string-prefix? "/" x)
	  (set! x #f)))
      (cond
	 (x 111)
	 (else 222))))

(define (bug-data-flow-lub2 s newest-d)
   (define check-date?
      (if (getenv "foo") list cons))
   (let ((date1 #f))
      (if (= s 4)
	  (begin
	     (set! date1 "tutu")
	     (if (check-date? date1 newest-d)
		 #t
		 (set! date1 #f)))
	  (begin
	     (set! date1 "toto")
	     (set! date1 #f)))
      (when date1
	 4)))

;*---------------------------------------------------------------------*/
;*    cse                                                              */
;*---------------------------------------------------------------------*/
(define (cse-foo x)
   (let ((y (car x)))
      (set-car! x 3)
      (let ((z (car x)))
	 z)))

(define-test cse
   (cse-foo (list 1 2))
   :result 3)

(define-test cse
   (let ((x (list 1 2)))
      (let ((y (car x)))
         (cse-foo x)
         (let ((z (car x)))
            z)))
   :result 3)

(define-test cse
   (let ((l '((1))))
      ;; this function was badly compiled due to a bug in the cse
      ;; that propagate the binding (a (c-car l)) into the loop.
      (let ((a ($car l)))
         (let loop ((a a))
            (if ($pair? a)
                (begin
                   ($set-car! l '(3))
                   (loop ($cdr a)))
                (let ((a ($car l)))
                   ($set-cdr! a 4)
                   a)))))
   :result '(3 . 4))

(define-test cse
   (let ((p (open-input-string "1 2 3 4 5 6 7")))
      (let* ((x (read p))
	     (y (eq? 'toto (read p)))
	     (z (read p)))
	 (= (+ x z) 4))))

