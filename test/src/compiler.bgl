;*---------------------------------------------------------------------*/
;*    cells                                                            */
;*---------------------------------------------------------------------*/
(define (cell-test1 a b)
   (labels ((foo (x) (set! x b) x))
      foo))

(define (cell-test2 a b . c)
   (labels ((foo (x y) (set! c y) y)
	    (bar (z)   (foo 2 1))
	    (hux (t)   (set! a (foo t t)) c))
      hux))

(define (cell-test3 . c)
   (let ((a 0)
	 (b 0))
      (labels ((foo (x) (set! a x) a)
	       (bar (y) (set! b y) (foo b)))
	 (bar 1)
	 foo)))

(define-test cell
   ((cell-test1 1 2) 3)
   :result 2)
(define-test cell ((cell-test2 1 2 3 4) 2)
   :result 2)
(define-test cell ((cell-test3 1 2 3 4) 2)
   :result 2)

;*---------------------------------------------------------------------*/
;*    tail                                                             */
;*---------------------------------------------------------------------*/
(define (tail-test1)
   (letrec ((loop (lambda (x y)
		     (if (=fx x 0)
			 y
			 (loop (- x 1) x)))))
      (loop 2 2)))

(define (tail-test2 x)
   (let* ((a tail-hux)
	  (fun (lambda (c) c)))
      (a (if x (fun 1) (fun 2)))))

(define (tail-hux x)
   x)

(define (tail-bar::int b::bool n)
   (define (odd2::int n)
      (if (=fx n 0)
	  #xABCDEF
	  (even2 (-fx n 1)) ))
   (define (even2::short n)
      (if (=fx n 0)
	  10
	  (odd2 (-fx n 1)) ))
   (if b
       (even2 n)
       (odd2 n)))

(define (tail-foo::int b::bool n)
   (define (odd::int n)
      (if (=fx n 0)
	  #xABCDEF
	  (even (-fx n 1)) ))
   (define (even::short n)
      (if (=fx n 0)
	  10
	  (odd (-fx n 1)) ))
   (if b
       (odd n)
       (even n)))

(define-test tail (tail-test1)
   :result 1)
(define-test tail (tail-test2 #f)
   :result 2)
(define-test tail (tail-foo #t 10)
   :result (tail-bar #f 10))

