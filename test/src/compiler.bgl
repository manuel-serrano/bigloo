   (let ((random-strings '#(#"d909ef3e" 0)))
      (substring (vector-ref random-strings 0) 0 1))
   :result "d")

;*---------------------------------------------------------------------*/
;*    expand                                                           */
;*---------------------------------------------------------------------*/
(define-test expand
   (let ((x 3))
      (define (f1 x)
         (+fx 1000 x))
      (define (f2 x)
         (f1 (+fx 100 x)))
      (define f
         (lambda (x)
            (f2 (+fx 10 x))))
      (f x))
   :result 1113)

