;*---------------------------------------------------------------------*/
;*    compiler                                                         */
;*---------------------------------------------------------------------*/
(module compiler
   (export test)
   (eval (export letrec-foo-loop))
   (extern "C"
      ($dummy::obj ::obj ... "")))

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "./test.bgh")

;*---------------------------------------------------------------------*/
;*    test ...                                                         */
;*---------------------------------------------------------------------*/
(define (test verbose tests::pair-nil)
   (when (or (null? tests) (member "compiler" tests))
      (test-all verbose "compiler")))

;*---------------------------------------------------------------------*/
;*    cse                                                              */
;*---------------------------------------------------------------------*/
(define (cse-foo x)
   (let ((y (car x)))
      (set-car! x 3)
      (let ((z (car x)))
	 z)))

(define-test cse
   (cse-foo (list 1 2))
   :expected 3)

(define-test cse
   (let ((x (list 1 2)))
      (let ((y (car x)))
         (cse-foo x)
         (let ((z (car x)))
            z)))
   :expected 3)

(define-test cse
   (let ((l '((1))))
      ;; this function was badly compiled due to a bug in the cse
      ;; that propagate the binding (a (c-car l)) into the loop.
      (let ((a ($car l)))
         (let loop ((a a))
            (if ($pair? a)
                (begin
                   ($set-car! l '(3))
                   (loop ($cdr a)))
                (let ((a ($car l)))
                   ($set-cdr! a 4)
                   a)))))
   :expected '(3 . 4))

(define-test cse
   (let ((p (open-input-string "1 2 3 4 5 6 7")))
      (let* ((x (read p))
	     (y (eq? 'toto (read p)))
	     (z (read p)))
	 (= (+ x z) 4))))

;*---------------------------------------------------------------------*/
;*    higher order                                                     */
;*---------------------------------------------------------------------*/
(define-test higher-order
   ((((((((((((((((((((((((((((((((((((((lambda (x) x) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) (lambda (i) i)) #t))

;*---------------------------------------------------------------------*/
;*    cfa                                                              */
;*---------------------------------------------------------------------*/
(define-test cfa
   (let ((random-strings '#(#"d909ef3e" 0)))
      (substring (vector-ref random-strings 0) 0 1))
   :expected "d")

;*---------------------------------------------------------------------*/
;*    expand                                                           */
;*---------------------------------------------------------------------*/
(define-test expand
   (let ((x 3))
      (define (f1 x)
         (+fx 1000 x))
      (define (f2 x)
         (f1 (+fx 100 x)))
      (define f
         (lambda (x)
            (f2 (+fx 10 x))))
      (f x))
   :expected 1113)

;*---------------------------------------------------------------------*/
;*    define                                                           */
;*---------------------------------------------------------------------*/
(define (foo1 x) (+fx x 1))
(define gee1 foo1)

(define (foo2 . x) (+fx (car x) 1))
(define gee2 foo2)

(define (foo3 x . y) (apply + (cons x y)))
(define gee3 foo3)

(define (foo4) 5)
(define gee4 foo4)

(define (foo5 x) (+fx x 1))
(define gee5 foo5)
(set! foo5 (lambda (y) 9))

(define-inline (foo6 x)
   (define (foo-inner x)
      x)
   (foo-inner x))

(define (typed-define y)
   (define (inner::int x) x)
   (inner y))

(define (n-ary-define y)
   (define (inner x . y)
      (cons x y))
   (inner y y))

(define (n-ary-typed-define y)
   (define (inner::pair x . y) (cons x y))
   (inner y y))

(define (set-derives)
  (define dset  (make-vector 10 -1))
  dset)

(define-macro (mk-hwdebug-available)
   `(begin
       (define hwdebug 7)))

(define (texpand)
   (mk-hwdebug-available)
   8)

(define (inner-print)
   (define (print) (begin 1 2 3 4 #t))
   (print))

(lambda (x)
   (define (bar x)
      x)
   (bar x))

(lambda (x)
   (define (bar x)
      (define (hux x)
	 x)
      (hux x))
   (bar x))

(define inner-test1
   (lambda (x)
      (define (bar x)
	 x)
      (bar x)))

(define (inner-test3 x)
   (define (bar x)
      x)
   (bar x))

(define (inner-test4 x)
   (define (bar x)
      (define (hux x)
	 x)
      (hux x))
   (bar x))

(define (inner-test5 f)
   (f 1))

(define-test internal (inner-test1 1) :expected 1)
(define-test internal (inner-test3 1) :expected 1)
(define-test internal (inner-test4 1) :expected 1)
(define-test internal
   (inner-test5 (lambda (x)
                   (define (bar x)
                      (define (hux x)
                         x)
                      (hux x))
                   (bar x)))
   :expected 1)
(define-test internal
   (inner-test5 (lambda (x)
                   (define (bar x)
                      x)
                   (bar x)))
   :expected 1)
(define-test alias (gee1 5) :expected 6)
(define-test alias (gee2 5) :expected 6)
(define-test alias (gee3 5 6) :expected 11)
(define-test alias (gee4) :expected 5)
(define-test alias (gee5 5) :expected 6)
(define-test alias (foo5 5) :expected 9)
(define-test inline (foo6 6) :expected 6)
(define-test inner (typed-define 5) :expected 5)
(define-test inner (n-ary-define 5) :expected '(5 5))
(define-test inner (n-ary-typed-define 5) :expected '(5 5))
(define-test inner (vector? (set-derives)) :expected #t)
(define-test inner (inner-print) :expected #t)
(define-test expand (texpand) :expected 8)

;*---------------------------------------------------------------------*/
;*    cells                                                            */
;*---------------------------------------------------------------------*/
(define (cell-test1 a b)
   (labels ((foo (x) (set! x b) x))
      foo))

(define (cell-test2 a b . c)
   (labels ((foo (x y) (set! c y) y)
	    (bar (z)   (foo 2 1))
	    (hux (t)   (set! a (foo t t)) c))
      hux))

(define (cell-test3 . c)
   (let ((a 0)
	 (b 0))
      (labels ((foo (x) (set! a x) a)
	       (bar (y) (set! b y) (foo b)))
	 (bar 1)
	 foo)))

(define-test cell
   ((cell-test1 1 2) 3)
   :expected 2)
(define-test cell ((cell-test2 1 2 3 4) 2)
   :expected 2)
(define-test cell ((cell-test3 1 2 3 4) 2)
   :expected 2)

;*---------------------------------------------------------------------*/
;*    tail                                                             */
;*---------------------------------------------------------------------*/
(define (tail-test1)
   (letrec ((loop (lambda (x y)
		     (if (=fx x 0)
			 y
			 (loop (- x 1) x)))))
      (loop 2 2)))

(define (tail-test2 x)
   (let* ((a tail-hux)
	  (fun (lambda (c) c)))
      (a (if x (fun 1) (fun 2)))))

(define (tail-hux x)
   x)

(define (tail-bar::int b::bool n)
   (define (odd2::int n)
      (if (=fx n 0)
	  #xABCDEF
	  (even2 (-fx n 1)) ))
   (define (even2::short n)
      (if (=fx n 0)
	  10
	  (odd2 (-fx n 1)) ))
   (if b
       (even2 n)
       (odd2 n)))

(define (tail-foo::int b::bool n)
   (define (odd::int n)
      (if (=fx n 0)
	  #xABCDEF
	  (even (-fx n 1)) ))
   (define (even::short n)
      (if (=fx n 0)
	  10
	  (odd (-fx n 1)) ))
   (if b
       (odd n)
       (even n)))

(define-test tail (tail-test1)
   :expected 1)
(define-test tail (tail-test2 #f)
   :expected 2)
(define-test tail (tail-foo #t 10)
   :expected (tail-bar #f 10))

;*---------------------------------------------------------------------*/
;*    closures                                                         */
;*---------------------------------------------------------------------*/
(define (closure-test1)
   (labels ((fun1 () 0)
	    (fun2 () (labels ((loop () (fun1)))
			(loop))))
      fun2))

(define (closure-test2 x y z)
   (labels ((hux (a1)  x)
	    (bar (a1) (hux y))
	    (gee ()  (bar z)))
      gee))

(define closure-test3 (labels ((lam_0 ()
			      (labels ((ignore ()
					       (let ((v 1))
						  (labels ((foo () v))
						     (foo)))))
				 (ignore))))
		 lam_0))

(define (closure-test4 a b)
   (labels ((foo (x) (set! x b) x))
      foo))

(define (closure-test5 a b . c)
   (labels ((foo (x y) (set! c y) y)
	    (bar (z) (foo 2 1))
	    (hux (t) (set! a (foo t t)) c))
      hux))

(define (closure-test6 . c)
   (let ((a2 0)
	 (b 0))
      (labels ((foo (x) (set! a2 x) a2)
	       (bar (y) (set! b y) (foo b)))
	 (bar 1)
	 foo)))

(define (closure-test7 x)
   (labels ((bar (a3) (hux a3))
	    (gee (b) bar)
	    (hux (c) x))
      bar
      gee))

(define (closure-plante-k2 l)
   (labels ((l1 (x) (labels ((l2 () (bar x (l3 (g)))))
                       (gee (l2) (l2))))
            (l3 (y) (labels ((l4 () (zee y (l1 (g)))))
                       (gee (l4) (l4)))))
      (l1 (g))))

(define (bar x y) (if (= x y) (+ x y) 0))
(define (gee x y) (+ x y))
(define (zee x y) (- x y))
(define (g) (if (= (gee 4 2) (zee 8 2)) 2 1))

(define (closure-plante-2 c_1)
   (labels ((c1_13 () (c_1 (list 1))))
      (lar (lambda () (hux (lambda () (c1_13)))))))

(define (closure-plante-3  c_1)
   (labels ((c1_13 (x) (c_1 (c1_13 (list 1)))))
      (lar (lambda () (hux (lambda () (c1_13 1)))))))

(define (lar x)
   x)

(define (hux x)
   x)

(define (closure-plante-4 a)
   (labels ((hux (z) foo)
	    (foo (x) x))
      (hux foo)))

(define (_closure-plante-4 x y)
   (+ x y))

(define (compile exp)
  (begin
    (print 'compile)
    (print
      (begin
        ((labels
           ((tag-101 () '(52))
            (tag-102 () '())
            (tag-103 (fun args) '())
            (tag-104 (args) (compile-application)))
           (lambda (e-105)
             (begin
               (if (pair? e-105)
                 (let ((cdr-118 (cdr e-105)) (car-117 (car e-105)))
                   (if (eq? car-117 'module)
                     (if (eq? cdr-118 '())
                       (tag-101)
                       (let ((cdr-149 (cdr e-105)) (car-148 (car e-105)))
                         (labels
                           ((kap-152
                              ()
                              (let ((cdr-156 (cdr e-105))
                                    (car-155 (car e-105)))
                                (tag-104 cdr-156))))
                           (if (pair? car-148)
                             (let ((cdr-161 (cdr car-148))
                                   (car-160 (car car-148)))
                               (kap-152))
                             (if (vector? car-148)
                               (kap-152)
                               (tag-103 car-148 cdr-149))))))
                     (labels
                       ((kap-121
                          ()
                          (let ((cdr-127 (cdr e-105)) (car-126 (car e-105)))
                            (labels
                              ((kap-130
                                 ()
                                 (let ((cdr-134 (cdr e-105))
                                       (car-133 (car e-105)))
                                   (tag-104 cdr-134))))
                              (if (pair? car-126)
                                (let ((cdr-139 (cdr car-126))
                                      (car-138 (car car-126)))
                                  (kap-130))
                                (if (vector? car-126)
                                  (kap-130)
                                  (tag-103 car-126 cdr-127)))))))
                       (let ((cdr-141 (cdr e-105)) (car-140 (car e-105)))
                         (kap-121)))))
                 (if (vector? e-105) #f (tag-102))))))
         exp)))))

(define (compile-application)
  (begin
    (print 'compile-application)
    (print
      (begin
        (let ((aux 1))
	   (case aux
	      ((0) '())
	      (else '())))))))

(define closure-plante-5
   (lambda (a4)
      (letrec ((x3 (lambda (x4)
		      (a4 0)
		      (lambda (c)
			 (labels ((foo () (lambda (x9) (x3 0))))
			    (foo))))))
	 x3)))

(define (closure-plante-6 x e)
   (labels ((loop ()
		  (labels ((foo () (labels ((gee () (loop)))
				      gee)))
		     (foo) x)))
      (loop)))

(define (closure-plante-7)
   (begin
      (set-exit
       (an-exit1013)
       (let ()
	  (push-exit! an-exit1013 1)
	  (let ((exp (let ((body1018 (lambda () 9)))
			(set-exit
			 (an-exit1025)
			 (let ()
			    (push-exit! an-exit1025 0)
			    (body1018))))))
	     (set! exp #unspecified)
	     (labels ((foo () (print exp)))
		(closure-plante-7-bar foo)))))
      9))

(define (closure-plante-7-bar f)
   (print (f)))

(define (closure-test8 str)
   (let ((g (regular-grammar ()
	       (#\)
		'())
	       (#\(
		(let* ((car (ignore))
		       (cdr (ignore)))
		   (cons car cdr)))
	       ((+ (out #\( #\)))
		(the-symbol))))
	 (p (open-input-string str)))
      (read/rp g p)))

(define (static-application)
   (((lambda (a b) b)
     3
     (lambda (x) x)) 3))

(define-test closure ((closure-test1)) :expected 0)
(define-test closure (((closure-test7 5) 6) 7) :expected 5)
(define-test closure ((closure-test2 1 2 3)) :expected 1)
(define-test closure (closure-test3) :expected 1)
(define-test closure ((closure-test4 1 2) 3) :expected 2)
(define-test closure ((closure-test5 1 2 3 4) 2) :expected 2)
(define-test closure ((closure-test6 1 2 3 4) 2) :expected 2)
(define-test closure (closure-test8 "(foo(bar(gee)))") :expected '(foo bar gee))
(define-test closure (_closure-plante-4 5 6) :expected 11)
(define-test closure (static-application) :expected 3)

;*---------------------------------------------------------------------*/
;*    letrec                                                           */
;*---------------------------------------------------------------------*/
(define (letrec-test1 y)
   (letrec ((x (integer->string y))
	    (foo (lambda (string)
		    (string->symbol (string-append string x)))))
      foo))

(define (letrec-foo a)
   (letrec ((letrec-foo (lambda (x) (bar 0) (set! letrec-foo 8) 'done))
	    (bar (lambda (x) (if (= x 0)
				 'done
				 (letrec-foo x)))))
      (letrec-foo a)))

(define (letrec-foo-loop)
   (let ((f -)) (let f ((n (f 1))) n)))

(define (bar-loop n)
   (let string-append ((n n))
      (if (=fx n 0)
	  0
	  (+fx n (string-append (-fx n 1))))))

(define (test-begin)
   (let ((x 5))
      (begin (begin (begin)
		    (begin (begin (begin) (define letrec-foo (lambda (y) (bar x y)))
				  (begin)))
		    (begin))
	     (begin)
	     (begin)
	     (begin (define bar (lambda (a b) (+ (* a b) a))))
	     (begin))
      (begin)
      (begin (letrec-foo (+ x 3)))))

(define (test-begin-eval)
   (eval
    '(let ((x 5))
	(begin (begin (begin)
		      (begin (begin (begin) (define letrec-foo (lambda (y) (bar x y)))
				    (begin)))
		      (begin))
	       (begin)
	       (begin)
	       (begin (define bar (lambda (a b) (+ (* a b) a))))
	       (begin))
	(begin)
	(begin (letrec-foo (+ x 3))))))

(define (test-letrec*1)
   (letrec* ((x 1)
	     (f (lambda (y) (+ x y))))
      (f 3)))

(define (test-letrec*2)
   (eval '(letrec* ((x 1)
		    (f (lambda (y) (+ x y))))
	   (f 3))))

(define (test-letrec*3)
   (letrec* ((p (lambda (x)
		   (+ 1 (q (- x 1)))))
	     (q (lambda (y)
		   (if (zero? y)
		       0
		       (+ 1 (p (- y 1))))))
	     (x (p 5))
	     (y x))
      y))

(define (test-letrec*4)
   (eval '(letrec* ((p (lambda (x)
			  (+ 1 (q (- x 1)))))
		    (q (lambda (y)
			  (if (zero? y)
			      0
			      (+ 1 (p (- y 1))))))
		    (x (p 5))
		    (y x))
	   y)))

(define (test-letrec*5)
   (define (f) (- y x))
   (define x 1)
   (define y x)
   (define (g) (f))
   (g))

(define (test-letrec*6)
   (eval '((lambda ()
	      (define (f) (- y x))
	      (define x 1)
	      (define y x)
	      (define (g) (f))
	      (g)))))

(define (test-letrec*7)
   (let ((r 0))
      (define (print) (begin 1 2 3 4 #t))
      (letrec* ((x 1)
                (y x))
         (set! r y))
      (print)
      r))

(define (test-letrec*8)
   (eval '(let ((r 0))
	   (define (print) (begin 1 2 3 4 #t))
	   (letrec* ((x 1)
		     (y x))
	      (set! r y))
	   (print)
	   r)))

(define (test-letrec*9)
   (define bar (list '(1 . 2)))
   (cdar bar))

(define (test-letrec*10 n)
   (letrec* ((u 1)
	     (a 0)
	     (letrec-foo (begin
		     (set! a (+ 1 a))
		     (lambda (x) (when (> x 0) (bar (- x u))))))
	     (t 1)
	     (bar (begin
		     (set! a (+ 1 a))
		     (lambda (x) (when (> x 0) (letrec-foo (- x t))))))
	     (z 4))
      (bar (+ n z))))

(define (test-letrec*11 n)
   (letrec* (
	     (letrec-foo (begin
		     (set! a 1)
		     (lambda (x) a)))
	     (a 10)
	     (bar (begin
		     (set! a (+ 1 a))
		     (lambda (x) a)))
	     )
      (+ (letrec-foo 1) a)))

(define (test-letrec*11b n)
   (letrec* ((letrec-foo (begin
		     (set! a 1)
		     (lambda (x) a)))
	     (a 10))
      (+ (letrec-foo 1) a)))

(define (test-letrec*11c n)
   (letrec* ((u 1)
	     (letrec-foo (begin
		     (set! a 1)
		     (lambda (x) a)))
	     (a 10)
	     (bar (begin
		     (set! a (+ 1 a))
		     (lambda (x) a)))
	     (z 4))
      (+ (letrec-foo 1) (bar 2))))

(define (test-letrec*12)
   (letrec* ((letrec-foo (lambda () a))
	     (a 10))
      (letrec-foo)))

(define (test-letrec*13)
   (define x (begin (set! v 0) 0))
   (define y (begin (set! v 1) 1))
   (define z y)
   v)

(define v 45)

(define (test-letrec*14 a)
   (letrec* ((u 1)
	     (letrec-foo (begin
		     (set! a 5)
		     4))
	     (bar (begin
		     (set! a 10)
		     (lambda (x) a)))
	     (z 4))
      a))

(define (test-letrec*15)
   (let ((g (regular-grammar ()
	       ((+ #\a) 1)
	       ((+ #\b) (ignore))
	       (else 2))))
      (call-with-input-string "bbbaaa"
	 (lambda (ip)
	    (read/rp g ip)))))

(define (test-narrow)
   (let ((x #f)
	 (y #t))
      (set! x (lambda () y))
      (set! y 5)
      (x)))

;*---------------------------------------------------------------------*/
