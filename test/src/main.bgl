;*---------------------------------------------------------------------*/
;*    main                                                             */
;*---------------------------------------------------------------------*/
(module main
   (import "./argsparse.bgl" . argsparse)
   (import "./bool.bgl" . bool)
   (import "./bigloo.bgl" . bigloo)
   (import "./bignum.bgl" . bignum)
   (import "./bit.bgl" . bit)
   (import "./char.bgl" . char)
   (import "./condexpand.bgl" . condexpand)
   (import "./crc.bgl" . crc)
   (import "./date.bgl" . date)
   (import "./digest.bgl" . digest)
   (import "./dsssl.bgl" . dsssl)
   (import "./hash.bgl" . hash)
   (import "./int1.bgl" . int1)
   (import "./int2.bgl" . int2)
   (import "./internet.bgl" . internet)
   (import "./io.bgl" . io)
   (import "./lalr.bgl" . lalr)
   (import "./match.bgl" . match)
   (import "./module.bgl" . module)
   (import "./mmap.bgl" . mmap)
   (import "./net.bgl" . net)
   (import "./number.bgl" . number)
   (import "./object.bgl" . object)
   (import "./os.bgl" . os)
   (import "./pair.bgl" . pair)
   (import "./port.bgl" . port)
   (import "./process.bgl" . process)
   (import "./real.bgl" . real)
   (import "./regexp.bgl" . regexp)
   (import "./rgc.bgl" . rgc)
   (import "./search.bgl" . search)
   (import "./serial.bgl" . serial)
   (import "./ssr.bgl" . ssr)
   (import "./string.bgl" . string)
   (import "./symbol.bgl" . symbol)
   (import "./tar.bgl" . tar)
   (import "./thread.bgl" . thread)
   (import "./unicode.bgl" . unicode)
   (import "./vector.bgl" . vector)
   (import "./weakptr.bgl" . weakptr)
   (import "./zip.bgl" . zip)

   ;; library tests
   (cond-expand ((library csv) (import "./csv0.bgl" . csv0)))
   (cond-expand ((library sqlite) (import "./sqlite0.bgl" . sqlite0)))
   (cond-expand ((library ssl) (import "./ssl0.bgl" . ssl0)))

   ;; backend tests
   (cond-expand (C (import "./extern_c.bgl" . c)))
   (cond-expand (jvm (import "./extern_jvm.bgl" . jvm)))
   (cond-expand (wasm (import "./extern_wasm.bgl" . wasm)))
   
   (main))

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "./test.bgh")

;*---------------------------------------------------------------------*/
;*    main ...                                                         */
;*---------------------------------------------------------------------*/
(define (main argv)
   
   (define verbose #f)
   (define tests '())
   
   (args-parse (cdr argv)
      ((("-v" "--verbose") (help "verbose"))
       (set! verbose #t))
      (else
       (set! tests (cons else tests))))

   (let* ((res-core (list
                       (argsparse.test verbose tests)
                       (bool.test verbose tests)
                       (bigloo.test verbose tests)
                       (bignum.test verbose tests)
                       (bit.test verbose tests)
                       (char.test verbose tests)
                       (condexpand.test verbose tests)
                       (crc.test verbose tests)
                       (date.test verbose tests)
                       (digest.test verbose tests)
                       (dsssl.test verbose tests)
                       (hash.test verbose tests)
                       (int1.test verbose tests)
                       (int2.test verbose tests)
                       (internet.test verbose tests)
                       (io.test verbose tests)
                       (lalr.test verbose tests)
                       (match.test verbose tests)
                       (module.test verbose tests)
                       (mmap.test verbose tests)
                       (net.test verbose tests)
                       (number.test verbose tests)
                       (object.test verbose tests)
                       (os.test verbose tests)
                       (pair.test verbose tests)
                       (port.test verbose tests)
                       (process.test verbose tests)
                       (real.test verbose tests)
                       (regexp.test verbose tests)
                       (rgc.test verbose tests)
                       (search.test verbose tests)
                       (serial.test verbose tests)
                       (ssr.test verbose tests)
                       (string.test verbose tests)
                       (symbol.test verbose tests)
                       (tar.test verbose tests)
                       (thread.test verbose tests)
                       (unicode.test verbose tests)
                       (vector.test verbose tests)
                       (weakptr.test verbose tests)
                       (zip.test verbose tests)))
          (res-libs (filter pair?
                       (list
                          (cond-expand
                             ((library csv) (csv0.test verbose tests)))
                          (cond-expand
                             ((library sqlite) (sqlite0.test verbose tests)))
                          (cond-expand
                             ((library ssl) (ssl0.test verbose tests))))))
          (res-extern (list
                         (cond-expand
                            (C (c.test verbose tests))
                            (jvm (jvm.test verbose tests))
                            (wasm (wasm.test verbose tests)))))
          (res (append res-core res-libs res-extern))
	  (success (apply + (map car (filter (lambda (x) x) res))))
	  (failures (apply + (map cdr (filter (lambda (x) x) res))))
	  (backend (cond-expand
		      (bigloo-c "C")
		      (bigloo-wasm "wasm")
		      (bigloo-jvm "jvm")
		      (else "?"))))
      (if (=fx failures 0)
	  (begin
             (printf "all ~a (~a) tests ~a.\n"
                success backend (color 'ok "passed"))
             (exit 0))
	  (begin
             (printf "~a/~a (~a) tests ~a.\n"
                failures (+fx success failures) backend
                (color 'fail "failed"))
             (exit 1)))))
