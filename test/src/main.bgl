;*---------------------------------------------------------------------*/
;*    main                                                             */
;*---------------------------------------------------------------------*/
(module main
   (import "./bool.bgl" . bool)
   (import "./bignum.bgl" . bignum)
   (import "./bit.bgl" . bit)
   (import "./char.bgl" . char)
   (import "./condexpand.bgl" . condexpand)
   (import "./date.bgl" . date)
   (import "./dsssl.bgl" . dsssl)
   (import "./hash.bgl" . hash)
   (import "./int1.bgl" . int1)
   (import "./int2.bgl" . int2)
   (import "./io.bgl" . io)
   (import "./module.bgl" . module)
   (import "./number.bgl" . number)
   (import "./object.bgl" . object)
   (import "./pair.bgl" . pair)
   (import "./port.bgl" . port)
   (import "./real.bgl" . real)
   (import "./string.bgl" . string)
   (import "./thread.bgl" . thread)
   (import "./unicode.bgl" . unicode)
   (import "./vector.bgl" . vector)
   (main))

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "./test.bgh")

;*---------------------------------------------------------------------*/
;*    main ...                                                         */
;*---------------------------------------------------------------------*/
(define (main argv)
   
   (define verbose #f)
   (define tests '())
   
   (args-parse (cdr argv)
      ((("-v" "--verbose") (help "verbose"))
       (set! verbose #t))
      (else
       (set! tests (cons else tests))))

   (let* ((res (list
                  (bool.test verbose tests)
                  (bignum.test verbose tests)
                  (bit.test verbose tests)
                  (char.test verbose tests)
                  (condexpand.test verbose tests)
                  (date.test verbose tests)
                  (dsssl.test verbose tests)
		  (hash.test verbose tests)
		  (int1.test verbose tests)
		  (int2.test verbose tests)
		  (io.test verbose tests)
                  (module.test verbose tests)
                  (number.test verbose tests)
                  (object.test verbose tests)
		  (pair.test verbose tests)
		  (port.test verbose tests)
		  (real.test verbose tests)
		  (string.test verbose tests)
                  (thread.test verbose tests)
                  (unicode.test verbose tests)
		  (vector.test verbose tests)))
	  (success (apply + (map car (filter (lambda (x) x) res))))
	  (failures (apply + (map cdr (filter (lambda (x) x) res))))
	  (backend (cond-expand
		      (bigloo-c "C")
		      (bigloo-wasm "wasm")
		      (bigloo-jvm "jvm")
		      (else "?"))))
      (if (=fx failures 0)
	  (begin
             (printf "all ~a (~a) tests ~a.\n"
                success backend (color 'ok "passed"))
             (exit 0))
	  (begin
             (printf "~a/~a (~a) tests ~a.\n"
                failures (+fx success failures) backend
                (color 'fail "failed"))
             (exit 1)))))
