;*---------------------------------------------------------------------*/
;*    main                                                             */
;*---------------------------------------------------------------------*/
(module main
   (import "./pair.bgl" . pair)
   (import "./string.bgl" . string)
   (import "./vector.bgl" . vector)
   (main))

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "./test.bgh")

;*---------------------------------------------------------------------*/
;*    main ...                                                         */
;*---------------------------------------------------------------------*/
(define (main argv)
   
   (define verbose #f)
   (define tests '())
   
   (args-parse (cdr argv)
      ((("-v" "--verbose") (help "verbose"))
       (set! verbose #t))
      (else
       (set! tests (cons else tests))))
   
   (let* ((res (list
		  (pair.test verbose tests)
		  (string.test verbose tests)
		  (vector.test verbose tests)))
	  (success (apply + (map car (filter (lambda (x) x) res))))
	  (failures (apply + (map cdr (filter (lambda (x) x) res))))
	  (backend (cond-expand
		      (bigloo-c "C")
		      (bigloo-wasm "wasm")
		      (bigloo-jvm "jvm")
		      (else "?"))))
      (if (=fx failures 0)
	  (printf "all ~a (~a) tests ~a.\n" success backend (color 'ok "passed"))
	  (printf "~a/~a (~a) tests ~a.\n" failures (+fx success failures) backend (color 'fail "failed")))))
