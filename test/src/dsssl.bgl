;*    Testing DSSSL declarations and arguments passing                 */
;*=====================================================================*/

;*---------------------------------------------------------------------*/
;*    dsssl                                                            */
;*---------------------------------------------------------------------*/
(module dsssl
   (export test)
   (eval (export dsssl2 dsssl4 dsssl6)))

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "./test.bgh")

;*---------------------------------------------------------------------*/
;*    test ...                                                         */
;*---------------------------------------------------------------------*/
(define (test verbose tests::pair-nil)
   (when (or (null? tests) (member "dsssl" tests))
      (test-all verbose "dsssl")))

;*---------------------------------------------------------------------*/
;*    auxiliary functions                                              */
;*---------------------------------------------------------------------*/
(define-macro (DSSSL-macro x)
   x)

(define (foo x y #!optional z (zz 1) #!rest r #!key i (j 1))
   (let ((f (lambda (z y #!key (i 8)) (list z y i))))
      (labels ((g (a b #!rest l) (list a b l)))
	 (list x y z zz i: i j: j))))

(define (test-dsssl-eval)
   (eval '(define (dsssl x y #!optional z (zz 1) #!rest r #!key i (j 1))
	     (let ((f (lambda (z y #!key (i 8)) (list z y i))))
		(labels ((g (a b #!rest l) (list a b l)))
		   (list x y z zz i: i j: j)))))
   #t)

(define (dsssl-lexical b c #!optional (=::procedure equal?))
   (= b c))

(define (connect #!optional environment #!key (hostname "localhost"))
   (cons environment hostname))

(define (dsssl2 a #!optional b (c 'c) (d 'd))
   (list a b c d))

(define (dsssl2-test1)
   (list (dsssl2 11 22 33 44)
	 (dsssl2 11 22 33)
	 (dsssl2 11 22)
	 (dsssl2 11)))

(define (dsssl2-test1-eval)
   (eval '(list (dsssl2 11 22 33 44)
		(dsssl2 11 22 33)
		(dsssl2 11 22)
		(dsssl2 11))))

(define (dsssl2-test2 f)
   (list (f 11 22 33 44)
	 (f 11 22 33)
	 (f 11 22)
	 (f 11)))

(define (dsssl2-test3 f)
   (list (apply f '(11 22 33 44))
	 (apply f '(11 22 33))
	 (apply f '(11 22))
	 (apply f '(11))))

(define (dsssl2-test4 f . args)
   (apply f args))

(define (dsssl3-test1)
   (list (dsssl3 11 22 33 44)
	 (dsssl3 11 22 33)
	 (dsssl3 11 22)
	 (dsssl3 11)))

(define (dsssl3-test2)
   (list ((car (list dsssl3)) 11 22 33 44)
	 ((car (list dsssl3)) 11 22 33)
	 ((car (list dsssl3)) 11 22)
	 ((car (list dsssl3)) 11)))

(define (dsssl3b-test1)
   (list (dsssl3b 11 c: 33 b: 22 d: 44)
	 (dsssl3b 11 b: 22 c: 33)
	 (dsssl3b 11 b: 22)
	 (dsssl3b 11)))

(define (dsssl3b-test2)
   (list ((car (list dsssl3b)) 11 d: 44 b: 22 c: 33)
	 ((car (list dsssl3b)) 11 c: 33 b: 22)
	 ((car (list dsssl3b)) 11 b: 22)
	 ((car (list dsssl3b)) 11)))

(define (dsssl3 a #!optional b (c 'c) (d 'd))
   (list a b c d))

(define (dsssl3b a #!key b (c 'c) (d 'd))
   (list a b c d))

;*---------------------------------------------------------------------*/
;*    dsssl4 ...                                                       */
;*---------------------------------------------------------------------*/
(define (dsssl4 a #!key b (d 'd) (c 'c))
   (list a b c d))

(define (dsssl4-test1)
   (list
    (dsssl4 11 c: 33 b: 22 d: 44)
    (dsssl4 11 b: 22 c: 33)
    (dsssl4 11 b: 22)
    (dsssl4 11)))

(define (dsssl4-test1-eval)
   (eval '(list
	   (dsssl4 11 c: 33 b: 22 d: 44)
	   (dsssl4 11 b: 22 c: 33)
	   (dsssl4 11 b: 22)
	   (dsssl4 11))))

(define c c:)
(define b b:)

(define (dsssl4-test1b)
   (list
    (dsssl4 11 d: 44 b: 22 c 33)
    (dsssl4 11 c 33 b 22)
    (dsssl4 11 b 22)
    (dsssl4 11)))

(define (dsssl4-test1b-eval)
   (eval '(let ((c c:)
		(b b:))
	     (list
	      (dsssl4 11 d: 44 b: 22 c 33)
	      (dsssl4 11 c 33 b 22)
	      (dsssl4 11 b 22)
	      (dsssl4 11)))))

(define (dsssl4-test2 f)
   (list
    (f 11 c: 33 b: 22 d: 44)
    (f 11 c: 33 b: 22 )
    (f 11 b: 22)
    (f 11)))

(define (dsssl4-test3 f)
   (list
    (apply f (list 11 b: 22 d: 44 c: 33))
    (apply f (list 11 c: 33 b: 22))
    (apply f (list 11 b: 22))
    (apply f (list 11))))

(define (dsssl4-test4 f . args)
   (apply f args))

;*---------------------------------------------------------------------*/
;*    dsssl5 ...                                                       */
;*---------------------------------------------------------------------*/
(define (dsssl5 ident
		#!key
		(version #unspecified)
		(format "raw")
		(filter #f)
		(delegate #f)
		(symbol-table '())
		(custom '())
		(info '()))
   (list ident version custom info format))

;*---------------------------------------------------------------------*/
;*    dsssl6                                                           */
;*---------------------------------------------------------------------*/
(define (dsssl6 #!optional (a 'a) b)
   (list a b))

(define (dsssl6-test1)
   (list (dsssl6 11 22)
	 (dsssl6 11)
	 (dsssl6)))

(define (dsssl6-test1-eval)
   (eval '(list (dsssl6 11 22)
		(dsssl6 11)
		(dsssl6))))

(define (dsssl6-test2 f)
   (list (f 11 22)
	 (f 11)
	 (f)))

(define (dsssl6-test3 f)
   (list (apply f '(11 22))
	 (apply f '(11))
	 (apply f '())))

(define (dsssl6-test4 f . args)
   (apply f args))

;*---------------------------------------------------------------------*/
;*    dsssl6b ...                                                      */
;*---------------------------------------------------------------------*/
(define dsssl6b dsssl6)

(define (dsssl6b-test1)
   (list (dsssl6b 11 22)
	 (dsssl6b 11)
	 (dsssl6b)))

(define (dsssl6b-test2 f)
   (list (f 11 22)
	 (f 11)
	 (f)))

(define (dsssl6b-test3 f)
   (list (apply f '(11 22))
	 (apply f '(11))
	 (apply f '())))

(define (dsssl6b-test4 f . args)
   (apply f args))

;*---------------------------------------------------------------------*/
;*    dsssl7 ...                                                       */
;*---------------------------------------------------------------------*/
(define (dsssl7 #!optional (dsssl7 2) (z dsssl7))
   z)

;*---------------------------------------------------------------------*/
;*    dsssl8 ...                                                       */
;*---------------------------------------------------------------------*/
(define (dsssl8 #!key (y 2) (z y))
   z)

;*---------------------------------------------------------------------*/
;*    dsssl9 ...                                                       */
;*---------------------------------------------------------------------*/
(define (dsssl9 ip::input-port op::output-port #!optional (s 1) (o -1))
   (+fx s o))

;*---------------------------------------------------------------------*/
;*    dsssl11 ...                                                      */
;*---------------------------------------------------------------------*/
(define (dsssl11 x y #!optional z #!key i (j 1) #!rest r)
    (list x y z i: i j: j r))

;*---------------------------------------------------------------------*/
;*    dt->sec ...                                                      */
;*---------------------------------------------------------------------*/
(define (dt->sec a #!key (x #t))
   (date->seconds x))

;*---------------------------------------------------------------------*/
;*    dsssl-bug ...                                                    */
;*---------------------------------------------------------------------*/
(define (dsssl-bug #!key (foo::bool #t))
   foo)

;*---------------------------------------------------------------------*/
;*    tests                                                            */
;*---------------------------------------------------------------------*/
(define-test opt+key
   (let ((f (lambda (x #!optional (port::output-port (current-output-port)) #!key (size 1000)) x)))
      (+ (f 1) ((car (list f)) 2)))
   :expected 3)

(define-test keyword (dsssl-bug :foo #f)
   :expected #f)

(let* ((dt (current-date))
       (res (date->seconds dt)))
   (define-test keyword ((if (> res 0) dt->sec list) 1 x: dt)
      :expected res))

(define-test dsssl.1 (foo 1 2 3 4 i: 5)
   :expected '(1 2 3 4 i: 5 j: 1))
(define-test dsssl.2 (foo 1 2 3 4 i: 5 j: 3)
   :expected '(1 2 3 4 i: 5 j: 3))
(define-test dsssl.3
   ((lambda (x y #!optional z #!rest r #!key i (j 1))
       (list x y z i: i j: j))
    3 4 5 i: 6 i: 7)
   :expected '(3 4 5 i: 6 j: 1))
(define-test dsssl-eps
   ((lambda (x y #!optional z #!rest r #!key i (j (DSSSL-macro 1)))
       (list x y z i: i j: j))
    3 4 5 i: 6 i: 7)
   :expected '(3 4 5 i: 6 j: 1))

(define-test eval.1 (test-dsssl-eval)
   :expected #t)
(define-test eval.2 (eval '(dsssl 1 2 3 4 i: 5))
   :expected '(1 2 3 4 i: 5 j: 1))
(define-test eval-eps.3
   (eval '(begin
           (define-macro (DSSSL-macro x)
              x)
           ((lambda (x y #!optional z #!rest r #!key i (j (DSSSL-macro 1)))
               (list x y z i: i j: j))
            3 4 5 i: 6 i: 7)))
   :expected '(3 4 5 i: 6 j: 1))
(define-test dsssl.4
   (eval '((lambda (x y #!optional z #!rest r #!key i (j 1))
              (list x y z i: i j: j))
           3 4 5 i: 6 i: 7))
   :expected '(3 4 5 i: 6 j: 1))

(define-test lexical
   (dsssl-lexical '(1 2) (list 1 2))
   :expected #t)
(define-test lexical.2
   (let ((equal? (lambda (a b) #f)))
      (dsssl-lexical '(1 2) (list 1 2)))
   :expected #t)
(define-test lexical.3
   (let ((equal? (lambda (a b) #f)))
      ((car (list dsssl-lexical)) '(1 2) (list 1 2)))
   :expected #t)

(define-test optional+key.1 (connect 3)
   :expected '(3 . "localhost"))
(define-test optional+key.2 (connect 3 hostname: "hueco")
   :expected '(3 . "hueco"))
(define-test optional+rest+key
   (eval '((lambda (x y #!optional z #!rest r #!key i (j 1))
              (list x y z r: r i: i j: j))
           3 4 5 6 i: 6))
   :expected '(3 4 5 r: (6 i: 6) i: 6 j: 1))
(define-test optional+rest+key
   (eval '((lambda (x y #!optional z #!rest r #!key i (j 1))
              (list x y z r: r i: i j: j))
           3 4 5 6 7 8 9 i: 6))
   :expected '(3 4 5 r: (6 7 8 9 i: 6) i: 6 j: 1))

(define-test dsssl2.1 (dsssl2-test1)
   :expected '((11 22 33 44)
               (11 22 33 d)
               (11 22 c d)
               (11 #f c d)))
(define-test dsssl2-eval.1 (dsssl2-test1-eval)
   :expected '((11 22 33 44)
               (11 22 33 d)
               (11 22 c d)
               (11 #f c d)))
(define-test dsssl2.2 (dsssl2-test2 dsssl2)
   :expected '((11 22 33 44)
               (11 22 33 d)
               (11 22 c d)
               (11 #f c d)))
(define-test dsssl2.2b (dsssl2-test2 (car (list dsssl2)))
   :expected '((11 22 33 44)
               (11 22 33 d)
               (11 22 c d)
               (11 #f c d)))
(define-test dsssl2.3 (dsssl2-test3 dsssl2)
   :expected '((11 22 33 44)
               (11 22 33 d)
               (11 22 c d)
               (11 #f c d)))
(define-test dsssl2.3b (dsssl2-test3 (car (list dsssl2)))
   :expected '((11 22 33 44)
               (11 22 33 d)
               (11 22 c d)
               (11 #f c d)))
(define-test dsssl3.1 (dsssl3-test1)
   :expected '((11 22 33 44)
               (11 22 33 d)
               (11 22 c d)
               (11 #f c d)))
(define-test dsssl3.2 (dsssl2-test2 dsssl3)
   :expected '((11 22 33 44)
               (11 22 33 d)
               (11 22 c d)
               (11 #f c d)))
(define-test dsssl3.2b (dsssl2-test2 (car (list dsssl3)))
   :expected '((11 22 33 44)
               (11 22 33 d)
               (11 22 c d)
               (11 #f c d)))
(define-test dsssl3.3 (dsssl2-test3 dsssl3)
   :expected '((11 22 33 44)
               (11 22 33 d)
               (11 22 c d)
               (11 #f c d)))
(define-test dsssl3.3 (dsssl2-test4 dsssl3 11 22 33 44)
   :expected '(11 22 33 44))
(define-test dsssl3.3
   ((car (list dsssl2-test4)) (car (list dsssl3)) 11 22 33 44)
   :expected '(11 22 33 44))
(define-test dsssl3.3b (dsssl2-test3 (car (list dsssl3)))
   :expected '((11 22 33 44)
               (11 22 33 d)
               (11 22 c d)
               (11 #f c d)))
(define-test dsssl3.4 (dsssl3-test2)
   :expected '((11 22 33 44)
               (11 22 33 d)
               (11 22 c d)
               (11 #f c d)))
(define-test dsssl3.5 (dsssl3b-test1)
   :expected 	 '((11 22 33 44)
                   (11 22 33 d)
                   (11 22 c d)
                   (11 #f c d)))
(define-test dsssl3.6 (dsssl3b-test2)
   :expected '((11 22 33 44)
               (11 22 33 d)
               (11 22 c d)
               (11 #f c d)))
(define-test dsssl3.5 (dsssl3b-test2)
   :expected '((11 22 33 44)
               (11 22 33 d)
               (11 22 c d)
               (11 #f c d)))
(define-test dsssl4.1 (dsssl4-test1)
   :expected '((11 22 33 44)
               (11 22 33 d)
               (11 22 c d)
               (11 #f c d)))
(define-test dsssl4-eval.1 (dsssl4-test1-eval)
   :expected '((11 22 33 44)
               (11 22 33 d)
               (11 22 c d)
               (11 #f c d)))
(define-test dsssl4.1b (dsssl4-test1b)
   :expected '((11 22 33 44)
               (11 22 33 d)
               (11 22 c d)
               (11 #f c d)))
(define-test dsssl4-eval.1b (dsssl4-test1b-eval)
   :expected '((11 22 33 44)
               (11 22 33 d)
               (11 22 c d)
               (11 #f c d)))
(define-test dsssl4.2 (dsssl4-test2 dsssl4)
   :expected '((11 22 33 44)
               (11 22 33 d)
               (11 22 c d)
               (11 #f c d)))
(define-test dsssl4.2b (dsssl4-test2 (car (list dsssl4)))
   :expected '((11 22 33 44)
               (11 22 33 d)
               (11 22 c d)
               (11 #f c d)))
(define-test dsssl4.3 (dsssl4-test3 dsssl4)
   :expected '((11 22 33 44)
               (11 22 33 d)
               (11 22 c d)
               (11 #f c d)))
(define-test dsssl4.3 (dsssl4-test4 dsssl4 11 b: 22 d: 44 c: 33)
   :expected '(11 22 33 44))
(define-test dsssl4.3
   ((car (list dsssl4-test4)) (car (list dsssl4)) 11 b: 22 d: 44 c: 33)
   :expected '(11 22 33 44))
(define-test dsssl4.3b (dsssl4-test3 (car (list dsssl4)))
   :expected '((11 22 33 44)
               (11 22 33 d)
               (11 22 c d)
               (11 #f c d)))

(define-test dsssl4-error
   (with-handler
      (lambda (e) 56)
      ((car (list dsssl4)) 1 z: 23))
   :expected 56)

(define-test dsssl5.1 (dsssl5 'bootstrap :version "18")
   :expected '(bootstrap "18" () () "raw"))
(define-test dsssl5.2 ((car (list dsssl5)) 'bootstrap :version "18")
   :expected '(bootstrap "18" () () "raw"))
(define-test dsssl6.1 (dsssl6-test1)
   :expected '((11 22)
               (11 #f)
               (a #f)))
(define-test dsssl6-eval.1 (dsssl6-test1-eval)
   :expected '((11 22)
               (11 #f)
               (a #f)))
(define-test dsssl6.2 (dsssl6-test2 dsssl6)
   :expected '((11 22)
               (11 #f)
               (a #f)))
(define-test dsssl6.2b (dsssl6-test2 (car (list dsssl6)))
   :expected '((11 22)
               (11 #f)
               (a #f)))
(define-test dsssl6.3 (dsssl6-test3 dsssl6)
   :expected '((11 22)
               (11 #f)
               (a #f)))
(define-test dsssl6.3b (dsssl6-test3 (car (list dsssl6)))
   :expected '((11 22)
               (11 #f)
               (a #f)))
(define-test dsssl6.4 ((car (list dsssl6-test4)) (car (list dsssl6)) 1 2)
   :expected '(1 2))
(define-test dsssl6b.1 (dsssl6b-test1)
   :expected '((11 22)
               (11 #f)
               (a #f)))
(define-test dsssl6b.2 (dsssl6b-test2 dsssl6b)
   :expected '((11 22)
               (11 #f)
               (a #f)))
(define-test dsssl6b.2b (dsssl6b-test2 (car (list dsssl6b)))
   :expected '((11 22)
               (11 #f)
               (a #f)))
(define-test dsssl6b.3 (dsssl6b-test3 dsssl6b)
   :expected '((11 22)
               (11 #f)
               (a #f)))
(define-test dsssl6b.3b (dsssl6b-test3 (car (list dsssl6b)))
   :expected '((11 22)
               (11 #f)
               (a #f)))
(define-test dsssl6b.4 ((car (list dsssl6b-test4)) (car (list dsssl6b)) 1 2)
   :expected '(1 2))
(define-test dsssl7.1 (dsssl7 43)
   :expected 43)
(define-test dsssl7.2 ((car (list dsssl7)) 43)
   :expected 43)
(define-test dsssl7.3 (apply (car (list dsssl7)) '(43))
   :expected 43)
(define-test dsssl8.1 (dsssl8 y: 44)
   :expected 44)
(define-test dsssl8.2 ((car (list dsssl7)) y: 44)
   :expected 44)
(define-test dsssl8.3 (apply (car (list dsssl7)) '(y: 44))
   :expected 44)
(define-test dsssl9.1 (dsssl9 (current-input-port) (current-output-port))
   :expected 0)
(define-test dsssl9.2
   ((vector-ref (vector dsssl9) 0)
    (current-input-port)
    (current-output-port))
   :expected 0)
(define-test dssss11.1 (dsssl11 3 4 5 i: 6 i: 7 8 9)
   :expected '(3 4 5 i: 6 j: 1 (8 9)))
(define-test dssss11.2 (apply dsssl11 '(3 4 5 i: 6 i: 7 8 9))
   :expected '(3 4 5 i: 6 j: 1 (8 9)))
(define-test dssss11.3 ((cadr (list dsssl9 dsssl11)) 3 4 5 i: 6 i: 7 8 9)
   :expected '(3 4 5 i: 6 j: 1 (8 9)))

;*---------------------------------------------------------------------*/
;*    generics and methods                                             */
;*---------------------------------------------------------------------*/
(define-class dsssl-test)

(define-generic (do-w/optional a::obj #!optional (b 5))
   (list 'default b))

(define-method (do-w/optional a::dsssl-test #!optional (b 5))
   (list 'method b))

(define-generic (do-w/key a #!key (k 5))
   (list 'default k))

(define-method (do-w/key a::dsssl-test #!key (k 5))
   (list 'method k))

(define-generic (do-w/rest a::obj #!rest r)
   (list 'default r))

(define-method (do-w/rest a::dsssl-test #!rest r)
   (list 'method r))

(define-generic (do-w/opt+key a::obj #!optional (b 1) #!key (k 2))
   (list 'default b k))

(define-method (do-w/opt+key a::dsssl-test #!optional (b 1) #!key (k 2))
   (list 'method b k))

(define-generic (do-w/opt+rest a::obj #!optional (b 1) #!rest r)
   (list 'default b r))

(define-method (do-w/opt+rest a::dsssl-test #!optional (b 1) #!rest r)
   (list 'method b r))

(define-generic (do-w/key+rest a #!key (k 1) #!rest r)
   (list 'default k r))

(define-method (do-w/key+rest a::dsssl-test #!key (k 1) #!rest r)
   (list 'method k r))

(define-generic (do-w/all3 a::obj #!optional (b 1) #!key (k 2) #!rest r)
   (list 'default b k r))

(define-method (do-w/all3 a::dsssl-test #!optional (b 1) #!key (k 2) #!rest r)
   (list 'method b k r))

(define-test generic/optional-default
   (do-w/optional 3)
   :expected '(default 5))

(define-test generic/optional-value
   (do-w/optional 3 10)
   :expected '(default 10))
(define-test generic/optional-method-default
   (do-w/optional (instantiate::dsssl-test))
   :expected '(method 5))

(define-test generic/optional-method-value
   (do-w/optional (instantiate::dsssl-test) 10)
   :expected '(method 10))

;; generic with #!key
(define-test generic/key-default
   (do-w/key 3)
   :expected '(default 5))
(define-test generic/key-value
   (do-w/key 3 k: 10)
   :expected '(default 10))
(define-test generic/key-method-default
   (do-w/key (instantiate::dsssl-test))
   :expected '(method 5))
(define-test generic/key-method-value
   (do-w/key (instantiate::dsssl-test) k: 10)
   :expected '(method 10))

;; generic with #!rest
(define-test generic/rest-empty
   (do-w/rest 3)
   :expected '(default ()))
(define-test generic/rest-values
   (do-w/rest 3 4 5)
   :expected '(default (4 5)))
(define-test generic/rest-method-empty
   (do-w/rest (instantiate::dsssl-test))
   :expected '(method ()))
(define-test generic/rest-method-values
   (do-w/rest (instantiate::dsssl-test) 4 5)
   :expected '(method (4 5)))

;; generic with #!optional + #!key combined
(define-test generic/opt+key-defaults
   (do-w/opt+key 3)
   :expected '(default 1 2))
(define-test generic/opt+key-opt-value
   (do-w/opt+key 3 7)
   :expected '(default 7 2))
(define-test generic/opt+key-key-value
   (do-w/opt+key 3 k: 9)
   :expected '(default 1 9))
(define-test generic/opt+key-both
   (do-w/opt+key 3 7 k: 9)
   :expected '(default 7 9))
(define-test generic/opt+key-method-defaults
   (do-w/opt+key (instantiate::dsssl-test))
   :expected '(method 1 2))
(define-test generic/opt+key-method-both
   (do-w/opt+key (instantiate::dsssl-test) 7 k: 9)
   :expected '(method 7 9))

;; generic with #!optional + #!rest combined
(define-test generic/opt+rest-defaults
   (do-w/opt+rest 3)
   :expected '(default 1 ()))
(define-test generic/opt+rest-values
   (do-w/opt+rest 3 10 20 30)
   :expected '(default 10 (20 30)))
(define-test generic/opt+rest-method
   (do-w/opt+rest (instantiate::dsssl-test) 10 20)
   :expected '(method 10 (20)))

;; generic with #!key + #!rest combined
(define-test generic/key+rest-defaults
   (do-w/key+rest 3)
   :expected '(default 1 ()))
(define-test generic/key+rest-value
   (do-w/key+rest 3 k: 10)
   :expected '(default 10 ()))
(define-test generic/key+rest-method
   (do-w/key+rest (instantiate::dsssl-test) k: 10)
   :expected '(method 10 ()))

;; generic with #!optional + #!key + #!rest combined
(define-test generic/all3-defaults
   (do-w/all3 3)
   :expected '(default 1 2 ()))
(define-test generic/all3-values
   (do-w/all3 3 10 k: 20)
   :expected '(default 10 20 ()))
(define-test generic/all3-method
   (do-w/all3 (instantiate::dsssl-test) 10 k: 20)
   :expected '(method 10 20 ()))
