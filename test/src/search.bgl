;*---------------------------------------------------------------------*/
;*    search                                                           */
;*---------------------------------------------------------------------*/
(module search
   (export test))

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "./test.bgh")

;*---------------------------------------------------------------------*/
;*    test ...                                                         */
;*---------------------------------------------------------------------*/
(define (test verbose tests::pair-nil)
   (when (or (null? tests) (member "search" tests))
      (test-all verbose "search")))

;*---------------------------------------------------------------------*/
;*    tests                                                            */
;*---------------------------------------------------------------------*/
;; kmp
(define-test kmp-table
   (kmp-table "foo bar")
   :expected pair?)

(define-test kmp-string
   (let ((t (kmp-table "bar")))
      (kmp-string t "foo bar gee" 0))
   :expected 4)

(define-test kmp-string
   (let ((t (kmp-table "bar")))
      (kmp-string t "foo bar gee" 1))
   :expected 4)

(define-test kmp-string
   (let ((t (kmp-table "bar")))
      (kmp-string t "foo bar bar" 5))
   :expected 8)

(define-test kmp-string
   (let ((t (kmp-table "hux")))
      (kmp-string t "foo bar gee" 1))
   :expected -1)

(define-test kmp-mmap
   (let ((t (kmp-table "bar")))
      (kmp-mmap t (string->mmap "foo bar gee") 1))
   :expected #e4)

(define-test kmp-mmap
   (let ((t (kmp-table "bar")))
      (kmp-mmap t (string->mmap "bar bar gee") 2))
   :expected #e4)

