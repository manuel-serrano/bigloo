;*---------------------------------------------------------------------*/
;*    trace                                                            */
;*---------------------------------------------------------------------*/
(module trace
   (export test))

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "./test.bgh")

;*---------------------------------------------------------------------*/
;*    test ...                                                         */
;*---------------------------------------------------------------------*/
(define (test verbose tests::pair-nil)
   (when (or (null? tests) (member "trace" tests))
      (test-all verbose "trace")))

;*---------------------------------------------------------------------*/
;*    tests                                                            */
;*---------------------------------------------------------------------*/
(define-test with-trace
   (with-trace 'debug "with-trace" 'a-value)
   :result 'a-value)

(define-test trace-item
   (with-trace 'debug 'with-trace
      (trace-item "time=" 1)
      #t))

(define-test trace-bold
   (trace-bold '(1 2))
   :result string?)

(define-test trace-color
   (trace-color 3 "foo bar")
   :result string?)

(define-test trace-margin
   trace-margin
   :result procedure?)

(define-test trace-margin-set!
   (begin
      (trace-margin-set! "~")
      (trace-margin))
   :result "~")

(define-test trace-port
   trace-port
   :result procedure?)

(define-test trace-port-set!
   (let ((op (open-output-string)))
      (unwind-protect
         (begin
            (trace-port-set! op)
            (eq? (trace-port) op))
         (close-output-port op))))
