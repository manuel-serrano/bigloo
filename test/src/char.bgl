;*---------------------------------------------------------------------*/
;*    chars                                                            */
;*---------------------------------------------------------------------*/
(module chars
   (export test))

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "./test.bgh")

;*---------------------------------------------------------------------*/
;*    test ...                                                         */
;*---------------------------------------------------------------------*/
(define (test verbose tests::pair-nil)
   (when (or (null? tests) (member "character" tests))
      (reset)
      (test-all verbose "character")))

;*---------------------------------------------------------------------*/
;*    maybe and reset                                                  */
;*---------------------------------------------------------------------*/
(define *maybe* #f)
(define (reset)
   (let ((n (cons 2 3)))
      (set! *maybe* (eq? (cddr (cons n n)) (cdr n)))))

(define (maybe n)
   (if *maybe* n 'never))

;*---------------------------------------------------------------------*/
;*    tests                                                            */
;*---------------------------------------------------------------------*/
(define-test char? (char? #\A)
   :result #t)
(define-test char? (char? (string-ref "abcd" 2))
   :result #t)
(define-test char? (char? 65)
   :result #f)

(define-test char=? (char=? #a065 #\A)
   :result #t)
(define-test char=? (char=? (string-ref "A" 0) #\A)
   :result #t)
(define-test char=? (char=? #\a #\A)
   :result #f)
(define-test char=? (char=? (integer->char 255) #a255)
   :result #t)
(define-test char=? (let ((x #\a)) (char=? x #\a))
   :result #t)
(define-test char=? (let ((x #\b)) (char=? x #\a))
   :result #f)

(define-test char<? (char<? #\a #\z)
   :result #t)
(define-test char<? (char<? #\a #\a)
   :result #f)
(define-test char<? (let ((x #\b)) (char<? x #\a))
   :result #f)
(define-test char<? (let ((x #\b)) (char<? #\a x))
   :result #t)
   
(define-test char>? (char>? #\a #\z)
   :result #f)
(define-test char>? (char>? #\a #\a)
   :result #f)
(define-test char>? (let ((x #\b)) (char>? x #\a))
   :result #t)
(define-test char>? (let ((x #\b)) (char>? #\a x))
   :result #f)
(define-test char>? (let ((s "Ã©tÃ©")) (char>? (string-ref s 0) #a127))
   :result #t)
   
(define-test char<=? (char<=? #\a #\z)
   :result #t)
(define-test char<=? (char<=? #\a #\a)
   :result #t)
   
(define-test char>=? (char>=? #\a #\z)
   :result #f)
(define-test char>=? (char>=? #\a #\a)
   :result #t)
   
(define-test char-ci=? (char-ci=? #a065 #\A)
   :result #t)
(define-test char-ci=? (char-ci=? (string-ref "A" 0) #\A)
   :result #t)
(define-test char-ci=? (char-ci=? #\a #\A)
   :result #t)
(define-test char-ci=? (let ((x #\A)) (char-ci=? x #\a))
   :result #t)
(define-test char-ci=? (let ((x #\B)) (char-ci=? x #\a))
   :result #f)

(define-test char-ci<? (char-ci<? #\a #\z)
   :result #t)
(define-test char-ci<? (char-ci<? #\a #\a)
   :result #f)
(define-test char-ci<? (let ((x #\B)) (char-ci<? x #\a))
   :result #f)
(define-test char-ci<? (let ((x #\B)) (char-ci<? #\a x))
   :result #t)
   
(define-test char-ci>? (char-ci>? #\a #\z)
   :result #f)
(define-test char-ci>? (char-ci>? #\a #\a)
   :result #f)
(define-test char-ci>? (let ((x #\B)) (char-ci>? x #\a))
   :result #t)
(define-test char-ci>? (let ((x #\B)) (char-ci>? #\a x))
   :result #f)
   
(define-test char-ci<=? (char-ci<=? #\a #\z)
   :result #t)
(define-test char-ci<=? (char-ci<=? #\a #\a)
   :result #t)
   
(define-test char-ci>=? (char-ci>=? #\a #\z)
   :result #f)
(define-test char-ci>=? (char-ci>=? #\a #\a)
   :result #t)
   
(define-test char-alphabetic? (char-alphabetic? #\A)
   :result #t)
(define-test char-alphabetic? (char-alphabetic? #\z)
   :result #t)
(define-test char-alphabetic? (char-alphabetic? #\?)
   :result #f)
(define-test char-alphabetic? (char-alphabetic? #\0)
   :result #f)

(define-test char-numeric? (char-numeric? #\1)
   :result #t)
(define-test char-numeric? (char-numeric? #\v)
   :result #f)
(define-test char-numeric? (char-numeric? #\a)
   :result #f)
(define-test char-numeric? (char-numeric? #\0)
   :result #t)

(define-test char-whitespace? (char-whitespace? #\space)
   :result #t)
(define-test char-whitespace? (char-whitespace? #\newline)
   :result #t)
(define-test char-whitespace? (char-whitespace? #\tab)
   :result #t)
(define-test char-whitespace? (char-whitespace? #\.)
   :result #f)
(define-test char-whitespace?.1 (char-whitespace? #\a)
   :result #f)

(define-test char-upper-case? (char-upper-case? #\A)
   :result #t)
(define-test char-upper-case? (char-upper-case? #\a)
   :result #f)

(define-test char-lower-case? (char-lower-case? #\a)
   :result #t)
(define-test char-lower-case? (char-lower-case? #\A)
   :result #f)

(define-test char-upcase (char-upcase #\a)
   :result #\A)
(define-test char-upcase (char-upcase #\A)
   :result #\A)

(define-test char-downcase (char-downcase #\a)
   :result #\a)
(define-test char-downcase (char-downcase #\A)
   :result #\a)

(define-test char->integer (char->integer #\A)
   :result 65)
(define-test char<->integer (char->integer (integer->char 128))
   :result 128)

(define-test integer->char (integer->char (char->integer #\A))
   :result #\A)

(define-test char? (char? (maybe #\a)))
(define-test char (char? (maybe 32)) :result #f)
(define-test char? (char? (string-ref (maybe "hello") 1)))

(define-test char->integer
   (char->integer (maybe #\a))
   :result (char->integer #\a))
(define-test char->integer
   (char->integer (maybe #a200))
   :result 200)
(define-test char->integer
   (char->integer #\')
   :result 39)
(define-test char->integer
   (char->integer #\xea)
   :result #xea)
(define-test char->integer
   (char->integer #\010)
   :result 8)
(define-test char->integer
   (char->integer #a008)
   :result 8)
(define-test char->integer
   (char->integer #\null)
   :result 0)
(define-test char->integer (char->integer #\0)
   :result 48)
(define-test char->integer (char->integer #a200)
   :result 200)

(define-test eq? (eq? #\a #\a) :result #t)
(define-test eq? (eq? #\a #\A) :result #f)
(define-test eq? (eq? #\| #\|) :result #t)
(define-test eqv? (eqv? #\a #\a) :result #t)
(define-test eqv? (eqv? #\a #\A) :result #f)
(define-test eqv? (eqv? #\| #\|) :result #t)
(define-test eqv? (eqv? (integer->char 255) (car (list #a255))) :result #t)
(define-test integer->char (integer->char 255) :result #a255)
(define-test integer->char (integer->char 48) :result #\0)


