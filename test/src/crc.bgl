(define-test crc-string
   (crc-string 'ieee-32 "the quick brown fox jumps over the lazy dog")
    :expected #zx7cf3039d)

(define-test crc-port
   (call-with-input-string "the quick brown fox jumps over the lazy dog"
      (lambda (in)
         (crc-port 'ieee-32 in)))
    :expected #zx7cf3039d)

(define-test crc-mmap
   (crc-mmap 'ieee-32 (string->mmap "the quick brown fox jumps over the lazy dog"))
    :expected #zx7cf3039d)

(define-test crc-file
   (crc-file 'ieee-32
      (make-file-path (dirname (dirname crc.filename))
         "scripts" "ssl-fixtures.sh"))
   :expected #z610157011)

(define-test register-crc!
   (begin
      (register-crc! 'invalid 1337 55)
      (crc-length 'invalid ))
   :expected 55)

(define-test crc-long
   (crc-long #\a #xB704CE #x864CFB 24)
   :expected 2582796051)

(define-test crc-elong
   (crc-long #\a #e432 #e143 24)
   :expected #e1627488943)

(define-test crc-llong
   (crc-long #\a #l432 #l143 24)
   :expected #l1627488943)

(define-test crc-long-le
   (crc-long-le #\a #xB704CE #x864CFB 24)
   :expected 2641004)

(define-test crc-elong-le
   (crc-long-le #\a #e432 #e143 24)
   :expected #e19)

(define-test crc-llong-le
   (crc-long-le #\a #l432 #l143 24)
   :expected #l19)
