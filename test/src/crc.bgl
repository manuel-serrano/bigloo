(module crc
   (export test))

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "./test.bgh")

;*---------------------------------------------------------------------*/
;*    test ...                                                         */
;*---------------------------------------------------------------------*/
(define (test verbose tests::pair-nil)
   (when (or (null? tests) (member "crc" tests))
      (test-all verbose "crc")))

(define-test crc-names
   (crc-names)
   :expected list?)

(define-test crc-polynomial
   (crc-polynomial (car (crc-names)))
   :expected number?)

(define-test crc-polynomial-le
   (crc-polynomial (car (crc-names)))
   :expected number?)

(define-test crc-polynomial-be->le
   (crc-polynomial-be->le 1 (crc-polynomial (car (crc-names))))
   :expected number?)

(define-test crc-length
   (crc-length 'can-15)
   :expected 15)
      
(define-test crc
   (crc 'atm-8 "W" :big-endian? #f)
   :expected #zx19)

(define-test crc
   (crc 'ieee-32 "0")
   :expected #zxd4326d90)

(define-test crc
   (crc 'ieee-32 "0")
   :expected  #zxd4326d90)

(define-test crc
   (crc 'ieee-32 "A")
   :expected  #zx30476dc0)

(define-test crc
   (crc 'ieee-32 "the quick brown fox jumps over the lazy dog")
    :expected #zx7cf3039d)

(define-test crc
   (crc 'ieee-32 "the quick brown fox jumps over the lazy dog" :init -1 :final-xor -1)
   :expected #zxf0269282)

(define-test crc
   (crc 'radix-64-24 "0")
   :expected #zxc99f60)

(define-test crc
   (crc 'radix-64-24 "A")
   :expected #zx9fef29)

(define-test crc
   (crc 'radix-64-24 "the quick brown fox jumps over the lazy dog")
   :expected #zx70d45d)

(define-test crc
   (crc 'radix-64-24 "the quick brown fox jumps over the lazy dog" :init -1 :final-xor -1)
   :expected #zxff8015)

