(module closure
   (export test)
   (option (set! *inlining?* #f)))

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "./test.bgh")

;*---------------------------------------------------------------------*/
;*    test ...                                                         */
;*---------------------------------------------------------------------*/
(define (test verbose tests::pair-nil)
   (when (or (null? tests) (member "closure" tests))
      (test-all verbose "closure")))

;*---------------------------------------------------------------------*/
;*    Globalisation                                                    */
;*---------------------------------------------------------------------*/
(define (test1)
   (labels ((fun1 () 0)
	    (fun2 () (labels ((loop () (fun1)))
			(loop))))
      fun2))

(define (test2 x y z)
   (labels ((hux (a1)  x)
	    (bar (a1) (hux y))
	    (gee ()  (bar z)))
      gee))

(define test3 (labels ((lam_0 ()
			      (labels ((ignore ()
					       (let ((v 1))
						  (labels ((foo () v))
						     (foo)))))
				 (ignore))))
		 lam_0))

(define (test4 a b)
   (labels ((foo (x) (set! x b) x))
      foo))

(define (test5 a b . c)
   (labels ((foo (x y) (set! c y) y)
	    (bar (z) (foo 2 1))
	    (hux (t) (set! a (foo t t)) c))
      hux))

(define (test6 . c)
   (let ((a2 0)
	 (b 0))
      (labels ((foo (x) (set! a2 x) a2)
	       (bar (y) (set! b y) (foo b)))
	 (bar 1)
	 foo)))

(define (test7 x)
   (labels ((bar (a3) (hux a3))
	    (gee (b) bar)
	    (hux (c) x))
      bar
      gee))

(define (plante-k2 l)
   (labels ((l1 (x) (labels ((l2 () (bar x (l3 (g)))))
                       (gee (l2) (l2))))
            (l3 (y) (labels ((l4 () (zee y (l1 (g)))))
                       (gee (l4) (l4)))))
      (l1 (g))))

(define (bar x y) (if (= x y) (+ x y) 0))
(define (gee x y) (+ x y))
(define (zee x y) (- x y))
(define (g) (if (= (gee 4 2) (zee 8 2)) 2 1))

(define (plante-2 c_1)
   (labels ((c1_13 () (c_1 (list 1))))
      (lar (lambda () (hux (lambda () (c1_13)))))))

(define (plante-3  c_1)
   (labels ((c1_13 (x) (c_1 (c1_13 (list 1)))))
      (lar (lambda () (hux (lambda () (c1_13 1)))))))

(define (lar x)
   x)

(define (hux x)
   x)

(define (plante-4 a)
   (labels ((hux (z) foo)
	    (foo (x) x))
      (hux foo)))

(define (_plante-4 x y)
   (+ x y))

(define (compile exp)
  (begin
    (print 'compile)
    (print
      (begin
        ((labels
           ((tag-101 () '(52))
            (tag-102 () '())
            (tag-103 (fun args) '())
            (tag-104 (args) (compile-application)))
           (lambda (e-105)
             (begin
               (if (pair? e-105)
                 (let ((cdr-118 (cdr e-105)) (car-117 (car e-105)))
                   (if (eq? car-117 'module)
                     (if (eq? cdr-118 '())
                       (tag-101)
                       (let ((cdr-149 (cdr e-105)) (car-148 (car e-105)))
                         (labels
                           ((kap-152
                              ()
                              (let ((cdr-156 (cdr e-105))
                                    (car-155 (car e-105)))
                                (tag-104 cdr-156))))
                           (if (pair? car-148)
                             (let ((cdr-161 (cdr car-148))
                                   (car-160 (car car-148)))
                               (kap-152))
                             (if (vector? car-148)
                               (kap-152)
                               (tag-103 car-148 cdr-149))))))
                     (labels
                       ((kap-121
                          ()
                          (let ((cdr-127 (cdr e-105)) (car-126 (car e-105)))
                            (labels
                              ((kap-130
                                 ()
                                 (let ((cdr-134 (cdr e-105))
                                       (car-133 (car e-105)))
                                   (tag-104 cdr-134))))
                              (if (pair? car-126)
                                (let ((cdr-139 (cdr car-126))
                                      (car-138 (car car-126)))
                                  (kap-130))
                                (if (vector? car-126)
                                  (kap-130)
                                  (tag-103 car-126 cdr-127)))))))
                       (let ((cdr-141 (cdr e-105)) (car-140 (car e-105)))
                         (kap-121)))))
                 (if (vector? e-105) #f (tag-102))))))
         exp)))))

(define (compile-application)
  (begin
    (print 'compile-application)
    (print
      (begin
        (let ((aux 1))
	   (case aux
	      ((0) '())
	      (else '())))))))

(define plante-5
   (lambda (a4)
      (letrec ((x3 (lambda (x4)
		      (a4 0)
		      (lambda (c)
			 (labels ((foo () (lambda (x9) (x3 0))))
			    (foo))))))
	 x3)))

(define (plante-6 x e)
   (labels ((loop ()
		  (labels ((foo () (labels ((gee () (loop)))
				      gee)))
		     (foo) x)))
      (loop)))

(define (plante-7)
   (begin
      (set-exit
       (an-exit1013)
       (let ()
	  (push-exit! an-exit1013 1)
	  (let ((exp (let ((body1018 (lambda () 9)))
			(set-exit
			 (an-exit1025)
			 (let ()
			    (push-exit! an-exit1025 0)
			    (body1018))))))
	     (set! exp #unspecified)
	     (labels ((foo () (print exp)))
		(plante-7-bar foo)))))
      9))

(define (plante-7-bar f)
   (print (f)))

(define (test8 str)
   (let ((g (regular-grammar ()
	       (#\)
		'())
	       (#\(
		(let* ((car (ignore))
		       (cdr (ignore)))
		   (cons car cdr)))
	       ((+ (out #\( #\)))
		(the-symbol))))
	 (p (open-input-string str)))
      (read/rp g p)))

(define (static-application)
   (((lambda (a b) b)
     3
     (lambda (x) x)) 3))

(define-test globalisation ((test1)) :expected 0)
(define-test globalisation (((test7 5) 6) 7) :expected 5)
(define-test kapture ((test2 1 2 3)) :expected 1)
(define-test kapture (test3) :expected 1)
(define-test cell ((test4 1 2) 3) :expected 2)
(define-test cell ((test5 1 2 3 4) 2) :expected 2)
(define-test cell ((test6 1 2 3 4) 2) :expected 2)
(define-test rgc (test8 "(foo(bar(gee)))") :expected '(foo bar gee))
(define-test _ (_plante-4 5 6) :expected 11)
(define-test ast (static-application) :expected 3)

;*---------------------------------------------------------------------*/
;*    kapture                                                          */
;*---------------------------------------------------------------------*/
(define (kapture-test1 x y z)
   (labels ((hux (a)  x)
	    (bar (a) (hux y))
	    (gee ()  (bar z)))
      gee))

(define kapture-test2
   (labels ((lam_0 ()
			    (labels ((ignore ()
					     (let ((v 1))
						(labels ((foo2 () v))
						   (foo2)))))
			       (ignore))))
	       lam_0))

(define luc
   (lambda ()
      (let ((counter 0))
	 (lambda x
	    (set! counter (+ counter 1))
	    (string->symbol
	     ((if (null? x)
		  (lambda (u)
		     (string-append ":X"  u))
		  (if (string? (car x))
		      (lambda (u)
			 (string-append (car x)  u))
		      (lambda (u)
			 (string-append (symbol->string (car x))  u))))
	      (number->string counter)))))))

(define (kapture:test)
   (labels ((gee (y) (lambda (x) (set! y x) y)))
      ((gee 0) 2)))

(define (kapture-plante-7 file7)
   (let* ((toto (lambda () file7))
	  (foo7 (lambda ()
                   (let ((bar (lambda ()
                                 (let ((gee (lambda ()
                                               (let ((hux (lambda () (toto))))
                                                  (hux)))))
                                    (gee)))))
                      (bar)))))
      (toto)
      foo7))

(define (kapture-plante-8 file8)
   (letrec ((lexer (begin
		      (set-car! (cons 1 2) 4)
		      (lambda (input-port)
			 (labels ((toto () (labels ((gee () (foo8)))
					      (parse)
					      (gee))))
			    (toto)))))
	    (parse (lambda ()
		      (letrec ((numl
                                  (begin
                                     (set-car! (cons 1 2) 4)
                                     (lambda (input-port)
                                        (labels ((tata ()
                                                    (labels ((hux () (foo8)))
                                                       (hux))))
                                           (tata))))))
			 (numl #f))))
	    (foo8 (lambda () file8)))
      (lexer file8)))

(define (kapture-plante-9 file9)
   (let ((port (open-input-file file9)))
      
      (define (lexical-error msg obj)
	 (let ((name (input-port-name port))
	       (filepos (input-port-position port)))
	    (error "lexer" msg obj)))
      
      (define (number-parse str)
	 (define number-lexer
	    (regular-grammar ()
	       ((+ (in #\0 #\9)) (the-fixnum))
	       (else (lexical-error "ERR" str))))
         
	 (let* ((oport (open-input-string str))
		(value (read/rp number-lexer oport)))
	    (close-input-port oport)
	    value))
      
      (define lexer
	 (regular-grammar ()
	    ((+ (in #\0 #\9)) (number-parse (the-string)))
	    (else (lexical-error "ERR" (the-failure)))))
      
      (if port (read/rp lexer port)
	  (error "read-models" "Cannot open file" file9))))

(define (dataflow l)
   (let ((x (cons 2 l)))
      (letrec ((f1 (lambda ()
		      (set! x '#(2))))
	       (f2 (lambda ()
		      (if (pair? x)
			  (begin
			     (f1)
			     (if (pair? x)
				 (car x)
				 (vector-ref x 0)))))))
	 (f2))))

(define (lightfuncall)
   (define (f1) #t)
   (define (f2) #f)
   (+ (lightfuncall-foo f1) (lightfuncall-foo f2)))

(define (lightfuncall-foo f)
   (if (f) 1 2))

(define (integrate-type::pair-nil locals::pair-nil node-or-nodes)
   
   (define (kill-used-in-node n)
      (set! locals (remq n locals)))

   (when (pair? locals)
      (cond
	 ((null? node-or-nodes)
	  #unspecified)
	 ((pair? node-or-nodes)
	  (for-each kill-used-in-node node-or-nodes))
	 (else
	  (kill-used-in-node node-or-nodes))))

   locals)

(define-test kapture ((kapture-test1 1 2 3))
   :expected 1)
(define-test kapture (kapture-test2)
   :expected 1)
(define-test kapture
   (let ((gen-sym (luc)))
      (gen-sym 'a))
   :expected 'a1)
(define-test kapture (kapture:test)
   :expected 2)
(define-test kapture ((kapture-plante-7 7))
   :expected 7)
(define-test kapture (kapture-plante-8 8)
   :expected 8)
(define-test kapture (dataflow '(1))
   :expected 2)
(define-test kapture (lightfuncall)
   :expected 3)
(define-test kapture (integrate-type (list 1 2 4) (list 4 6 67))
   :expected '(1 2))
