;*---------------------------------------------------------------------*/
;*    serials                                                          */
;*---------------------------------------------------------------------*/
(module serials
   (export test))

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "./test.bgh")

;*---------------------------------------------------------------------*/
;*    test ...                                                         */
;*---------------------------------------------------------------------*/
(define (test verbose tests::pair-nil)
   (when (or (null? tests) (member "serial" tests))
      (test-all verbose "serial")))

;*---------------------------------------------------------------------*/
;*    tests                                                            */
;*---------------------------------------------------------------------*/
(define-test obj->string
   (obj->string (cons 1 2))
   :expected string?)

(define-class SPoint x y)

(define-class SPoint3D::SPoint z)

(define-test obj->string
   (let ((o (list (vector 1 2.3 "foo" 'bar #t #f #unspecified #z55))))
      (equal? o (string->obj (obj->string o)))))

(define-test obj->string
   (let ((o (list (instantiate::SPoint3D (x 0) (y 0) (z 0)))))
      (equal? o (string->obj (obj->string o)))))

(define-test string->obj
   (let* ((s "foo")
          (p (cons s s))
          (o (list p p))
          (no (string->obj (obj->string o))))
      (and (eq? (caar o) (cdar o))
           (eq? (caadr o) (cdadr o)))))

(define-test flonum (string->obj (obj->string 0.5))
   :expected real?)

(let ((o '(#s8:0 #s8:1 #s8:-1 #u8:0 #u8:1 #u8:250
           #s16:0 #s16:1 #s16:-1 #u16:0 #u16:1 #u16:250
           #s16:15000 #s16:-15000 #u16:30000
           #s32:0 #s32:1 #s32:-1 #u32:0 #u32:1 #u32:250
           #s32:15000 #s32:-15000 #u32:30000
           #s32:70000 #s32:-70000 #u32:70000
           #s64:0 #s64:1 #s64:-1 #u64:0 #u64:1 #u64:250
           #s64:15000 #s64:-15000 #u64:30000
           #s64:70000 #s64:-70000 #u64:70000)))
   (define-test int8
      (string->obj (obj->string o))
      :expected o))

(let* ((s (make-string 3 #\a))
       (l (list s s)))
   (define-test list
      (string->obj (obj->string l))
      :expected l))

(define-test mixed
   (let* ((s "toto n'est pas content")
          (sp "titi non plus")
          (ptr (make-weakptr sp))
          (l (list s s s sp sp s sp sp 'toto 'toto '#(1 2 3) #\a #\a #t #f
                ptr ptr))
          (v `#(,l ,l ,l () ,(unspecified) 1.13 1.13 #a123
                  (point 1 2) (point 2 1) 0010 0011))
          (vec (make-vector 3 v))
          (rep (obj->string v)))
      (equal? (string->obj rep) v)))

(define-test weakptr
   (let* ((c (cons 2 3))
          (ptr (make-weakptr c)))
      (set-car! c ptr)
      (let ((ptr2 (string->obj (obj->string ptr))))
         (and (weakptr? ptr2)
              (let ((d (weakptr-data ptr2)))
                 (and (pair? d)
                      (pair? c)
                      (eq? (car d) ptr2)
                      (eqv? (cdr d) 3)))))))

;*---------------------------------------------------------------------*/
;*    custom serializers                                               */
;*---------------------------------------------------------------------*/
(define-test register-procedure-serialization!
   (multiple-value-bind (serializer unserializer)
      (get-procedure-serialization)
      (let ((env '()))
         (register-procedure-serialization!
            (lambda (p)
               (let ((id (symbol->string (gensym))))
                  (set! env (cons (cons id p) env))
                  id))
            (lambda (id)
               (cdr (assoc id env))))
         (unwind-protect
            (car (string->obj (obj->string (list (lambda (x) x)))))
            (register-procedure-serialization! serializer unserializer))))
   :expected procedure?)

(define-test get-procedure-serialization
   (multiple-value-bind (serializer unserializer)
      (get-procedure-serialization)
      (and (procedure? serializer) (procedure? unserializer))))

(define-test register-class-serialization!
   (begin
      (register-class-serialization! SPoint
         (lambda (o::SPoint)
            (vector (-> o x) (-> o y)))
         (lambda (o v)
            (instantiate::SPoint
               (x (vector-ref o 0))
               (y (vector-ref o 1)))))
      (isa? (string->obj
               (obj->string
                  (instantiate::SPoint (x 1) (y 2))))
         SPoint)))

(define-test register-class-serialization!
   (begin
      (register-class-serialization! SPoint
         (lambda (o::SPoint)
            (vector (-> o x) (-> o y)))
         (lambda (o v)
            (instantiate::SPoint
               (x (vector-ref o 0))
               (y (vector-ref o 1)))))
      (isa? (string->obj
               (obj->string
                  (instantiate::SPoint3D (x 1) (y 2) (z 20))))
         SPoint)))

(define-test register-class-serialization!
   (begin
      (register-class-serialization! SPoint3D
         (lambda (o::SPoint3D)
            (vector (-> o x) (-> o y) (-> o z)))
         (lambda (o v)
            (instantiate::SPoint3D
               (x (+ v (vector-ref o 0)))
               (y (+ v (vector-ref o 1)))
               (z (+ v (vector-ref o 2))))))
      (let ((o::SPoint3D (string->obj
                            (obj->string
                               (instantiate::SPoint3D (x 1) (y 2) (z 3)))
                            #unspecified 100)))
         (-> o x)))
   :expected 101)

(define-test get-class-serialization
   (multiple-value-bind (serializer unserializer)
      (get-class-serialization SPoint)
      (and (procedure? serializer) (procedure? unserializer))))

;*---------------------------------------------------------------------*/
;*    io                                                               */
;*---------------------------------------------------------------------*/
(define-test output-obj
   (let* ((f (make-file-name (os-tmp)
               (format "bigloo-test-~a" (current-microseconds))))
          (o (open-output-binary-file f)))
      (unwind-protect
         (begin
            (output-obj o (list f f))
            #t)
         (begin
            (close-binary-port o)
            (delete-file f)))))

(define-test input-obj
   (let* ((f (make-file-name (os-tmp)
               (format "bigloo-test-~a" (current-microseconds))))
          (val (list f 1 '#(3.4) 'foo bar:))
          (out (open-output-binary-file f)))
      (unwind-protect
         (output-obj out val)
         (close-binary-port out))
      (let ((in (open-input-binary-file f)))
         (unwind-protect
            (equal? val (input-obj in))
            (begin
               (close-binary-port in)
               (delete-file f))))))




