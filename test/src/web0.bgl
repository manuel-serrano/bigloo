;*---------------------------------------------------------------------*/
;*    web0                                                             */
;*---------------------------------------------------------------------*/
(module web0
   (cond-expand ((library web) (library web)))
   (export test))

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "./test.bgh")

;*---------------------------------------------------------------------*/
;*    test ...                                                         */
;*---------------------------------------------------------------------*/
(define (test verbose tests::pair-nil)
   (when (or (null? tests) (member "web" tests))
      (test-all verbose "web")))

;*---------------------------------------------------------------------*/
;*    tests ...                                                        */
;*---------------------------------------------------------------------*/
(define-test read-json
   (call-with-input-string "[{\"a\": 1, \"b\": [1, 2]}, false, null]"
      read-json)
   :cond-expand (library web)
   :expected '#((("a" . 1) ("b" . #(1 2))) #f ()))

(define-test obj->json
   (call-with-output-string
      (lambda (op)
         (obj->json '#((("a" . 1) ("b" . #(1 2))) #f ()) op
            (lambda (obj op proc) #f))))
   :cond-expand (library web)
   :expected "[{\"a\":1,\"b\":[1,2]},false,null]")

(define-test json-stringify
   (json-stringify '#((("a" . 1) ("b" . #(1 2))) #f ()))
   :cond-expand (library web)
   :expected "[{\"a\":1,\"b\":[1,2]},false,null]"
