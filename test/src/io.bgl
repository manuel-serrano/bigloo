;*---------------------------------------------------------------------*/
;*    i/o                                                              */
;*---------------------------------------------------------------------*/
(module i/o
   (export test))

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "./test.bgh")

;*---------------------------------------------------------------------*/
;*    test ...                                                         */
;*---------------------------------------------------------------------*/
(define (test verbose tests::pair-nil)
   (when (or (null? tests) (member "i/o" tests))
      (test-all verbose "i/o")))

;*---------------------------------------------------------------------*/
;*    tests ...                                                        */
;*---------------------------------------------------------------------*/
(define-test read (call-with-input-string "(foo \"bar\" 1)" read)
   :expected '(foo "bar" 1))
   
