;*---------------------------------------------------------------------*/
;*    unicodes                                                          */
;*---------------------------------------------------------------------*/
(module unicodes
   (export test))

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "./test.bgh")

;*---------------------------------------------------------------------*/
;*    test ...                                                         */
;*---------------------------------------------------------------------*/
(define (test verbose tests::pair-nil)
   (when (or (null? tests) (member "unicode" tests))
      (test-all verbose "unicode")))

;*---------------------------------------------------------------------*/
;*    tests                                                            */
;*---------------------------------------------------------------------*/
(define-test utf8-string? (utf8-string? "abc012!~")
   :expected #t)

(define-test utf8-string? (utf8-string? "abc012!\xf0")
   :expected #f)

(define-test ascii-string? (utf8-string? "abc012!~")
   :expected #t)

(define-test ascii-string? (utf8-string? "abc012!\xf0")
   :expected #f)

