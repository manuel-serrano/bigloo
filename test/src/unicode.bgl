;*---------------------------------------------------------------------*/
;*    unicodes                                                         */
;*---------------------------------------------------------------------*/
(module unicodes
   (export test))

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "./test.bgh")

;*---------------------------------------------------------------------*/
;*    test ...                                                         */
;*---------------------------------------------------------------------*/
(define (test verbose tests::pair-nil)
   (when (or (null? tests) (member "unicode" tests))
      (test-all verbose "unicode")))

;*---------------------------------------------------------------------*/
;*    utf8                                                             */
;*---------------------------------------------------------------------*/
(define-test string-minimal-charset (string-minimal-charset "foobar")
   :result 'ascii)

(define-test utf8-string-minimal-charset (string-minimal-charset "foobar")
   :result 'ascii)

(define-test utf8-string-minimal-charset (string-minimal-charset "\xc3\xa9t\xc3\xa9")
   :result 'latin1)

(define-test ascii-string? (utf8-string? "abc012!~")
   :result #t)

(define-test ascii-string? (utf8-string? "abc012!\xf0")
   :result #f)

(define-test utf8-string? (utf8-string? "abc012!~")
   :result #t)

(define-test utf8-string? (utf8-string? "abc012!\xf0")
   :result #f)

(define-test utf8-string? (utf8-string? "\xc3\xa9t\xc3\xa9")
   :result #t)

(define-test utf8-char-size (utf8-char-size #\A)
   :result 1)

(define-test utf8-char-size (utf8-char-size #\x81)
   :result 2)

(define-test utf8-char-size (utf8-char-size #\xfe)
   :result 4)

(define-test utf8-string-length (utf8-string-length "ete")
   :result 3)

(define-test utf8-string-length (utf8-string-length "\xc3\xa9t\xc3\xa9")
   :result 3)

(define-test utf8-string-encode (utf8-string-encode "\xc3\xa9t\xc3\xa9")
   :result "\xc3\xa9t\xc3\xa9")

(define-test utf8-string-ref (utf8-string-ref "\xc3\xa9t\xc3\xa9" 1)
   :result "t")

(define-test utf8-string-ref (utf8-string-ref "\xc3\xa9t\xc3\xa9" 2)
   :result "\xc3\xa9")

(define-test utf8-substring (utf8-substring "\xc3\xa9t\xc3\xa9" 1 3)
   :result "t\xc3\xa9")

(define-test utf8-string-append (utf8-string-append "\xc3\xa9" "t\xc3\xa9")
   :result "\xc3\xa9t\xc3\xa9")

(define-test utf8-string-append* (utf8-string-append* "\xc3\xa9" "t" "\xc3\xa9")
   :result "\xc3\xa9t\xc3\xa9")

(define-test utf8-string-append-fill!
   (let ((buf (make-string 10 #\-)))
      (utf8-string-append-fill! buf 1 "\xc3\xa9t\xc3\xa9")
      (utf8-substring buf 0 4))
   :result "-\xc3\xa9t\xc3\xa9")

(define-test utf8-string-append-fill!
   (let ((buf (make-string 10 #\-)))
      (utf8-string-append-fill! buf 1 "\xc3\xa9t\xc3\xa9"
         (utf8-string-index->string-index "\xc3\xa9t\xc3\xa9" 1))
      (utf8-substring buf 0 4))
   :result "-t\xc3\xa9-")

(define-test utf8-string-index->string-index
   (utf8-string-index->string-index "\xc3\xa9t\xc3\xa9" 2)
   :result 3)

(define-test utf8->iso-latin
   (utf8->iso-latin "\xc3\xa9t\xc3\xa9")
   :result "\xe9t\xe9")
   
(define-test utf8->iso-latin!
   (utf8->iso-latin! "\xc3\xa9t\xc3\xa9")
   :result "\xe9t\xe9")
   
(define-test utf8->iso-latin!
   (let* ((s "ete")
          (c (utf8->iso-latin! s)))
      (eq? s c))
   :result #t)
   
(define-test utf8->iso-latin-15
   (utf8->iso-latin-15 "\xc3\xa9t\xc3\xa9")
   :result "\xe9t\xe9")
   
(define-test utf8->iso-latin-15!
   (utf8->iso-latin-15! "\xc3\xa9t\xc3\xa9")
   :result "\xe9t\xe9")
   
(define-test utf8->iso-latin-15!
   (let* ((s "ete")
          (c (utf8->iso-latin-15! s)))
      (eq? s c))
   :result #t)
   
(define-test utf8->cp1252
   (utf8->cp1252 "\xc3\xa9t\xc3\xa9")
   :result "\xe9t\xe9")
   
(define-test utf8->cp1252!
   (utf8->cp1252!  "\xc3\xa9t\xc3\xa9")
   :result "\xe9t\xe9")
   
(define-test iso-latin->utf8
   (iso-latin->utf8 "\xe9t\xe9")
   :result "\xc3\xa9t\xc3\xa9")
   
(define-test iso-latin->utf8!
   (iso-latin->utf8! "\xe9t\xe9")
   :result "\xc3\xa9t\xc3\xa9")
   
(define-test iso-latin-15->utf8
   (iso-latin-15->utf8 "\xe9t\xe9")
   :result "\xc3\xa9t\xc3\xa9")
   
(define-test iso-latin-15->utf8!
   (iso-latin-15->utf8! "\xe9t\xe9")
   :result "\xc3\xa9t\xc3\xa9")

(define-test cp1252->utf8
   (cp1252->utf8 "\xe9t\xe9")
   :result "\xc3\xa9t\xc3\xa9")
   
(define-test cp1252->utf8!
   (cp1252->utf8! "\xe9t\xe9")
   :result "\xc3\xa9t\xc3\xa9")
   

;*---------------------------------------------------------------------*/
;*    ucs2                                                             */
;*---------------------------------------------------------------------*/
(define-test ucs2? (ucs2? (char->ucs2 #\a))
   :result #t)
(define-test ucs2? (ucs2? 10)
   :result #f)
(define-test ucs2? (ucs2? #u0101)
   :result #t)

(define-test ucs2=? (ucs2=? (char->ucs2 #\a) (ucs2-downcase (char->ucs2 #\A)))
   :result #t)
(define-test ucs2=? (ucs2=? (char->ucs2 #\a) (char->ucs2 #\b))
   :result #f)

(define-test ucs2<? (ucs2<? (char->ucs2 #\a) (char->ucs2 #\b))
   :result #t)
(define-test ucs2<? (ucs2<? (char->ucs2 #\b) (char->ucs2 #\a))
   :result #f)

(define-test ucs2<=? (ucs2<=? (char->ucs2 #\a) (char->ucs2 #\b))
   :result #t)
(define-test ucs2<=? (ucs2<=? (char->ucs2 #\b) (char->ucs2 #\b))
   :result #t)
(define-test ucs2<=? (ucs2<=? (char->ucs2 #\c) (char->ucs2 #\a))
   :result #f)

(define-test ucs2>? (ucs2>? (char->ucs2 #\a) (char->ucs2 #\b))
   :result #f)
(define-test ucs2>? (ucs2>? (char->ucs2 #\b) (char->ucs2 #\a))
   :result #t)
(define-test ucs2>=? (ucs2>=? (char->ucs2 #\a) (char->ucs2 #\b))
   :result #f)
(define-test ucs2>=? (ucs2>=? (char->ucs2 #\b) (char->ucs2 #\b))
   :result #t)
(define-test ucs2>=? (ucs2>=? (char->ucs2 #\c) (char->ucs2 #\a))
   :result #t)

(define-test ucs2-ci=? (ucs2-ci=? (char->ucs2 #\a) (char->ucs2 #\A))
   :result #t)
(define-test ucs2-ci=? (ucs2-ci=? (char->ucs2 #\a) (char->ucs2 #\b))
   :result #f)

(define-test ucs2-ci<? (ucs2-ci<? (char->ucs2 #\a) (char->ucs2 #\B))
   :result #t)
(define-test ucs2-ci<? (ucs2-ci<? (char->ucs2 #\b) (char->ucs2 #\a))
   :result #f)

(define-test ucs2-ci<=? (ucs2-ci<=? (char->ucs2 #\a) (char->ucs2 #\B))
   :result #t)
(define-test ucs2-ci<=? (ucs2-ci<=? (char->ucs2 #\B) (char->ucs2 #\B))
   :result #t)
(define-test ucs2-ci<=? (ucs2-ci<=? (char->ucs2 #\C) (char->ucs2 #\a))
   :result #f)

(define-test ucs2-ci>? (ucs2-ci>? (char->ucs2 #\a) (char->ucs2 #\b))
   :result #f)
(define-test ucs2-ci>? (ucs2-ci>? (char->ucs2 #\B) (char->ucs2 #\a))
   :result #t)

(define-test ucs2-ci>=? (ucs2-ci>=? (char->ucs2 #\a) (char->ucs2 #\B))
   :result #f)
(define-test ucs2-ci>=? (ucs2-ci>=? (char->ucs2 #\b) (char->ucs2 #\b))
   :result #t)
(define-test ucs2-ci>=? (ucs2-ci>=? (char->ucs2 #\c) (char->ucs2 #\a))
   :result #t)

(define-test ucs2-alphabetic? (ucs2-alphabetic? (char->ucs2 #\a))
   :result #t)
(define-test ucs2-alphabetic? (ucs2-alphabetic? (char->ucs2 #\0))
   :result #f)
(define-test ucs2-numeric? (ucs2-numeric? (char->ucs2 #\a))
   :result #f)
(define-test ucs2-numeric? (ucs2-numeric? (char->ucs2 #\0))
   :result #t)

(define-test ucs2-whitespace? (ucs2-whitespace? (char->ucs2 #\a))
   :result #f)
(define-test ucs2-whitespace? (ucs2-whitespace? (char->ucs2 #\space))
   :result #t)

(define-test ucs2-upper-case? (ucs2-upper-case? (char->ucs2 #\a))
   :result #f)
(define-test ucs2-upper-case? (ucs2-upper-case? (char->ucs2 #\A))
   :result #t)

(define-test ucs2-lower-case? (ucs2-lower-case? (char->ucs2 #\a))
   :result #t)
(define-test ucs2-lower-case? (ucs2-lower-case? (char->ucs2 #\A))
   :result #f)

(define-test ucs2<->integer (ucs2->integer (integer->ucs2 65))
   :result 65)
(define-test ucs2<->char (ucs2->char (char->ucs2 #\a))
   :result #\a)
(define-test ucs2<->char (ucs2->char (char->ucs2 #\b))
   :result #\b)

(define-test ucs2-downcase (char->ucs2 #\a)
   :result (ucs2-downcase (char->ucs2 #\A)))
(define-test ucs2-upcase (char->ucs2 #\A)
   :result (ucs2-upcase (char->ucs2 #\a)))
(define-test write
   (let ((p (open-output-string)))
      (write #u0101 p)
      (close-output-port p))
   :result "#u0101")

;; unicode strings
(define-test make-ucs2-string (ucs2-string? (make-ucs2-string 10))
   :result #t)

(define-test ucs2-string? (ucs2-string? #u"toto")
   :result #t)
(define-test ucs2-string? (ucs2-string? "toto")
   :result #f)

(define-test ucs2-string-ref
   (ucs2-string-ref (make-ucs2-string 10 #u0101) 3)
   :result #u0101)
(define-test ucs2-string-set!
   (let ((str (make-ucs2-string 10 #u0101)))
      (ucs2-string-set! str 3 #u0102)
      (ucs2-string-ref str 3))
   :result #u0102)

(define-test ucs2-string-length
   (ucs2-string-length (make-ucs2-string 10))
   :result 10)

(define-test ucs2-string=?
   (ucs2-string=? (let ((s (make-ucs2-string 10 #u0101)))
                     (ucs2-string-set! s 2 (char->ucs2 #\a))
                     (ucs2-string-set! s 3 #u0102)
                     (ucs2-string-set! s 4 #u0103)
                     s)
      (let ((s (make-ucs2-string 10 #u0101)))
         (ucs2-string-set! s 2 (char->ucs2 #\a))
         (ucs2-string-set! s 3 #u0102)
         (ucs2-string-set! s 4 #u0103)
         s))
   :result #t)
(define-test ucs2-string=?
   (ucs2-string=? (let ((s (make-ucs2-string 10 #u0101)))
                     (ucs2-string-set! s 2 (char->ucs2 #\a))
                     
                     (ucs2-string-set! s 3 #u0102)
                     (ucs2-string-set! s 4 #u0104)
                     s)
      (let ((s (make-ucs2-string 10 #u0101)))
         (ucs2-string-set! s 2 (char->ucs2 #\a))
         (ucs2-string-set! s 3 #u0102)
         (ucs2-string-set! s 4 #u0103)
         s))
   :result #f)

(define-test ucs2-string-ci=?
   (ucs2-string-ci=? (let ((s (make-ucs2-string 10 #u0101)))
                        (ucs2-string-set! s 2 (char->ucs2 #\a))
                        (ucs2-string-set! s 3 (char->ucs2 #\a))
                        s)
      (let ((s (make-ucs2-string 10 #u0101)))
         (ucs2-string-set! s 2 (char->ucs2 #\a))
         (ucs2-string-set! s 3 (char->ucs2 #\A))
         s))
   :result #t)
(define-test ucs2-string-ci=?
   (ucs2-string-ci=? (let ((s (make-ucs2-string 10 #u0101)))
                        (ucs2-string-set! s 2 (char->ucs2 #\a))
                        (ucs2-string-set! s 3 (char->ucs2 #\b))
                        s)
      (let ((s (make-ucs2-string 10 #u0101)))
         (ucs2-string-set! s 2 (char->ucs2 #\A))
         (ucs2-string-set! s 3 (char->ucs2 #\A))
         s))
   :result #f)

(define-test ucs2-string<?
   (ucs2-string<? (let ((s (make-ucs2-string 10 #u0101)))
                     (ucs2-string-set! s 2 (char->ucs2 #\a))
                     (ucs2-string-set! s 3 #u0102)
                     (ucs2-string-set! s 4 #u0104)
                     s)
      (let ((s (make-ucs2-string 10 #u0101)))
         (ucs2-string-set! s 2 (char->ucs2 #\b))
         (ucs2-string-set! s 3 #u0102)
         (ucs2-string-set! s 4 #u0104)
         s)) :result #t)
(define-test ucs2-string<?
   (ucs2-string<? (let ((s (make-ucs2-string 10 #u0101)))
                     (ucs2-string-set! s 2 (char->ucs2 #\a))
                     (ucs2-string-set! s 3 #u0102)
                     (ucs2-string-set! s 4 #u0104)
                     s)
      (let ((s (make-ucs2-string 10 #u0101)))
