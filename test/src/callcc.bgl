;*---------------------------------------------------------------------*/
;*    callcc                                                           */
;*---------------------------------------------------------------------*/
(module callcc
   (export test))

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "./test.bgh")

;*---------------------------------------------------------------------*/
;*    test ...                                                         */
;*---------------------------------------------------------------------*/
(define (test verbose tests::pair-nil)
   (when (or (null? tests) (member "callcc" tests))
      (test-all verbose "callcc")))

;*---------------------------------------------------------------------*/
;*    tests                                                            */
;*---------------------------------------------------------------------*/
(define-test uncallcc-protect
   (let ((x 3))
      (call/cc (lambda (exit)
		  (unwind-protect
		     (begin
			(set! x (+ 1 x))
			(exit (begin (set! x (+ 1 x)) x))
			(set! x (+ 10 x)))
		     (set! x (+ 1 x)))))
      x)
   :cond-expand call/cc
   :expected 6)
