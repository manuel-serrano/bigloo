;*    Testing the C extern interface                                   */
;*=====================================================================*/

;*---------------------------------------------------------------------*/
;*    extern_c                                                         */
;*---------------------------------------------------------------------*/
(module extern_c
   
   (extern "C"
      (include "extern_c.h")
      (import "c.h")

      ;; macros and functions
      (macro PLUS::long ::long ::long)
      (cnst macro CNST::long)
      (infix macro PLUS_OP::long ::long ::long)
      (cnst macro $0L::void* "0L")
      (macro strtod::double ::string ::void*)

      ;; types
      (type any "void *")
      (macro $any->obj::obj ::any "(obj_t)")
      (macro $obj->any::any ::obj "(void *)")

      ;; variables
      count::long)
      
   (export test))

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "./test.bgh")

;*---------------------------------------------------------------------*/
;*    test ...                                                         */
;*---------------------------------------------------------------------*/
(define (test verbose tests::pair-nil)
   (when (or (null? tests) (member "extern_c" tests))
      (test-all verbose "extern_c")))

;*---------------------------------------------------------------------*/
;*    tests                                                            */
;*---------------------------------------------------------------------*/
(define-test binary-macro (PLUS 1 3) :expected 4)   
(define-test cnst-macro CNST :expected 1234)
(define-test infix-macro (PLUS_OP 142 328) :expected 470)

(define-test function (strtod "3.14" $0L) :eq ~equal? :expected 3.14)

(define-test type ($any->obj ($obj->any (cons 1 2))) :expected '(1 . 2))

(define-test variable count :expected 10)
(define-test variable (begin (set! count 20) count) :expected 20)

(define-test cigloo ($inc $init) :expected 0)

(define-test bigloo-mangle
   (bigloo-mangle "fib")
   :expected "BgL_fibz00")

(define-test bigloo-mangle
   (bigloo-mangle "string->number")
   :expected "BgL_stringzd2ze3numberz31")

(define-test bigloo-module-mangle
   (bigloo-module-mangle "fib" "mod")
   :expected "BGl_fibz00zzmodz00")

(define-test bigloo-module-mangle
   (bigloo-module-mangle "string->number" "lib")
   :expected "BGl_stringzd2ze3numberz31zzlibz00")

(define-test bigloo-mangled?
   (bigloo-mangled? "BgL_fibz00"))

(define-test bigloo-mangled?
   (bigloo-mangled? "BGl_fibz00zzmodz00"))

(define-test bigloo-mangled?
   (bigloo-mangled? "BGl_fibz00zzmodz")
   :expected #f)

(define-test bigloo-demangle
   (bigloo-demangle "BgL_fibz00")
   :expected "fib")
   
(define-test bigloo-demangle
   (multiple-value-bind (id mod)
      (bigloo-demangle "BGl_stringzd2ze3numberz31zzlibz00")
      (cons id mod))
   :expected '("string->number" . "lib"))

(define-test bigloo-need-mangling?
   (bigloo-need-mangling? "fib")
   :expected #f)

(define-test bigloo-need-mangling?
   (bigloo-need-mangling? "integer?")
   :expected #t)

(define-test bigloo-class-mangled?
   (bigloo-class-mangled? (bigloo-mangle "Point"))
   :expected #f)

(define-test bigloo-class-mangled?
   (bigloo-class-mangled? (string-append (bigloo-mangle "Point") "_bglt")))

(define-test bigloo-class-demangle
   (bigloo-class-demangle (string-append (bigloo-mangle "Point") "_bglt"))
   :expected "Point_bglt")

(define-test pragma
   (pragma::long "$1 + 10" 14)
   :expected 24)

(define-test pragma
   (pragma::bint "BINT($1 + 10)" 14)
   :expected 24)

(define-test free-pragma
   (free-pragma::bint "BINT($1 + 10)" 14)
   :expected 24)

(define-test pragma-id
   (let ((x/y::obj 3))
      (pragma "$1 = BINT(24)" (pragma x/y))
      x/y)
   :expected 24)

