;*---------------------------------------------------------------------*/
;*    match                                                            */
;*---------------------------------------------------------------------*/
(module match
   (export test))

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "./test.bgh")

;*---------------------------------------------------------------------*/
;*    test ...                                                         */
;*---------------------------------------------------------------------*/
(define (test verbose tests::pair-nil)
   (when (or (null? tests) (member "match" tests))
      (test-all verbose "match")))

;*---------------------------------------------------------------------*/
;*    match-test ...                                                   */
;*---------------------------------------------------------------------*/
(define (match-test)
   (let ((l '(let ((x 6))
              (+ x 5))))
      (match-case l
	 ((let ?bindings . ?body) 'ok)
	 (else 4))))

;*---------------------------------------------------------------------*/
;*    match-test-2 ...                                                 */
;*---------------------------------------------------------------------*/
(define (match-test-2 x)
   (match-case x
      ;; 1- on definit une lambda typee
      ((?- ((?type ?name) . ?args) . ?body)
       'do-define-lambda)
      ;; 1- on definit une lambda non typee
      ((or (?- (?name . ?args) . ?body)
	   (?- ?name (lambda ?args . ?body)))
       'do-define-lambda)
      ;; 2- on definit une valeur non typee
      ((?- ?name . (?value . ()))
       'do-define-value)
      ;; 2b- on definit une valeur typee
      (else
       'else)))

;*---------------------------------------------------------------------*/
;*    match-test-3 ...                                                 */
;*---------------------------------------------------------------------*/
(define (match-test-3 x)
   (match-case x
      ((foo bar)
       x))
   #t)

;*---------------------------------------------------------------------*/
;*    match-test-4 ...                                                 */
;*---------------------------------------------------------------------*/
(define (match-test-4 x)
   (match-case x
      (((and ?let-part (let ?- ?body)) . ?args)
       'let)
      (((and ?x (labels ?- ?body)) . ?args)
       'app)
      (else
       'else)))

;*---------------------------------------------------------------------*/
;*    match-test-5 ...                                                 */
;*---------------------------------------------------------------------*/
(define (match-test-5 x)
   (match-case x
      ((atom ?-)
       'atom)
      (else
       'else)))

;*---------------------------------------------------------------------*/
;*    Une structure pour tester atom                                   */
;*---------------------------------------------------------------------*/
(define-struct s x) 

;*---------------------------------------------------------------------*/
;*    Structures                                                       */
;*---------------------------------------------------------------------*/
(define-struct int-point x y)
(define-struct real-point x y)

(define (is-in-circle? r p)
   (match-case p
      (#{int-point ?x ?y}
       (<=fx (+fx (*fx x x) (*fx y y)) (*fx r r)))
      (#{real-point ?x ?y}
       (<= (+fl (*fl x x) (*fl y y)) (* r r)))
      (else
       (error "is-in-circle?" "argument not a point" p))))

(define p-int (make-int-point))

(int-point-x-set! p-int 4)
(int-point-y-set! p-int -4)

(define p-real (make-real-point))

(real-point-x-set! p-real 4.4)
(real-point-y-set! p-real -4.4)

(define (uncompilable exp)
   exp)

;*---------------------------------------------------------------------*/
;*    match-eq ...                                                     */
;*---------------------------------------------------------------------*/
(define (match-eq l)
   (match-case l
      ((toto "toto") 'toto)
      ((toto toto) 'toto-bis)
      ((toto 4) 4)
      ((toto 3.3) 33)
      (else 'else)))

;*---------------------------------------------------------------------*/
;*    match-non-linear ...                                             */
;*---------------------------------------------------------------------*/
(define (match-non-linear exp)
   (match-case exp
      (((and ?x (? integer?)) (and ?x (? integer?))) 1)
      (((* ?x) (* ?x)) 2)
      (else 3)))

;*---------------------------------------------------------------------*/
;*    match-not ...                                                    */
;*---------------------------------------------------------------------*/
(define (match-not exp)
   (match-case exp
      (((and ?expr (? symbol?)))
       1)
      (((and ?expr (? list?) (not ())))
       2)
      ((not foo)
       3)
      (else
       4)))

;*---------------------------------------------------------------------*/
;*    match-string ...                                                 */
;*---------------------------------------------------------------------*/
(define (match-string x)
   (match-case x
      (("a" b) 1)
      (("a" c) 2)
      (else 3)))

;*---------------------------------------------------------------------*/
;*    test-match ...                                                   */
;*---------------------------------------------------------------------*/
(define-test match-case
   (let ((l '(foo bar 3 ("gee") bar)))
      (match-case l
         ((?x ?x) 'foo)
         ((?x ?y (and ?n (? number?)) ?- ?y) (cons x n))
         (else #f)))
   :result (cons 'foo 3))

(define-test match-lambda
   ((match-lambda
       ((?head ??-) head)
       (else #f))
    (list 'head 'middle 'tail))
   :result 'head)

(define-test match-lambda
   ((match-lambda
       ((?x ?x) 'foo)
       ((?x ?- ?x) 'bar))
    '(a b a))
   :result 'bar)

(define-test let (match-test)
   :result 'ok)
(define-test expand-define (match-test-2 '(define (foo x) x))
   :result 'do-define-lambda)
(define-test expand-define (match-test-2 '(define foo (lambda (x) x)))
   :result 'do-define-lambda)
(define-test expand-define (match-test-2 '(define foo 3))
   :result 'do-define-value)
(define-test expand-define (match-test-2 '(define foo))
   :result 'else)
(define-test expand (match-test-3 8)
   :result #t)
(define-test match-test-4 (match-test-4 '((labels ((gee (x) x)) gee) 1))
   :result 'app)

(define-test atom (match-test-5 '(1 2 3))
   :result 'else)
(define-test atom (match-test-5 '#(1 2 3))
   :result 'atom)
(define-test atom (match-test-5 (make-s))
   :result 'atom)

(define-test structure (is-in-circle? 10 p-int)
   :result #t)
(define-test structure (is-in-circle? 10 p-real)
   :result #t)
(define-test structure (begin (match-lambda (#{int-point} 'toto)) #t)
   :result #t)

(define-test match-eq (match-eq (list 'toto "toto"))
   :result 'toto)
(define-test match-eq (match-eq (list 'toto "tutu"))
   :result 'else)
(define-test match-eq (match-eq (list 'toto 'toto))
   :result 'toto-bis)
(define-test match-eq (match-eq (list 'toto 'tata))
   :result 'else)
(define-test match-eq (match-eq (list 'toto 4))
   :result 4)
(define-test match-eq (match-eq (list 'toto 3))
   :result 'else)
(define-test match-eq (match-eq (list 'toto 3.3))
   :result 33)
(define-test match-eq (match-eq (list 'toto 3.2))
   :result 'else)

(define-test match-non-linear (match-non-linear '((* a) (* b)))
   :result 3)
(define-test match-non-linear (match-non-linear '((* a) (* a)))
   :result 2)
(define-test match-non-linear (match-non-linear '(1 2))
   :result 3)
(define-test match-non-linear (match-non-linear '(1 1))
   :result 1)

(define-test match-not (match-not '(foo))
   :result 1)
(define-test match-not (match-not '((foo)))
   :result 2)
(define-test match-not (match-not '(()))
   :result 3)
(define-test match-not (match-not 'foo)
   :result 4)

(define-test match-string (match-string '("a" b))
   :result 1)
(define-test match-string (match-string '("a" c))
   :result 2)
(define-test match-string (match-string '("a" d))
   :result 3)
(define-test match-string (match-string '("a"))
   :result 3)
(define-test match-string (match-string '("a" c c))
   :result 3)

(define-test repetiion
   (pair? (expand '(match-case x ((??- . ?x) 1)))))
 
;*---------------------------------------------------------------------*/
;*    Class pattern matching tests (isa)                               */
;*---------------------------------------------------------------------*/
(define-class mpoint
   (x (default 0))
   (y (default 0)))

(define-class mpoint3d::mpoint
   (z (default 0)))

(define-class msegment
   (start (default #unspecified))
   (end (default #unspecified)))

(define-class mrect
   (width (default 0))
   (height (default 0)))

(define mp1 (instantiate::mpoint (x 3) (y 4)))
(define mp3 (instantiate::mpoint3d (x 1) (y 2) (z 3)))

(define (isa-basic p)
   (match-case p
      ((isa mpoint (x ?x) (y ?y)) (list x y))
      (else 'fail)))

(define (isa-partial p)
   (match-case p
      ((isa mpoint (x ?x)) x)
      (else 'fail)))

(define (isa-type-only p)
   (match-case p
      ((isa mpoint) 'yes)
      (else 'no)))

(define (isa-literal p)
   (match-case p
      ((isa mpoint (x 3) (y ?y)) y)
      (else 'fail)))

(define (isa-subclass p)
   (match-case p
      ((isa mpoint (x ?x) (y ?y)) (list x y))
      (else 'fail)))

(define (isa-or p)
   (match-case p
      ((or (isa mpoint3d (z ?v)) (isa mpoint (x ?v))) v)
      (else 'fail)))

(define (isa-and p)
   (match-case p
      ((and ?whole (isa mpoint (x ?x))) (list whole x))
      (else 'fail)))

(define (isa-nested seg)
   (match-case seg
      ((isa msegment (start (isa mpoint (x ?x1) (y ?y1)))
                     (end (isa mpoint (x ?x2) (y ?y2))))
       (list x1 y1 x2 y2))
      (else 'fail)))

(define (isa-repeated r)
   (match-case r
      ((isa mrect (width ?s) (height ?s)) s)
      (else 'fail)))

(define (isa-not p)
   (match-case p
      ((not (isa mpoint)) 'not-point)
      (else 'is-point)))

(define-test segment.1 (match-case '(a b c)
                     ((??x) x)
                     (else 'fail)) :result
   '(a b c))
(define-test segment.2 (match-case '(a b c d)
                     ((a ??x d) x)
                     (else 'fail)) :result
   '(b c))
(define-test segment.3 (match-case '(a b c b c)
                     ((a ??x ??x) x)
                     (else 'fail)) :result
   '(b c))
(define-test segment.4 (match-case '(a b c d)
                     ((a ??x c d) x)
                     (else 'fail)) :result
   '(b))
(define-test segment.5 (match-case '(a b)
                     ((a ??x b ??x) x)
                     (else 'fail)) :result
   '())

(define-test isa-basic (isa-basic mp1) :result '(3 4))
(define-test isa-partial (isa-partial mp1) :result 3)
(define-test isa-type-only (isa-type-only mp1) :result 'yes)
(define-test isa-type-only.2 (isa-type-only 42) :result 'no)
(define-test isa-literal.1 (isa-literal mp1) :result 4)
(define-test isa-literal.2 (isa-literal (instantiate::mpoint (x 0) (y 9))) :result 'fail)
(define-test isa-subclass (isa-subclass mp3) :result '(1 2))
(define-test isa-or.1 (isa-or mp3) :result 3)
(define-test isa-or.2 (isa-or (instantiate::mpoint (x 99) (y 0))) :result 99)
(define-test isa-and (isa-and mp1) :result (list mp1 3))
(define-test isa-nested
   (isa-nested (instantiate::msegment
                  (start (instantiate::mpoint (x 10) (y 20)))
                  (end (instantiate::mpoint (x 30) (y 40))))) :result
   '(10 20 30 40))
(define-test isa-repeated.1 (isa-repeated (instantiate::mrect (width 5) (height 5))) :result 5)
(define-test isa-repeated.2 (isa-repeated (instantiate::mrect (width 3) (height 7))) :result 'fail)
(define-test isa-not.1 (isa-not mp1) :result 'is-point)
(define-test isa-not.2 (isa-not 42) :result 'not-point)
 
