;*    Creation    :  Mon Apr 13 12:18:58 2026                          */
;*    Last change :  Sun May 31 11:18:39 2026 (serrano)                */
;*    Copyright   :  2026 manuel serrano                               */
;*    -------------------------------------------------------------    */
;*    Testing bit functions                                            */
;*=====================================================================*/

;*---------------------------------------------------------------------*/
;*    bits                                                             */
;*---------------------------------------------------------------------*/
(module bits
   (export test))

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "./test.bgh")

;*---------------------------------------------------------------------*/
;*    test ...                                                         */
;*---------------------------------------------------------------------*/
(define (test verbose tests::pair-nil)
   (when (or (null? tests) (member "bit" tests))
      (test-all verbose "bit")))

;*---------------------------------------------------------------------*/
;*    tests                                                            */
;*---------------------------------------------------------------------*/
(define-test bit-or (bit-or 1 2)
   :expected 3)
(define-test bit-ors8 (bit-ors8 #s8:1 #s8:2)
   :expected #s8:3)
(define-test bit-oru8 (bit-oru8 #u8:1 #u8:2)
   :expected #u8:3)
(define-test bit-ors16 (bit-ors16 #s16:1 #s16:2)
   :expected #s16:3)
(define-test bit-oru16 (bit-oru16 #u16:1 #u16:2)
   :expected #u16:3)
(define-test bit-ors32 (bit-ors32 #s32:1 #s32:2)
   :expected #s32:3)
(define-test bit-oru32 (bit-oru32 #u32:1 #u32:2)
   :expected #u32:3)
(define-test bit-ors64 (bit-ors64 #s64:1 #s64:2)
   :expected #s64:3)
(define-test bit-oru64 (bit-oru64 #u64:1 #u64:2)
   :expected #u64:3)
(define-test bit-orelong (bit-orelong #e1 #e2)
   :expected #e3)
(define-test bit-orllong (bit-orllong #l1 #l2)
   :expected #l3)

(define-test bit-xor (bit-xor 1 2)
   :expected 3)
(define-test bit-xorelong (bit-xorelong #e1 #e2)
   :expected #e3)
(define-test bit-xorllong (bit-xorllong #l1 #l2)
   :expected #l3)
(define-test bit-xors8 (bit-xors8 #s8:1 #s8:2)
   :expected #s8:3)
(define-test bit-xoru8 (bit-xoru8 #u8:1 #u8:2)
   :expected #u8:3)
(define-test bit-xors16 (bit-xors16 #s16:1 #s16:2)
   :expected #s16:3)
(define-test bit-xoru16 (bit-xoru16 #u16:1 #u16:2)
   :expected #u16:3)
(define-test bit-xors32 (bit-xors32 #s32:1 #s32:2)
   :expected #s32:3)
(define-test bit-xoru32 (bit-xoru32 #u32:1 #u32:2)
   :expected #u32:3)
(define-test bit-xors64 (bit-xors64 #s64:1 #s64:2)
   :expected #s64:3)
(define-test bit-xoru64 (bit-xoru64 #u64:1 #u64:2)
   :expected #u64:3)

(define-test bit-and (bit-and 1 3)
   :expected 1)
(define-test bit-andelong (bit-andelong #e1 #e3)
   :expected #e1)
(define-test bit-andllong (bit-andllong #l1 #l3)
   :expected #l1)
(define-test bit-ands8 (bit-ands8 #s8:1 #s8:3)
   :expected #s8:1)
(define-test bit-andu8 (bit-andu8 #u8:1 #u8:3)
   :expected #u8:1)
(define-test bit-ands16 (bit-ands16 #s16:1 #s16:3)
   :expected #s16:1)
(define-test bit-andu16 (bit-andu16 #u16:1 #u16:3)
   :expected #u16:1)
(define-test bit-ands32 (bit-ands32 #s32:1 #s32:3)
   :expected #s32:1)
(define-test bit-andu32 (bit-andu32 #u32:1 #u32:3)
   :expected #u32:1)
(define-test bit-ands64 (bit-ands64 #s64:1 #s64:3)
   :expected #s64:1)
(define-test bit-andu64 (bit-andu64 #u64:1 #u64:3)
   :expected #u64:1)

(define-test bit-not (bit-not 1)
   :expected -2)
(define-test bit-notelong (bit-notelong #e1)
   :expected #e-2)
(define-test bit-notllong (bit-notllong #l1)
   :expected #l-2)
(define-test bit-nots8 (bit-nots8 #s8:1)
   :expected #s8:-2)
(define-test bit-notu8 (bit-notu8 #u8:1)
   :expected #u8:254)
(define-test bit-nots16 (bit-nots16 #s16:1)
   :expected #s16:-2)
(define-test bit-notu16 (bit-notu16 #u16:1)
   :expected #u16:65534)
(define-test bit-nots32 (bit-nots32 #s32:1)
   :expected #s32:-2)
(define-test bit-notu32 (bit-notu32 #u32:1)
   :expected #u32:4294967294)
(define-test bit-nots64 (bit-nots64 #s64:1)
   :expected #s64:-2)
(define-test bit-notu64 (bit-notu64 #u64:1)
   :expected (+u64 (*u64 #u64:1844674407370 #u64:10000000) #u64:9551614))

(define-test bit-lsh (bit-lsh 1 7)
   :expected 128)
(define-test bit-lshs8 (bit-lshs8 #s8:1 7)
   :expected #s8:128)
(define-test bit-lshu8 (bit-lshu8 #u8:1 7)
   :expected #u8:128)
(define-test bit-lshs16 (bit-lshs16 #s16:1 7)
   :expected #s16:128)
(define-test bit-lshu16 (bit-lshu16 #u16:1 7)
   :expected #u16:128)
(define-test bit-lshs32 (bit-lshs32 #s32:1 7)
   :expected #s32:128)
(define-test bit-lshu32 (bit-lshu32 #u32:1 7)
   :expected #u32:128)
(define-test bit-lshs64 (bit-lshs64 #s64:1 7)
   :expected #s64:128)
(define-test bit-lshu64 (bit-lshu64 #u64:1 7)
   :expected #u64:128)
(define-test bit-lshelong (bit-lshelong #e1 7)
   :expected #e128)
(define-test bit-lshllong (bit-lshllong #l1 7)
   :expected #l128)

(define-test bit-rsh (bit-rsh 43 3)
   :expected 5)
(define-test bit-rshs8 (bit-rshs8 #s8:43 3)
   :expected #s8:5)
(define-test bit-rshu8 (bit-rshu8 #u8:43 3)
   :expected #u8:5)
(define-test bit-rshs16 (bit-rshs16 #s16:43 3)
   :expected #s16:5)
(define-test bit-rshu16 (bit-rshu16 #u16:43 3)
   :expected #u16:5)
(define-test bit-rshs32 (bit-rshs32 #s32:43 3)
   :expected #s32:5)
(define-test bit-rshu32 (bit-rshu32 #u32:43 3)
   :expected #u32:5)
(define-test bit-rshs64 (bit-rshs64 #s64:43 3)
   :expected #s64:5)
(define-test bit-rshu64 (bit-rshu64 #u64:43 3)
   :expected #u64:5)
(define-test bit-rshelong (bit-rshelong #e43 3)
   :expected #e5)
(define-test bit-rshllong (bit-rsh #l43 3)
   :expected #l5)

(define-test bit-ursh (bit-ursh 200 3)
   :expected 25)
(define-test bit-urshs8 (bit-urshs8 #s8:200 3)
   :expected #s8:-7)
(define-test bit-urshu8 (bit-urshu8 #u8:200 3)
   :expected #u8:25)
(define-test bit-urshs16 (bit-urshs16 #s16:200 3)
   :expected #s16:25)
(define-test bit-urshu16 (bit-urshu16 #u16:200 3)
   :expected #u16:25)
(define-test bit-urshs32 (bit-urshs32 #s32:200 3)
   :expected #s32:25)
(define-test bit-urshu32 (bit-urshu32 #u32:200 3)
   :expected #u32:25)
(define-test bit-urshs64 (bit-urshs64 #s64:200 3)
   :expected #s64:25)
(define-test bit-urshu64 (bit-urshu64 #u64:200 3)
   :expected #u64:25)
(define-test bit-urshelong (bit-urshelong #e200 3)
   :expected #e25)
(define-test bit-urshllong (bit-urshllong #l200 3)
   :expected #l25)
