;*---------------------------------------------------------------------*/
;*    extern_jvm                                                       */
;*---------------------------------------------------------------------*/
;; tag-start doc
(module extern_jvm

   (extern "java"
      
      (abstract-class Intf
         (abstract public abstract_met::int))
      
      (class Point::Intf
         (constructor new)
         (constructor new2 ::int ::int)
         (field x::int)
         (field y::int)
         (field static point_num::int)
         (abstract_met::int)
         (toString::String)
         (static statistics::int))

      (array Point* ::Point)
      
      (export callback))

   (export test))
;; tag-end doc

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "./test.bgh")

;*---------------------------------------------------------------------*/
;*    callback ...                                                     */
;*---------------------------------------------------------------------*/
(define (callback::int x::int)
   (+fx x 1))

;*---------------------------------------------------------------------*/
;*    test ...                                                         */
;*---------------------------------------------------------------------*/
(define (test verbose tests::pair-nil)
   (when (or (null? tests) (member "extern_jvm" tests))
      (test-all verbose "extern_jvm")))

(define-test ctor
   (begin (Point.new) #t))
(define-test ctor
   (begin (Point.new2 1 2) #t))

(define-test predicate
   (Point? (Point.new)))
(define-test predicate
   (Intf? (Point.new)))
(define-test predicate
   (Intf? 3) :expected #f)

;; tag-start doc2
(define-test field
   (let ((o::Point (Point.new2 1 2))) (-> o x)) :expected 1)
(define-test field
   (let ((o::Point (Point.new2 1 2))) (-> o y)) :expected 2)

(define-test method
   (let ((o::Point (Point.new))) (string? ((-> o toString)))))
(define-test abstract-method
   (let ((o::Point (Point.new))) (integer? ((-> o abstract_met)))))
;; tag-end doc2

(define-test static-field
   (> Point.point_num 0))

(define-test static-method
   (> (Point.statistics) 1000))

(define-test array
   (Point*? 3)
   :expected #f)

(define-test array
   (Point*? (make-Point* 0))
   :expected #t)

(define-test array-length
   (let ((a (make-Point* 4)))
      (Point*-length a))
   :expected 4)

(define-test array-accessors
   (let ((a (make-Point* 4)))
      (Point*-set! a 1 (Point.new))
      (Point? (Point*-ref a 1))))
