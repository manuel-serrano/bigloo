;*---------------------------------------------------------------------*/
;*    extern_jvm                                                       */
;*---------------------------------------------------------------------*/
;; tag-start doc
(module extern_jvm

   (extern "java"
      
      (abstract-class Intf
         (abstract public abstract_met::int))
      
      (class Point::Intf
         (constructor new)
         (constructor new2 ::int ::int)
         (field x::int)
         (field y::int)
         (field static point_num::int)
         (abstract_met::int)
         (toString::String)
         (static statistics::int))

      (array Point* ::Point)
      (array float* ::float)
      (array double* ::double)
      
      (export callback))

   (export test))
;; tag-end doc

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "./test.bgh")

;*---------------------------------------------------------------------*/
;*    callback ...                                                     */
;*---------------------------------------------------------------------*/
(define (callback::int x::int)
   (+fx x 1))

;*---------------------------------------------------------------------*/
;*    test ...                                                         */
;*---------------------------------------------------------------------*/
(define (test verbose tests::pair-nil)
   (when (or (null? tests) (member "extern_jvm" tests))
      (test-all verbose "extern_jvm")))

(define-test ctor
   (begin (Point.new) #t))
(define-test ctor
   (begin (Point.new2 1 2) #t))

(define-test predicate
   (Point? (Point.new)))
(define-test predicate
   (Intf? (Point.new)))
(define-test predicate
   (Intf? 3) :result #f)

;; tag-start doc2
(define-test field
   (let ((o::Point (Point.new2 1 2))) (-> o x)) :result 1)
(define-test field
   (let ((o::Point (Point.new2 1 2))) (-> o y)) :result 2)

(define-test method
   (let ((o::Point (Point.new))) (string? ((-> o toString)))))
(define-test abstract-method
   (let ((o::Point (Point.new))) (integer? ((-> o abstract_met)))))
;; tag-end doc2

(define-test static-field
   (> Point.point_num 0))

(define-test static-method
   (> (Point.statistics) 1000))

;; tag-start doc3
(define-test array
   (Point*? 3)
   :result #f)

(define-test array
   (Point*? (Point*.new 0))
   :result #t)

(define-test array-length
   (let ((a (Point*.new 4)))
      (Point*.length a))
   :result 4)

(define-test array-accessors
   (let ((a (Point*.new 4)))
      (Point*.set! a 1 (Point.new))
      (Point? (Point*.ref a 1))))
;; tag-end doc3

(define-test array-float*
   (let ((a (float*.new 4)))
      (float*.set! a 0 4.5)
      (float*.set! a 1 .5)
      (+fl (float*.ref a 0) (float*.ref a 1)))
   :result 5.)

(define-test array-double*
   (let ((a (double*.new 4)))
      (double*.set! a 0 4.5)
      (double*.set! a 1 .5)
      (+fl (double*.ref a 0) (double*.ref a 1)))
   :result 5.)
