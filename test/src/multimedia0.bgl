;*---------------------------------------------------------------------*/
;*    multimedia0                                                      */
;*---------------------------------------------------------------------*/
(module multimedia0
   (cond-expand ((library multimedia) (library multimedia)))
   (export test))

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "./test.bgh")

;*---------------------------------------------------------------------*/
;*    test ...                                                         */
;*---------------------------------------------------------------------*/
(define (test verbose tests::pair-nil)
   (when (or (null? tests) (member "multimedia" tests))
      (test-all verbose "multimedia")))

;*---------------------------------------------------------------------*/
;*    tests ...                                                        */
;*---------------------------------------------------------------------*/
(define-test exif
   exif
   :cond-expand (library multimedia)
   :expected class?)

(define-test jpeg-exif
   (isa? (jpeg-exif "misc/img.jpg") exif)
   :cond-expand (library multimedia))

(define-test jpeg-exif
   (let ((ex::exif (jpeg-exif "misc/img.jpg")))
      (-> ex comment))
   :cond-expand (library multimedia)
   :expected "an exif comment")

(define-test jpeg-exif
   (let ((ex::exif (jpeg-exif "misc/img.jpg")))
      (-> ex width))
   :cond-expand (library multimedia)
   :expected 64)
