;*---------------------------------------------------------------------*/
;*    multimedia0                                                      */
;*---------------------------------------------------------------------*/
(module multimedia0
   (cond-expand ((library multimedia) (library multimedia)))
   (export test))

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "./test.bgh")

;*---------------------------------------------------------------------*/
;*    test ...                                                         */
;*---------------------------------------------------------------------*/
(define (test verbose tests::pair-nil)
   (when (or (null? tests) (member "multimedia" tests))
      (test-all verbose "multimedia")))

;*---------------------------------------------------------------------*/
;*    tests ...                                                        */
;*---------------------------------------------------------------------*/
(define-test exif
   exif
   :cond-expand (library multimedia)
   :expected class?)

(define-test jpeg-exif
   (isa? (jpeg-exif "misc/img.jpg") exif)
   :cond-expand (library multimedia))

(define-test jpeg-exif
   (let ((ex::exif (jpeg-exif "misc/img.jpg")))
      (-> ex comment))
   :cond-expand (library multimedia)
   :expected "an exif comment")

(define-test jpeg-exif
   (let ((ex::exif (jpeg-exif "misc/img.jpg")))
      (-> ex width))
   :cond-expand (library multimedia)
   :expected 64)

(define-test jpeg-parse-dimensions
   (bind-values (width height)
      (call-with-input-file "misc/img.jpg" jpeg-parse-dimensions)
      (cons width height))
   :cond-expand (library multimedia)
   :expected '(64 . 64))

(define-test jpeg-dimensions
   (bind-values (width height)
      (jpeg-dimensions "misc/img.jpg")
      (cons width height))
   :cond-expand (library multimedia)
   :expected '(64 . 64))

(define-test make-hex-color
   (make-hex-color 127 255 10)
   :expected "#7fff0a")

(define-test parse-hex-color
   (call-with-values (lambda () (parse-hex-color "#7fff0a")) list)
   :expected '(127 255 10))

(define-test parse-web-color
   (call-with-values (lambda () (parse-web-color "#7fff0a")) list)
   :expected '(127 255 10))

(define-test parse-web-color
   (call-with-values (lambda () (parse-web-color "rgb(234,43,25)")) list)
   :expected '(234 43 25))

(define-test parse-web-color
   (call-with-values (lambda () (parse-web-color "rgb(100%,0%,51%)")) list)
   :expected '(255 0 130))

(define-test parse-web-color
   (call-with-values (lambda () (parse-web-color "hsl(23,50%,74%)")) list)
   :expected '(222 181 156))

(define-test hsv->rgb
   (call-with-values (lambda () (hsv->rgb 34 43 19)) list)
   :expected '(48 39 27))

(define-test hsl->rgb
   (call-with-values (lambda () (hsl->rgb 23 50 74)) list)
   :expected '(222 181 156))

(define-test rgb->hsl
   (call-with-values (lambda () (rgb->hsl 222 181 156)) list)
   :expected '(23 50 74))
