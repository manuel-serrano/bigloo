(define-test '|eval.set5| (eval '((lambda (x y z t u v) (set! v (- v)) v) 1 2 3 4 5 6)) :expected -6)
(define-test '|eval.global| (eval '(begin (define *eval-glo* 0)
			       (set! *eval-glo* 1)
			       *eval-glo*)) :expected
      1)
(define-test '|eval.global| (procedure? (eval 'cos)) :expected #t)
(define-test '|eval.cond| (eval '((lambda (x) (if (< x 1) 5 6)) 1)) :expected 6)
(define-test '|eval.cond| (eval '((lambda (x) (if (< x 1) 5 6)) 0)) :expected 5)
(define-test '|eval.cond| (eval '((lambda (x) (begin (set! x 4) (set! x 5) x)) 1)) :expected 5)
(define-test '|eval.define| (eval '(begin (define (ffoo x) x) (ffoo 3))) :expected 3)
(define-test '|eval.define| (eval '(begin (define vvar (ffoo 4)) vvar)) :expected 4)
(define-test '|eval.bind-exit1| (eval '(+ 1 (bind-exit (exit) (exit 3) 14))) :expected 4)
(define-test '|eval bind-exit.2| (eval
			       '(let ((str #u"foo")
				      (ht (cons 1 2)))
				 (bind-exit (break)
				    (let loop ()
				       (set-car! ht 2)
				       (break #unspecified)
				       (loop)))
				 (car ht))) :expected
      2)
(define-test '|eval.unwind-protext| (eval '(let ((x 0))
				       (unwind-protect
					  (set! x 10)
					  (set! x 1))
				       x)) :expected
      1)
