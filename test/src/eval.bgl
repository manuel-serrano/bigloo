(define-test eval.bind-exit (eval
			       '(let ((str #u"foo")
				      (ht (cons 1 2)))
				 (bind-exit (break)
				    (let loop ()
				       (set-car! ht 2)
				       (break #unspecified)
				       (loop)))
				 (car ht))) :expected
      2)
