;*---------------------------------------------------------------------*/
;*    eval                                                             */
;*---------------------------------------------------------------------*/
(module eval
   (export test)
   (eval (export *f* gee bar)))

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "./test.bgh")

;*---------------------------------------------------------------------*/
;*    test ...                                                         */
;*---------------------------------------------------------------------*/
(define (test verbose tests::pair-nil)
   (when (or (null? tests) (member "eval" tests))
      (test-all verbose "eval")))

;*---------------------------------------------------------------------*/
;*    declarations                                                     */
;*---------------------------------------------------------------------*/
(define-inline (collect-to stop?::procedure parse::procedure start::pair-nil)
    (define (collect::pair-nil accum)
      (let ((item (parse)))
        (if (stop? item) (reverse! accum)
  	  (collect (cons item accum)))))
    (collect start))

(define (genum n)
   (lambda ()
      (set! n (- n 1))
      n))

(define gee 23)

(define *f* 6)

(define (bar)
   (set! *f* 7))

(eval '(define-class evpt x (y read-only (default 10))))
(eval '(define (evpt? o) (isa? o evpt)))

;*---------------------------------------------------------------------*/
;*    tests                                                            */
;*---------------------------------------------------------------------*/
(define-test eval
   (eval '1) :expected 1)
(define-test eval
   (procedure? (eval 'car)) :expected #t)
(define-test eval
   (eval '(car '(1 2))) :expected 1)
(define-test eval
   (eval '((lambda (x) (+ 1 x)) 4)) :expected 5)
(define-test eval
   ((eval '(lambda (x) (+ 1 x))) 4) :expected 5)
(define-test eval
   (apply (eval '(lambda (x) (+ 1 x))) '(4)) :expected 5)
(define-test eval
   (let ((foo (lambda (x) (+ 1 x))))
      (eval `(,foo 4))) :expected 5)
(define-test eval
   (eval '(apply (lambda (x) (+ 1 x)) '(4))) :expected 5)
(define-test eval
   (let ((foo (lambda (x) (+ 1 x))))
      (eval `(apply ,foo '(4)))) :expected 5)
(define-test eval
   (eval '(begin (define *v* #t) *v*)) :expected #t)
(define-test eval
   (eval '(begin (define *v* #f) *v*)) :expected #f)


(define-test '|fib| (eval '(letrec ((fib (lambda (x)
				       (if (<fx x 2)
					   1
					   (+fx (fib (-fx x 1))
					      (fib (-fx x 2)))))))
		       (fib 20))) :expected
      10946)
(define-test '|args.1| ((eval '(lambda (a b c d e f g h)
			   (+ a b c d e f g h)))
		   1 2 3 4 5 6 7 8) :expected
      
      36)
(define-test '|args.2| ((eval '(lambda (a b c d e f g . h)
			   (+ a b c d e f g (apply + h))))
		   1 2 3 4 5 6 7 8 9) :expected
      45)
(define-test '|args.3| (let ((foo (lambda (a b c d e f g h)
				(+ a b c d e f g h))))
		     (eval `(,foo 1 2 3 4 5 6 7 8))) :expected
      36)
(define-test '|args.4| (let ((foo (lambda (a b c d e f g . h)
				(+ a b c d e f g (apply + h)))))
		     (eval `(,foo 1 2 3 4 5 6 7 8 9))) :expected
      45)
(define-test '|if.1| (eval '(if #t #t #f)) :expected #t)
(define-test '|if.2| (eval '(let ((if (lambda (x y z) z))) (if #t #t #f))) :expected #f)
(define-test '|set!.2| (eval '(begin (bar) *f*)) :expected 7)
(define-test '|set!.3| (begin (eval '(define (foo1 x) (set! bar1 x) bar1))
			 (eval '(define bar1 6))
			 (eval '(foo1 1))) :expected
      1)
(define-test '|variable| (eval '(procedure? read)) :expected #t)
(define-test '|-4 args| (eval '(let ((foo  (lambda  (a b c . d) d)))
			   (car (list (foo 1 2 3 4))))) :expected
      '(4))
(define-test '|4 args| (eval '(let ((foo  (lambda  (a b c d) (+ a b c d))))
			  (+ 0 (foo 1 2 3 4)))) :expected
      10)
(define-test '|5 args| (eval '(let ((foo (lambda (a b c d e) (+ a b c d e))))
			  (+ (foo 1 2 3 4 5) 0))) :expected
      15)
(define-test '|-5 args| (eval '(let ((foo (lambda (a b c d . e)
					(+ a b c d (car e)))))
			   (+ 0 (foo 1 2 3 4 5)))) :expected
      15)
(define-test '|with-exception-handler.1|
      (eval '(bind-exit (exit)
	      (with-exception-handler
		 (lambda (e)
		    (exit 1))
		 (lambda ()
		    (car 1))))) :expected
      1)
(define-test '|with-exception-handler.1b|
      (eval '(bind-exit (exit)
	      (with-exception-handler
		 (lambda (e)
		    (exit 1))
		 (lambda ()
		    (car 1))))) :expected
      1)
(define-test '|with-exception-handler.2|
      (eval '(bind-exit (exit)
	      (with-exception-handler
		 (lambda (e)
		    (exit 1)
		    (print "foo"))
		 (lambda ()
		    (car 1))))) :expected
      1)
(define-test '|try.1| (eval '(try (car 1) (lambda (escape proc mes obj) (escape 1)))) :expected
      1)
(define-test '|try.1b| (eval '(try (car 1) (lambda (escape proc mes obj) (escape 1)))) :expected
      1)
(define-test '|try.2| (eval '(try (car 1) (lambda (escape proc mes obj) (escape 1) (print "foo")))) :expected
      1)
(define-test '|funcall.0| (eval '(let ((f (lambda () 0))) (f))) :expected 0)
(define-test '|funcall.1| (eval '(let ((f (lambda (a) a))) (f 1))) :expected 1)
(define-test '|funcall.2| (eval '(let ((f (lambda (a b) (+ a b)))) (f 1 1))) :expected 2)
(define-test '|funcall.3| (eval '(let ((f (lambda (a b c) (+ a b c))))
			     (f 0 1 2))) :expected
      3)
(define-test '|funcall.4| (eval '(let ((f (lambda (a b c d) (+ a b c d))))
			     (f 0 1 2 1))) :expected
      4)
(define-test '|funcall.5| (eval '(let ((f (lambda (a b c d e) (+ a b c d e))))
			     (f 1 -1 2 3 0))) :expected
      5)
(define-test '|funcall.-1| (eval '(let ((f (lambda f f))) (f))) :expected '())
(define-test '|funcall.-1| (eval '(let ((f (lambda f f))) (f 1 2 3))) :expected '(1 2 3))
(define-test '|cnst.1| (eval '(cons 1 2)) :expected (cons 1 2))
(define-test '|cnst.2| (eval '(vector 1 2)) :expected '#(1 2))
(define-test '|global variable.1| (eval '(begin (define (foo11 x) bar11)
				     (define bar11 4)
				     (foo11 5))) :expected
      4)
(define-test '|global variable.2| (eval '(begin (define (foo22 x) (set! bar22 x))
				     (define bar22 5)
				     (foo22 4)
				     bar22)) :expected
      4)
(define-test '|inline| (collect-to zero? (genum 10) '()) :expected '(9 8 7 6 5 4 3 2 1))
(define-test '|export-export| (eval 'gee) :expected gee)
(define-test '|eval.cnst| (eval 4) :expected 4)
(define-test '|eval.cnst| (eval ''foo) :expected 'foo)
(define-test '|eval.cnst| (eval '(quote (foo bar))) :expected '(foo bar))
(define-test '|eval.cnst| (eval '(quote #(foo bar))) :expected '#(foo bar))
(define-test '|eval.begin| (eval '(begin)) :expected #unspecified)
(define-test '|eval.begin| (eval '(begin 1)) :expected 1)
(define-test '|eval.begin| (eval '(begin 1 2)) :expected 2)
(define-test '|eval.var0| (eval '((lambda (x) x) 1)) :expected 1)
