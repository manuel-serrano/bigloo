(define-test '|let*.4| (eval '(let* ((x 5)) (let* ((x 3) (y x)) y))) :expected 3)
(define-test '|let*.5| (eval '(let ((a 0)) (let ((x a)) (let* ((x x) (y x)) y)))) :expected 0)
