(define-test '|let*.7| (eval '(let ((a 0)) (let ((x 4)) (let* ((x a) (y x)) y)))) :expected 0)
(define-test '|let*.8| (eval '(let ((a 0)) (let ((x a)) (let* ((x a) (y x)) y)))) :expected 0)
(define-test '|let*.9| (eval '(let ((a 0)) (let ((x a)) (let* ((x a) (y a)) y)))) :expected 0)
(define-test '|let*.10| (eval '(let* ((x (lambda (y) (+ 1 y)))) (x 10))) :expected 11)
