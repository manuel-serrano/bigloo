(define-test eval.set0 (eval '((lambda (x) (set! x (- x)) x) 1)) :expected -1)
(define-test eval.set1 (eval '((lambda (x y) (set! y (- y)) y) 1 2)) :expected -2)
(define-test eval.set2 (eval '((lambda (x y z) (set! z (- z)) z) 1 2 3)) :expected -3)
(define-test eval.set3 (eval '((lambda (x y z t) (set! t (- t)) t) 1 2 3 4)) :expected -4)
