;*---------------------------------------------------------------------*/
;*    eval                                                             */
;*---------------------------------------------------------------------*/
(module eval
   (export test)
   (eval (export *f* gee bar)))

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "./test.bgh")

;*---------------------------------------------------------------------*/
;*    test ...                                                         */
;*---------------------------------------------------------------------*/
(define (test verbose tests::pair-nil)
   (when (or (null? tests) (member "eval" tests))
      (test-all verbose "eval")))

;*---------------------------------------------------------------------*/
;*    declarations                                                     */
;*---------------------------------------------------------------------*/
(define-inline (collect-to stop?::procedure parse::procedure start::pair-nil)
    (define (collect::pair-nil accum)
      (let ((item (parse)))
        (if (stop? item) (reverse! accum)
  	  (collect (cons item accum)))))
    (collect start))

(define (genum n)
   (lambda ()
      (set! n (- n 1))
      n))

(define gee 23)

(define *f* 6)

(define (bar)
   (set! *f* 7))

(eval '(define-class evpt x (y read-only (default 10))))
(eval '(define (evpt? o) (isa? o evpt)))

;*---------------------------------------------------------------------*/
;*    tests                                                            */
;*---------------------------------------------------------------------*/
(define-test eval
   (eval '1) :expected 1)
(define-test eval
   (procedure? (eval 'car)) :expected #t)
(define-test eval
   (eval '(car '(1 2))) :expected 1)
(define-test eval
   (eval '((lambda (x) (+ 1 x)) 4)) :expected 5)
(define-test eval
   ((eval '(lambda (x) (+ 1 x))) 4) :expected 5)
(define-test eval
   (apply (eval '(lambda (x) (+ 1 x))) '(4)) :expected 5)
(define-test eval
   (let ((foo (lambda (x) (+ 1 x))))
      (eval `(,foo 4))) :expected 5)
(define-test eval
   (eval '(apply (lambda (x) (+ 1 x)) '(4))) :expected 5)
(define-test eval
   (let ((foo (lambda (x) (+ 1 x))))
      (eval `(apply ,foo '(4)))) :expected 5)
(define-test eval
   (eval '(begin (define *v* #t) *v*)) :expected #t)
(define-test eval
   (eval '(begin (define *v* #f) *v*)) :expected #f)

(define-test eval-class
   (eval '(define-class EvPoint (ctor) x y))
   :expected #f)
(define-test eval-class
   (eval '(define-class EvWrapPoint p::EvPoint))
   :expected #f)
(define-test eval-class-ctor
   (eval
      '(define (ctor o::EvPoint)
        (set! o.x (+fx 1 o.x))
        o))
   :expected 'ctor)
(define-test eval-instantiate
   (eval '(instantiate::EvPoint (x 34) (y 10)))
   :expected object?)
(define-test eval-instantiate
   (eval '(instantiate::EvWrapPoint (p (instantiate::EvPoint (x 34) (y 10)))))
   :expected object?)
(define-test eval-get
   (eval '(let ((o::EvPoint (instantiate::EvPoint (x 34) (y 10)))) o.x))
   :expected 35)
(define-test eval-get
   (eval '(let ((o::EvPoint (instantiate::EvPoint (x 34) (y 10)))) (-> o x)))
   :expected 35)
(define-test eval-get
   (eval '(let ((o::EvPoint (instantiate::EvPoint (x 34) (y 10))))
           (let ((o.x 100))
              o.x)))
   :expected 100)
(define-test eval-get
   (eval '(let* ((o (instantiate::EvWrapPoint (p (instantiate::EvPoint (x 44) (y 10)))))
                 (w::EvWrapPoint o))
           w.p.x))
   :expected 45)

(define-test eval-set
   (eval '(let ((o::EvPoint (instantiate::EvPoint (x 34) (y 10))))
           (set! o.y (+fx o.x 10))
           o.y))
   :expected 45)

(define-test eval-fun
   (eval '(letrec ((fib (lambda (x)
                           (if (<fx x 2)
                               1
                               (+fx (fib (-fx x 1))
                                  (fib (-fx x 2)))))))
           (fib 20))) :expected
   10946)
(define-test eval-args ((eval '(lambda (a b c d e f g h)
			   (+ a b c d e f g h)))
		   1 2 3 4 5 6 7 8) :expected
      
      36)
(define-test eval-args ((eval '(lambda (a b c d e f g . h)
			   (+ a b c d e f g (apply + h))))
		   1 2 3 4 5 6 7 8 9) :expected
      45)
(define-test eval-args (let ((foo (lambda (a b c d e f g h)
				(+ a b c d e f g h))))
		     (eval `(,foo 1 2 3 4 5 6 7 8))) :expected
      36)
(define-test eval-args (let ((foo (lambda (a b c d e f g . h)
				(+ a b c d e f g (apply + h)))))
		     (eval `(,foo 1 2 3 4 5 6 7 8 9))) :expected
      45)
(define-test eval-if (eval '(if #t #t #f)) :expected #t)
(define-test eval-if  (eval '(let ((if (lambda (x y z) z))) (if #t #t #f))) :expected #f)
(define-test eval-set (eval '(begin (bar) *f*)) :expected 7)
(define-test eval-set (begin (eval '(define (foo1 x) (set! bar1 x) bar1))
			 (eval '(define bar1 6))
			 (eval '(foo1 1))) :expected
      1)
(define-test eval-var (eval '(procedure? read)) :expected #t)
(define-test eval-varargs (eval '(let ((foo  (lambda  (a b c . d) d)))
			   (car (list (foo 1 2 3 4))))) :expected
      '(4))
(define-test eval-varargs (eval '(let ((foo  (lambda  (a b c d) (+ a b c d))))
			  (+ 0 (foo 1 2 3 4)))) :expected
      10)
(define-test eval-fxargs (eval '(let ((foo (lambda (a b c d e) (+ a b c d e))))
			  (+ (foo 1 2 3 4 5) 0))) :expected
      15)
(define-test eval-varargs (eval '(let ((foo (lambda (a b c d . e)
					(+ a b c d (car e)))))
			   (+ 0 (foo 1 2 3 4 5)))) :expected
      15)
(define-test eval-with-exception-handler
      (eval '(bind-exit (exit)
	      (with-exception-handler
		 (lambda (e)
		    (exit 1))
		 (lambda ()
		    (car 1))))) :expected
      1)
(define-test eval-with-exception-handler
      (eval '(bind-exit (exit)
	      (with-exception-handler
		 (lambda (e)
		    (exit 1))
		 (lambda ()
		    (car 1))))) :expected
      1)
(define-test eval-with-exception-handler
      (eval '(bind-exit (exit)
	      (with-exception-handler
		 (lambda (e)
		    (exit 1)
		    (print "foo"))
		 (lambda ()
		    (car 1))))) :expected
      1)
(define-test eval-try (eval '(try (car 1) (lambda (escape proc mes obj) (escape 1)))) :expected
      1)
(define-test eval-try (eval '(try (car 1) (lambda (escape proc mes obj) (escape 1)))) :expected
      1)
(define-test eval-try (eval '(try (car 1) (lambda (escape proc mes obj) (escape 1) (print "foo")))) :expected
      1)
(define-test eval-funcall (eval '(let ((f (lambda () 0))) (f))) :expected 0)
(define-test eval-funcall (eval '(let ((f (lambda (a) a))) (f 1))) :expected 1)
(define-test eval-funcall (eval '(let ((f (lambda (a b) (+ a b)))) (f 1 1))) :expected 2)
(define-test eval-funcall (eval '(let ((f (lambda (a b c) (+ a b c))))
			     (f 0 1 2))) :expected
      3)
(define-test eval-funcall (eval '(let ((f (lambda (a b c d) (+ a b c d))))
			     (f 0 1 2 1))) :expected
      4)
(define-test eval-funcall (eval '(let ((f (lambda (a b c d e) (+ a b c d e))))
			     (f 1 -1 2 3 0))) :expected
      5)
(define-test eval-funcall  (eval '(let ((f (lambda f f))) (f))) :expected '())
(define-test eval-funcall  (eval '(let ((f (lambda f f))) (f 1 2 3))) :expected '(1 2 3))
(define-test eval-cnst (eval '(cons 1 2)) :expected (cons 1 2))
(define-test eval-cnst (eval '(vector 1 2)) :expected '#(1 2))
(define-test eval-global (eval '(begin (define (foo11 x) bar11)
				     (define bar11 4)
