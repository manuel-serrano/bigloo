				   (foo (lambda (a) (set! g (* 2 a)))))
			     (let loop ((i 0))
				(if (=fx i 10)
				    (foo i)
				    (loop (+fx i 1))))
			     g)) :expected
      20)
(define-test '|letrec*.1| (eval '(letrec* ((x 1)) x)) :expected 1)
(define-test '|letrec*.2| (eval '(letrec* ((x 1) (y 2)) (+ x y))) :expected 3)
(define-test '|tail.0| (eval '(let ((x 100000))
			  (letrec ((loop (lambda ()
					    (if (= x 0)
						(list x)
						(begin
						   (set! x (- x 1))
						   (loop))))))
			     (loop)))) :expected
      '(0))
(define-test '|tail.1| (eval '(letrec ((loop (lambda (x)
					   (if (= x 0)
					       (list x)
					       (loop (- x 1))))))
			  (loop 10000))) :expected
      '(0))
(define-test '|tail.2| (eval '(letrec ((loop (lambda (x y)
					   (if (= x 0)
					       (list y)
					       (loop (- x 1) (+ y 1))))))
			  (loop 10000 0))) :expected
      '(10000))
(define-test '|tail.3| (eval '(letrec ((loop (lambda (x y z)
					   (if (= x 0)
					       (list y z)
					       (loop (- x 1) (+ y 1) (+ z 1))))))
			  (loop 10000 0 0))) :expected
      '(10000 10000))
(define-test '|tail.4| (eval '(letrec ((loop (lambda (x y z t)
					   (if (= x 0)
					       (list y z t)
					       (loop (- x 1) (+ y 1) (+ z 1) (+ t 1))))))
			  (loop 10000 0 0 0))) :expected
      '(10000 10000 10000))
(define-test '|tail.5| (eval '(letrec ((loop (lambda (x y z t u)
					   (if (= x 0)
					       (list y z t u)
					       (loop (- x 1) (+ y 1) (+ z 1) (+ t 1) (+ u 1))))))
			  (loop 10000 0 0 0 0))) :expected
      '(10000 10000 10000 10000))
(define-test '|tail.-1| (eval '(letrec ((loop (lambda x
					    (if (= (car x) 0)
						x
						(loop (- (car x) 1))))))
			   (loop 10000))) :expected
      '(0))
(define-test '|tail.-2| (eval '(letrec ((loop (lambda (x . y)
					    (if (= x 0)
						y
						(loop (- x 1) (+ (car y) 1))))))
			   (loop 10000 0))) :expected
      '(10000))
(define-test '|tail.-3| (eval '(letrec ((loop (lambda (x y . z)
					    (if (= x 0)
						(cons y z)
						(loop (- x 1) (+ y 1) (+ (car z) 1))))))
			   (loop 10000 0 0))) :expected
      '(10000 10000))
(define-test '|tail.-4| (eval '(letrec ((loop (lambda (x y z . t)
					    (if (= x 0)
						(cons* y z t)
						(loop (- x 1) (+ y 1) (+ z 1) (+ (car t) 1))))))
			   (loop 10000 0 0 0))) :expected
      '(10000 10000 10000))
