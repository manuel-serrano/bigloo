(define-test '|tail.error| (bind-exit (esc)
			 (with-exception-handler
			    (lambda (e)
			       (esc #t))
			    (lambda ()
			       (eval '((begin (define (fooo x))) (fooo 3)))))) :expected
      #t)
(define-test '|do| (eval '(do ((i 1 2) (j 0 i)) ((positive? j) j))) :expected 1)
(define-test '|typed-indent.1| (eval '((lambda (x::int) x) 3)) :expected 3)
(define-test '|typed-indent.2| (eval '(let ((x::int 3)) x)) :expected 3)
(define-test '|typed-indent.3| (eval '(let* ((x::int 3) (y x)) y)) :expected 3)
(define-test '|typed-indent.4| (eval '(letrec ((x::int 3)) x)) :expected 3)
(define-test '|eval class.1| (eval '(evpt? (instantiate::evpt (x 20)))) :expected #t)
(define-test '|eval class.3| (eval '(evpt? (instantiate::evpt (x 10)))) :expected #t)
(define-test '|eval class.4| (eval '(evpt? (instantiate::evpt (x 10) (y 10)))) :expected #t)
(define-test '|eval class.5| (eval '(evpt? #f)) :expected #f)
(define-test '|eval class.7| (eval '(let ((p (instantiate::evpt (x 10) (y 40))))
				(with-access::evpt p (x y)
				   (set! x (+ x y))
				   x))) :expected
      50)
