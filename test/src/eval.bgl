(define-test tail.error (bind-exit (esc)
			 (with-exception-handler
			    (lambda (e)
			       (esc #t))
			    (lambda ()
			       (eval '((begin (define (fooo x))) (fooo 3)))))) :expected
      #t)
(define-test do (eval '(do ((i 1 2) (j 0 i)) ((positive? j) j))) :expected 1)
(define-test typed-indent.1 (eval '((lambda (x::int) x) 3)) :expected 3)
(define-test typed-indent.2 (eval '(let ((x::int 3)) x)) :expected 3)
(define-test typed-indent.3 (eval '(let* ((x::int 3) (y x)) y)) :expected 3)
(define-test typed-indent.4 (eval '(letrec ((x::int 3)) x)) :expected 3)
(define-test evalclass.1 (eval '(evpt? (instantiate::evpt (x 20)))) :expected #t)
(define-test evalclass.3 (eval '(evpt? (instantiate::evpt (x 10)))) :expected #t)
(define-test evalclass.4 (eval '(evpt? (instantiate::evpt (x 10) (y 10)))) :expected #t)
(define-test evalclass.5 (eval '(evpt? #f)) :expected #f)
(define-test evalclass.7 (eval '(let ((p (instantiate::evpt (x 10) (y 40))))
				(with-access::evpt p (x y)
				   (set! x (+ x y))
				   x))) :expected
      50)
(define-test evalclass.8 (eval '(let ((p (instantiate::evpt (x 10) (y 40))))
				(with-access::evpt p (x y)
				   (cond
				      ((and (eq? x 10))
				       10)
				      (else
				       20))))) :expected
      10)
(define-test evalclass.9 (eval '(let ((p (instantiate::evpt (x 10) (y 40))))
				(with-access::evpt p (x y)
				   (cond
				      ((and (eq? y 40))
				       10)
				      (else
				       20))))) :expected
      10)
(define-test evalclass.10  (eval '(let ((i (instantiate::evpt (x 10) (y 40))))
				  (with-access::evpt i (y)
				     (let ((x 100))
					x)))) :expected
      100)
(define-test evalclass.11  (eval '(let ((i (instantiate::evpt (x 10) (y 40))))
				  (with-access::evpt i (x)
				     (let ((x 100))
					x)))) :expected
      100)
(define-test evalclass.12  (eval '(let ((i (instantiate::evpt (x 10) (y 40))))
				  (with-access::evpt i (x)
				     (let ((x 100))
					x)
				     x))) :expected
      10)
(define-test evalclass.13  (eval '(let ((i (instantiate::evpt (x 10) (y 40))))
				  (with-access::evpt i (x)
				     (list x (let ((x 100)) x) x)))) :expected
      '(10 100 10))
(define-test evalclass.14  (eval '(let ((i (instantiate::evpt (x 10) (y 40))))
				  (let ((x 20))
				     (with-access::evpt i (y)
					x)))) :expected
      '20)
(define-test evalclass.15  (eval '(let ((i (instantiate::evpt (x 10) (y 40))))
				  (let ((x 20))
				     (with-access::evpt i (x)
					x)))) :expected
      '10)
(define-test evalclass.16  (eval '(let ((i (instantiate::evpt (x 10) (y 40))))
				  (with-access::evpt i (x y)
				     (let ((x 20))
					(set! x y)
					x)))) :expected
      '40)
(define-test evalclass.17  (eval '(let ((i (instantiate::evpt (x 10) (y 40))))
				  (with-access::evpt i (x y)
				     (set! x y)
				     x))) :expected
      '40)
(define-test evalduplicate (eval '(let* ((i (instantiate::evpt (x 10) (y 40)))
					(j (duplicate::evpt i (x 11))))
				  (with-access::evpt j (x y)
				     (+ x y)))) :expected
      51)
(define-test eval-define (eval '(begin
				 (define (inner.1 x)
				    (define (%inner.1 x) x)
				    (%inner.1 x))
				 (inner.1 34))) :expected
      34)
(define-test eval-define (eval '(begin
				 (define (inner.2 x)
				    (define (%inner.2) x)
				    (%inner.2))
				 (inner.2 35))) :expected
      35)
(define-test eval-define (eval '(begin
				 (define (inner.3 x)
				    (define (%inner.3) x)
				    (%inner.3))
				 (+ (inner.3 35) (inner.3 15)))) :expected
      50)
(define-test eval-define (let ((p (open-output-string)))
			    (with-error-to-port p
  			       (lambda ()
				  (eval `(begin
					    (define (barev)
					       (let ((y 10))
						  (if (begin
							 (define (glop)
							    y)
							 (glop))
						      1)))
					    (barev)))))) :expected 1)
(define-test eval-define
      (eval '(define <HOPIMPRESS:ROW>
	      (lambda args3633
		 (let ((id #f)
		       (data-x 0)
		       (data-y 0)
		       (width 0)
		       (height 0)
		       (attrs '())
		       (body '()))
		    (letrec ((loop3634
				(lambda (args3633)
				   (if (null? args3633)
				       (begin
					  (print :class #f
					     :id #f
					     (letrec ((loop (lambda (l x y)
							       (if (null? l)
								   body
								   '()))))
						(loop body data-x data-y))))
				       '()))))
		       (loop3634 args3633)))))) :expected
      '<HOPIMPRESS:ROW>)
(define-test eval-flonum
      (eval '(let  ((add 1.3))
	      (let ((toadd  (*fl add 1e-4)))
		 (lambda (dum) (set! add 1.0))
		 (>fl toadd 0.0)))) :expected
      #t)


(define-test repl
   (let ((res #f))
      (with-output-to-string
         (lambda ()
            (with-input-from-string "(+ 3 4)"
               (lambda ()
                  (set! res (repl))))))
      res)
   :expected 7)

(define-test quit
   (let ((res #f))
      (with-output-to-string
         (lambda ()
            (with-input-from-string "(+ 1 2) (quit 30) (car '(1 2))"
               (lambda ()
                  (set! res (repl))))))
      res)
   :expected 30)

(define-test get-repl-error-notifier
   (get-repl-error-notifier)
   :expected #f)

(define-test set-repl-error-notifier!
   (begin
      (set-repl-error-notifier! exception-notify)
      (get-repl-error-notifier))
   :expected procedure?)

(define-test get-prompter
   (get-prompter)
   :expected procedure?)

(define-test set-prompter!
   (begin
      (set-prompter! (lambda (level) (format "~a>" level)))
      (get-prompter))
   :expected procedure?)

(define-test set-repl-printer!
   (with-output-to-string
      (lambda ()
         (set-repl-printer!
            (lambda (v::obj p::output-port) (fprintf p "=> ~a" v)))
         (with-input-from-string "(car '(foo))"
            (lambda ()
               (repl)))))
   :expected "\n=> foo\n\n")

(define-test native-repl-printer
   (native-repl-printer)
   :expected procedure?)

(define-test expand
   (expand '(cond ((> x 1) 24) (else 26)))
   :expected '(if (> x 1) 24 26))

(define-test expand-once
   (expand-once '(cond ((> x 1) (cond (z 24) (else 32))) (else 26)))
   :expected '(if (> x 1) (cond (z 24) (else 32)) (cond (else 26))))

(define-test load
   (with-output-to-string
      (lambda ()
         (load "misc/load.bgl")))
   :expected "x\nz\n35\n11\n")

(define-test loadq
   (loadq "misc/load.bgl")
   :expected "misc/load.bgl")

(define-test loadq
   (with-output-to-string
      (lambda ()
         (loadq "misc/load.bgl")))
   :expected "")

(define-test *load-path*
   *load-path*
   :expected list?)

