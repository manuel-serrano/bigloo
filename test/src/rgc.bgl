(define-test the-symbol
   (let ((g (regular-grammar ()
               ((+ (in ("az")))
                (the-symbol))
               ((: (in ("09")) (+ (in ("az"))))
                (the-symbol)))))
      (call-with-input-string "0abcdefgh"
         (lambda (in)
            (read/rp g in))))
   :expected '0abcdefgh)

(define-test the-downcase-symbol
   (let ((g (regular-grammar ()
               ((+ (in ("az")))
                (the-downcase-symbol))
               ((: (in ("09")) (+ (in ("AZ"))))
                (the-downcase-symbol)))))
      (call-with-input-string "0ABCDEFGH"
         (lambda (in)
            (read/rp g in))))
   :expected '0abcdefgh)

(define-test the-upcase-symbol
