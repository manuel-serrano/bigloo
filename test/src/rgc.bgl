(define-test the-fixnum
   (call-with-input-string "1234"
      (lambda (in)
         (read/rp (regular-grammar () ((: digit) (the-fixnum))) in)))
   :expected 1)

(define-test the-fixnum
   (call-with-input-string "1234"
      (lambda (in)
         (read/rp (regular-grammar () ((+ digit) (the-fixnum))) in)))
   :expected 1234)

(define-test the-flonum
   (call-with-input-string "1234"
      (lambda (in)
         (read/rp (regular-grammar () ((+ digit) (the-flonum))) in)))
   :expected 1234.)

(define-test the-flonum
   (call-with-input-string "1234"
      (lambda (in)
         (read/rp (regular-grammar () ((+ digit) (the-flonum))) in)))
   :expected 1234.)

(define-test the-flonum
   (let ((g (regular-grammar ((float (or (: (* digit) "." (+ digit))
                                         (: (+ digit) "." (* digit)))))
               ((: (? (in "-+"))
                   (or float
                       (: (or float (+ digit))
                          (in "eE") (? (in "+-"))
                          (+ digit))))
                (the-flonum)))))
      (call-with-input-string "-32e-10"
         (lambda (in)
            (read/rp g in))))
   :eq ~equal?
   :expected -32e-10)

(define-test the-failure
   (let ((g (regular-grammar ()
               ((+ alpha)
                (the-string))
               (digit
                (the-failure))
               (else
                (unless (eof-object? (the-failure))
                   (ignore))))))
      (call-with-input-string "  aaaa  "
         (lambda (in)
            (read/rp g in))))
   :expected "aaaa")

(define-test the-failure
   (let ((g (regular-grammar ()
               ((+ alpha)
                (the-string))
               (digit
                (the-failure))
               (else
                (unless (eof-object? (the-failure))
                   (ignore))))))
      (call-with-input-string "  1245 "
         (lambda (in)
            (read/rp g in))))
   :expected #\1)

(define-test ignore
   (let ((g (regular-grammar ()
               (")" 
                '())
               ("(" 
                (let* ((car (ignore))
                       (cdr (ignore)))
                   (cons car cdr)))
               ((+ (out "()"))
                (the-string)))))
      (call-with-input-string "(foo(bar(gee)))"
         (lambda (in)
            (read/rp g in))))
   :expected '("foo" "bar" "gee"))

(define-test rgc-context
   (let ((res #f))
      (let ((g (regular-grammar ()
                  ((context foo "foo") (set! res 'foo-bis))
                  ("foo" (rgc-context 'foo) (set! res 'foo) (ignore))
                  (else 'done))))
         (call-with-input-string "foofoo"
            (lambda (in)
               (read/rp g in)))
         res))
   :expected 'foo-bis)

(define-test the-context
   (let ((res #f))
      (let ((g (regular-grammar ()
                  ((context ctx "foo") (set! res (the-context)))
                  ("foo" (rgc-context 'ctx) (ignore))
                  (else 'done))))
         (call-with-input-string "foofoo"
            (lambda (in)
               (read/rp g in)))
         res))
   :expected 'ctx)

(define-test rgc-trap
   (let ((ncontext 0)
	 (ntiti 0)
	 (neol 0)
	 (nbol 0)
	 (neof 0) 
	 (n 0))
      (let ((grammar (regular-grammar ((lettre  (in ("az"))))
			((+ (in #\space #\newline))
			 (set! n (+ (the-length) n))
			 (ignore))
			((when (rgc-context? 'titi) "titi")
			 (rgc-context)
			 (set! n (+ (the-length) n))
			 (set! ncontext (+ 1 ncontext))
			 (ignore))
			("titi"
			 (set! ntiti (+ 1 ntiti))
			 (set! n (+ (the-length) n)) 
			 (rgc-context 'titi)
			 (ignore))
			((eof "toto")
			 (set! n (+ (the-length) n))
			 (set! neof (+ 1 neof))
			 (ignore))
			((eol "toto")
			 (set! n (+ (the-length) n))
			 (set! neol (+ 1 neol))
			 (ignore))
			((bol "toto")
			 (set! nbol (+ 1 nbol))
			 (ignore))
			("toto"
			 (set! n (+ (the-length) n)) 
			 (ignore))
			((+ lettre)
			 (set! n (+ (the-length) n)) 
			 (ignore))
			(else
			 (the-failure)))))
	 (labels ((run (port)
                     (let loop ((r (read/rp grammar port)))
                        (if (eof-object? r)
                            (list ncontext ntiti neol nbol neof n)
                            (loop (read/rp grammar port))))))
            (call-with-input-string "titi
titi
toto titi et oui toto
toto toto
titi
titi
toto titi et oui toto
toto"
               run))))
   :expected '(3 3 3 3 1 66))

(define-test rgc-eval
   (begin
      (eval '(begin (define *char* 0)
              (define *line* 0)
              (define *word* 0)
              (define g
                 (regular-grammar ()
                    ((+ #\Newline)
                     (set! *char* (+fx *char* (the-length)))
                     (set! *line* (+fx *line* (the-length)))
                     'keep)
                    ((+ (in #\space #\tab))
                     (set! *char* (+fx *char* (the-length)))
                     'keep)
                    ((+ (out #\newline #\space #\tab))
                     (set! *char* (+fx *char* (the-length)))
                     (set! *word* (+fx 1 *word*))
                     'keep)
                    (else
                     (the-failure))))))
      (eval '(let ((p (open-input-string #"toto \ntiti \ntutu")))
              (let loop ((exp (read/rp g p)))
                 (if (eof-object? exp)
                     (list *char* *line* *word*)
                     (loop (read/rp g p)))))))
   :expected '(16 2 3))

;*---------------------------------------------------------------------*/
;*    test-unread ...                                                  */
;*---------------------------------------------------------------------*/
(define (test-read-chars bufsize strsize)
   (let ((p (if (number? bufsize)
		(open-input-file rgc.filename bufsize)
		(open-input-file rgc.filename))))
      (unwind-protect
	 (let loop ((str (read-chars strsize p))
		    (acc '()))
	    (if (or (eof-object? str) (string=? str ""))
		(apply string-append (reverse! acc))
		(loop (read-chars strsize p)
		      (cons str acc))))
	 (close-input-port p))))

(define (test-read-chars2 n bf of)
   (let ((p (open-input-file rgc.filename bf)))
      (when (> of 0) (read-chars of p))
      (unwind-protect
	 (begin
	    (read-chars n p)
	    (input-port-position p))
	 (close-input-port p))))
      
(define (test-read-chars3 n bf of)
   (let ((p (open-input-file rgc.filename bf)))
      (when (> of 0) (read-chars of p))
      (unwind-protect
	 (let* ((s1 (read-chars (* 2 n) p))
		(s2 (read-chars (* 2 n) p)))
	    (string-append s1 s2))
	 (close-input-port p))))
      
(define (test-read-chars4 n bf of)
   (let ((p (open-input-file rgc.filename bf)))
      (when (> of 0) (read-chars of p))
      (unwind-protect
	 (read-chars (* 2 n) p)
	 (close-input-port p))))

(define (test-read-chars5 s)
   (with-input-from-string s
      (lambda ()
	 (let loop ((buf (read-chars 2))
		    (old #f))
	    (if (eof-object? buf)
		old
		(loop (read-chars 2) buf))))))

(define-test test-unread
   (string-case ",1"
      ((: #\, #\1)
       (unread-char! (string-ref (the-string) 1) (the-port))
       (read (the-port))))
   :expected 1)

(let ((res (test-read-chars #f 8192)))
   (define-test read-chars (test-read-chars 10 1)
      :expected res)
   (define-test read-chars (test-read-chars 10 2)
      :expected res)
   (define-test read-chars (test-read-chars 10 8)
      :expected res)
   (define-test read-chars (test-read-chars 10 9)
      :expected res)
   (define-test read-chars (test-read-chars 10 10)
      :expected res)
   (define-test read-chars (test-read-chars 10 11)
      :expected res)
   (define-test read-chars (test-read-chars 10 111)
      :expected res)
   (define-test read-chars2 (test-read-chars2 3 3 0)
      :expected 3)
   (define-test read-chars2 (test-read-chars2 3 3 3)
      :expected 6)
   (define-test read-chars2 (test-read-chars2 3 10 3)
      :expected 6)
   (define-test read-chars3 (test-read-chars3 3 3 0)
      :expected (test-read-chars4 6 3 0))
   (define-test read-chars3 (test-read-chars3 3 3 10)
      :expected (test-read-chars4 6 3 10))
   (define-test read-chars3 (test-read-chars3 10 3 10)
      :expected (test-read-chars4 20 3 10))
   (define-test read-chars3 (test-read-chars3 10 3 0)
      :expected (test-read-chars4 20 3 0))
   (define-test read-chars5 (test-read-chars5 "123")
      :expected "3")
   (define-test read-chars5 (test-read-chars5 "12")
      :expected "12")
   (define-test read-chars5 (test-read-chars5 "1")
      :expected "1"))

;*---------------------------------------------------------------------*/
;*    insertion                                                        */
;*---------------------------------------------------------------------*/
(define-test unread-string-readchars
   (let* ((p (open-input-string "123456789"))
          (dummy1 (unread-string! "ab" p))
          (str1 (read-chars 3 p)) ;; ab1
          (dummy2 (unread-string! "cdefghijklmnop" p))
          (str2 (read-chars 4 p)) ;; cdef
          (str3 (read-chars 10 p)) ;; g-p
          (str4 (read-chars 5 p)) ;; 23456
          (dummy3 (unread-string! "qr" p))
          (str5 (read-string p)) ;; qr789
          (c-ready? (char-ready? p))
          (dummy4 (unread-string! "st" p))
          (str6 (read-chars 1 p)) ;; s
          (c-ready?2 (char-ready? p))
          (str7 (read-chars 1 p)) ;; t
          (c-ready?3 (char-ready? p))
          (str8 (read p)))
      (and (equal? str1 "ab1")
           (equal? str2 "cdef")
           (equal? str3 "ghijklmnop")
           (equal? str4 "23456")
           (equal? str5 "qr789")
           (not c-ready?)
           (equal? str6 "s")
           c-ready?2
           (equal? str7 "t")
           (not c-ready?3)
           (eof-object? str8)))
   :expected #t)

(define-test unread-string-read
   (let* ((p (open-input-string "a 1 #\\x \"str\""))
          (dummy0 (unread-string! " " p))
          (c0 (read-char p)) ;; space
          (dummy0b (unread-string! "" p))
          (sym (read p))     ;; a
          ;(dummy0c (tprint (read-char p)))
          (dummy1 (unread-string! "b" p))
          (sym2 (read p)) ;; b
          (dummy2 (begin
                     (read-char p) ;; the space
                     (unread-string! "2" p)))
          (nb (read p)) ;; 21
          (char (read p))
          (dummy3 (unread-string! "\"\"" p))
          (str1 (read p))
          (dummy4 (begin
                     (read-char p) ;; the space
                     (unread-string! "#\\" p)))
          (char2 (read p)) ;; #\"
          (dummy5 (unread-string! "\"" p))
          (str2 (read p)))
      ;(tprint sym " " sym2 " " nb " " char " " str1 " " char2 " " str2)
      (and (equal? c0 #\space)
           (eq? sym 'a)
           (eq? sym2 'b)
           (=fx nb 21)
           (char=? char #\x)
           (string=? str1 "")
           (char=? char2 #\")
           (string=? str2 "str")))
   :expected #t)

(define-test unread-string-read
   (let* ((p (open-input-string "a 1 #\\x \"str\""))
          (dummy0 (unread-char! #\space p))
          (c0 (read-char p)) ;; space
          (sym (read p))     ;; a
          (dummy1 (unread-char! #\b p))
          (sym2 (read p)) ;; b
          (dummy2 (begin
                     (read-char p) ;; the space
                     (unread-char! #\2 p)))
          (nb (read p)) ;; 21
          (char (read p))
          (dummy3 (begin
                     (unread-char! #\" p)
                     (unread-char! #\" p)))
          (str1 (read p))
          (dummy4 (begin
                     (read-char p) ;; the space
                     (unread-char! #\\ p)
                     (unread-char! #\# p)))
          (char2 (read p)) ;; #\"
          (dummy5 (unread-char! #\" p))
          (str2 (read p)))
      ;(tprint sym " " sym2 " " nb " " char " " str1 " " char2 " " str2)
      (and (equal? c0 #\space)
           (eq? sym 'a)
           (eq? sym2 'b)
           (=fx nb 21)
           (char=? char #\x)
           (string=? str1 "")
           (char=? char2 #\")
           (string=? str2 "str")))
   :expected #t)

(define-test unread-char-readchars
   (let* ((p (open-input-string "123456789"))
          (dummy1 (unread-char! #\a p))
          (str1 (read-chars 2 p)) ;; a1
          (dummy2 (unread-char! #\c p))
          (str2 (read-chars 1 p))) ;; c
      (and (equal? str1 "a1")
           (equal? str2 "c")))
   :expected #t)

(define-test unread-substring-readchars
   (let* ((p (open-input-string "123456789"))
          (dummy1 (unread-substring! "0ab1" 1 3 p))
          (str1 (read-chars 3 p)) ;; ab1
          (dummy2 (unread-substring! "1234cdefghijklmnop11" 4 18 p))
          (str2 (read-chars 4 p)) ;; cdef
          (str3 (read-chars 10 p)) ;; g-p
          (str4 (read-chars 5 p)) ;; 23456
          (dummy3 (unread-substring! "qr1" 0 2 p))
          (str5 (read-string p)) ;; qr789
          (c-ready? (char-ready? p))
          (dummy4 (unread-substring! "0st" 1 3 p))
          (str6 (read-chars 1 p)) ;; s
          (c-ready?2 (char-ready? p))
          (str7 (read-chars 1 p)) ;; t
          (c-ready?3 (char-ready? p))
          (str8 (read p)))
      (and (equal? str1 "ab1")
           (equal? str2 "cdef")
           (equal? str3 "ghijklmnop")
           (equal? str4 "23456")
           (equal? str5 "qr789")
           (not c-ready?)
           (equal? str6 "s")
           c-ready?2
           (equal? str7 "t")
           (not c-ready?3)
           (eof-object? str8)))
   :expected #t)

(define-test unread-substring-read
   (let* ((p (open-input-string "a 1 #\\x \"str\""))
          (dummy0 (unread-substring! "1 2" 1 2 p))
          (c0 (read-char p)) ;; space
          (dummy0b (unread-substring! "1234" 2 2 p))
          (sym (read p))     ;; a
          ;(dummy0c (tprint (read-char p)))
          (dummy1 (unread-substring! "1b2222" 1 2 p))
          (sym2 (read p)) ;; b
          (dummy2 (begin
                     (read-char p) ;; the space
                     (unread-substring! "02" 1 2 p)))
          (nb (read p)) ;; 21
          (char (read p))
          (dummy3 (unread-substring! "\"\"124332" 0 2 p))
          (str1 (read p))
          (dummy4 (begin
                     (read-char p) ;; the space
                     (unread-substring! "1234567890#\\" 10 12 p)))
          (char2 (read p)) ;; #\"
          (dummy5 (unread-substring! "\"" 0 1 p))
          (str2 (read p)))
      ;(tprint sym " " sym2 " " nb " " char " " str1 " " char2 " " str2)
      (and (equal? c0 #\space)
           (eq? sym 'a)
           (eq? sym2 'b)
           (=fx nb 21)
           (char=? char #\x)
           (string=? str1 "")
           (char=? char2 #\")
           (string=? str2 "str")))
   :expected #t)

(define-test unread-substring-error1
   (with-handler
      (lambda (e) #t)
      (let ((p (open-input-string "A")))
         (unread-substring! "" 0 2 p)
         #f))
   :expected #t)

(define-test unread-substring-error2
   (with-handler
      (lambda (e) #t)
      (let ((p (open-input-string "A")))
         (unread-substring! "aoeu" -1 0 p)
         #f))
   :expected #t)

(define-test unread-substring-error3
   (with-handler
      (lambda (e) #t)
      (let ((p (open-input-string "A")))
         (unread-substring! "oaeu" 2 0 p)
         #f))
   :expected #t)

(define-test unread-substring-error4
   (with-handler
      (lambda (e) #t)
      (let ((p (open-input-string "A")))
         (close-input-port p)
         (unread-substring! "oaeu" 0 2 p)
         #f))
   :expected #t)
