(module rgc
   (export test))

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "./test.bgh")

;*---------------------------------------------------------------------*/
;*    test ...                                                         */
;*---------------------------------------------------------------------*/
(define (test verbose tests::pair-nil)
   (when (or (null? tests) (member "rgc" tests))
      (test-all verbose "rgc")))

(define-test regular-grammar
   (regular-grammar
         ((sign (in #\+ #\-))
          (optsign (>= 1 sign))
          (octdigit (in ("07"))))
      ((: #\0 optsign octdigit)
       0))
   :expected procedure?)

(define-test regular-grammar
   (regular-grammar ()
      ((: #\a (? #\b) #\c)
       0))
   :expected procedure?)

(define-test regular-grammar
   (regular-grammar ()
      ((: (? #\a) #\b #\c)
       0))
   :expected procedure?)

(define-test regular-grammar
   (regular-grammar ()
      ((: #\a #\b (? #\c))
       0))
   :expected procedure?)

(define-test regular-grammar
   (regular-grammar ((chiffre (in ("09")))
		     (lettre  (in ("azAZ") #a128 #a255))
		     (special (in "!@~$%^&*></.-_+\|=?:"))
		     (id      (: (or lettre chiffre special)
				 (* (or lettre chiffre special #\, #\' #\`)))))
      ((: #\# #\a chiffre chiffre chiffre)
       ;; character ascii forms
       0)
      ((: ";" (* all))
       ;; commets
       (ignore))
      ((: #\# (or id (: #\. (+ #\.))) #\()
       ;; typed vectors beginning
       1)
      (else
       2))
   :expected procedure?)

(define-test read/rp
   (let ((port (open-input-string #";1line\n;2line\n;3line\n;4line\n"))
	 (gram (regular-grammar ()
                  ((= 2 (: #\; (* all) #\newline))
                   (the-string))
                  (else
                   ""))))
      (read/rp gram port))
   :expected #";1line\n;2line\n")

(define-test string-case
   (string-case rgc.filename
      ((: (* all) ".")
       (ignore))
      ((+ (out #\.))
       (the-string))
      (else
       ""))
   :expected "bgl")

(define-test string-case
   (string-case ",1"
      ((: #\, #\1)
       (unread-char! (string-ref (the-string) 1) (the-port))
       (read (the-port))))
   :expected 1)

(define-test rgc-when
   (let ((armed #f)
         (res '()))
      (let ((g (regular-grammar ()
                  ((when (not armed) (: "#!" (+ (or #\/ alpha))))
                   (set! armed #t)
                   (set! res (the-string))
                   (ignore))
                  ((+ (in #\Space #\Tab))
                   (ignore))
                  (else
                   (the-failure)))))
         (call-with-input-string "#!/bin/sh #!/bin/zsh"
            (lambda (ip)
               (read/rp g ip)))
         res))
   :expected "#!/bin/sh")

(define-test rgc-variable
   (let ((level 0))
      (let ((g (regular-grammar ((lpar (in #\( #\[ #\{))
                                 (rpar (in #\) #\] #\})) )
                  (lpar
                   (the-string)
                   (set! level (+ level 1)))
                  (rpar
                   (the-string)
                   (set! level (- level 1))
                   'paren)
                  ((+ (out  #\( #\[ #\{ #\) #\] #\}))
                   (the-string))
                  (else (the-failure)))))
         (call-with-input-string "(define (test-rgc-jm) (let* ((level 0) (my-grammar (regular-grammar ( (lpar (in #\( #\[ #\{)) (rpar (in #\) #\] #\})) )"
            (lambda (in)
               (let loop ()
                  (let ((c (read/rp g in)))
                     (if (eof-object? c)
                         level
                         (loop))))))))
   :expected 5)

(define-test rgc-var
   (let ((g (regular-grammar ((ident (: alpha (* alnum)))
                              (number (+ digit))
                              (blank (in " \t\n\r")))
               (ident (cons (cons 'ident (the-string)) (ignore)))
               (number (cons (cons 'number (the-fixnum)) (ignore)))
               ((+ blank) (ignore))
               (else '()))))
      (call-with-input-string " Foo34 45\n58 gee"
         (lambda (in)
            (read/rp g in))))
   :expected '((ident . "Foo34") (number . 45) (number . 58) (ident . "gee")))

(define-test rgc-char
   (let ((g (regular-grammar ()
               (#\a (cons 'a (the-string)))
               (#\b (cons 'b (the-string)))
               (else (cons 'else (the-failure))))))
      (call-with-input-string "bac"
         (lambda (in)
            (read/rp g in))))
   :expected '(b . "b"))

(define-test rgc-posix
   (let ((g (regular-grammar ()
               ((posix "[az]+|xx*|y{3,5}")
                (cons (the-string) (ignore)))
               (else
                (if (eof-object? (the-failure))
                    '()
                    (ignore))))))
      (call-with-input-string " \naaz yyyy "
         (lambda (in)
            (read/rp g in))))
   :expected '("aaz" "yyyy"))

(define-test rgc>=
   (let ((g (regular-grammar ()
               ((>= 2 (: #\; (* all) #\newline))
                (the-string))
               (else
                ""))))
      (call-with-input-string #";1line\n;2line\n;3line\n;4line\n"
         (lambda (in)
            (read/rp g in))))
   :expected #";1line\n;2line\n;3line\n;4line\n")

(define-test rgc-and
   (let ((g (regular-grammar ()
		  ((+ (and (#\a #\b) "09abcd")) (the-string))
		  (else
		   ""))))
      (call-with-input-string "aaaabbbbccc"
         (lambda (in)
            (read/rp g in))))
   :expected "aaaabbbb")

(define-test rgc-and
   (let ((g (regular-grammar ()
               ((+ (and "am" "nz")) (the-string))
               (else
                ""))))
      (call-with-input-string "aaaabbbbccc"
         (lambda (in)
            (read/rp g in))))
   :expected "")

(define-test rgc-but
   (let ((g (regular-grammar ()
               ((+ (but ("09ad") ("ce"))) (the-string))
               (else
                ""))))
      (call-with-input-string "aaaabbbbccc"
         (lambda (in)
            (read/rp g in))))
   :expected "aaaabbbb")

(define-test rgc-**
   (let ((g (regular-grammar ()
		  ((** 3 6 #\a) (the-string)))))
      (call-with-input-string "aaaaaaaaaaabbbbccc"
         (lambda (in)
            (read/rp g in))))
   :expected "aaaaaa")

(define-test rgc-...
   (let ((g (regular-grammar ()
               ((... 3 "begin") (the-string)))))
      (call-with-input-string "begin"
         (lambda (in)
            (read/rp g in))))
   :expected "beg")

(define-test rgc-bol
   (let ((g (regular-grammar ()
               ((bof all)
                (let ((c (the-character)))
                   (cons `(bof ,c) (ignore))))
               ((eof all)
                (let ((c (the-character)))
                   (cons `(eof ,c) (ignore))))
               ((bol all)
                (let ((c (the-character)))
                   (cons `(bol ,c) (ignore))))
               (else
                (let ((char (the-failure)))
                   (cond ((eof-object? char) '())
                         (else
                          (cons `(char ,char) (ignore)))))))))
      (call-with-input-string "abcd" (lambda (in) (read/rp g in))))
   :expected '((bof #\a) (char #\b) (char #\c) (eof #\d)))

(define-test the-port
   (call-with-input-string "abc"
      (lambda (in)
         (let ((g (regular-grammar ()
                     (#\a (eq? (the-port) in)))))
            (read/rp g in)))))

(define-test the-length
   (let ((g (regular-grammar ()
               ((+ (in ("az"))) (the-length)))))
      (call-with-input-string "foo bargee"
         (lambda (in)
            (read/rp g in))))
   :expected 3)

(define-test the-string
   (let ((g (regular-grammar ()
               ((: (or alpha #\_) (* (or alnum #\_)))
                (the-string))
               (else
                #t))))
      (call-with-input-string "_foo45 bargee"
         (lambda (in)
            (read/rp g in))))
   :expected "_foo45")

(define-test the-string
   (let ((g (regular-grammar ()
               ((: (or alpha #\_) (* (or alnum #\_)))
                (eq? (the-string) (the-string)))
               (else
                #t))))
      (call-with-input-string "foo bargee"
         (lambda (in)
            (read/rp g in))))
   :expected #f)
      
(define-test the-substring
   (let ((g (regular-grammar ()
               ((: #\" (+ alpha) #\")
                (string=? (the-substring 1 (-fx (the-length) 1))
                   (the-substring 1 -1)))
               (else
                #f))))
      (call-with-input-string "\"foo\""
         (lambda (in)
            (read/rp g in)))))

(define-test the-substring
   (let ((g (regular-grammar ()
               ((: #\" (* (out #\")) #\")
                (the-substring 1 (-fx (the-length) 1))))))
      (call-with-input-string "\"foo\""
         (lambda (in)
            (read/rp g in))))
   :expected "foo")

