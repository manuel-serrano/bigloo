(define-test syslog
   (begin
      (openlog "/dev/null"
         (syslog-option 'LOG_PID 'LOG_ODELAY)
         (syslog-facility 'LOG_MAIL))
      (syslog (syslog-level 'LOG_INFO) "this is a log message"))
   :cond-expand C
   :expected #unspecified)

