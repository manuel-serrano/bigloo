;*---------------------------------------------------------------------*/
;*    os                                                               */
;*---------------------------------------------------------------------*/
(module os
   (export test))

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "./test.bgh")

;*---------------------------------------------------------------------*/
;*    test ...                                                         */
;*---------------------------------------------------------------------*/
(define (test verbose tests::pair-nil)
   (when (or (null? tests) (member "os" tests))
      (test-all verbose "os")))

;*---------------------------------------------------------------------*/
;*    fname ...                                                        */
;*---------------------------------------------------------------------*/
(define (fname s)
   (string-replace s #\/ (file-separator)))

;*---------------------------------------------------------------------*/
;*    tests                                                            */
;*---------------------------------------------------------------------*/
(define-test command-line (command-line)
   :expected pair?)
   
(define-test executable-name (executable-name)
   :expected string?)

(define-test time
   (multiple-value-bind (res real user sys)
      (time (lambda () (begin (sleep 10) 30)))
      (cons res (and (>= real 0) (>= real (+ user sys)))))
   :expected '(30 . #t))

(define-test register-exit-function!
   (begin (register-exit-function! (lambda (n) n)) #t))

(define-test register-exit-function!
   (with-handler
      (lambda (e)
         #t)
      (begin (register-exit-function! (lambda (x y) x)) #f)))

(define-test unregister-exit-function!
   (begin (unregister-exit-function! (lambda (n) n)) #t))

(define-test exit
   (procedure? exit))

(define-test getenv
   (getenv "HOME")
   :expected string?)

(define-test getenv
   (getenv)
   :expected list?)

(define-test putenv
   (begin
      (putenv "XXX" "24")
      (getenv "XXX"))
   :cond-expand C
   :expected "24")

(define-test file-separator
   (file-separator)
   :expected char?)

(define-test path-separator
   (file-separator)
   :expected char?)

(define-test basename
   (basename "foo")
   :expected "foo")
(define-test basename
   (basename (make-file-name "foo" "bar"))
   :expected "bar")
(define-test basename
   (basename (make-file-path "foo" "bar" "gee"))
   :expected "gee")

(define-test prefix
   (prefix "foo.scm") 
   :expected  "foo")
(define-test prefix
   (prefix "./foo.scm") 
   :expected  "./foo")
(define-test prefix
   (prefix "foo.tar.gz") 
   :expected  "foo.tar")
(define-test prefix
   (prefix "foo.scm")
   :expected "foo")
(define-test prefix
   (prefix (make-file-name "bar" "foo.scm"))
   :expected 
   (make-file-name "bar" "foo"))

(define-test suffix
   (suffix "foo.scm") 
   :expected  "scm")
(define-test suffix
   (suffix "./foo.scm") 
   :expected  "scm")
(define-test suffix
   (suffix "foo.tar.gz") 
   :expected  "gz")
(define-test suffix
   (suffix "foo.scm")
   :expected "scm")
(define-test suffix
   (suffix (make-file-name "bar" "foo.scm"))
   :expected "scm")

(define-test dirname
   (dirname "abc/def/ghi") 
   :expected  "abc/def")
(define-test dirname
   (dirname "abc") 
   :expected   ".")
(define-test dirname
   (dirname "abc/") 
   :expected  "abc")
(define-test dirname
   (dirname "/abc") 
   :expected  "/")
 (define-test dirname
    (dirname "foo")
    :expected ".")
(define-test dirname
   (dirname "")
   :expected ".")
(define-test dirname
   (dirname (make-file-name "foo" "bar"))
   :expected "foo")
(define-test dirname
   (dirname (make-file-path "foo" "bar" "gee"))
   :expected (make-file-name "foo" "bar"))

(define-test file-name-absolute?
   (file-name-absolute? "foo/bar")
   :expected #f)

(define-test file-name-absolute?
   (file-name-absolute? "/tmp/foo/bar")
   :expected #t)

(define-test make-file-name
   (make-file-name "foo" "bar")
   :expected (format "foo~abar" (file-separator)))

(define-test make-file-path
   (make-file-path "foo" "bar" "gee")
   :expected (format "foo~abar~agee" (file-separator) (file-separator)))

(define-test file-name->list
   (file-name->list "/etc/passwd")
   :expected '("" "etc" "passwd"))

(define-test file-name->list
   (file-name->list "etc/passwd")
   :expected '("etc" "passwd"))

(define-test unix-path->list
   (unix-path->list ".")
   :expected '("."))

(define-test unix-path->list
   (unix-path->list ".:/usr/bin")
   :expected '("." "/usr/bin"))

(define-test file-name-canonicalize
   (file-name-canonicalize "/etc/passwd")
   :expected "/etc/passwd")
(define-test file-name-canonicalize
   (file-name-canonicalize "/etc/../tmp/passwd")
   :expected "/tmp/passwd")
(define-test file-name-canonicalize
   (file-name-canonicalize "")
   :expected "")
(define-test file-name-canonicalize
   (file-name-canonicalize "~/passwd")
   :expected "~/passwd")
(define-test file-name-canonicalize!
   (file-name-canonicalize "/etc/../tmp/passwd")
   :expected "/tmp/passwd")

(define-test file-name-unix-canonicalize
   (file-name-unix-canonicalize "~/passwd")
   :expected (make-file-name (getenv "HOME") "passwd"))
(define-test file-name-unix-canonicalize
   (file-name-unix-canonicalize "~foo/passwd")
   :expected (make-file-name (dirname (getenv "HOME")) "foo/passwd"))
(define-test file-name-unix-canonicalize!
   (file-name-unix-canonicalize "/foo/passwd")
   :expected "/foo/passwd")
(define-test file-name-unix-canonicalize!
   (file-name-unix-canonicalize "/")
   :expected "/")

(define-test file-name-canonicalize
   (file-name-canonicalize (fname "/tmp/bin"))
   :expected (fname "/tmp/bin"))

(define-test file-name-canonicalize
   (file-name-canonicalize! (fname "/tmp/bin"))
   :expected (fname "/tmp/bin"))

(define-test file-name-canonicalize
   (file-name-canonicalize (fname "/tmp/bin/"))
   :expected (fname "/tmp/bin/"))
(define-test file-name-canonicalize
   (file-name-canonicalize! (string-copy (fname "/tmp/bin/")))
   :expected (fname "/tmp/bin/"))
(define-test file-name-canonicalize
   (file-name-canonicalize (fname "/tmp//bin/"))
   :expected (fname "/tmp/bin/"))
(define-test file-name-canonicalize!
   (let ((s (fname "/tmp//bin/")))
      (file-name-canonicalize! (string-copy s)))
   :expected (fname "/tmp/bin/"))
(define-test file-name-canonicalize
   (file-name-canonicalize (fname "/tmp/../bin/"))
   :expected (fname "/bin/"))
(define-test file-name-canonicalize!
   (let ((s (fname "/tmp/../bin/")))
      (file-name-canonicalize! (string-copy (fname "/tmp/../bin/"))))
   :expected (fname "/bin/"))
(define-test file-name-canonicalize
   (file-name-canonicalize (fname "/tmp/abc/../../bin/"))
   :expected (fname "/bin/"))
(define-test file-name-canonicalize!
   (let ((s (fname "/tmp/../bin/")))
      (file-name-canonicalize! (string-copy (fname "/tmp/abc/../../bin/"))))
      :expected (fname "/bin/"))
(define-test file-name-canonicalize
   (file-name-canonicalize (fname "/foo/bar/."))
   :expected (fname "/foo/bar"))
(define-test file-name-canonicalize
   (file-name-canonicalize (fname "/../foo/bar"))
   :expected (fname "/foo/bar"))
(define-test file-name-canonicalize
   (file-name-canonicalize (fname "/foo/./bar"))
   :expected (fname "/foo/bar"))
(define-test file-name-canonicalize
   (file-name-canonicalize (fname "/foo/././bar"))
   :expected (fname "/foo/bar"))
(define-test file-name-canonicalize
   (file-name-canonicalize (fname "/foo/././////bar"))
   :expected (fname "/foo/bar"))
(define-test file-name-canonicalize
   (file-name-canonicalize (fname "/foo/././////../bar"))
   :expected (fname "/bar"))
(define-test file-name-canonicalize
   (file-name-canonicalize (fname "/foo/././////../////.//bar"))
   :expected (fname "/bar"))
(define-test file-name-canonicalize
   (file-name-canonicalize (fname "/foo/././////../////.//bar/./././."))
   :expected (fname "/bar"))
(define-test file-name-canonicalize
   (file-name-canonicalize (fname "/foo/bar/.."))
   :expected (fname "/foo"))
(define-test file-name-canonicalize
   (file-name-canonicalize (fname "/.."))
   :expected (fname "/"))
(define-test file-name-canonicalize
   (file-name-canonicalize (fname "/foo/.bar/gee"))
   :expected (fname "/foo/.bar/gee"))
(define-test file-name-canonicalize
   (file-name-canonicalize (fname "./foo"))
   :expected (fname "foo"))
(define-test file-name-canonicalize
   (file-name-canonicalize (fname "."))
   :expected (fname "."))
(define-test file-name-canonicalize
   (file-name-canonicalize "")
   :expected "")
(define-test file-name-canonicalize
   (file-name-canonicalize ".")
   :expected ".")
(define-test file-name-unix-canonicalize
   (file-name-unix-canonicalize "./")
   :expected ".")
(define-test file-name-unix-canonicalize
   (file-name-unix-canonicalize ".//")
   :expected "")
(define-test file-name-unix-canonicalize
   (file-name-unix-canonicalize "././")
   :expected ".")
(define-test file-name-unix-canonicalize
   (file-name-unix-canonicalize ".//a")
   :expected "a")
(define-test file-name-unix-canonicalize
   (file-name-unix-canonicalize "test/..")
   :expected "")
(define-test file-name-unix-canonicalize
   (file-name-unix-canonicalize "./test/..")
   :expected "")
(define-test file-name-unix-canonicalize
   (file-name-unix-canonicalize "../test/bar/..")
   :expected "../test")
(define-test file-name-unix-canonicalize
   (file-name-unix-canonicalize "../test/foo")
   :expected "../test/foo")
(define-test file-name-unix-canonicalize
   (file-name-unix-canonicalize "../../test/foo")
   :expected "../../test/foo")
(define-test file-name-unix-canonicalize
   (file-name-unix-canonicalize "..test/foo")
   :expected "..test/foo")

(define-test relative-file-name
   (relative-file-name "/etc/passwd" "/etc")
   :expected "passwd")

(define-test find-file/path
   (find-file/path "/etc/passwd" '("/toto" "/titi")) 
   :expected  "/etc/passwd")
(define-test find-file/path
   (find-file/path "passwd" '("/toto" "/etc"))
   :expected  "/etc/passwd")
(define-test find-file/path
   (find-file/path "pass-wd" '("." "/etc"))
   :expected  #f)

(define-test signal
   (begin (signal sigint 'default) #t)
   :cond-expand C)

(define-test get-signal-handler
   (get-signal-handler sigint)
   :cond-expand C
   :expected 'default)

(define-test sigsetmask
   (sigsetmask 0)
   :cond-expand C
   :expected 0)
   
(define-test system
   (system "true > /dev/null")
   :cond-expand (or C wasm)
   :expected 0)

(define-test system->string
   (system->string "echo \"hello\"")
   :cond-expand C
   :expected "hello\n")

(define-test os-class (os-class)
   :expected string?)

(define-test os-name
   (os-name)
   :expected string?)

(define-test os-version
   (os-version)
   :expected string?)

(define-test os-tmp
   (os-tmp)
   :expected string?)

(define-test os-charset
   (os-charset)
   :expected string?)

(define-test os-arch
   (os-arch)
   :expected string?)

(define-test getuid
   (>=fx (getuid) 0)
   :cond-expand C)

(define-test setuid
   setuid
   :cond-expand C
   :expected procedure?)

(define-test getgid
   (>=fx (getgid) 0)
   :cond-expand C)

(define-test setgid
   setgid
   :cond-expand C
   :expected procedure?)

(define-test getpid
   (>=fx (getpid) 0)
   :cond-expand C)

(define-test getppid
   (>=fx (getppid) 0)
   :cond-expand C)

(define-test getgroups
   (getgroups)
   :cond-expand C
   :expected vector?)

(define-test getpwnam
   (getpwnam (getenv "USER"))
   :cond-expand C
   :expected pair?)

(define-test getpwuid
   (getpwuid (getuid))
   :cond-expand C
   :expected pair?)

(define-test getrlimit
   (multiple-value-bind (soft hard)
      (getrlimit 'NOFILE)
      (and (elong? soft) (elong? hard)))
   :cond-expand C)

(define-test getrlimit
   (cond-expand
      (rlimit 'supported)
      (else 'unsupported))
   :cond-expand C
   :expected 'supported)

(define-test getrlimit
   (cond-expand
      (rlimit 'supported)
      (else 'unsupported))
   :cond-expand (not C)
   :expected 'unsupported)

(define-test setrlimit!
   (begin (setrlimit! 'NOFILE #e256 #e1048576) #t)
   :cond-expand C)

(define-test openlog
   (openlog "/dev/null"
      (syslog-option 'LOG_PID 'LOG_ODELAY)
      (syslog-facility 'LOG_MAIL))
   :cond-expand C
   :expected #unspecified)

(define-test syslog
   (begin
      (openlog "/dev/null"
         (syslog-option 'LOG_PID 'LOG_ODELAY)
         (syslog-facility 'LOG_MAIL))
      (syslog (syslog-level 'LOG_INFO) "this is a log message"))
   :cond-expand C
   :expected #unspecified)

(define-test syslog-option
   (openlog "/dev/null"
      (syslog-option 'LOG_PID 'LOG_CONS)
      (syslog-facility 'LOG_MAIL))
   :cond-expand C
   :expected #unspecified)
   
(define-test syslog-level
   (begin
      (openlog "/dev/null"
         (syslog-option 'LOG_PID 'LOG_ODELAY)
         (syslog-facility 'LOG_MAIL))
      (syslog (syslog-level 'LOG_DEBUG) "this is a log message"))
   :cond-expand C
   :expected #unspecified)

(define-test syslog-facility
   (openlog "/dev/null"
      (syslog-option 'LOG_PID 'LOG_CONS)
      (syslog-facility 'LOG_CRON))
   :cond-expand C
   :expected #unspecified)

(define-test closelog
   (closelog)
   :cond-expand C
   :expected #unspecified)



