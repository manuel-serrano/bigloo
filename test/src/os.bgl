(define-test getrlimit
   (multiple-value-bind (soft hard)
      (getrlimit 'NOFILE)
      (and (elong? soft) (elong? hard)))
   :cond-expand C)

(define-test getrlimit
   (cond-expand
      (rlimit 'supported)
      (else 'unsupported))
   :cond-expand C
   :expected 'supported)

(define-test getrlimit
   (cond-expand
      (rlimit 'supported)
      (else 'unsupported))
   :cond-expand (not C)
   :expected 'unsupported)

(define-test setrlimit!
   (begin (setrlimit! 'NOFILE #e256 #e1048576) #t)
   :cond-expand C)

(define-test openlog
   (openlog "/dev/null"
      (syslog-option 'LOG_PID 'LOG_ODELAY)
      (syslog-facility 'LOG_MAIL))
   :cond-expand C
