;*---------------------------------------------------------------------*/
;*    dates                                                            */
;*---------------------------------------------------------------------*/
(module dates
   (export test))

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "./test.bgh")

;*---------------------------------------------------------------------*/
;*    test ...                                                         */
;*---------------------------------------------------------------------*/
(define (test verbose tests::pair-nil)
   (when (or (null? tests) (member "date" tests))
      (test-all verbose "date")))

;*---------------------------------------------------------------------*/
;*    tests                                                            */
;*---------------------------------------------------------------------*/
(define-test date? (date? (pwd))
   :expected #f)
(define-test date? (date? (current-date))
   :expected #t)
(define-test date? (date? (seconds->date (current-seconds)))
   :expected #t)

(define-test make-date
   (date? (make-date :sec 1 :min 1 :hour 1 :day 19 :month 2 :year 2000))
   :expected #t)
(define-test make-date
   (date-year (make-date :sec 1 :min 1 :hour 1 :day 19 :month 2 :year 2000))
   :expected 2000)
(define-test date-copy
   (let* ((d1 (make-date :year 2000))
          (d2 (date-copy d1)))
      (equal? d1 d2))
   :expected #t)
(define-test date-copy
   (let* ((d1 (make-date :year 2001))
          (d2 (date-copy d1 :year 2002)))
      (= (- (date->seconds d2) (date->seconds d1))
         (* 365 24 60 60)))
   :expected #t)

(define-test date-update!
   (let ((d (make-date :month 2 :year 2001)))
      (date-update! d :month 3)
      (date-month d))
   :expected 3)

(define-test date->gmtdate!
   (date? (date->gmtdate! (make-date :hour 1 :year 2001)))
   :cond-expand bigloo-c
   :expected #t)
   
(define-test current-date (>= (date-year (current-date)) 1970)
   :expected #t)

(define-test date
   (> (string-length (date)) 0)
   :expected #t)

(define-test current-seconds (>=elong (current-seconds) #e0)
   :expected #t)

(define-test current-microseconds (>=llong (current-microseconds) #l0)
   :expected #t)

(define-test current-milliseconds (>=llong (current-milliseconds) #l0)
   :expected #t)

(define-test current-nanoseconds (>=llong (current-nanoseconds) #l0)
   :expected #t)

(define-test seconds->date
   (let* ((s1 (current-seconds))
	  (d1 (seconds->date s1)))
      (= (date->seconds d1) s1))
   :expected #t)
(define-test seconds->date
   (let* ((d1 (current-date))
	  (s1 (date->seconds d1)))
      (equal? (seconds->date s1) d1)))

(define-test milliseconds->date
   (let* ((d1 (current-date))
	  (s1 (date->milliseconds d1)))
      (equal? (milliseconds->date s1) d1)))

(define-test nanoseconds->date
   (let* ((d1 (current-date))
	  (s1 (date->nanoseconds d1)))
      (equal? (nanoseconds->date s1) d1)))

(define-test seconds->gmtdate
   (let* ((d1 (date->gmtdate! (current-date)))
	  (s1 (date->seconds d1)))
      (equal? (seconds->gmtdate s1) d1))
   :cond-expand bigloo-c
   :expected #t)

(define-test milliseconds->gmtdate
   (let* ((d1 (date->gmtdate! (current-date)))
	  (s1 (date->milliseconds d1)))
      (equal? (milliseconds->gmtdate s1) d1))
   :cond-expand bigloo-c
   :expected #t)

(define-test date->seconds (>elong (date->seconds (current-date)) #e0)
   :expected #t)
(define-test date->nanoseconds (>llong (date->nanoseconds (current-date)) #l0)
   :expected #t)
(define-test date->milliseconds (>llong (date->milliseconds (current-date)) #l0)
   :expected #t)

(define-test date->string (string? (date->string (current-date)))
   :expected #t)
(define-test date-day
   (date-day (make-date :sec 1 :min 1 :hour 1
                :day 19 :month 2 :year 2000))
   :expected 19)
(define-test date-day
   (date-day (make-date :sec 1 :min 1 :hour 1
                :day 31 :month 5 :year 1999))
   :expected 31)
(define-test date-day
   (date-day
      (seconds->date
         (date->seconds (make-date :sec 1 :min 1 :hour 1 :day 28))))
   :expected 28)
(define-test date-day
   (date-month
      (seconds->date
         (date->seconds (make-date :sec 1 :min 1 :hour 1
                           :day 30 :month 5 :year 1998))))
   :expected 5)
(define-test date-day
   (date-day
      (seconds->date
         (date->seconds (make-date :sec 1 :min 1 :hour 1
                           :day 31 :month 5 :year 1971))))
   :expected 31)
(define-test date-week-day
   (date-week-day (make-date :sec 1 :min 1 :hour 1
                     :day 2 :month 2 :year 2003))
   :expected 1)
(define-test date-week-day
   (date-week-day (make-date :sec 1 :min 1 :hour 1
                     :day 3 :month 2 :year 2003))
   :expected 2)
(define-test date-week-day
   (date-week-day (make-date :sec 1 :min 1 :hour 1
                     :day 4 :month 2 :year 2003))
   :expected 3)
(define-test date-week-day
   (date-week-day (make-date :sec 1 :min 1 :hour 1
                     :day 5 :month  2 :year 2003))
   :expected 4)
(define-test date-week-day
   (date-week-day (make-date :sec 1 :min 1 :hour 1
                     :day 6 :month  2 :year 2003))
   :expected 5)
(define-test date-week-day
   (date-week-day (make-date :sec 1 :min 1 :hour 1
                     :day 7 :month  2 :year 2003))
   :expected 6)
(define-test date-week-day
   (date-week-day (make-date :sec 1 :min 1 :hour 1
                     :day 8 :month  2 :year 2003))
   :expected 7)
(define-test date-month
   (date-month (make-date :sec 1 :min 1 :hour 1
                  :day 17 :month  5 :year 1980))
   :expected 5)
(define-test date-year
   (date-year (make-date :sec 1 :min 1 :hour 1
                 :day 17 :month  5 :year 1981))
   :expected 1981)
(define-test leap-year? (leap-year? 1966)
   :expected #f)
(define-test leap-year? (leap-year? 1968)
   :expected #t)
(define-test leap-year? (leap-year? 2000)
   :expected #t)
(define-test leap-year? (leap-year? 2100)
   :expected #f)
(define-test date-hour
   (date-hour (make-date :sec 0 :min 0 :hour 14
                 :day 6 :month 1 :year 2003))
   :expected 14)
(define-test date-hour
   (date-hour (make-date :sec 0 :min 0 :hour 14
                 :day 6 :month 7 :year 2003))
   :expected 14)
(define-test date-hour
   (date-hour (make-date :sec 0 :min 0 :hour 14
                 :day 6 :month 7 :year 2003))
   :expected 14)
(define-test date-hour
   (date-hour (make-date :sec 0 :min 0 :hour 23
                 :day 6 :month 7 :year 2003))
   :expected 23)
(define-test date-day
   (date-day (make-date :sec 0 :min 30 :hour 23
                :day 6 :month 7 :year 2003))
   :expected 6)

(define-test date->seconds
   (let ((d1 (date->seconds (make-date :min 30 :hour 23 :year 2003))))
      (= (date->seconds (seconds->date d1)) d1))
   :expected #t)
(define-test data->seconds
   (let ((d1 (date->seconds (make-date :day 6 :month 1 :year 2003))))
      (= (date->seconds (seconds->date d1)) d1))
   :expected #t)

(define-test date-day
   (date-day
      (seconds->date
         (+elong
            (date->seconds (make-date :sec 1 :min 1 :hour 1
                              :day 16 :month  5 :year 1996))
            (day-seconds))))
   :expected 17)
(define-test date-month
   (date-month
      (seconds->date
         (+elong
            (date->seconds (make-date :sec 1 :min 1 :hour 1
                              :day 31 :month  5 :year 1996))
            (day-seconds))))
   :expected 6)
(define-test date-day
   (date-day
      (seconds->date
         (+elong
            (date->seconds (make-date :sec 1 :min 1 :hour 1
                              :day 31 :month  5 :year 1996))
            (day-seconds))))
   :expected 1)
(define-test date-day
   (date-day
      (seconds->date
         (+elong
            (date->seconds (make-date :sec 1 :min 1 :hour 1
                              :day 17 :month  5 :year 1996))
            (*elong #e31 (day-seconds)))))
   :expected 17)
(define-test date-month
   (date-month
      (seconds->date
         (+elong
            (date->seconds (make-date :sec 1 :min 1 :hour 1
                              :day 17 :month  5 :year 1996))
            (*elong #e31 (day-seconds)))))
   :expected 6)
(define-test date-day
   (date-day
      (seconds->date
         (+elong
            (date->seconds (make-date :sec 1 :min 1 :hour 1
                              :day 31 :month  5 :year 1996))
            #e0)))
   :expected 31)
(define-test date-day
   (date-day
      (seconds->date
         (-elong
            (date->seconds
               (make-date :sec 1 :min 1 :hour 1
                  :day 18 :month  5 :year 1996))
            (day-seconds))))
   :expected 17)
(define-test date->seconds
   (=elong (date->seconds
              (make-date :sec 1 :day 20 :month 6 :year 1996))
      (date->seconds
         (make-date :sec 1 :day 20 :month 6 :year 1996)))
   :expected #t)
(define-test date->seconds
   (=elong (date->seconds
              (make-date :sec 1 :day 20 :month 6 :year 1996))
      (date->seconds
         (make-date :sec 1 :day 19 :month 6 :year 1996)))
   :expected #f)
(define-test date->seconds
   (<elong (date->seconds
              (make-date :day 18 :month 6 :year 1996))
      (date->seconds
         (make-date :day 19 :month 6 :year 1996)))
   :expected #t)
(define-test date->seconds
   (<elong (date->seconds
              (make-date :sec 1 :min 1 :hour 1
                 :day 20 :month 6 :year 1996))
      (date->seconds
         (make-date :sec 1 :min 1 :hour 1
            :day 19 :month 6 :year 1996)))
   :expected #f)
(define-test dae->seconds
   (<=elong (date->seconds
               (make-date :sec 1 :min 1 :hour 1 :year 1996))
      (date->seconds
         (make-date :sec 1 :min 1 :hour 1 :year 1996)))
   :expected #t)
(define-test date->seconds
   (<=elong (date->seconds
               (make-date :sec 1 :month 6 :year 1996))
      (date->seconds
         (make-date :sec 1 :month 6 :year 1996)))
   :expected #t)
(define-test date->seconds
   (<elong (date->seconds
              (make-date :sec 1 :min 1 :hour 1
                 :day 20 :month 6 :year 1996))
      (date->seconds
         (make-date :sec 1 :min 1 :hour 1
            :day 19 :month 6 :year 1996)))
   :expected #f)
(define-test date->seconds
   (>elong (date->seconds
              (make-date :sec 1 :min 1 :hour 1
                 :day 18 :month 6 :year 1996))
      (date->seconds
         (make-date :sec 1 :min 1 :hour 1
            :day 19 :month 6 :year 1996)))
   :expected #f)
(define-test date->seconds
   (>elong (date->seconds
              (make-date :sec 1 :min 1 :hour 1
                 :day 20 :month 6 :year 1996))
      (date->seconds
         (make-date :sec 1 :min 1 :hour 1
            :day 19 :month 6 :year 1996)))
   :expected #t)
(define-test date->seconds
   (>=elong (date->seconds
               (make-date :sec 1 :min 1 :hour 1
                  :day 18 :month 6 :year 1996))
      (date->seconds
         (make-date :sec 1 :min 1 :hour 1
            :day 19 :month 6 :year 1996)))
   :expected #f)
(define-test date->seconds
   (>=elong (date->seconds
               (make-date :sec 1 :min 1 :hour 1
                  :day 18 :month 6 :year 1996))
      (date->seconds
         (make-date :sec 1 :min 1 :hour 1
            :day 18 :month 6 :year 1996)))
   :expected #t)
(define-test date->seconds
   (>elong (date->seconds
              (make-date :sec 1 :min 1 :hour 1
                 :day 20 :month 6 :year 1996))
      (date->seconds
         (make-date :sec 1 :min 1 :hour 1
            :day 19 :month 6 :year 1996)))
   :expected #t)

(define-test date->utc-string (string? (date->utc-string (current-date)))
   :expected #t)

(define-test rfc2822-date->date
   (rfc2822-date->date "Wed, 22 Oct 2008 17:04:22 +0200")
   :expected
   (make-date :year 2008 :month 10 :day 22
      :hour 17 :min 04 :sec 22 :timezone 7200))

(define-test nanoseconds
      (let* ((nsec (current-nanoseconds))
	     (usec (/llong nsec #l1000))
	     (sec (/llong usec #l1000000)))
	 (=llong sec (/llong nsec (*llong #l1000000 #l1000))))
      :expected #t)
(define-test nanoseconds
   (let* ((sec (current-seconds))
          (d (nanoseconds->date
                (+llong (*llong (elong->llong sec) #l1000000000) #l1))))
      (=llong (date-nanosecond d) #l1))
   :expected #t)
(define-test nanoseconds
      (let* ((d (make-date :year 2000 :sec 14 :nsec #l23)))
	 (and (=llong (date-nanosecond d) #l23)
	      (=fx (date-second d) 14)))
      :expected #t)
(define-test nanoseconds (date? (nanoseconds->date (current-nanoseconds)))
   :expected #t)
(define-test nanoseconds
   (let* ((s1 (current-nanoseconds))
	  (d1 (nanoseconds->date s1)))
      (= (date->nanoseconds d1) s1)
      :expected #t))

(define-test nanoseconds
   (let* ((d1 (current-date))
	  (s1 (date->nanoseconds d1)))
      (equal? (nanoseconds->date s1) d1))
   :expected #t)

(define-test seconds->string
   (seconds->string #e0)
   :expected "Thu Jan  1 01:00:00 1970")

(define-test seconds->utc-string
   (seconds->string #e1)
   :expected "Thu Jan  1 01:00:01 1970")

(define-test date-second
   (date-second (make-date))
   :expected 0)

(define-test date-second
   (date-second (make-date :sec 10 :hour 2 :min 3))
   :expected 10)

(define-test date-minute
   (date-second (make-date))
   :expected 0)

(define-test date-minute
   (date-minute (make-date :sec 10 :hour 2 :min 3))
   :expected 3)

(define-test date-millisecond
   (date-millisecond (make-date))
   :expected 0)

(define-test date-millisecond
   (date-millisecond (make-date :nsec #l100000000 :hour 2 :min 3))
   :expected 100)

(define-test date-nanosecond
   (date-nanosecond (make-date))
   :expected 0)

(define-test date-nanosecond
   (date-nanosecond (make-date :nsec #l10 :hour 2 :min 3))
   :expected #l10)

(define-test date-year-day
   (date-year-day (make-date))
   :expected 1)

(define-test date-year-day
   (date-year-day (make-date :sec 10 :hour 2 :day 1 :month 2))
   :expected 32)

(define-test date-timezone
   (date-timezone (make-date :timezone 0))
   :expected 0)

(define-test date-timezone
   (date-timezone (make-date :sec 10 :hour 2 :day 1 :month 2 :timezone 3600))
   :expected 3600)

(define-test date-is-dst
   (date-is-dst (make-date :sec 10 :hour 2 :day 1 :month 8 :year 2020))
   :expected 1)

(define-test date-is-dst
   (date-is-dst (make-date :sec 10 :hour 2 :day 1 :month 2 :year 2020))
   :expected 0)

(define-test integer->second
   (typeof (integer->second 39483))
   :expected "elong")

(define-test day-seconds
   (day-seconds)
   :expected (* 24 60 60))

(define-test day-name
   (day-name 1)
   :expected "Sunday")

(define-test day-aname
   (day-aname 3)
   :expected "Tue")

(define-test month-name
   (month-name 1)
   :expected "January")

(define-test month-aname
   (month-aname 3)
   :expected "Mar")

(define-test date-month-length
   (date-month-length (make-date :year 2001 :month 2))
   :expected 28)

(define-test date-month-length
   (date-month-length (make-date :year 2004 :month 2))
   :expected 29)

(define-test date->rfc2822-date
   (date->rfc2822-date (make-date :month 3 :day 5 :year 2020 :timezone 0))
   :expected "Thu, 5 Mar 2020 00:00:00 GMT")

(define-test rfc2822-parse-date
   (let ((d (current-date)))
      (call-with-input-string (date->rfc2822-date d)
         (lambda (ip)
            (equal? d (rfc2822-parse-date ip)))))
   :expected #t)

(define-test iso8601-date->date
   (iso8601-date->date "1981-03-01T10:00:00Z")
   :expected (make-date :hour 10 :timezone 0 :year 1981 :month 3))

(define-test date->iso8601-date
   (date->iso8601-date (make-date :month 3 :day 5 :year 2015 :timezone 0))
   :expected "2015-03-05T00:00:00Z")

(define-test iso8601-parse-date
   (let ((d (current-date)))
      (call-with-input-string (date->iso8601-date d)
         (lambda (ip) (equal? d (iso8601-parse-date ip)))))
   :expected #t)



