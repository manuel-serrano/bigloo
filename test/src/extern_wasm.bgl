;*---------------------------------------------------------------------*/
;*    extern_wasm                                                      */
;*---------------------------------------------------------------------*/
(module extern_wasm
   (export test))

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "./test.bgh")

;*---------------------------------------------------------------------*/
;*    test ...                                                         */
;*---------------------------------------------------------------------*/
(define (test verbose tests::pair-nil)
   (when (or (null? tests) (member "ssl" tests))
      (test-all verbose "ssl")))

   
