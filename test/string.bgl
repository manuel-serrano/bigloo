(define-test string-prefix-length (string-prefix-length "abcde" "abcdef")
   :expected 5)
(define-test string-prefix-length (string-prefix-length "0abcde" "abcdef" 1)
   :expected 5)
(define-test string-prefix-length (string-prefix-length "0abcde" "abcdef" 1 3)
   :expected 2)
(define-test string-prefix-length (string-prefix-length "0abcde" "aabcdef" 1 3 1)
   :expected 2)
(define-test string-prefix-length (string-prefix-length "0abcde" "aabcdef" 1 4 1 3)
   :expected 2)
(define-test string-suffix-length (string-suffix-length "abcde" "fabcde")
   :expected 5)
(define-test string-suffix-length (string-suffix-length "0abcde" "fabcde" 1)
   :expected 5)
(define-test string-suffix-length (string-suffix-length "0cdef" "fabcde" 1 4)
   :expected 3)
(define-test string-suffix-length (string-suffix-length "0cdef" "aabcde" 1 4 1)
   :expected 3)
(define-test string-suffix-length (string-suffix-length "0abcde" "aaabcde" 1 3 2 4)
   :expected 2)
(define-test string-suffix-length (string-suffix-length "ab" "-")
   :expected 0)

(define-test string-suffix-length-ci (string-suffix-length-ci "Abcde" "fabcde")
   :expected 5)
(define-test string-prefix-length-ci (string-prefix-length-ci "AbCde" "abcdef")
   :expected 5)
(define-test string-prefix-length-ci (string-prefix-length-ci "0ABCDE" "abcdef" 1)
   :expected 5)

(define-test string-prefix? (string-prefix? "abc" "abcde")
   :expected #t)
(define-test string-prefix? (string-prefix? "abcf" "abcde")
   :expected #f)
(define-test string-prefix? (string-prefix? "0abc" "abcde" 1)
   :expected #t)
(define-test string-suffix? (string-suffix? "0CDE" "abcde" 1)
   :expected #f)
(define-test string-prefix? (string-prefix? "0Abc" "abcde" 1)
   :expected #f)
(define-test string-prefix? (string-prefix? "0abcf" "abcde" 1 4)
   :expected #t)
(define-test string-prefix? (string-prefix? "0abcf" "abcde" 1 5)
   :expected #f)
(define-test string-prefix? (string-prefix? "0abcf" "0abcde" 1 4 1)
   :expected #t)
(define-test string-prefix? (string-prefix? "0abcf" "0abcde" 1 4 2)
   :expected #f)
(define-test string-prefix? (string-prefix? "0abcf" "00abcde" 1 4 2 5)
   :expected #t)
(define-test string-prefix? (string-prefix? "0abcf" "0abcde" 1 4 2 2)
   :expected #f)

(define-test string-prefix-ci? (string-prefix-ci? "abc" "ABCDE")
   :expected #t)
(define-test string-prefix-ci? (string-prefix-ci? "abcf" "ABCDE")
   :expected #f)
(define-test string-prefix-ci? (string-prefix-ci? "0abc" "ABCDE" 1)
   :expected #t)

(define-test string-suffix? (string-suffix? "cde" "abcde")
   :expected #t)
(define-test string-suffix? (string-suffix? "cdef" "abcde")
   :expected #f)
(define-test string-suffix? (string-suffix? "0cde" "abcde" 1)
   :expected #t)
(define-test string-suffix? (string-suffix? "0cdf" "abcde" 1)
   :expected #f)
(define-test string-suffix? (string-suffix? "0cdef" "abcde" 1 4)
   :expected #t)
(define-test string-suffix? (string-suffix? "0abcf" "abcde" 1 5)
   :expected #f)
(define-test string-suffix? (string-suffix? "0cdef" "0abcde" 1 4 1)
   :expected #t)
(define-test string-suffix? (string-suffix? "0abcf" "0abcde" 1 4 2)
   :expected #f)
(define-test string-suffix? (string-suffix? "0cdef" "0abcde" 1 4 2 6)
   :expected #t)
(define-test string-suffix? (string-suffix? "0abcf" "0abcde" 1 4 2 2)
   :expected #f)
(define-test string-suffix? (string-suffix? "-" "ab")
   :expected #f)

(define-test string-suffix-ci? (string-suffix-ci? "CDE" "abcde")
   :expected #t)
(define-test string-suffix-ci? (string-suffix-ci? "cdef" "ABCDE")
   :expected #f)
(define-test string-suffix-ci? (string-suffix-ci? "0CDE" "abcde" 1)
   :expected #t)

(define-test string-char-index (string-char-index "foobar-gee" #\-)
   :expected 6)
(define-test string-char-index (string-char-index "foobar-gee" #\o 2)
   :expected 2)
(define-test string-char-index (string-char-index "foobar-gee" #\e 1 4)
   :expected #f)

(define-test string-index (string-index "foobar-gee" #\-)
   :expected 6)
(define-test string-index (string-index "foobar-gee" "-")
   :expected 6)
(define-test string-index (string-index "foobar-gee" "-g")
   :expected 6)
(define-test string-index (string-index "foobar-gee" "-r")
   :expected 5)
(define-test string-index (string-index "foobar-gee" "r-")
   :expected 5)
(define-test string-index (string-index "foobar-ge-e" "-")
   :expected 6)
(define-test string-index (string-index "foobar-ge-e" "-" 7)
   :expected 9)
(define-test string-index (string-index "foobar-ge-e" "_")
   :expected #f)
(define-test string-index (string-index "foobar-ge-e" "_" 7)
   :expected #f)

(define-test string-index-right (string-index-right "foobar-gee" "-")
   :expected 6)
(define-test string-index-right (string-index-right "foobar-ge-e" "-")
   :expected 9)
(define-test string-index-right (string-index-right "foobar-ge-e" "-" 7)
   :expected 6)

(define-test string-index-right (string-index-right "foobar-ge-e" "_")
   :expected #f)
(define-test string-index-right (string-index-right "foobar-ge-e" "_" 7)
   :expected #f)
(define-test string-index-right (string-index-right "true" #\t 1)
   :expected 0)
(define-test string-index-right (string-index-right "true" #\t 0)
   :expected #f)

(define-test string-skip (string-skip "foobar-gee" #\f)
   :expected 1)
(define-test string-skip (string-skip "foobar-gee" "f")
   :expected 1)
(define-test string-skip (string-skip "foobar-gee" "fo")
   :expected 3)
(define-test string-skip (string-skip "foobar-gee" "fofofofofofofofofofo")
   :expected 3)
(define-test string-skip (string-skip "foobar-gee" "of")
   :expected 3)
(define-test string-skip (string-skip "foobar-gee" "ofofofofofofofofof")
   :expected 3)
(define-test string-skip (string-skip "foobar-ge-e" "_")
   :expected 0)
(define-test string-skip (string-skip "foobar-ge-e" "_" 7)
   :expected 7)
(define-test string-skip (string-skip "foobar-gee" "fobar-ge")
   :expected #f)
(define-test string-skip (string-skip "1023:00" "0123456789")
   :expected 4)
(define-test string-skip (string-skip "1023:00" "+-")
   :expected 0)
(define-test string-skip (string-skip "1023:00" "0123456789abklmnopqrstu")
   :expected 4)

(define-test string-skip-right (string-skip-right "foobar-gee" #\e)
   :expected 7)
(define-test string-skip-right (string-skip-right "foobar-gee" "e")
   :expected 7)
(define-test string-skip-right (string-skip-right "foobar-gee" "ge")
   :expected 6)
(define-test string-skip-right (string-skip-right "foobar-gee" "gegegegegegegegegege")
   :expected 6)
(define-test string-skip-right (string-skip-right "foobar-gee" "eg")
   :expected 6)
(define-test string-skip-right (string-skip-right "foobar-gee" "egegegegegegegegeg")
   :expected 6)
(define-test string-skip-right (string-skip-right "foobar-ge-e" "_")
   :expected 10)
(define-test string-skip-right (string-skip-right "foobar-ge-e" "_" 7)
   :expected 6)
(define-test string-skip-right (string-skip-right "foobar-gee" "fobar-ge")
   :expected #f)

(define-test string-natural-compare3 (string-natural-compare3 "foo" "foo")
   :expected 0)
(define-test string-natural-compare3 (string-natural-compare3 "foo0" "foo1")
   :expected -1)
(define-test string-natural-compare3 (string-natural-compare3 "foo1" "foo0")
   :expected 1)
(define-test string-natural<? (string-natural<? "rfc1.txt" "rfc822.txt")
   :expected #t)
(define-test string-natural<?b (string-natural<? "rfc822.txt" "rfc1.txt")
   :expected #f)
(define-test string-natural<? (string-natural<? "rfc1.txt" "rfc2086.txt")
   :expected #t)
(define-test string-natural<? (string-natural<? "rfc2086.txt" "rfc1.txt")
   :expected #f)
(define-test string-natural<? (string-natural<? "rfc822.txt" "rfc2086.txt")
   :expected #t)
(define-test string-natural<? (string-natural<? "rfc2086.txt" "rfc822.txt")
   :expected #f)

(define-test string-natural-compare3 (string-natural-compare3 "a0" "a1")
   :expected -1)
(define-test string-natural-compare3 (string-natural-compare3 "a1" "a1a")
   :expected -1)
(define-test string-natural-compare3 (string-natural-compare3 "a1a" "a1b")
   :expected -1)
(define-test string-natural-compare3 (string-natural-compare3 "a1b" "a2")
   :expected -1)
(define-test string-natural-compare3 (string-natural-compare3 "a2" "a10")
   :expected -1)
(define-test string-natural-compare3 (string-natural-compare3 "a10" "a20")
   :expected -1)
(define-test string-natural-compare3 (string-natural-compare3 "a2" "a20")
   :expected -1)

(define-test string-natural<? (string-natural<? "x2-g8" "x2-y7")
   :expected #t)
(define-test string-natural<? (string-natural<? "x2-y7" "x2-y08")
   :expected #f)
(define-test string-natural<? (string-natural<? "x2-y08" "x8-y8")
   :expected #t)
(define-test string-natural<? (string-natural<? "1.001" "1.002")
   :expected #t)
(define-test string-natural<? (string-natural<? "1.002" "1.010")
   :expected #t)
(define-test string-natural<? (string-natural<? "1.010"  "1.02")
   :expected #f)
(define-test string-natural<? (string-natural<? "1.02" "1.1")
   :expected #t)
(define-test string-natural<? (string-natural<? "1.1" "1.02")
   :expected #f)
(define-test string-natural<? (string-natural<? "1.02" "1.3")
   :expected #t)

(define-test string-natural-compare3-ci (string-natural-compare3-ci "foo" "foo")
   :expected 0)
(define-test string-natural-compare3-ci (string-natural-compare3-ci "foo" "Foo")
   :expected 0)
(define-test string-natural-compare3-ci (string-natural-compare3-ci "foo1" "foo0")
   :expected 1)
(define-test string-natural-compare3-ci (string-natural-compare3-ci "foo1" "FOO0")
   :expected 1)
(define-test string-natural-compare3-ci (string-natural-compare3-ci "FOO1" "foo0")
   :expected 1) substring

(define-test number->string (number->string 10)
   :expected "10")
(define-test number->string (number->string 10 16)
   :expected "a")
(define-test number->string (number->string 10 2)
   :expected "1010")

(define-test integer->string/padding (integer->string/padding 9 3)
   :expected "009")
(define-test integer->string/padding (integer->string/padding 19 3)
   :expected "019")
(define-test integer->string/padding (integer->string/padding 192 3)
   :expected "192")
(define-test integer->string/padding (integer->string/padding -9 3)
   :expected "-09")
(define-test integer->string/padding (integer->string/padding -19 3)
   :expected "-19")

(define-test string-contains (string-contains "foo bar" "bar")
   :expected 4)
(define-test string-contains (string-contains "foo bar" "bar" 1)
   :expected 4)
(define-test string-contains (string-contains "foo bar" "bar" 10)
   :expected #f)
(define-test string-contains (string-contains "foo bar" "bar" -1)
   :expected 4)

(define-test string-contains-ci (string-contains-ci "FOO BAR" "bar" 1)
   :expected 4)
(define-test string-contains-ci (string-contains-ci "FOO BAR" "bar" 1)
   :expected 4)
(define-test string-contains-ci (string-contains-ci "foo bar" "bar" 10)
   :expected #f)
(define-test string-contains-ci (string-contains-ci "foo bar" "bar" -1)
   :expected 4)
(define-test string-as-read (string-as-read (string #\\ #\n #\o #\\ #\t))
   :expected (string #\newline #\o #\tab))
(define-test string-for-read (string-for-read (string #\newline #\o #\tab))
   :expected (string #\\ #\n #\o #\\ #\t))
(define-test string-delete (string-delete "abcedfghij" "fgh")
   :expected "abcedij")
(define-test string-delete (string-delete "abcedfghij" "fgh" 6)
   :expected "ij")
(define-test string-delete (string-delete "abcedfghij" #\b 1 5)
   :expected "ced")
(define-test string-delete (string-delete "abcedfghij" (lambda (c) #t) 7)
   :expected "")
(define-test strint-char-index (string-char-index "abcdef" #\f)
   :expected 5)
(define-test strint-char-index (string-char-index "abcdef" #\f 5 1)
   :expected 5)
(define-test strint-char-index (string-char-index "abcdef" #\f 4 2)
   :expected 5)
(define-test strint-char-index (string-char-index "abcdef" #\f 4 1)
   :expected #f)
(define-test strint-char-index (string-char-index "abcdef" #\f 4 2)
   :expected 5)
(define-test strint-char-index (string-char-index "abcdef" #\e)
   :expected 4)
(define-test strint-char-index (string-char-index "abcdef" #\e 4 1)
   :expected 4)
(define-test strint-char-index (string-char-index "abcdef" #\e 4 2)
   :expected 4)
(define-test strint-char-index (string-char-index "abcdef" #\e 3 1)
   :expected #f)
(define-test strint-char-index (string-char-index "abcdef" #\e 3 3)
   :expected 4)

(define-test string-trim-both (string-trim-both "  The outlook wasn't brilliant,  \n\r")
   :expected "The outlook wasn't brilliant,")
(define-test string-trim.1 (string-trim "  The outlook wasn't brilliant,  \n\r")
   :expected "The outlook wasn't brilliant,  \n\r")
(define-test string-trim-right (string-trim-right "  The outlook wasn't brilliant,  \n\r")
   :expected "  The outlook wasn't brilliant,")

(define-test string-shrink! (string-shrink! (string-append "abc" "def") 4)
   :expected "abcd")

(define-test string-fill! (string-fill! (string-append "abc" "de") #\-)
   :expected "-----")

(define-test string-replace (string-replace "foo-bar" #\- #\_)
   :expected "foo_bar")
(define-test string-replace! (let ((s (string-append "foo" "-bar")) (string-replace! s #\- #\_) s))
   :expected "foo_bar")

(define-test string-split (string-split "foo  bar gee")
   :expected '("foo" "bar" "gee"))
(define-test string-cut (string-split "foo  bar gee")
   :expected '("foo" "" "bar" "gee"))

(define-test string-hex-intern (string-hex-intern "4a4b4c")
   :expected "JKL")
(define-test string-hex-intern! (let ((s (string-append "4a4b" "4c"))) (string-hex-intern! s) s)
   :expected "JKL")

(define-test string-hex-extern (string-hex-intern "JKL")
   :expected "4a4b4c")

(define-test string-trim (string-trim "  foo bar ")
   :expected "foo bar ")

(define-test string-trim-right (string-trim-right "  foo bar ")
   :expected "   foo bar")

(define-test string-trim-both (string-trim-both "  foo bar ")
   :expected "foo bar")
