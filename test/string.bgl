(define-test hex-string (string-hex-intern "414141")
   :expected "AAA")
(define-test hex-string (string-hex-intern! (string-copy "414141"))
   :expected "AAA")
(define-test hex-string (string-hex-intern (string-hex-extern "foo bar0x12"))
   :expected "foo bar0x12")

(define-test md5 (md5sum "")
   :expected "d41d8cd98f00b204e9800998ecf8427e")
(define-test md5 (md5sum "a")
   :expected "0cc175b9c0f1b6a831c399e269772661")
(define-test md5 (md5sum "abc")
   :expected "900150983cd24fb0d6963f7d28e17f72")
(define-test md5 (md5sum "message digest")
   :expected "f96b697d7cb7938d525a2f31aaf161d0")
(define-test md5 (md5sum "abcdefghijklmnopqrstuvwxyz")
   :expected "c3fcd3d76192e4007dfb496cca67e13b")
(define-test md5 (md5sum "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789")
   :expected "d174ab98d277d9f5a5611c2c9f419d9f")
(define-test md5(md5sum "12345678901234567890123456789012345678901234567890123456789012345678901234567890")
   
   :expected "57edf4a22be3c955ac49da2e2107b67a")
(define-test hmac-md5 (hmac-md5sum-string (make-string 16 #a011)
			     "Hi There")
   :expected "9294727a3638bb1c13f48ef8158bfc9d")
(define-test hmac-md5 (hmac-md5sum-string "Jefe"
			     "what do ya want for nothing?")
   :expected "750c783e6ab0b503eaa86e310a5db738")
(define-test hmac-md5 (hmac-md5sum-string (make-string 16 #a170)
			     (make-string 50 #a221))
   :expected "56be34521d144c88dbb8c733f0e8b3f6")
(define-test hmac-md5 (hmac-md5sum-string (string-hex-intern
						 "0102030405060708090a0b0c0d0e0f10111213141516171819")
			     (make-string 50 #a205))
   :expected "697eaf0aca3a3aea3a75164746ffaa79")
