(define-test string? (string? "foo")
   :expected #t)
(define-test string? (string? 3)
   :expected #f)
(define-test string? (string? 'foo)
   :expected #f)
(define-test string? (string? (make-string 10 #\a))
   :expected #t)

(define-test string-null? (string-null? "foo")
   :expected #f)
(define-test string-null? (string-null? "")
   :expected #t)

(define-test empty-string? (empty-string? "foo")
   :expected #f)
(define-test empty-string? (empty-string? "")
   :expected #t)

(define-test string=? (string=? "foo" "bar")
   :expected #f)
(define-test string=? (string=? "foo" "foo")
   :expected #t)
(define-test string=? (string=? "ToTo" "tOtO")
   :expected #f)

(define-test literal "\342\202\254"
   :expected (apply string (map integer->char '(#o342 #o202 #o254))))

(define-test string=? (let ((s (make-string 3 (integer->char 0))))
			 (string=? s #"\000\000\000")))
(define-test string=? (let ((s (make-string 3 (integer->char 0))))
			   (string=? s #"\000\001\000"))
   :expected #f)
(define-test string-length (string-length "12345")
   :expected 5)
(define-test equal? (equal? "toto n'est pas content" "toto est content")
   :expected #f)

(define-test make-string (make-string 1 #\a) :expected "a")
(define-test make-string (make-string 3 #\z) :expected "zzz")
(define-test make-string (make-string 0 #\z) :expected "")

(define-test string-ref (string-ref (make-string 1 #\a) 0) :expected #\a)
(define-test string-ref-ur (string-ref (make-string 3 #\a) 2) :expected #\a)

(define-test string-set! (let ((s (string-copy "0123456789")))
			   (string-set! s 0 (string-ref s 1))
			   s)
   :expected "1123456789")
(define-test string-set-ur! (let ((s (string-copy "0123")))
			       (string-set-ur! s 0 (string-ref s 1))
			       s)
   :expected "1123")

(define-test string (string #\a #\b #\c) :expected "abc")

(define-test string-append (string-append "Toto " "est content")
   :expected "Toto est content")
(define-test string-append (string-append "toto" " n'est" " pas" " content")
   :expected "toto n'est pas content")
(define-test string-upcase (string-upcase "toto TOTO ToTo") :expected "TOTO TOTO TOTO")
(define-test string-upcase! (let ((s "toto TOTO ToTo")) (string-upcase! s) s) :expected "TOTO TOTO TOTO")
(define-test string-downcase (string-downcase "toto TOTO ToTo") :expected "toto toto toto")
(define-test string-downcase! (let ((s "toto TOTO ToTo")) (string-dowcase! s) s) :expected "toto toto toto")
(define-test string-capitalize (string-capitalize "toto TOTO ToTo") :expected "Toto Toto Toto")
(define-test string-capitalize! (let ((s "toto TOTO ToTo")) (string-capitalize s) s) :expected "Toto Toto Toto")
(define-test string-ci=? (string-ci=? "Toto" "tOtO") :expected #t)

(define-test string-copy (string-copy (make-string 3 #\6))
   :expected "666")
(define-test list->string (list->string '(#\t #\o #\t #\o))
   :expected "toto")
(define-test string->list (string->list "toto")
   :expected '(#\t #\o #\t #\o))
(define-test string->list (string->list "-$>$")
   :expected '(#\- #\$ #\> #\$))
(define-test string->string (list->string (string->list "tot oto"))
   :expected "tot oto")
(define-test string->integer (string->integer "01234")
   :expected 1234)
(define-test integer->string (integer->string 0)
   :expected "0")
(define-test integer->string (integer->string 1)
   :expected "1")
(define-test integer->string (integer->string -1)
   :expected "-1")
(define-test integer->string (integer->string 1234)
   :expected "1234")
(define-test integer->string (integer->string -1234)
   :expected "-1234")
(define-test unsigned->string (unsigned->string 1234 16)
   :expected "4d2")
(define-test unsigned->string (pair?
				 (member (unsigned->string -1234 16)
				    '("fffffb2e"  "fffffffffffffb2e")))
   :expected #t)
(define-test unsigned->string (unsigned->string #e1234 16)
   :expected "4d2")
(define-test unsigned->string (pair?
				 (member (unsigned->string #e-1234 16)
				    '("fffffb2e" "fffffffffffffb2e")))
   :expected #t)
(define-test unsigned->string (unsigned->string #l1234 16)
   :expected "4d2")
(define-test unsigned->string (unsigned->string #l-1234 16)
   :expected "fffffffffffffb2e")
(define-test string->real (string->real "1234.25")
   :expected 1234.25)
(define-test real->string (real->string 1234.25)
   :expected "1234.25")
(define-test substring (substring "0123456789" 1 5)
   :expected "1234")

(define-test blit-string!
   (let ((dst (make-string 10 #\0))
	 (src (make-string 5 #\1)))
      (blit-string! src 1 dst 1 3) dst)
   :expected "0111000000")
(define-test blit-string!
   (let ((s (make-string 20 #\-)))
      (blit-string! "toto" 0 s 16 4)
      s)
   :expected "----------------toto")

