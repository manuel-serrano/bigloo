(include "test.bgh")

;*---------------------------------------------------------------------*/
;*    test ...                                                         */
;*---------------------------------------------------------------------*/
(define (test verbose tests::pair-nil)
   (when (or (null? tests) (member "string" tests))
      (test-all verbose "string")))

;*---------------------------------------------------------------------*/
;*    8bits->7bits ...                                                 */
;*---------------------------------------------------------------------*/
(define (8bits->7bits string::bstring)
   (let ((len (string-length string)))
      (let loop ((i 0))
         (if (=fx i len)
             string
             (begin 
                (case (string-ref string i)
                   ((#\é #\è)
                    (string-set! string i #\e))
                   ((#\É #\È)
                    (string-set! string i #\E))
                   ((#\à)
                    (string-set! string i #\a))
                   ((#\À)
                    (string-set! string i #\A))
                   ((#\û #\ü)
                    (string-set! string i #\u))
                   ((#\Û #\Ü)
                    (string-set! string i #\U))
                   ((#\î #\ï)
                    (string-set! string i #\i))
                   ((#\Î #\Ï)
                    (string-set! string i #\I))
                   ((#\ö #\ô)
                    (string-set! string i #\o))
                   ((#\Ö #\Ô)
                    (string-set! string i #\O))
                   ((#\ç)
                    (string-set! string i #\c))
                   ((#\C)
                    (string-set! string i #\C)))
                (loop (+fx i 1)))))))

;*---------------------------------------------------------------------*/
;*    string-natural<? ...                                             */
;*---------------------------------------------------------------------*/
(define (string-natural<? s1 s2)
   (=fx (string-natural-compare3 s1 s2) -1))

;*---------------------------------------------------------------------*/
;*    test-sha1 ...                                                    */
;*---------------------------------------------------------------------*/
(define (test-sha1 str sum)
   (define-test sha1-string (sha1sum str)
      :expected sum)
   (define-test sha1-port
      (with-input-from-string str
	 (lambda ()
	    (sha1sum (current-input-port))))
      :expected sum)
   (define-test sha1-mmap
      (sha1sum (string->mmap str))
      :expected sum))
   
;*---------------------------------------------------------------------*/
;*    test-sha256 ...                                                  */
;*---------------------------------------------------------------------*/
(define (test-sha256 str sum)
   (define-test sha256-string (sha256sum str)
      :expected sum)
   (define-test sha256-port
      (with-input-from-string str
	 (lambda ()
	    (sha256sum (current-input-port))))
      :expected sum)
   (define-test sha256-mmap (sha256sum (string->mmap str))
      :expected sum))

;*---------------------------------------------------------------------*/
;*    test-sha256-2 ...                                                */
;*---------------------------------------------------------------------*/
(define (test-sha256-2)
   (for-each (lambda (s1 res)
		(define-test "sha256" (sha256sum-string s1) :expected res))
      '("VzqZI-2-d2WCGxDu*W.RFiJ9*bz=&F,V45a?WFKCkk5uk,OeKBVSJ8Eg9H3M;R.wc.+ZsDefqMzAA-E."
