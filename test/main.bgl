;*---------------------------------------------------------------------*/
;*    test                                                             */
;*---------------------------------------------------------------------*/
(module test
   (import "./string.bgl" . string)
   (import "./vector.bgl" . vector)
   (main))

;*---------------------------------------------------------------------*/
;*    test machinery                                                   */
;*---------------------------------------------------------------------*/
(include "test.bgh")

;*---------------------------------------------------------------------*/
;*    main ...                                                         */
;*---------------------------------------------------------------------*/
(define (main argv)
   
   (define verbose #f)
   (define tests '())
   
   (args-parse (cdr argv)
      ((("-v" "--verbose") (help "verbose"))
       (set! verbose #t))
      (else
       (set! tests (cons else tests))))
   
   (let* ((res (list
		  (string.test verbose tests)
		  (vector.test verbose tests)))
	  (success (apply + (map car (filter (lambda (x) x) res))))
	  (failures (apply + (map cdr (filter (lambda (x) x) res)))))
      (newline)
      (if (=fx failures 0)
	  (print "all (" success ") tests " (color 'ok "passed") ".")
	  (print failures "/" (+fx success failures) " tests " (color 'fail "failed") "."))))
