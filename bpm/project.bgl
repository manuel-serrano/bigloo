;*---------------------------------------------------------------------*/
;*    project                                                          */
;*---------------------------------------------------------------------*/
(module project
   (import "./config.bgl" . config)
   (import "./utils.bgl" . utils)
   (import "./database.bgl" . db)
   (import "./package.bgl" . pkg)
   (import "./solver.bgl" . solver)
   (import "./check.bgl" . check)
   (export init clone load add-pkg install-pkg install-dependencies))

;*---------------------------------------------------------------------*/
;*    template ...                                                     */
;*---------------------------------------------------------------------*/
(define-macro (template file)
   (call-with-input-file (make-file-path project.dirname "template" file)
      read-string))

;*---------------------------------------------------------------------*/
;*    init ...                                                         */
;*    -------------------------------------------------------------    */
;*    Create a new project in dir                                      */
;*---------------------------------------------------------------------*/
(define (init path::bstring force::bool)
   
   (define (err msg obj)
      (utils.error "project init" msg obj))
   
   (define qpath (file-name-unix-canonicalize path))
   
   (when (file-exists? qpath)
      (if force
          (if (directory? qpath)
              (delete-directories qpath)
              (delete-file qpath))
          (err "File exists" qpath)))
   
   (make-directories qpath)
   (unless (directory? qpath)
      (err "Cannot create directory" path))
   
   (init-in-dir path))

;*---------------------------------------------------------------------*/
;*    init-in-dir ...                                                  */
;*---------------------------------------------------------------------*/
(define (init-in-dir qpath::bstring)
   
   (define (err msg obj)
      (utils.error "project init" msg obj))

   (define pkg
      (basename qpath))
   
   (let ((pkgdir (make-file-name qpath "pkg")))
      (make-directory pkgdir)
      (unless (directory? pkgdir)
         (err "Cannot create directory" pkgdir)))
   
   (let ((odir (make-file-name qpath "obj")))
      (make-directory odir)
      (unless (directory? odir)
         (err "Cannot create directory" odir)))
   
   (let ((pkgsexp (make-file-name qpath "package.sexp")))
      (call-with-output-file pkgsexp
         (lambda (op)
            (display (pregexp-replace "@PKG@" (template "package.sexp") pkg)
               op)))
      
      (unless (file-exists? pkgsexp)
         (err "Cannot create package.sexp file" pkgsexp)))
   
   (let ((sdir (make-file-name qpath "src")))
      (make-directory sdir)
      (unless (directory? sdir)
         (err "Cannot create directory" sdir)))
      
   (let ((tdir (make-file-name qpath "test")))
      (make-directory tdir)
      (unless (directory? tdir)
         (err "Cannot create directory" tdir))
      
      (let ((makefile (make-file-path qpath "test" "Makefile")))
         (call-with-output-file makefile
            (lambda (op)
               (display (template "test/Makefile") op))))
      
      (let ((test (make-file-path qpath "test" "test.bgl")))
         (call-with-output-file test
            (lambda (op)
               (display (pregexp-replace "@PKG@"
                           (template "test/test.bgl") pkg)
                  op))))))

;*---------------------------------------------------------------------*/
;*    clone ...                                                        */
;*---------------------------------------------------------------------*/
(define (clone name::bstring version force::bool)
   (let ((pv (db.find-package-version name version)))
      (download-pkg name pv name)))

;*---------------------------------------------------------------------*/
;*    is-a-project? ...                                                */
;*    -------------------------------------------------------------    */
;*    Is the directory a project?                                      */
;*---------------------------------------------------------------------*/
(define (is-a-project? dir::bstring)
   (file-exists? (make-file-name dir "package.sexp")))

;*---------------------------------------------------------------------*/
;*    add-pkg ...                                                      */
;*---------------------------------------------------------------------*/
(define (add-pkg dir::bstring name::bstring version)
   (let ((pv::PackageVersion (db.find-package-version name version)))
      (add-dependency! dir name (or version "*"))
      (install-dependencies dir)))

;*---------------------------------------------------------------------*/
;*    install-pkg ...                                                  */
;*---------------------------------------------------------------------*/
(define (install-pkg dir::bstring name::bstring pv::PackageVersion)
   (unless (is-a-project? dir)
      (if (utils.yes-no? "Shall I initialize it? "
             (format "The current directory ~s is not a bpm project.\n" (pwd)))
          (init-in-dir dir)
          (exit 0)))
   (unless (directory? "pkg")
      (make-directory "pkg")
      (call-with-output-file "pkg/Makefile.pkg"
         (lambda (op) (display "" op))))
   (utils.verb
      (format "installing package ~a..."
         (utils.color 'command name)))
   (download-pkg-and-makefile name pv (make-file-path (pwd) "pkg" name)))

;*---------------------------------------------------------------------*/
;*    pkg-installed? ...                                               */
;*---------------------------------------------------------------------*/
(define (pkg-installed? dir::bstring name::bstring pv::PackageVersion)
   (let ((base (make-file-path dir "pkg" name)))
      (when (directory? base)
         (let ((file (make-file-name base "package.sexp")))
            (when (file-exists? file)
               (let ((sexp (call-with-input-file file read)))
                  (null? (pkg.compare-package-version pv sexp))))))))

;*---------------------------------------------------------------------*/
;*    install-dependencies ...                                         */
;*---------------------------------------------------------------------*/
(define (install-dependencies dir::bstring)
   (let* ((p::Package (load dir))
          (r (solver.resolve-package p #f)))
      (when (file-exists? (make-file-path dir "pkg" "Makefile.pkg"))
         (delete-file (make-file-path dir "pkg" "Makefile.pkg"))
         (call-with-output-file (make-file-path dir "pkg" "Makefile.pkg")
            (lambda (op)
               (display "" op))))
      (if (pair? r)
          (for-each (lambda (d)
                       (let ((p::Package (car d))
                             (v::PackageVersion (cdr d)))
                          (unless (pkg-installed? dir p.name v)
                             (install-pkg dir p.name v))))
             (cdr (reverse r)))
          (print (utils.color 'error p) "cannot resolve"))))

;*---------------------------------------------------------------------*/
;*    download-pkg-and-makefile ...                                    */
;*---------------------------------------------------------------------*/
(define (download-pkg-and-makefile name::bstring pv::PackageVersion dir::bstring)
   (download-pkg name pv dir)
   (install-pkg-makefile name pv dir))

;*---------------------------------------------------------------------*/
;*    download-pkg ...                                                 */
;*---------------------------------------------------------------------*/
(define (download-pkg name::bstring pv::PackageVersion dir::bstring)
   (if (directory? dir)
       (when (utils.yes-no? "Shall I remove it? "
                (format "Directory ~s already exists.\n" dir))
          (delete-directories dir)))
   (unless (directory? dir)
      (let ((path (utils.untar (utils.download pv.url name) dir)))
         (let ((sexp (check.package path)))
            (when (pair? sexp)
               (let ((diffs (pkg.compare-package-version pv sexp)))
                  (when (pair? diffs)
                     (utils.error utils.command
                        (format "Downloaded package ~a mismatch" name)
                        (format "\n~(\n)"
                           (map (lambda (d)
                                   (apply format "  ~a\n    ~a\n    ~a" d))
                              diffs))))))))))

;*---------------------------------------------------------------------*/
;*    install-pkg-makefile ...                                         */
;*---------------------------------------------------------------------*/
(define (install-pkg-makefile name::bstring pv::PackageVersion dir::bstring)
   (let* ((mf (make-file-name dir "Makefile.pkg"))
          (inc (if (file-exists? mf)
                   mf
                   (generate-auto-makefile name
                      dir
                      (format "pkg/Makefile.~a" name)
                      pv.backends))))
      (when (string? inc)
         (call-with-append-file
            (make-file-path "pkg" "Makefile.pkg")
            (lambda (op)
               (fprint op "include " inc))))))

;*---------------------------------------------------------------------*/
;*    generate-auto-makefile ...                                       */
;*---------------------------------------------------------------------*/
(define (generate-auto-makefile name::bstring dir::bstring mf::bstring backends)
   (let ((files (filter-map (lambda (s)
                               (when (string-suffix? ".bgl" s)
                                  (prefix s)))
                   (directory->list (make-file-name dir "src")))))
      (when (pair? files)
         (call-with-output-file mf
            (lambda (op)
               (utils.verb
                  (format "  generating ~a..." (utils.color 'command mf))
                  :lvl 2)
               (fprint op "BFLAGS += -I pkg/" name "/src")
               (when (memq 'c backends)
                  (fprintf op "PKG_OBJECTS += ~( )\n"
                     (map (lambda (s)
                             (string-append "pkg/" name "/$(OBJ)/" s ".o"))
                        files)))
               (when (memq 'wasm backends)
                  (fprintf op "PKG_WOBJECTS += ~( )\n"
                     (map (lambda (s)
                             (string-append "pkg/" name "/$(OBJ)/" s ".wasm"))
                        files)))
               (when (memq 'jvm backends)
                  (fprintf op "PKG_JOBJECTS += ~( )\n"
                     (map (lambda (s)
                             (string-append "pkg/" name "/$(OBJ)/" s ".class"))
                        files)))
               (newline op)
               (when (memq 'c backends)
                  (fprint op "pkg/" name "/$(OBJ)/%.o: pkg/" name "/src/%.bgl")
                  (fprint op "\t$(BIGLOO) -c $(BFLAGS) $(BCFLAGS) $< -o $@"))
               (when (memq 'jvm backends)
                  (fprint op "pkg/" name "/$(OBJ)/%.class: pkg/" name "/src/%.bgl")
                  (fprint op "\t$(BIGLOO) -c $(BFLAGS) $(BJFLAGS) $< -o $@"))
               (when (memq 'wasm backends)
                  (fprint op "pkg/" name "/$(OBJ)/%.obj: pkg/" name "/src/%.bgl")
                  (fprint op "\t$(BIGLOO) -c $(BFLAGS) $(BWFLAGS) $< -o $@"))
               mf)))))
         
;*---------------------------------------------------------------------*/
;*    add-dependency! ...                                              */
;*---------------------------------------------------------------------*/
(define (add-dependency! dir::bstring name::bstring version::bstring)
   (let ((path (make-file-name dir "package.sexp")))
      (let* ((sexp (call-with-input-file path (lambda (ip) (read ip #t))))
             (dep (utils.plist-get sexp :dependencies '()))
             (e (assoc name dep)))
         (if (pair? e)
             (set-car! (cdr e) version)
             (set! dep
                (utils.plist-set sexp
                   :dependencies (cons (list name version) dep))))
         (call-with-output-file path
            (lambda (op)
               (pkg.pp dep op))))))

;*---------------------------------------------------------------------*/
;*    load ...                                                         */
;*---------------------------------------------------------------------*/
(define (load path::bstring)
   (if (is-a-project? path)
       (let* ((file (make-file-name path "package.sexp"))
              (l (call-with-input-file file read))
              (version (instantiate::PackageVersion
                          (version (utils.plist-get l version: #f))
                          (note (utils.plist-get l :note ""))
                          (author (utils.plist-get l :author ""))
                          (homepage (utils.plist-get l :homage ""))
                          (url (utils.plist-get l :url ""))
                          (checksum (utils.plist-get l :checksum ""))
                          (backends (utils.plist-get l :backends #f))
                          (bigloo (utils.plist-get l :bigloo "5.0.0"))
                          (dependencies (utils.plist-get l :dependencies '())))))
          (instantiate::Package
             (name (utils.plist-get l name: #f))
             (description (utils.plist-get l description: ""))
             (versions (list version))))
       (utils.error utils.command "Directory is not a bpm project"
          path)))
