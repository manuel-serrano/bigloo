;*---------------------------------------------------------------------*/
;*    bpm                                                              */
;*---------------------------------------------------------------------*/
(module bpm
   (import "./config.bgl" . config)
   (import "./utils.bgl" . utils)
   (import "./database.bgl" . db)
   (import "./project.bgl" . proj)
   (import "./package.bgl" . pkg)
   (import "./solver.bgl" . solver)
   (import "./check.bgl" . check)
   (main))

;*---------------------------------------------------------------------*/
;*    main ...                                                         */
;*---------------------------------------------------------------------*/
(define (main cmdline)
   (let ((a (parse-cmdline cmdline)))
      (cond
         ((procedure? a) (a))
         ((pair? a) (apply (car a) (cdr a))))))

;*---------------------------------------------------------------------*/
;*    parse-cmdline ...                                                */
;*---------------------------------------------------------------------*/
(define (parse-cmdline cmdline)
   
   (define (usage args-parse-usage)
      (printf "~a ~a\n" config.name config.version)
      (print "usage: " config.name " [options] command arg0 arg1 ...")
      (args-parse-usage)
      (exit 0))

   (let ((action #f)
         (force #f)
         (rec #f))
      
      (bind-exit (break)
         (args-parse (cdr cmdline)
            
            ;; empty command line
            (()
             (set! action (lambda () (usage args-parse-usage))))
            
            ;; common options
            (section "Common options")
            ((("-h" "--help") (help "This message (use -v -h for long help)"))
             (set! action args-parse-usage))
            (("-v?<level>" (help "Increase/set verbosity level (-v0 silence)"))
             (if (string=? <level> "")
                 (config.verbose-set! (+fx config.verbose 1))
                 (config.verbose-set! (string->integer <level>))))
            (("--no-color" (help "Disable colored traces"))
             (bigloo-trace-color-set! #f))
            (("--force" (help "Force execution action"))
             (set! force #t))
            (("--rc-dir" ?dir (help "Uses an alternate RC directory (see \"BPM_RC_DIRECTORY\")"))
             (config.rc-directory-set! dir))
            (("-r" (help "Proceed recursively"))
             (set! rec #t))
            
            ;; sub commands
            (section "Sub commands")
            (("config" (help "config commands"))
             (set! action (config-parse-cmdline the-remaining-args))
             (break #t))
            (("db" (help "database commands"))
             (set! action (db-parse-cmdline the-remaining-args))
             (break #t))
            (("pkg" (help "package commands"))
             (set! action (pkg-parse-cmdline the-remaining-args rec))
             (break #t))
            (("proj" (help "project commands"))
             (set! action (proj-parse-cmdline the-remaining-args force))
             (break #t))
            
            (else
             (set! action (lambda () (usage args-parse-usage))))))
      
      action))

;*---------------------------------------------------------------------*/
;*    config-parse-cmdline ...                                         */
;*---------------------------------------------------------------------*/
(define (config-parse-cmdline cmdline::pair-nil)
   
   (define (usage args-parse-usage)
      (printf "~a ~a\n" config.name config.version)
      (print "usage: " config.name " [options] "
         (utils.color 'command "config") " arg0 arg1 ...")
      (args-parse-usage :breakline #t)
      (exit 0))
   
   (bind-exit (break)
      (args-parse cmdline
         (()
          (lambda () (usage args-parse-usage)))
         (("show" (help "Show configuration"))
          (break config.show))
         (else
          (break (lambda () (usage args-parse-usage)))))))

;*---------------------------------------------------------------------*/
;*    pkg-parse-cmdline ...                                            */
;*---------------------------------------------------------------------*/
(define (pkg-parse-cmdline cmdline::pair-nil rec::bool)
   
   (define (usage args-parse-usage)
      (printf "~a ~a\n" config.name config.version)
      (print "usage: " config.name " [options] "
         (utils.color 'command "pkg") " arg0 arg1 ...")
      (args-parse-usage :breakline #t)
      (exit 0))

   (bind-exit (break)
      (args-parse cmdline
         (()
          (lambda () (usage args-parse-usage)))
         (("install" ?pkg (?version) (help "Install package in the current project"))
          (utils.command-set! "pkg install")
          (break
             (lambda ()
                (proj.add-pkg (pwd) pkg version))))
         (("upgrade" (help "Upgrade the dependency packages"))
          (break
             (lambda ()
                (tprint "TODO"))))
         (("resolve" (?pkg ?version) (help "Resolve the package dependencies"))
          (utils.command-set! "pkg resolve")
          (break
             (lambda ()
                (let* ((p (db.find-package (or pkg (pwd))))
                       (r (solver.resolve-package p version)))
                   (if (pair? r)
                       (let ((i (reverse r)))
                          (print-dependencies (caar i) (cdar i) (cdr i)))
                       (print (utils.color 'error pkg) "cannot resolve"))))))
         (("check" (?pkg) (help "Check package syntax"))
          (utils.command-set! "pkg check")
          (break
             (lambda ()
                (when (check.package (or pkg (pwd)))
                    (print "package ok.")))))
         (else
          (break (lambda () (usage args-parse-usage)))))))

;*---------------------------------------------------------------------*/
;*    proj-parse-cmdline ...                                           */
;*---------------------------------------------------------------------*/
(define (proj-parse-cmdline cmdline::pair-nil force::bool)
   
   (define (usage args-parse-usage)
      (printf "~a ~a\n" config.name config.version)
      (print "usage: " config.name " [options] "
         (utils.color 'command "proj") " arg0 arg1 ...")
      (args-parse-usage :breakline #t)
      (exit 0))
   
   (bind-exit (break)
      (args-parse cmdline
         (()
          (lambda () (usage args-parse-usage)))
         (("init" ?dir (help "Create a new project in directory DIR"))
          (break (lambda () (proj.init dir force))))
         (("clone" ?pkg (?version) (help "Create a new project from existing package PKG"))
          (break (lambda () (proj.clone pkg version force))))
         (("info" (help "Project information"))
          (break (lambda () (tprint "not implemented yet"))))
         (("resolve" (?dir) (help "Resolve project dependencies"))
          (utils.command-set! "proj resolve")
          (break
             (lambda ()
                (let* ((path (or dir (pwd)))
                       (p::Package (proj.load path))
                       (r (solver.resolve-package p #f)))
                   (if (pair? r)
                       (let ((i (reverse r)))
                          (print-dependencies (caar i) (cdar i) (cdr i)))
                       (print (utils.color 'error p.name) " cannot resolve."))))))
         (("install-deps" (?dir) (help "Install the project dependencies"))
          (utils.command-set! "proj install-deps")
          (break
             (lambda ()
                (let ((path (if dir (make-file-name (pwd) dir) (pwd))))
                   (proj.install-dependencies path)))))
         (else
          (break (lambda () (usage args-parse-usage)))))))

;*---------------------------------------------------------------------*/
;*    db-parse-cmdline ...                                             */
;*---------------------------------------------------------------------*/
(define (db-parse-cmdline cmdline::pair-nil)
   
   (define (usage args-parse-usage)
      (printf "~a ~a\n" config.name config.version)
      (print "usage: " config.name " [options] "
         (utils.color 'command "db") " arg0 arg1 ...")
      (args-parse-usage :breakline #t)
      (exit 0))

   (bind-exit (break)
      (args-parse cmdline
         (()
          (lambda () (usage args-parse-usage)))
         (("list" (help "List packages"))
          (break
             (lambda ()
                (db.list-packages (db.load-database config.rc-directory)))))
         (("update" (help "Update database"))
          (break (lambda ()
                    (db.update! (db.load-database config.rc-directory)))))
         (("init" ?url (help "Initialize a database from a url"))
          (break (lambda () (db.init url))))
         (else
          (break (lambda () (usage args-parse-usage)))))))

;*---------------------------------------------------------------------*/
;*    print-dependencies ...                                           */
;*---------------------------------------------------------------------*/
(define (print-dependencies p::Package pv::PackageVersion deps::pair-nil)
   (print (utils.color 'package p.name) ": "
      (utils.color 'version pv.version))
   (for-each (lambda (e)
                (let ((p::Package (car e))
                      (v::PackageVersion (cdr e)))
                   (print "   " (utils.color 'package p.name) " (" v.version ")")))
      deps))
