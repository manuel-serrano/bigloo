;*---------------------------------------------------------------------*/
;*    bpm                                                              */
;*---------------------------------------------------------------------*/
(module bpm
   (import "./config.bgl" . config)
   (import "./utils.bgl" . utils)
   (import "./database.bgl" . db)
   (import "./project.bgl" . proj)
   (import "./package.bgl" . pkg)
   (main))

;*---------------------------------------------------------------------*/
;*    main ...                                                         */
;*---------------------------------------------------------------------*/
(define (main cmdline)
   (let ((a (parse-cmdline cmdline)))
      (cond
         ((procedure? a) (a))
         ((pair? a) (apply (car a) (cdr a))))))

;*---------------------------------------------------------------------*/
;*    parse-cmdline ...                                                */
;*---------------------------------------------------------------------*/
(define (parse-cmdline cmdline)
   
   (define (usage args-parse-usage)
      (printf "~a v~a\n" config.name config.version)
      (print "usage: " config.name " [options] command arg0 arg1 ...")
      (args-parse-usage #f)
      (exit 0))

   (let ((action #f)
         (force #f)
         (rec #f))
      
      (bind-exit (break)
         (args-parse (cdr cmdline)
            
            ;; empty command line
            (()
             (set! action (lambda () (usage args-parse-usage))))
            
            ;; common options
            (section "Common options")
            ((("-h" "--help") (help "This message (use -v -h for long help)"))
             (set! action args-parse-usage))
            (("-v?<level>" (help "Increase/set verbosity level (-v0 silence)"))
             (if (string=? <level> "")
                 (config.verbose-set! (+fx config.verbose 1))
                 (config.verbose-set! (string->integer <level>))))
            (("--no-color" (help "Disable colored traces"))
             (bigloo-trace-color-set! #f))
            (("--force" (help "Force execution action"))
             (set! force #t))
            (("--rc-dir" ?dir (help "Uses an alternate RC directory (see \"BMP_RC_DIRECTORY\")"))
             (config.rc-directory-set! dir))
            (("-r" (help "Proceed recursively"))
             (set! rec #t))
            
            ;; sub commands
            (section "Sub commands")
            (("config" (help "config commands"))
             (set! action (config.parse-cmdline the-remaining-args))
             (break #t))
            (("db" (help "database commands"))
             (set! action (db-parse-cmdline the-remaining-args))
             (break #t))
            (("pkg" (help "package commands"))
             (set! action (pkg-parse-cmdline the-remaining-args rec))
             (break #t))
            (("proj" (help "project commands"))
             (set! action (proj-parse-cmdline the-remaining-args force))
             (break #t))
            
            (else
             (set! action (lambda () (usage args-parse-usage))))))
      
      action))

;*---------------------------------------------------------------------*/
;*    pkg-parse-cmdline ...                                            */
;*---------------------------------------------------------------------*/
(define (pkg-parse-cmdline cmdline::pair-nil rec::bool)
   
   (define (usage args-parse-usage)
      (printf "~a v~a\n" config.name config.version)
      (print "usage: " config.name " [options] "
         (trace-color 2 "pkg") " arg0 arg1 ...")
      (args-parse-usage #f)
      (exit 0))

   (bind-exit (break)
      (args-parse cmdline
         (()
          (lambda () (usage args-parse-usage)))
         (("install" ?pkg (?version) (help "Install a package"))
          (utils.command-set! "pkg install")
          (break
             (lambda ()
                (proj.install-pkg pkg version))))
         (("upgrade" (help "Update the dependency packages"))
          (break
             (lambda ()
                (tprint "TODO"))))
         (else
          (break (lambda () (usage args-parse-usage)))))))

;*---------------------------------------------------------------------*/
;*    proj-parse-cmdline ...                                           */
;*---------------------------------------------------------------------*/
(define (proj-parse-cmdline cmdline::pair-nil force::bool)
   
   (define (usage args-parse-usage)
      (printf "~a v~a\n" config.name config.version)
      (print "usage: " config.name " [options] "
         (trace-color 2 "proj") " arg0 arg1 ...")
      (args-parse-usage #f)
      (exit 0))
   
   (bind-exit (break)
      (args-parse cmdline
         (()
          (lambda () (usage args-parse-usage)))
         (("init" ?dir (help "Create a new project in directory DIR"))
          (break (lambda () (proj.init dir force))))
         (else
          (break (lambda () (usage args-parse-usage)))))))

;*---------------------------------------------------------------------*/
;*    db-parse-cmdline ...                                             */
;*---------------------------------------------------------------------*/
(define (db-parse-cmdline cmdline::pair-nil)
   
   (define (usage args-parse-usage)
      (printf "~a v~a\n" config.name config.version)
      (print "usage: " config.name " [options] "
         (trace-color 2 "db") " arg0 arg1 ...")
      (args-parse-usage #f)
      (exit 0))

   (bind-exit (break)
      (args-parse cmdline
         (()
          (lambda () (usage args-parse-usage)))
         (("list" (help "List packages"))
          (break
             (lambda ()
                (db.list-packages (db.load-database config.rc-directory)))))
         (("update" (help "Update database"))
          (break (lambda ()
                    (db.update (db.load-database config.rc-directory)))))
         (("init" ?url (help "Initialize a database from a url"))
          (break (lambda () (db.init url))))
         (else
          (break (lambda () (usage args-parse-usage)))))))

