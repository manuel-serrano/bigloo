;*---------------------------------------------------------------------*/
;*    bpm                                                              */
;*---------------------------------------------------------------------*/
(module bpm
   (library bpmlib)
   (import "./config.bgl" . config)
   (import "./database.bgl" . db)
   (import "./project.bgl" . proj)
   (main))

;*---------------------------------------------------------------------*/
;*    main ...                                                         */
;*---------------------------------------------------------------------*/
(define (main cmdline)
   (let ((a (parse-cmdline cmdline)))
      (cond
         ((procedure? a) (a))
         ((pair? a) (apply (car a) (cdr a))))))

;*---------------------------------------------------------------------*/
;*    parse-cmdline ...                                                */
;*---------------------------------------------------------------------*/
(define (parse-cmdline cmdline)
   (let ((action '())
         (force #f)
         (usage-action #f)
         (help #f))

      (bind-exit (break)
         (args-parse (cdr cmdline)

            ;; common options
            (section "Common options")
            ((("-h" "--help") (help "This message (use -v -h for long help)"))
             (set! usage-action args-parse-usage)
             (set! help #t))
            (("-v?<level>" (help "Increase/set verbosity level (-v0 silence)"))
             (if (string=? <level> "")
                 (config.verbose-level-set! (+fx (config.verbose-level) 1))
                 (config.verbose-level-set! (string->integer <level>))))
            (("--no-color" (help "Disable colored traces"))
             (bigloo-trace-color-set! #f))
            (("--force" (help "Force execution action"))
             (set! force #t))
            (("--rc-dir" ?dir (help "Uses an alternate RC directory (see \"BMP_RC_DIRECTORY\")"))
             (config.set-rc-directory dir))
            
            ;; sub commands
            (section "Sub commands")
            (("config" (help "config commands"))
             (set! action (config.parse-config (cddr cmdline)))
             (break #t))
            (("db" (help "database commands"))
             (set! action (db.parse-cmdline (cddr cmdline)))
             (break #t))
            (("pkg" (help "package commands"))
             (set! action (parse-pkg-cmdline (cddr cmdline)))
             (break #t))
            (("proj" (help "project commands"))
             (set! action (proj.parse-cmdline (cdr cmdline) force))
             (break #t))
            
            (else
             (usage args-parse-usage))))

      (if (and (not action) usage-action)
          (lambda () (usage usage-action))
          action)))

;*---------------------------------------------------------------------*/
;*    usage ...                                                        */
;*---------------------------------------------------------------------*/
(define (usage args-parse-usage #!key (exitval 0) (msg #f))
   (when (string? msg)
      (print msg)
      (newline))
   (printf "~a v~a" (config.name) (bpmlib-version))
   (print "usage: " (config.name) " [options] command arg0 arg1 ...")
   (when (procedure? args-parse-usage)
      (args-parse-usage #f))
   (exit exitval))

;*---------------------------------------------------------------------*/
;*    parse-config-cmdline ...                                         */
;*---------------------------------------------------------------------*/
(define (parse-config-cmdline cmdline)
   #f)

;*---------------------------------------------------------------------*/
;*    parse-pkg-cmdline ...                                            */
;*---------------------------------------------------------------------*/
(define (parse-pkg-cmdline cmdline)
   #f)
