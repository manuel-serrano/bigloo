;*---------------------------------------------------------------------*/
;*    config                                                           */
;*---------------------------------------------------------------------*/
(module config
   (export parse-cmdline name version
      verbose verbose-set!
      repository tmp-directory
      rc-directory rc-directory-set!
      database-filename))

;*---------------------------------------------------------------------*/
;*    parse-cmdline ...                                                */
;*---------------------------------------------------------------------*/
(define (parse-cmdline cmdline::pair)

   (define (usage args-parse-usage)
      (printf "~a v~a\n" name version)
      (print "usage: " name " [options] "
         (trace-color 2 "config") " arg0 arg1 ...")
      (args-parse-usage #f)
      (exit 0))
   
   (args-parse cmdline
      (()
       (lambda () (usage args-parse-usage)))
      (("show" (help "Show configuration"))
       show)
      (else
       (lambda () (usage args-parse-usage)))))

;*---------------------------------------------------------------------*/
;*    name ...                                                         */
;*---------------------------------------------------------------------*/
(define name
   "bpm")

;*---------------------------------------------------------------------*/
;*    version ...                                                      */
;*---------------------------------------------------------------------*/
(define version
   "1.0.0")

;*---------------------------------------------------------------------*/
;*    verbose ...                                                      */
;*---------------------------------------------------------------------*/
(define verbose 0)

;*---------------------------------------------------------------------*/
;*    verbose-set! ...                                                 */
;*---------------------------------------------------------------------*/
(define (verbose-set! l::long)
   (set! verbose l))

;*---------------------------------------------------------------------*/
;*    show ...                                                         */
;*---------------------------------------------------------------------*/
(define (show)
   (print "repository: " (trace-color 30 repository))
   (print "rc-directory: " (trace-color 30 rc-directory))
   (print "tmp-directory: " (trace-color 30 tmp-directory)))

;*---------------------------------------------------------------------*/
;*    repository ...                                                   */
;*---------------------------------------------------------------------*/
(define repository
   (or (getenv "BPM_REPOSITORY")
       "https://github.com/manuel-serrano/bpm/blob/master/packages.sexp"))

;*---------------------------------------------------------------------*/
;*    rc-directory                                                     */
;*---------------------------------------------------------------------*/
(define rc-directory
   (or (getenv "BPM_RC_DIRECTORY")
       (make-file-path (getenv "HOME") ".config" "bpm")))

;*---------------------------------------------------------------------*/
;*    rc-directory-set! ...                                            */
;*---------------------------------------------------------------------*/
(define (rc-directory-set! v)
   (set! rc-directory v))

;*---------------------------------------------------------------------*/
;*    tmp-directory ...                                                */
;*---------------------------------------------------------------------*/
(define tmp-directory
   (or (getenv "BPM_TMP_DIRECTORY")
       (make-file-path (os-tmp) "bpm")))

;*---------------------------------------------------------------------*/
;*    database-filename ...                                            */
;*---------------------------------------------------------------------*/
(define database-filename
   "bpm.db")
