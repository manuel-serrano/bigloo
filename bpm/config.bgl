;*    bpm configuration                                                */
;*=====================================================================*/

;*---------------------------------------------------------------------*/
;*    config                                                           */
;*---------------------------------------------------------------------*/
(module config
   (export show name version
      dry-run dry-run-set!
      verbose verbose-set!
      repository tmp-directory
      rc-directory rc-directory-set!
      database-filename
      git-command))

;*---------------------------------------------------------------------*/
;*    name ...                                                         */
;*---------------------------------------------------------------------*/
(define name
   "bpm")

;*---------------------------------------------------------------------*/
;*    version ...                                                      */
;*---------------------------------------------------------------------*/
(define version
   "1.0.0")

;*---------------------------------------------------------------------*/
;*    dry-run ...                                                      */
;*---------------------------------------------------------------------*/
(define dry-run #f)

;*---------------------------------------------------------------------*/
;*    dry-run-set! ...                                                 */
;*---------------------------------------------------------------------*/
(define (dry-run-set! v::bool)
   (set! dry-run v))

;*---------------------------------------------------------------------*/
;*    verbose ...                                                      */
;*---------------------------------------------------------------------*/
(define verbose 0)

;*---------------------------------------------------------------------*/
;*    verbose-set! ...                                                 */
;*---------------------------------------------------------------------*/
(define (verbose-set! l::long)
   (set! verbose l))

;*---------------------------------------------------------------------*/
;*    show ...                                                         */
;*---------------------------------------------------------------------*/
(define (show)
   (print "repository: " (trace-color 30 repository))
   (print "rc-directory: " (trace-color 30 rc-directory))
   (print "database: " (trace-color 30 database-filename))
   (print "tmp-directory: " (trace-color 30 tmp-directory)))

;*---------------------------------------------------------------------*/
;*    repository ...                                                   */
;*---------------------------------------------------------------------*/
(define repository
   (or (getenv "BPM_REPOSITORY")
       "https://github.com/manuel-serrano/bpm/blob/master/packages.sexp"))

;*---------------------------------------------------------------------*/
;*    rc-directory                                                     */
;*---------------------------------------------------------------------*/
(define rc-directory
   (or (getenv "BPM_RC_DIRECTORY")
       (make-file-path (getenv "HOME") ".config" "bpm")))

;*---------------------------------------------------------------------*/
;*    rc-directory-set! ...                                            */
;*---------------------------------------------------------------------*/
(define (rc-directory-set! v)
   (set! rc-directory v))

;*---------------------------------------------------------------------*/
;*    tmp-directory ...                                                */
;*---------------------------------------------------------------------*/
(define tmp-directory
   (or (getenv "BPM_TMP_DIRECTORY")
       (make-file-path (os-tmp) "bpm")))

;*---------------------------------------------------------------------*/
;*    database-filename ...                                            */
;*---------------------------------------------------------------------*/
(define database-filename
   "bpm.db")

;*---------------------------------------------------------------------*/
;*    git-command ...                                                  */
;*---------------------------------------------------------------------*/
(define git-command
   "git")
