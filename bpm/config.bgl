;*    bpm configuration                                                */
;*=====================================================================*/

;*---------------------------------------------------------------------*/
;*    config                                                           */
;*---------------------------------------------------------------------*/
(module config
   (export parse-cmdline name verbose? verbose-level verbose-level-set!
      show repository rc-directory rc-directory-set! tmp-directory
      database-filename))

;*---------------------------------------------------------------------*/
;*    parse-cmdline ...                                                */
;*---------------------------------------------------------------------*/
(define (parse-cmdline cmdline::pair)
   (args-parse (cdr cmdline)
      (()
       (when (null? (cdr cmdline))
          (lambda () (args-parse-usafe #f))))
      (("show" (help "Show configuration"))
       show)
      (else
       (lambda () (args-parse-usage #f)))))

;*---------------------------------------------------------------------*/
;*    name ...                                                         */
;*---------------------------------------------------------------------*/
(define name
   "bpm")

;*---------------------------------------------------------------------*/
;*    verbose ...                                                      */
;*---------------------------------------------------------------------*/
(define verbose 0)

;*---------------------------------------------------------------------*/
;*    verbose?                                                         */
;*---------------------------------------------------------------------*/
(define (verbose? l::long)
   (>=fx verbose l))

;*---------------------------------------------------------------------*/
;*    verbose-level ...                                                */
;*---------------------------------------------------------------------*/
(define (verbose-level::long)
   verbose)

;*---------------------------------------------------------------------*/
;*    verbose-level-set! ...                                           */
;*---------------------------------------------------------------------*/
(define (verbose-level-set! l::long)
   (set! verbose l))

;*---------------------------------------------------------------------*/
;*    show ...                                                         */
;*---------------------------------------------------------------------*/
(define (show)
   (print "repository: " (trace-color 30 repository))
   (print "rc-directory: " (trace-color 30 rc-directory))
   (print "tmp-directory: " (trace-color 30 tmp-directory)))

;*---------------------------------------------------------------------*/
;*    repository ...                                                   */
;*---------------------------------------------------------------------*/
(define repository
   (or (getenv "BPM_REPOSITORY")
       "https://github.com/manuel-serrano/bpm/blob/master/packages.sexp"))

;*---------------------------------------------------------------------*/
;*    rc-directory                                                     */
;*---------------------------------------------------------------------*/
(define rc-directory
   (or (getenv "BPM_RC_DIRECTORY")
       (make-file-path (getenv "HOME") ".config" "bpm")))

;*---------------------------------------------------------------------*/
;*    rc-directory-set! ...                                            */
;*---------------------------------------------------------------------*/
(define (rc-directory-set! v)
   (set! rc-directory v))

;*---------------------------------------------------------------------*/
;*    tmp-directory ...                                                */
;*---------------------------------------------------------------------*/
(define tmp-directory
   (or (getenv "BPM_TMP_DIRECTORY")
       (make-file-path (os-tmp) "bpm")))

;*---------------------------------------------------------------------*/
;*    database-filename ...                                            */
;*---------------------------------------------------------------------*/
(define database-filename
   "bpm.db")
