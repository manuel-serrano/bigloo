;*---------------------------------------------------------------------*/
;*    package                                                          */
;*---------------------------------------------------------------------*/
(module package
   (import "./config.bgl" . config)
   (import "./utils.bgl" . utils)
   (export Package PackageVersion pp decode-name list->package-version
      check-version))

;*---------------------------------------------------------------------*/
;*    Package ...                                                      */
;*---------------------------------------------------------------------*/
(define-class Package
   (name::bstring read-only)
   (description::bstring read-only)
   (versions::pair-nil (default '())))

;*---------------------------------------------------------------------*/
;*    PackageVersion ...                                               */
;*---------------------------------------------------------------------*/
(define-class PackageVersion
   (version::bstring read-only)
   (note::bstring read-only)
   (author::bstring read-only)
   (url::bstring read-only)
   (checksum::bstring read-only)
   (backends::pair-nil read-only)
   (bigloo read-only)
   (dependencies::pair-nil read-only))

;*---------------------------------------------------------------------*/
;*    serialization                                                    */
;*---------------------------------------------------------------------*/
(register-class-serialization! Package
   (lambda (o::Package)
      (vector o.name o.description o.versions))
   (lambda (o v)
      (instantiate::Package
         (name (vector-ref o 0))
         (description (vector-ref o 1))
         (versions (vector-ref o 2)))))

(register-class-serialization! PackageVersion
   (lambda (o::PackageVersion)
      (vector o.version o.note o.author o.url o.checksum o.backends o.bigloo
         o.dependencies))
   (lambda (o v)
      (instantiate::PackageVersion
         (version (vector-ref o 0))
         (note (vector-ref o 1))
         (author (vector-ref o 2))
         (url (vector-ref o 3))
         (checksum (vector-ref o 4))
         (backends (vector-ref o 5))
         (bigloo (vector-ref o 6))
         (dependencies (vector-ref o 7)))))

;*---------------------------------------------------------------------*/
;*    pp ...                                                           */
;*---------------------------------------------------------------------*/
(define (pp l op::output-port)
   (fprint op "(")
   (let loop ((l l))
      (when (pair? l)
         (display "  " op)
         (display (car l) op)
         (display " " op)
         (write (cadr l) op)
         (newline op)
         (loop (cddr l))))
   (fprint op ")"))

;*---------------------------------------------------------------------*/
;*    list->package-version ...                                        */
;*---------------------------------------------------------------------*/
(define (list->package-version::PackageVersion l::pair)

   (define cache l)

   (define (plist-get/list c::pair-nil key::keyword opt)
      (let loop ((l c))
         (cond
            ((pair? l)
             (if (pair? (cdr l))
                 (if (eq? (car l) key)
                     (let ((r (cadr l)))
                        (set! cache l)
                        r)
                     (loop (cddr l)))
                 (utils.error/loc "package" "syntax error" l)))
            ((null? l)
             opt)
            (else
             (utils.error/loc "package" "syntax error" l)))))

   (define (plist-get l::pair-nil key::keyword #!optional opt)
      (or (plist-get/list cache key #f)
          (plist-get/list l key opt)
          (utils.error/loc "package" (format "missing attribute ~a" key) l)))

   (instantiate::PackageVersion
      (version (plist-get l version:))
      (note (plist-get l description:))
      (author (plist-get l author:))
      (url (plist-get l url:))
      (checksum (plist-get l sha256:))
      (bigloo (plist-get l bigloo: #t))
      (backends (plist-get l backends: '(c jvm wasm)))
      (dependencies (plist-get l dependencies: '()))))

;*---------------------------------------------------------------------*/
;*    decode-name ...                                                  */
;*---------------------------------------------------------------------*/
(define (decode-name pkg::bstring)
   (cond
      ((pregexp-match "(.*)/([0-9]+.[0-9]+.[0-9]+)" pkg)
       =>
       (lambda (m)
          (values (cadr m) (caddr m))))
      (else
       (values pkg #f))))
      
;*---------------------------------------------------------------------*/
;*    check-version ...                                                */
;*---------------------------------------------------------------------*/
(define (check-version pv::PackageVersion dir::bstring)
   #t)
           
