;*---------------------------------------------------------------------*/
;*    database                                                         */
;*---------------------------------------------------------------------*/
(module database
   (import "./config.bgl" . config)
   (import "./utils.bgl" . utils)
   (import "./package.bgl" . pkg)
   (export Database parse-cmdline update list-packages))

;*---------------------------------------------------------------------*/
;*    Database ...                                                     */
;*---------------------------------------------------------------------*/
(define-class Database
   (path::bstring read-only)
   (packages::struct read-only))

;*---------------------------------------------------------------------*/
;*    database ...                                                     */
;*---------------------------------------------------------------------*/
(define database #f)

;*---------------------------------------------------------------------*/
;*    parse-cmdline ...                                                */
;*---------------------------------------------------------------------*/
(define (parse-cmdline cmdline::pair)
   (args-parse (cdr cmdline)
      (("list" (help "List packages"))
       (list list-packages (load-database config.rc-directory)))
      (("update" (help "Update database"))
       #f)
      (("init" ?url (help "Initialize a database"))
       (init url))
      (else
       (list args-parse-usage #f))))

;*---------------------------------------------------------------------*/
;*    init ...                                                         */
;*---------------------------------------------------------------------*/
(define (init url)
   (let ((rcdir config.rc-directory))
      (if (directory? rcdir)
          (utils.error "db init" "RC directory already exists" rcdir)
          (make-directories rcdir))
      (cond
         ((directory? url)
          (init-from-directory rcdir url))
         (else
          (utils.error "db init" "URL not supported" url)))))

;*---------------------------------------------------------------------*/
;*    load-database ...                                                */
;*---------------------------------------------------------------------*/
(define (load-database rcdir::bstring)
   (let* ((n (make-file-name rcdir config.database-filename))
          (p (open-input-binary-file n)))
      (if (binary-port? p)
          (unwind-protect
             (input-obj p)
             (close-binary-port p))
          (utils.error "load-database" "Cannot find database" p))))

;*---------------------------------------------------------------------*/
;*    save-database ...                                                */
;*---------------------------------------------------------------------*/
(define (save-database rcdir::bstring db::Database)
   (let* ((n (make-file-name rcdir config.database-filename))
          (p (open-output-binary-file n)))
      (unwind-protect
         (output-obj p db)
         (close-binary-port p))))

;*---------------------------------------------------------------------*/
;*    init-from-directory ...                                          */
;*---------------------------------------------------------------------*/
(define (init-from-directory::Database rcdir::bstring url::bstring)
   
   (define db::Database
      (instantiate::Database
         (path (make-file-name rcdir config.database-filename))
         (packages (make-hashtable :keys 'string))))
   
   (define (add-package dir)
      (let ((versions (map (lambda (p)
                              (pkg.list->package-version
                                 (call-with-input-file (make-file-name dir p)
                                    (lambda (ip)
                                       (read ip #t)))))
                         (sort utils.version<=?
                            (filter (lambda (f)
                                       (string-suffix? ".sexp" f))
                               (directory->list dir))))))
         (if (pair? versions)
             (with-access::PackageVersion (car versions) (note)
                (let* ((name (basename dir))
                       (pkg (instantiate::Package
                              (name name)
                              (description note)
                              (versions versions))))
                   (hashtable-put! db.packages name pkg)))
             (utils.error "db init" "Empty package directory" dir))))
   
   (for-each add-package (filter directory? (directory->path-list url)))

   (save-database rcdir db)

   db)

;*---------------------------------------------------------------------*/
;*    update ...                                                       */
;*---------------------------------------------------------------------*/
(define (update)
   #unspecified)
   
;*---------------------------------------------------------------------*/
;*    list-packages ...                                                */
;*---------------------------------------------------------------------*/
(define (list-packages db::Database)
   (for-each (lambda (p::Package)
                (display (utils.color 'arg0 p.name))
                (display " ")
                (let ((v0::PackageVersion (car (last-pair p.versions))))
                   (display v0.version))
                (newline)
                (display "  ")
                (display p.description)
                (newline))
      (sort (lambda (p::Package q::Package)
               (string<=? p.name q.name))
         (hashtable->list db.packages))))

