;*---------------------------------------------------------------------*/
;*    database                                                         */
;*---------------------------------------------------------------------*/
(module database
   (import "./config.bgl" . config)
   (import "./utils.bgl" . utils)
   (import "./git.bgl" . git)
   (import "./package.bgl" . pkg)
   (import "./versions.bgl" . versions)
   (export Database init update! load-database
      list-packages find-package find-package-version))

;*---------------------------------------------------------------------*/
;*    Database ...                                                     */
;*---------------------------------------------------------------------*/
(define-class Database
   ;; the path the .db file
   (path::bstring read-only)
   ;; the url of the origin
   (url::bstring read-only)
   ;; the local clone
   dir::bstring
   ;; the list of packages
   (packages::struct read-only (default (make-hashtable :keys 'string))))

;*---------------------------------------------------------------------*/
;*    serialization                                                    */
;*---------------------------------------------------------------------*/
(register-class-serialization! Database
   (lambda (o::Database)
      (vector o.path o.url o.dir (hashtable-map cons o.packages)))
   (lambda (o v)
      (let* ((db::Database (instantiate::Database
                              (path (vector-ref o 0))
                              (url (vector-ref o 1))
                              (dir (vector-ref o 2))))
             (pkgs db.packages))
         (for-each (lambda (kb)
                      (hashtable-put! pkgs (car kb) (cdr kb)))
            (vector-ref o 3))
         db)))

;*---------------------------------------------------------------------*/
;*    dbcache ...                                                      */
;*---------------------------------------------------------------------*/
(define dbcache '())

;*---------------------------------------------------------------------*/
;*    init ...                                                         */
;*---------------------------------------------------------------------*/
(define (init url)
   (let ((rcdir config.rc-directory))
      (if (directory? rcdir)
          (utils.error "db init" "RC directory already exists" rcdir)
          (begin
             (utils.verb
                (format "creating directory ~a" (utils.color 'arg0 rcdir)))
             (make-directories rcdir)))
      (let ((db (instantiate::Database
                   (path (make-file-name rcdir config.database-filename))
                   (url url)
                   (dir url))))
         (cond
            ((directory? url)
             (update-from-directory! db))
            ((git.git-url? url)
             (let ((db::Database db))
                (set! db.dir (make-file-name rcdir "git"))
                (init-git! db)
                (update-from-directory! db)))
            (else
             (utils.error "db init" "URL not supported" url))))))

;*---------------------------------------------------------------------*/
;*    load-database ...                                                */
;*---------------------------------------------------------------------*/
(define (load-database::Database rcdir::bstring)
   (let* ((n (make-file-name rcdir config.database-filename))
          (db (assoc n dbcache)))
      (if (pair? db)
          (cdr db)
          (let ((p (open-input-binary-file n)))
             (utils.verb (format "loading database ~a" (utils.color 'database n)))
             (if (binary-port? p)
                 (unwind-protect
                    (let ((db (input-obj p)))
                       (set! dbcache (cons (cons n db) dbcache))
                       db)
                    (close-binary-port p))
                 (utils.error "load-database" "Cannot find database" p))))))

;*---------------------------------------------------------------------*/
;*    save-database ...                                                */
;*---------------------------------------------------------------------*/
(define (save-database db::Database)
   (let ((p (open-output-binary-file db.path)))
      (unwind-protect
         (output-obj p db)
         (close-binary-port p))))

;*---------------------------------------------------------------------*/
;*    update-from-directory! ...                                       */
;*---------------------------------------------------------------------*/
(define (update-from-directory!::Database db::Database)
   
   (define (package-name file sexp::pair-nil)
      (let ((l (memq name: sexp)))
         (cond
            ((and (pair? l) (pair? (cdr l)) (string? (cadr l)))
             (cadr l))
            (else
             (utils.error file "Cannot find package name" sexp)))))
   
   (define (read-package-version file)
      (if (string-suffix? ".sexp" file)
          (with-handler
             (lambda (e)
                (exception-notify e)
                #f)
             (let ((sexp (call-with-input-file file
                            (lambda (ip) (read ip #t)))))
                (unless (pair? sexp)
                   (utils.error "read" "Corrupted file" file))
                (cons (package-name file sexp)
                   (pkg.list->package-version sexp))))
          (begin
             (print "ignoring file " (utils.color 'warning file))
             #f)))
   
   (let ((versions (filter-map read-package-version
                      (directory->path-list db.dir))))
      (for-each (lambda (x)
                   (let ((name (car x))
                         (v::PackageVersion (cdr x)))
                      (let ((o (hashtable-get db.packages name)))
                         (if (isa? o pkg.Package)
                             (let ((o::Package o))
                                (unless (find (lambda (w::PackageVersion)
                                                 (string=? v.version
                                                    w.version))
                                           o.versions)
                                   (utils.verb 
                                      (format "  adding ~a version ~a"
                                         name
                                         (utils.color 'version v.version))
                                      :lvl 2)
                                   (set! o.versions
                                      (append! o.versions (list v)))))
                             (begin
                                (utils.verb 
                                   (format "adding package ~a"
                                      (utils.color 'package name)))
                                (hashtable-put! db.packages name
                                   (instantiate::Package
                                      (name name)
                                      (description v.note)
                                      (versions (list v)))))))))
         (sort (lambda (x y)
                  (if (string=? (car x) (car y))
                      (let ((vx::PackageVersion (cdr x))
                            (vy::PackageVersion (cdr y)))
                         (>=fx (string-natural-compare3 vx.version vy.version) 0))
                      (string<? (car x) (car y))))
            versions))
      
      (save-database db)
      
      db))

;*---------------------------------------------------------------------*/
;*    update! ...                                                      */
;*---------------------------------------------------------------------*/
(define (update! db::Database)
   (cond
      ((directory? db.url)
       (update-from-directory! db))
      ((git.git-url? db.url)
       (when (git.update db.dir)
          (update-from-directory! db)))
      (else
       (utils.error "db init" "URL not supported" db.url))))

;*---------------------------------------------------------------------*/
;*    init-git! ...                                                    */
;*---------------------------------------------------------------------*/
(define (init-git! db::Database)
   (if (directory? db.dir)
       (utils.error "db init" "git directory already exists" db.dir)
       (make-directory db.dir))
   (unless (directory? db.dir)
      (utils.error "db init" "cannot create git directory" db.dir))
   (unless (git.clone db.url db.dir)
      (utils.error "db init" "cannot clone git repository" db.url)))
   
;*---------------------------------------------------------------------*/
;*    list-packages ...                                                */
;*---------------------------------------------------------------------*/
(define (list-packages db::Database)
   (for-each (lambda (p::Package)
                (let ((v0::PackageVersion (car (last-pair p.versions))))
                   (print (utils.color 'package p.name) " " v0.version)
                   (when (>fx (string-length p.description) 0)
                      (print "  " p.description))
                   (when (>=fx config.verbose 1)
                      (for-each (lambda (pv::PackageVersion)
                                   (print "  version: " pv.version)
                                   (print "  author: " pv.author)
                                   (print "  homepage: " pv.homepage)
                                   (print "  url: " pv.url)
                                   (unless (or (string=? pv.note "")
                                               (string=? pv.note p.description))
                                      (print "  note: " pv.note))
                                   (print "  bigloo: " pv.bigloo)
                                   (print "  dependencies: " pv.dependencies))
                         p.versions))
                   (newline)))
      (sort (lambda (p::Package q::Package)
               (string<=? p.name q.name))
         (hashtable->list db.packages))))

;*---------------------------------------------------------------------*/
;*    find-package ...                                                 */
;*---------------------------------------------------------------------*/
(define (find-package::Package name::bstring)
   (let ((db::Database (load-database config.rc-directory)))
      (let ((p (hashtable-get db.packages name)))
         (or p
             (utils.error utils.command
                "Cannot find package"
                (utils.color 'error name))))))

;*---------------------------------------------------------------------*/
;*    find-package-version ...                                         */
;*---------------------------------------------------------------------*/
(define (find-package-version::PackageVersion name::bstring version)
   (let ((db::Database (load-database config.rc-directory)))
      (let ((p (hashtable-get db.packages name)))
         (if (isa? p pkg.Package)
             (let ((p::Package p))
                (if version
                    (or (find (lambda (pv::PackageVersion)
                                 (versions.match version pv.version))
                           p.versions)
                        (utils.error utils.command
                           (format "Cannot find package version \"~a\""
                              (utils.color 'error version))
                           name))
                    (car p.versions)))
             (utils.error utils.command
                "Cannot find package in database"
                (utils.color 'error name))))))
                       
