;*---------------------------------------------------------------------*/
;*    utils                                                            */
;*---------------------------------------------------------------------*/
(module utils
   (import "./config.bgl" . config)
   (export
      command command-set!
      (error bmp-error)
      (error/loc bmp-error/loc)
      verb
      rm-rf cp* cp-r
      download
      untar
      url?
      yes-no?
      color
      plist-get plist-set))

;*---------------------------------------------------------------------*/
;*    command ...                                                      */
;*---------------------------------------------------------------------*/
(define command "")

;*---------------------------------------------------------------------*/
;*    current-command-set! ...                                         */
;*---------------------------------------------------------------------*/
(define (command-set! cmd)
   (set! command cmd))

;*---------------------------------------------------------------------*/
;*    bmp-error ...                                                    */
;*---------------------------------------------------------------------*/
(define (bmp-error cmd msg obj)
   (if (epair? obj)
       (match-case (cer obj)
          ((at ?fname ?loc)
           (error/location (format "~a ~a" config.name cmd) msg obj fname loc))
          (else
           (error (format "~a ~a" config.name cmd) msg obj)))
       (error (format "~a ~a" config.name cmd) msg obj)))

;*---------------------------------------------------------------------*/
;*    bmp-error/loc ...                                                */
;*---------------------------------------------------------------------*/
(define (bmp-error/loc cmd msg obj loc)
   (if (epair? loc)
       (match-case (cer loc)
          ((at ?fname ?loc)
           (error/location (format "~a ~a" config.name cmd) msg obj fname loc))
          (else
           (error (format "~a ~a" config.name cmd) msg obj)))
       (error (format "~a ~a" config.name cmd) msg obj)))

;*---------------------------------------------------------------------*/
;*    verb ...                                                         */
;*---------------------------------------------------------------------*/
(define (verb msg::bstring #!key (lvl::long 1))
   (when (>=fx config.verbose lvl) (print msg)))

;*---------------------------------------------------------------------*/
;*    rm-rf ...                                                        */
;*---------------------------------------------------------------------*/
(define (rm-rf path)
   (when (file-exists? path)
      (if (directory? path)
	  (let ((files (directory->list path)))
	     (for-each (lambda (f) (rm-rf (make-file-name path f))) files)
	     (delete-directory path))
	  (delete-file path))))

;*---------------------------------------------------------------------*/
;*    cp* ...                                                          */
;*---------------------------------------------------------------------*/
(define (cp* src dest)
   (unless (or (directory? dest) (make-directory dest))
      (raise (instantiate::&io-write-error
		(proc 'cp*)
		(msg "Cannot create directory")
		(obj dest))))
   (for-each (lambda (f)
		(let ((path (make-file-name src f)))
		   (unless (directory? path)
		      (copy-file path (make-file-name dest f)))))
	     (directory->list src)))

;*---------------------------------------------------------------------*/
;*    cp-r ...                                                         */
;*---------------------------------------------------------------------*/
(define (cp-r src dest)
   (unless (or (directory? dest) (make-directory dest))
      (raise
         (instantiate::&io-write-error
            (proc "cp-r")
            (msg "Cannot create directory")
            (obj dest))))
   (let loop ((src src)
	      (dest dest))
      (if (directory? src)
	  (let ((destdir (make-file-name dest (basename src))))
	     (unless (or (directory? destdir) (make-directory destdir))
		(raise
                   (instantiate::&io-write-error
                      (proc "cp-r")
                      (msg "Cannot create directory")
                      (obj destdir))))
	     (for-each (lambda (f)
			  (loop (make-file-name src f) destdir))
		       (directory->list src)))
	  (copy-file src (make-file-name dest (basename src))))))

;*---------------------------------------------------------------------*/
;*    download-error ...                                               */
;*---------------------------------------------------------------------*/
(define (download-error line url)
   (raise
      (instantiate::&io-read-error
         (proc "download-error")
         (msg line)
         (obj url))))

;*---------------------------------------------------------------------*/
;*    download-redirect ...                                            */
;*---------------------------------------------------------------------*/
(define (download-redirect url ip)
   (let laap ((line (read-line ip)))
      (if (eof-object? line)
	  (download-error line url)
	  (let ((m (pregexp-match "[Ll]ocation: \(.*\)" line)))
	     (if (pair? m)
		 (cadr m)
		 (laap (read-line ip)))))))

;*---------------------------------------------------------------------*/
;*    download ...                                                     */
;*---------------------------------------------------------------------*/
(define (download::bstring url::bstring name::bstring #!key md5 sha256 sha512)
   
   (define (http-download url name)
      
      (unless (directory? config.tmp-directory)
         (make-directories config.tmp-directory)
         (unless (directory? config.tmp-directory)
            (bmp-error "download" "Cannot create tmp directory"
               config.tmp-directory)))
      
      (let* ((tgz (string-append name ".tgz"))
             (tmp (make-file-name config.tmp-directory tgz)))
         (call-with-output-file tmp
            (lambda (op)
               (let liip ((url url))
                  (trace-item "url=" url)
                  (let ((ip (open-input-file url)))
                     (unless (input-port? ip)
                        (raise
                           (instantiate::&io-read-error
                              (proc "download")
                              (msg "Cannot open url")
                              (obj url))))
                     (unwind-protect
                        (let* ((line (read-line ip))
                               (status (string-split line " ")))
                           (unless (and (pair? status)
                                        (pair? (cdr status)))
                              (download-error line url))
                           (case (string->integer (cadr status))
                              ((200)
                               (let laap ()
                                  (let ((e (read-line ip)))
                                     (if (string=? e "")
                                         (send-chars ip op)
                                         (laap)))))
                              ((301 302 307)
                               (let ((nu (download-redirect url ip)))
                                  (when (>=fx config.verbose 3)
                                     (print
                                        "  download redirected to "
                                        (color 'arg0 nu)))
                                  (liip nu)))
                              (else
                               (download-error line url))))
                        (close-input-port ip))))))
         tmp))
   
   (define (git-download url name)
      (error "git-download" "not implemented" url))
   
   ;; download the file if it does not exist
   (let ((tgz (cond
                 ((or (string-prefix? "http://" url)
                      (string-prefix? "https://" url))
                  (http-download url name))
                 ((string-prefix? "git://" url)
                  (git-download url name))
                 ((string-prefix? "file://" url)
                  (substring url 7))
                 (else
                  url))))
      (if (file-exists? tgz)
          (cond
             (sha512
              (if (string=? (sha512sum-file tgz) sha512)
                  tgz
                  (bmp-error "download" "Corrupted tgz" url)))
             (sha256
              (if (string=? (sha256sum-file tgz) sha256)
                  tgz
                  (bmp-error "download" "Corrupted tgz" url)))
             (md5
              (if (string=? (md5sum-file tgz) md5)
                  tgz
                  (bmp-error "download" "Corrupted tgz" url)))
             (else
              tgz))
          (bmp-error "download" "Cannot download url" url))))

;*---------------------------------------------------------------------*/
;*    tar-header-type ...                                              */
;*---------------------------------------------------------------------*/
(define (tar-header-type t)
   (with-access::tar-header t (type)
      type))

;*---------------------------------------------------------------------*/
;*    tar-header-name ...                                              */
;*---------------------------------------------------------------------*/
(define (tar-header-name t)
   (with-access::tar-header t (name)
      name))

;*---------------------------------------------------------------------*/
;*    port-untar ...                                                   */
;*---------------------------------------------------------------------*/
(define (port-untar pz::input-port path::bstring outdir::bstring)
   (let loop ((rootdir #f))
      (let ((h (tar-read-header pz)))
	 (if (not h)
	     rootdir
	     (case (tar-header-type h)
		((dir)
		 (let* ((dir (tar-header-name h))
                        (path (make-file-name outdir dir)))
		    (if (or (directory? path) (make-directory path))
			(loop (or rootdir dir))
			(raise
                           (instantiate::&io-write-error
                              (proc "tarball-untar")
                              (msg "Cannot create directory")
                              (obj path))))))
		((normal)
		 (let* ((path (make-file-name outdir (tar-header-name h)))
			(dir (dirname path)))
		    (when (and (file-exists? dir) (not (directory? dir)))
		       (delete-file dir))
		    (unless (file-exists? dir)
		       (make-directory dir))
		    (let ((p (open-output-file path)))
		       (if (output-port? p)
			   (unwind-protect
			      (display (tar-read-block h pz) p)
			      (close-output-port p))
			   (raise
                              (instantiate::&io-write-error
                                 (proc "untar")
                                 (msg "Cannot open file for output")
                                 (obj p)))))
		    (loop rootdir)))
		(else
		 (raise (instantiate::&io-parse-error
			   (proc 'tarball-untar)
			   (msg (format "Illegal file type `~a'"
                                   (tar-header-type h)))
			   (obj path)))))))))

;*---------------------------------------------------------------------*/
;*    tarball-untar ...                                                */
;*---------------------------------------------------------------------*/
(define (tarball-untar path::bstring outdir::bstring)
   (let ((pz (open-input-file path)))
      (unwind-protect
	 (port-untar pz path outdir)
	 (close-input-port pz))))

;*---------------------------------------------------------------------*/
;*    tarball-untar-gz ...                                             */
;*---------------------------------------------------------------------*/
(define (tarball-untar-gz path::bstring outdir::bstring)
   (let ((pz (open-input-gzip-file path)))
      (unwind-protect
         (port-untar pz path outdir)
	 (close-input-port pz))))

;*---------------------------------------------------------------------*/
;*    untar ...                                                        */
;*---------------------------------------------------------------------*/
(define (untar::bstring path::bstring outdir::bstring)
   
   (when (>= config.verbose 1)
      (print "untar " (color 'arg0 path) "\n  -> " (color 'arg1 outdir)))
   
   (let ((dir (if (or (string-suffix? ".tgz" path) (string-suffix? ".gz" path))
                  (tarball-untar-gz path (dirname outdir))
                  (tarball-untar path (dirname outdir)))))
      (unless (string=? dir (basename outdir))
         (rename-file dir outdir))
      outdir))
       
;*---------------------------------------------------------------------*/
;*    url? ...                                                         */
;*---------------------------------------------------------------------*/
(define (url? str)
   (or (string-prefix? "http://" str) (string-prefix? "https://" str)))

;*---------------------------------------------------------------------*/
;*    yes-no? ...                                                      */
;*---------------------------------------------------------------------*/
(define (yes-no?::bool message::bstring . rest)
   (for-each display rest)
   (let loop ()
      (display message)
      (let ((c (read)))
         (if (eq? c 'y)
             #t
             (if (eq? c 'n)
                 #f
                 (loop))))))

;*---------------------------------------------------------------------*/
;*    color ...                                                        */
;*---------------------------------------------------------------------*/
(define (color col msg)
   (if (fixnum? col)
       (trace-color col msg)
       (let ((c (assq col colors)))
          (if (pair? c)
              (trace-color (+fx (modulofx (cadr c) 16) 1) msg)
              (trace-color 0 msg)))))

;*---------------------------------------------------------------------*/
;*    colors                                                           */
;*---------------------------------------------------------------------*/
(define colors
   '((error 0)
     (warning 6)
     (ok 3)
     (message 1)
     (command 2)
     (arg0 3)
     (arg1 4)
     (arg2 5)
     (package 6)
     (version 7)
     (variable 7)
     (macro 3)
     (function 4)
     (record 5)
     (exception 6)))

;*---------------------------------------------------------------------*/
;*    plist-get ...                                                    */
;*---------------------------------------------------------------------*/
(define (plist-get l::pair-nil key::keyword def)
   (let loop ((l l))
      (cond
         ((pair? l)
          (if (pair? (cdr l))
              (if (eq? (car l) key)
                  (cadr l)
                  (loop (cddr l)))
              (bmp-error "plist" "syntax error" l)))
         ((null? l)
          def)
         (else
          (bmp-error "plist" "syntax error" l)))))

;*---------------------------------------------------------------------*/
;*    plist-set ...                                                    */
;*---------------------------------------------------------------------*/
(define (plist-set l::pair-nil key::keyword value)
   (let loop ((l l))
      (cond
         ((pair? l)
          (if (pair? (cdr l))
              (if (eq? (car l) key)
                  (cons* key value (cddr l))
                  (cons* (car l) (cadr l) (loop (cddr l))))
              (bmp-error "package" "syntax error" l)))
         ((null? l)
          (append l (list key value)))
         (else
          (bmp-error "plist" "syntax error" l)))))
