;*---------------------------------------------------------------------*/
;*    The library                                                      */
;*---------------------------------------------------------------------*/
(declare-library! 'bpmlib 
   :srfi '(bpmlib)
   :basename "bigloobpmlib"
   :module-init '__bpmlib
   :module-eval '__bpmlib_make_lib
   :class-init "bigloo.bpmlib.bpmlib"
   :class-eval "bigloo.bpmlib.make_lib")

