;*---------------------------------------------------------------------*/
;*    The module                                                       */
;*---------------------------------------------------------------------*/
(module bignum
   (import (utils "utils.scm"))
   (include "test.sch")
   (export (test-bignum)))

;*---------------------------------------------------------------------*/
;*    bigfactorial ...                                                 */
;*---------------------------------------------------------------------*/
(define (factorial n::bignum)
   (let loop ((n n) (f #z1))
      (if (positivebx? n)
	  (loop (-bx n #z1) (*bx f n))
	  f)))

;*---------------------------------------------------------------------*/
;*    fixbig? ...                                                      */
;*---------------------------------------------------------------------*/
(define (fixbig? n)
   (cond-expand
      (enable-gmp (fixnum? n))
      (else (or (fixnum? n) (bignum? n)))))

;*---------------------------------------------------------------------*/
;*    test-bignum ...                                                  */
;*---------------------------------------------------------------------*/
(define (test-bignum)
   (test-module "bignum" "bignum.scm"))
			
 
